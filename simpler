#!/bin/sh
# The simpler command: run, build and inspect a Simpler program.
#
#   simpler run prog.smplr [arguments]   compile and run it
#   simpler run --dry prog.smplr [args]  run it, but only say what it would write, delete, start, fetch or mail
#   simpler run https://...              fetch a program, show what it can touch, ask once, then run it
#   simpler undo prog.smplr              put back the files its last run wrote, changed or deleted
#   simpler replay [--show] prog.smplr   run its last failed run again with the same input (--show prints the input)
#   simpler room [--undo] folder [args]  Claude Code in a lock that can change only that folder (--undo puts it back)
#   simpler build prog.smplr [-o name]   make a program file (default: prog)
#   simpler what prog.smplr              list everything the program can touch
#   simpler pieces prog.smplr            list each function: what it takes, what it touches, its examples
#   simpler trusted prog.smplr [args]    succeed when all it can touch is inside ~/.config/simpler/trust
#   simpler test prog.smplr              run its test_ functions
#   simpler c prog.smplr                 print the C it compiles to
#   simpler prompt [part ...]            print the one page to give an AI, with the parts named
#                                        (regex json bytes net screen, or all) and modules (tui opts astro)
set -e

self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
home=$(cd "$(dirname "$self")" && pwd)

usage() { sed -n '2,17p' "$self" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# The compiler: next to this script after an install, or built in the repo.
compiler() {
    if [ -n "$SIMPLERC" ]; then echo "$SIMPLERC"; return; fi
    if [ -x "$home/simplerc" ]; then echo "$home/simplerc"; return; fi
    if [ ! -x "$home/selfhost/simpler" ] || [ "$home/selfhost/simpler.c" -nt "$home/selfhost/simpler" ]; then
        ${CC:-cc} -O2 -w "$home/selfhost/simpler.c" -o "$home/selfhost/simpler" -lm
    fi
    echo "$home/selfhost/simpler"
}

# Where a module's file is looked for: next to the program, then $SIMPLER_LIB,
# then the lib folder that came with simpler.
find_mod() {
    for d in "$progdir" "$SIMPLER_LIB" "$home/lib"; do
        if [ -n "$d" ] && [ -f "$d/$1.smplr" ]; then echo "$d/$1.smplr"; return; fi
    done
}

# copy_mods FILE: put every module FILE uses, and the ones those use, in $work.
copy_mods() {
    for m in $(sed -n 's/^uses "\([A-Za-z0-9_]*\)"[[:space:]]*$/\1/p' "$1"); do
        [ "$m" = input ] || [ -f "$work/$m.smplr" ] && continue
        f=$(find_mod "$m")
        [ -n "$f" ] || continue
        cp "$f" "$work/$m.smplr"
        copy_mods "$work/$m.smplr"
    done
}

# prep FILE: a work folder with FILE as input.smplr and its modules beside it.
prep() {
    [ -f "$1" ] || { echo "simpler: no file named $1" >&2; exit 2; }
    work=$(mktemp -d)
    progdir=$(dirname "$1")
    cp "$1" "$work/input.smplr"
    # A module the program calls as name.thing with no uses line gets its line (at the end, so
    # no line number moves). Not when the name also stands alone: then it is a variable.
    for m in $(grep -oE '(^|[^.A-Za-z0-9_])[a-z][a-z0-9_]*\.[A-Za-z]' "$work/input.smplr" | sed 's/^[^a-z]//; s/\..*//' | sort -u); do
        [ -n "$(find_mod "$m")" ] || continue
        grep -Eq "^uses \"$m\"|(^|[^.A-Za-z0-9_])$m([^.A-Za-z0-9_]|\$)" "$work/input.smplr" ||
            printf '\nuses "%s"\n' "$m" >> "$work/input.smplr"
    done
    copy_mods "$work/input.smplr"
}

# to_c MODE OUT: compile the work folder to C in OUT, with messages that name the file.
to_c() {
    if ! (cd "$work" && "$cc_simpler" $1 > out 2> err); then
        sed "s|^input\.smplr:|$shown:|" "$work/err" >&2
        rm -rf "$work"
        exit 1
    fi
    sed "s|simpler_fl\[\] = {\"input\.smplr\"|simpler_fl[] = {\"$shown\"|" "$work/out" > "$2"
    rm -rf "$work"
}

# The page for one module: its types, and each function that has a comment above it.
mod_page() {
    progdir=.
    f=$(find_mod "$1")
    [ -n "$f" ] || { echo "simpler: no module named $1" >&2; exit 2; }
    echo "Module $1. Put  uses \"$1\"  at the top of the program. Call a function as $1.name(...)"
    echo "and write a type as $1.Name. The module's functions and types:"
    echo
    awk '/^\/\// { c = c $0 "\n"; next }
         /^[A-Za-z_][A-Za-z0-9_]* = type \{/ { printf "%s", c; t = 1 }
         t { print; if ($0 ~ /^\}/) t = 0; c = ""; next }
         /^test_/ { c = ""; next }
         /^[A-Za-z_][A-Za-z0-9_]*\(.*\{[ \t]*$/ { sub(/[ \t]*\{[ \t]*$/, ""); if (c != "") printf "%s%s\n", c, $0 }
         { c = "" }' "$f"
}

# A name that is safe inside a message; any other file is shown as input.smplr.
show_name() {
    case $1 in *[!A-Za-z0-9._/-]*) echo input.smplr ;; *) echo "$1" ;; esac
}

# names TEXT: the quoted names in TEXT, one per line. Fails when TEXT holds
# anything it cannot read for sure, such as a name with a quote in it.
names() {
    rest=$(printf '%s' "$1" | sed 's/"[^"\\]*"//g; s/anything under//g; s/any file named on the command line//g; s/[, ]//g' | tr -d '\n')
    [ -z "$rest" ] || return 1
    printf '%s\n' "$1" | grep -o '"[^"]*"' | sed 's/^"//; s/"$//'
    return 0
}

# full PATH: the path as the kernel sees it, links followed. A folder keeps
# its /, and a name with a * becomes its folder, which is what the lock opens.
full() {
    p=$1
    case $p in "~/"*) p=$HOME/${p#"~/"} ;; esac
    case $p in *'*'*) p=${p%%'*'*}; case $p in */*) p=${p%/*}/ ;; *) p=./ ;; esac ;; esac
    case $p in
        */) p=$(realpath -m -- "$p"); echo "${p%/}/" ;;
        *) realpath -m -- "$p" ;;
    esac
}

# inside WORD KIND [args]: is every name on the program's "may WORD" line
# allowed by the KIND lines of the rules file?
inside() {
    word=$1; kind=$2; shift 2
    line=$(printf '%s\n' "$listing" | sed -n "s/^may $word  *//p")
    [ -n "$line" ] || return 0
    wanted=$(names "$line") || return 1
    allowed=$(names "$(sed -n "s/^$kind[[:space:]]//p" "$rules")") || return 1
    case $line in *"any file named on the command line"*)
        for a in "$@"; do wanted="$wanted
$a"; done ;;
    esac
    case $kind in reads|writes)
        allowed=$(printf '%s\n' "$allowed" | while IFS= read -r r; do [ -n "$r" ] && full "$r"; done) ;;
    esac
    while IFS= read -r n; do
        [ -n "$n" ] || continue
        case $kind in reads|writes) n=$(full "$n") ;; esac
        ok=0
        while IFS= read -r r; do
            [ -n "$r" ] || continue
            case $kind in
                reads|writes) case $r in */) case $n in "$r"*) ok=1 ;; esac ;; *) [ "$n" = "$r" ] && ok=1 ;; esac ;;
                *) if [ "$r" = "*" ] || [ "$n" = "$r" ]; then ok=1; fi ;;
            esac
        done <<EOF
$allowed
EOF
        [ $ok = 1 ] || return 1
    done <<EOF
$wanted
EOF
    return 0
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
    help|-h|--help) usage ;;
    prompt)
        # The one page, then each part (regex json bytes net screen, or all) or
        # module page (tui opts astro) that is named.
        [ "$1" = all ] && set -- regex json bytes net screen
        cat "$home/PROMPT.md"
        for p in "$@"; do
            echo
            if [ -f "$home/prompt/$p.md" ]; then cat "$home/prompt/$p.md"; else mod_page "$p"; fi
        done
        exit ;;
    undo) SIMPLER_UNDO=1; export SIMPLER_UNDO; cmd=run ;;
    replay)
        SIMPLER_REPLAY=1
        [ "$1" = --show ] && { SIMPLER_REPLAY=show; shift; }
        export SIMPLER_REPLAY; cmd=run ;;
    room)
        # Claude Code in a kernel lock that writes only the folder and its own
        # folder for login and temp files. A copy of the folder is kept first; --undo
        # puts it back, after keeping a copy of how it is now.
        undo=; [ "$1" = --undo ] && { undo=1; shift; }
        [ -d "${1:-}" ] || { echo "simpler: no folder named ${1:-}" >&2; exit 2; }
        dir=$(cd "$1" && pwd -P); shift
        case $dir in /|"$(cd "$HOME" && pwd -P)") echo "simpler: a room needs a folder of its own, not $dir" >&2; exit 2 ;; esac
        copies=$HOME/.local/state/simpler/room-copies
        copy=$copies/$(printf '%s' "$dir" | cksum | cut -d' ' -f1)
        if [ -n "$undo" ]; then
            [ -f "$copy.tar" ] || { echo "simpler: no copy of $dir to put back" >&2; exit 1; }
            tar -C "$dir" -cf "$copy.after.tar" .
            find "$dir" -mindepth 1 -delete
            tar -C "$dir" -xf "$copy.tar"
            echo "put back $dir as it was before the room (how it was after: $copy.after.tar)"
            exit
        fi
        [ -x "$HOME/.local/bin/claude" ] || { echo "simpler: a room needs Claude Code in ~/.local/bin/claude, where its installer puts it" >&2; exit 1; }
        mkdir -p "$copies" "$HOME/.local/state/simpler/room/tmp"
        tar -C "$dir" -cf "$copy.tar" .
        prog=${XDG_CACHE_HOME:-$HOME/.cache}/simpler/room
        if [ ! -x "$prog" ] || [ "$home/room.smplr" -nt "$prog" ]; then
            mkdir -p "$(dirname "$prog")"
            "$self" build "$home/room.smplr" -o "$prog" > /dev/null
        fi
        cd "$dir"
        exec "$prog" "$@" ;;
    run|build|what|pieces|test|c|trusted) ;;
    *) echo "simpler: no command named $cmd" >&2; usage 2 >&2 ;;
esac
if [ "$cmd" = run ] && [ "$1" = --dry ]; then SIMPLER_DRY=1; export SIMPLER_DRY; shift; fi
[ $# -gt 0 ] || usage 2 >&2
file=$1
shift
cc_simpler=$(compiler)

# A program from a link: fetched each time, and run only after its owner has
# seen what it can touch and said yes. The yes is kept for that exact text, so
# a changed program asks again. The answer is read from the terminal, so a
# program or an AI cannot give it.
case $file in
    https://*)
        [ "$cmd" = run ] || { echo "simpler: a link can only be run" >&2; exit 2; }
        link=$file
        links=${XDG_CACHE_HOME:-$HOME/.cache}/simpler/links
        mkdir -p "$links"
        file=$links/$(printf '%s' "$link" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c1-16).smplr
        curl -fsSL --max-time 30 -o "$file.new" -- "$link" || { echo "simpler: could not fetch $link" >&2; exit 1; }
        mv "$file.new" "$file"
        seen=${XDG_STATE_HOME:-$HOME/.local/state}/simpler/ok/$({ sha256sum 2>/dev/null || shasum -a 256; } < "$file" | cut -c1-32)
        if [ ! -e "$seen" ]; then
            echo "$link"
            "$self" what "$file" || exit 1
            grep -q landlock /sys/kernel/security/lsm 2>/dev/null || echo "Mind: this kernel cannot hold the programs it starts to that list."
            printf 'Run it? [y/N] '
            ans=n
            { read -r ans < /dev/tty; } 2>/dev/null || ans=n
            case $ans in y|Y|yes) mkdir -p "$(dirname "$seen")"; : > "$seen" ;; *) echo "simpler: not run" >&2; exit 1 ;; esac
        fi ;;
    http://*) echo "simpler: only an https link is run" >&2; exit 2 ;;
esac
shown=$(show_name "$file")
# Runs the examples of a built program; a failing one is named by the source file.
examples_ok() {
    SIMPLER_EXAMPLES=1 "$1" 2>"$1.err"; ex=$?
    sed "s|^input\.smplr:|$shown:|" "$1.err" >&2
    return $ex
}

case $cmd in
    trusted)
        # Only where the kernel lock works, and only with a rules file: the same
        # five top lines, written by the owner of the machine.
        rules=${SIMPLER_TRUST:-$HOME/.config/simpler/trust}
        [ -f "$rules" ] || exit 1
        grep -q landlock /sys/kernel/security/lsm 2>/dev/null || exit 1
        prep "$file"
        listing=$(cd "$work" && "$cc_simpler" what 2>/dev/null) || { rm -rf "$work"; exit 1; }
        rm -rf "$work"
        inside read reads "$@" && inside write writes "$@" && inside run runs \
            && inside fetch fetches && inside mail mails || exit 1
        exit 0 ;;
    what|pieces)
        prep "$file"
        (cd "$work" && "$cc_simpler" $cmd) 2>&1 | sed "s|^input\.smplr:|$shown:|"
        rm -rf "$work" ;;
    c)
        out=$(mktemp); prep "$file"; to_c "" "$out"; cat "$out"; rm -f "$out" ;;
    test)
        dir=$(mktemp -d); prep "$file"; to_c test "$dir/t.c"
        ${CC:-cc} -w "$dir/t.c" -o "$dir/t" -lm
        code=0; "$dir/t" || code=$?
        rm -rf "$dir"; exit $code ;;
    build)
        name=$(basename "$file" .smplr)
        [ "$1" = "-o" ] && name=$2
        # Never write over a file that is not a built program: a script
        # with the same name as the source would be gone.
        if [ -e "$name" ]; then
            case $(head -c 4 "$name" | od -An -tx1 | tr -d ' \n') in
                7f454c46|cffaedfe|cafebabe) ;;
                *) echo "simpler build: $name exists and is not a built program; pick another name with -o" >&2; exit 1 ;;
            esac
        fi
        dir=$(mktemp -d); prep "$file"; to_c "" "$dir/p.c"
        ${CC:-cc} -O2 -w "$dir/p.c" -o "$dir/p" -lm
        # The example lines at the top: no program unless each gives its output.
        if ! examples_ok "$dir/p"; then rm -rf "$dir"; echo "simpler: not built" >&2; exit 1; fi
        mv "$dir/p" "$name"
        rm -rf "$dir" ;;
    run)
        # The built program is kept under a name made from the source and the
        # compiler, so a second run of the same program starts at once.
        prep "$file"
        sum=$({ cat "$work"/*.smplr "$cc_simpler" 2>/dev/null; echo "$SIMPLER_PIECES"; } | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c1-32)
        cache=${XDG_CACHE_HOME:-$HOME/.cache}/simpler
        if [ ! -x "$cache/$sum" ]; then
            mkdir -p "$cache"
            dir=$(mktemp -d); to_c "" "$dir/p.c"
            ${CC:-cc} -O1 -w "$dir/p.c" -o "$dir/p" -lm
            if ! examples_ok "$dir/p"; then rm -rf "$dir"; echo "simpler: not run" >&2; exit 1; fi
            mv "$dir/p" "$cache/$sum"; rm -rf "$dir"
        else
            rm -rf "$work"
        fi
        # The program asks for its own path; that is the source file, not the cache.
        SIMPLER_SELF=$(cd "$(dirname "$file")" && pwd)/$(basename "$file"); export SIMPLER_SELF
        exec "$cache/$sum" "$@" ;;
esac
