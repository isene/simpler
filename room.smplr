// simpler room: Claude Code inside one kernel lock. It writes only the folder
// it starts in and its own folder for login and temp files. It runs system
// programs, and nothing from the home folder but Claude Code itself. It reaches
// only Anthropic's two hosts, so Claude Code runs without permission prompts.
reads "./", "~/.local/state/simpler/room/", "~/.gitconfig", "~/.config/git/"
writes "./", "~/.local/state/simpler/room/"
runs "~/.local/bin/claude"
fetches "api.anthropic.com", "platform.claude.com"
main(sys) {
  room = sys.env.var("HOME") + "/.local/state/simpler/room"
  sys.env.setVar("CLAUDE_CONFIG_DIR", room)
  sys.env.setVar("TMPDIR", room + "/tmp")
  sys.env.setVar("CLAUDE_CODE_TMPDIR", room + "/tmp")
  sys.env.setVar("TMPPREFIX", room + "/tmp/zsh")
  sys.env.setVar("DISABLE_AUTOUPDATER", "1")
  args = ["--dangerously-skip-permissions"]
  for a in sys.args {
    args.push(a)
  }
  exit(sys.programs.status("~/.local/bin/claude", args))
}
