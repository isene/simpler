  sys.screen.print("      else if (f == '<' && (R->pp[2] == '=' || R->pp[2] == '!')) { n->t = RLOOK; n->c = 2; n->neg = R->pp[2] == '!'; R->pp += 3; }")
  sys.screen.print("      else if (f == '<' || (f == 'P' && R->pp[2] == '<')) { while (*R->pp && *R->pp != '>') R->pp++; if (!*R->pp) re_die(R, \"has a group name with no >\"); R->pp++; cap = 1; }")
  sys.screen.print("      else { const char* q = R->pp + 1; while (*q == 'i' || *q == 'm' || *q == 's') q++; if (*q != ')' || q == R->pp + 1) re_die(R, \"has a (? form that is not known\"); for (q = R->pp + 1; *q != ')'; q++) { if (*q == 'i') R->fi = 1; if (*q == 'm') R->fm = 1; if (*q == 's') R->fs = 1; } R->pp = q + 1; return n; } }")
  sys.screen.print("    if (cap) { if (R->ng + 1 >= RE_MAXG) re_die(R, \"has more than 31 groups\"); n->g = ++R->ng; }")
  sys.screen.print("    n->sub = re_alt(R, depth + 1); if (*R->pp != ')') re_die(R, \"has a ( with no )\"); R->pp++; return n; }")
  sys.screen.print("  if (c0 == '[') { R->pp++; return re_set(R); }")
  sys.screen.print("  if (c0 == '.') { R->pp++; return re_new(RANY); }")
  sys.screen.print("  if (c0 == '^') { R->pp++; return re_new(RBOL); }")
  sys.screen.print("  if (c0 == '$') { R->pp++; return re_new(REOL); }")
  sys.screen.print("  if (c0 == '*' || c0 == '+' || c0 == '?') re_die(R, \"has a * + or ? with nothing before it\");")
  sys.screen.print("  if (c0 == '\\\\') { int cls; char e = R->pp[1]; R->pp++;")
  sys.screen.print("    if (e == 'b') { R->pp++; return re_new(RWB); } if (e == 'B') { R->pp++; return re_new(RNWB); }")
  sys.screen.print("    if (e == 'A') { R->pp++; return re_new(RSTART); } if (e == 'Z' || e == 'z') { R->pp++; return re_new(REND); }")
  sys.screen.print("    if (e >= '1' && e <= '9') { R->pp++; n = re_new(RBREF); n->g = e - '0'; return n; }")
  sys.screen.print("    c = re_escc(R, &cls); if (cls) { n = re_new(RSET); re_setadd(n, -1, cls); return n; } n = re_new(RC); n->c = c; return n; }")
  sys.screen.print("  R->pp = re_dec(R->pp, &c); n = re_new(RC); n->c = c; return n; }")
  sys.screen.print("static RNode* re_seq(RE* R, int depth) { RNode* head = 0; RNode** tail = &head; while (*R->pp && *R->pp != '|' && *R->pp != ')') { RNode* a = re_atom(R, depth); while (1) { long lo, hi; const char* q = R->pp; char c = *q; if (c == '*') { lo = 0; hi = RE_INF; q++; } else if (c == '+') { lo = 1; hi = RE_INF; q++; } else if (c == '?') { lo = 0; hi = 1; q++; } else if (c == '{' && ((q[1] >= '0' && q[1] <= '9') || (q[1] == ',' && q[2] >= '0' && q[2] <= '9'))) { char* t = (char*)q + 1; lo = 0; if (*t != ',') lo = strtol(q + 1, &t, 10); hi = lo; if (*t == ',') { t++; if (*t == '}') hi = RE_INF; else if (*t >= '0' && *t <= '9') hi = strtol(t, &t, 10); else break; } if (*t != '}') break; q = t + 1; if (hi < lo) re_die(R, \"has a count that runs backwards\"); if (lo > 1000 || (hi != RE_INF && hi > 1000)) re_die(R, \"has a count above 1000\"); } else break; RNode* r = re_new(RREP); r->lo = (int)lo; r->hi = (int)hi; r->sub = a; if (*q == '?') { r->lazy = 1; q++; } else if (*q == '+') q++; R->pp = q; a = r; } *tail = a; tail = &a->next; } return head; }")
  sys.screen.print("static RNode* re_alt(RE* R, int depth) { if (depth > 200) re_die(R, \"has groups more than 200 deep\"); RNode* first = re_seq(R, depth); if (*R->pp != '|') return first; RNode* head = re_new(RALT); RNode* cur = head; head->sub = first; while (*R->pp == '|') { RNode* a = re_new(RALT); R->pp++; a->sub = re_seq(R, depth); cur->alt = a; cur = a; } return head; }")
  sys.screen.print("static void re_enc(RE* R, long c) { if (c < 0x80) R->first[c] = 1; else if (c < 0x800) R->first[0xC0 | (c >> 6)] = 1; else if (c < 0x10000) R->first[0xE0 | (c >> 12)] = 1; else if (c < 0x110000) R->first[0xF0 | (c >> 18)] = 1; else R->first[(c - 0x110000) & 255] = 1; }")
  sys.screen.print("static int re_first(RE* R, RNode* n) { for (; n; n = n->next) { int nul = 1; switch (n->t) { case RC: re_enc(R, n->c); if (R->fi) { re_enc(R, re_low(n->c)); re_enc(R, re_up(n->c)); } nul = 0; break; case RANY: memset(R->first, 1, 256); nul = 0; break; case RSET: for (long b = 0; b < 128; b++) if (re_inset(R, n, b) != n->neg) R->first[b] = 1; memset(R->first + 128, 1, 128); nul = 0; break; case RGRP: nul = re_first(R, n->sub); break; case RALT: nul = 0; for (RNode* a = n; a; a = a->alt) if (re_first(R, a->sub)) nul = 1; break; case RREP: nul = re_first(R, n->sub); if (n->lo == 0) nul = 1; break; case RBREF: memset(R->first, 1, 256); break; default: break; } if (!nul) return 0; } return 1; }")
  sys.screen.print("static RE* re_comp(long pat, long line) { static RE* cache[512]; const char* src = (const char*)(intptr_t)pat; unsigned long h = 5381; for (const unsigned char* q = (const unsigned char*)src; *q; q++) h = h * 33 + *q; RE* R = cache[h & 511]; if (R && strcmp(R->key, src) == 0) { R->line = line; return R; } R = (RE*)calloc(1, sizeof(RE)); R->key = strdup(src); R->pp = R->key; R->line = line; R->root = re_alt(R, 0); if (*R->pp == ')') re_die(R, \"has a ) with no (\"); R->open = re_first(R, R->root); R->head = R->root && !R->fm && (R->root->t == RSTART || R->root->t == RBOL); if (R->root && R->root->t == RSTART) R->head = 1; cache[h & 511] = R; return R; }")
  sys.screen.print("static int re_m(RE* R, RNode* n, const char* p, RK* k);")
  sys.screen.print("static const char* re_one(RE* R, RNode* n, const char* p) { long c; const char* q; if (p >= R->e) return 0; q = re_dec(p, &c); if (n->t == RC) return (c == n->c || (R->fi && re_low(c) == re_low(n->c))) ? q : 0; if (n->t == RANY) return (c != 10 || R->fs) ? q : 0; return re_inset(R, n, c) != n->neg ? q : 0; }")
  sys.screen.print("static int re_rep(RE* R, RNode* n, const char* p, RK* k, long count, const char* last) {")
  sys.screen.print("  RNode* s = n->sub;")
  sys.screen.print("  if (s && !s->next && (s->t == RC || s->t == RANY || s->t == RSET)) { const char* q = p; const char* r; long c = 0;")
  sys.screen.print("    if (!n->lazy) { while (c < n->hi && (r = re_one(R, s, q))) { q = r; c++; } if (c < n->lo) return 0; while (1) { if (re_m(R, n->next, q, k)) return 1; if (c == n->lo || q == p) return 0; q--; while (q > p && ((unsigned char)*q & 0xC0) == 0x80) q--; c--; } }")
  sys.screen.print("    while (c < n->lo) { r = re_one(R, s, q); if (!r) return 0; q = r; c++; }")
  sys.screen.print("    while (1) { if (re_m(R, n->next, q, k)) return 1; if (c >= n->hi) return 0; r = re_one(R, s, q); if (!r) return 0; q = r; c++; } }")
  sys.screen.print("  if (count > 0 && p == last && count >= n->lo) return re_m(R, n->next, p, k);")
  sys.screen.print("  RK kk = { 1, n, k, count + 1, p };")
  sys.screen.print("  if (!n->lazy) { if (count < n->hi && re_m(R, s, p, &kk)) return 1; return count >= n->lo ? re_m(R, n->next, p, k) : 0; }")
  sys.screen.print("  if (count >= n->lo && re_m(R, n->next, p, k)) return 1;")
  sys.screen.print("  return count < n->hi ? re_m(R, s, p, &kk) : 0; }")
  sys.screen.print("static int re_k(RE* R, const char* p, RK* k) {")
  sys.screen.print("  if (!k) { R->end = p; return 1; }")
  sys.screen.print("  if (k->kind == 0) { RNode* n = k->n; if (n->g > 0) { const char* os = R->cs[n->g]; const char* oe = R->ce[n->g]; R->cs[n->g] = k->last; R->ce[n->g] = p; if (re_m(R, n->next, p, k->up)) return 1; R->cs[n->g] = os; R->ce[n->g] = oe; return 0; } return re_m(R, n->next, p, k->up); }")
  sys.screen.print("  if (k->kind == 1) return re_rep(R, k->n, p, k->up, k->count, k->last);")
  sys.screen.print("  if (k->kind == 2) return 1;")
  sys.screen.print("  return p == k->last; }")
  sys.screen.print("static int re_look(RE* R, RNode* n, const char* p, RK* k) { const char* scs[RE_MAXG]; const char* sce[RE_MAXG]; int ok = 0; memcpy(scs, R->cs, sizeof(scs)); memcpy(sce, R->ce, sizeof(sce)); if (n->c == 1) { RK kk = { 2, 0, 0, 0, 0 }; ok = re_m(R, n->sub, p, &kk); } else { RK kk = { 3, 0, 0, 0, p }; const char* q = p; while (1) { if (re_m(R, n->sub, q, &kk)) { ok = 1; break; } if (q == R->b) break; q--; while (q > R->b && ((unsigned char)*q & 0xC0) == 0x80) q--; } } if (ok != n->neg && re_m(R, n->next, p, k)) return 1; memcpy(R->cs, scs, sizeof(scs)); memcpy(R->ce, sce, sizeof(sce)); return 0; }")
  sys.screen.print("static long re_budget = 0;")
  sys.screen.print("static int re_m(RE* R, RNode* n, const char* p, RK* k) {")
  sys.screen.print("  char here;")
  sys.screen.print("  if (++R->steps > R->limit) re_die(R, \"takes too many steps on this text\");")
  sys.screen.print("  if (R->base - &here > re_budget) re_die(R, \"goes too deep on this text\");")
  sys.screen.print("  while (n && n->t <= RSET) { p = re_one(R, n, p); if (!p) return 0; n = n->next; }")
  sys.screen.print("  if (!n) return re_k(R, p, k);")
  sys.screen.print("  switch (n->t) {")
  sys.screen.print("    case RBOL: return (p == R->b || (R->fm && p[-1] == 10)) ? re_m(R, n->next, p, k) : 0;")
  sys.screen.print("    case REOL: return (p == R->e || (R->fm && *p == 10) || (p + 1 == R->e && *p == 10)) ? re_m(R, n->next, p, k) : 0;")
  sys.screen.print("    case RSTART: return p == R->b ? re_m(R, n->next, p, k) : 0;")
  sys.screen.print("    case REND: return p == R->e ? re_m(R, n->next, p, k) : 0;")
  sys.screen.print("    case RWB: case RNWB: { long ca = 0, cb = 0; if (p > R->b) { const char* q = p - 1; while (q > R->b && ((unsigned char)*q & 192) == 128) q--; re_dec(q, &ca); } if (p < R->e) re_dec(p, &cb); int a = p > R->b && re_word(ca); int b = p < R->e && re_word(cb); return ((a != b) == (n->t == RWB)) ? re_m(R, n->next, p, k) : 0; }")
  sys.screen.print("    case RGRP: { RK kk = { 0, n, k, 0, p }; return re_m(R, n->sub, p, &kk); }")
  sys.screen.print("    case RALT: { for (RNode* a = n; a; a = a->alt) if (re_m(R, a->sub, p, k)) return 1; return 0; }")
  sys.screen.print("    case RREP: return re_rep(R, n, p, k, 0, 0);")
  sys.screen.print("    case RBREF: { const char* s = n->g <= R->ng ? R->cs[n->g] : 0; const char* e = n->g <= R->ng ? R->ce[n->g] : 0; long len; if (!s || !e) return 0; len = e - s; if (R->e - p < len) return 0; for (long i = 0; i < len; i++) if (s[i] != p[i] && !(R->fi && (unsigned char)s[i] < 128 && re_low((unsigned char)s[i]) == re_low((unsigned char)p[i]))) return 0; return re_m(R, n->next, p + len, k); }")
  sys.screen.print("    case RLOOK: return re_look(R, n, p, k);")
  sys.screen.print("  }")
  sys.screen.print("  return 0; }")
  sys.screen.print("static const char* re_step(RE* R, const char* p) { if (p >= R->e) return R->e + 1; p++; while (p < R->e && ((unsigned char)*p & 0xC0) == 0x80) p++; return p; }")
  sys.screen.print("static const char* re_search(RE* R, const char* from) { char mark; const char* p = from; RNode* f = R->root; int lit = f && f->t == RC && !R->fi && f->c < 128 && f->c > 0; R->steps = 0; R->base = &mark; while (1) { if (lit) { p = (const char*)memchr(p, (int)f->c, (size_t)(R->e - p)); if (!p) return 0; } else if (!R->open) { while (p < R->e && !R->first[(unsigned char)*p]) p++; if (p >= R->e) return 0; } for (int i = 0; i <= R->ng; i++) { R->cs[i] = 0; R->ce[i] = 0; } if (re_m(R, R->root, p, 0)) { R->cs[0] = p; R->ce[0] = R->end; return p; } if (p >= R->e || R->head) return 0; p = re_step(R, p); } }")
  sys.screen.print("static void re_stack(void) { struct rlimit rl; long cur = 8388608; long want = 67108864; if (getrlimit(RLIMIT_STACK, &rl) == 0) {")
  sys.screen.print("#ifdef __linux__")
  sys.screen.print("if (rl.rlim_cur != RLIM_INFINITY && (long)rl.rlim_cur < want && (rl.rlim_max == RLIM_INFINITY || (long)rl.rlim_max >= want)) { rl.rlim_cur = (rlim_t)want; setrlimit(RLIMIT_STACK, &rl); getrlimit(RLIMIT_STACK, &rl); }")
  sys.screen.print("#endif")
  sys.screen.print("cur = (rl.rlim_cur == RLIM_INFINITY || (long)rl.rlim_cur > want) ? want : (long)rl.rlim_cur; } re_budget = cur / 2; }")
  sys.screen.print("static RE* re_open(long s, long pat, long line) { RE* R = re_comp(pat, line); if (!re_budget) re_stack(); R->b = (const char*)(intptr_t)s; R->e = R->b + strlen(R->b); R->limit = 1000000 + 100 * (long)(R->e - R->b); return R; }")
  sys.screen.print("static long re_str(const char* a, const char* b) { long n = (a && b && b > a) ? (long)(b - a) : 0; char* r = (char*)malloc(n + 1); if (n) memcpy(r, a, n); r[n] = 0; return (long)(intptr_t)r; }")
  sys.screen.print("static long re_groups(RE* R) { long l = l_new(); for (int i = 0; i <= R->ng; i++) l_push(l, re_str(R->cs[i], R->ce[i])); return l; }")
  sys.screen.print("static const char* re_after(RE* R) { return R->ce[0] > R->cs[0] ? R->ce[0] : re_step(R, R->ce[0]); }")
  sys.screen.print("long re_test(long s, long pat, long line) { RE* R = re_open(s, pat, line); return re_search(R, R->b) != 0; }")
  sys.screen.print("long re_find(long s, long pat, long line) { RE* R = re_open(s, pat, line); if (!re_search(R, R->b)) return l_new(); return re_groups(R); }")
  sys.screen.print("long re_all(long s, long pat, long line) { RE* R = re_open(s, pat, line); long out = l_new(); const char* p = R->b; while (p <= R->e && re_search(R, p)) { l_push(out, re_groups(R)); p = re_after(R); } return out; }")
  sys.screen.print("long re_split(long s, long pat, long line) { RE* R = re_open(s, pat, line); long out = l_new(); const char* p = R->b; const char* last = p; while (p <= R->e && re_search(R, p)) { if (R->ce[0] == R->cs[0]) { p = re_after(R); continue; } l_push(out, re_str(last, R->cs[0])); last = R->ce[0]; p = last; } l_push(out, re_str(last, R->e)); return out; }")
  sys.screen.print("static void re_put(char** b, size_t* n, size_t* cap, const char* a, size_t len) { if (*n + len + 1 > *cap) { *cap = (*n + len + 1) * 2; *b = (char*)realloc(*b, *cap); } if (len) memcpy(*b + *n, a, len); *n += len; (*b)[*n] = 0; }")
  sys.screen.print("long re_replace(long s, long pat, long to, long line) { RE* R = re_open(s, pat, line); const char* t = (const char*)(intptr_t)to; size_t n = 0, cap = 64; char* out = (char*)malloc(cap); const char* p = R->b; const char* last = p; out[0] = 0; while (p <= R->e && re_search(R, p)) { re_put(&out, &n, &cap, last, (size_t)(R->cs[0] - last)); for (const char* q = t; *q; q++) { if (*q == '$' && q[1] == '$') { re_put(&out, &n, &cap, q, 1); q++; } else if (*q == '$' && q[1] >= '0' && q[1] <= '9') { int g = q[1] - '0'; q++; if (q[1] >= '0' && q[1] <= '9' && g * 10 + (q[1] - '0') <= R->ng) { g = g * 10 + (q[1] - '0'); q++; } if (g <= R->ng && R->cs[g] && R->ce[g] > R->cs[g]) re_put(&out, &n, &cap, R->cs[g], (size_t)(R->ce[g] - R->cs[g])); } else re_put(&out, &n, &cap, q, 1); } last = R->ce[0]; p = re_after(R); } if (last < R->e) re_put(&out, &n, &cap, last, (size_t)(R->e - last)); return (long)(intptr_t)out; }")
  sys.screen.print("long s_case(long s, long up) { const unsigned char* p = (const unsigned char*)(intptr_t)s; long n = strlen((const char*)p); unsigned char* r = (unsigned char*)malloc(n + 1); for (long i = 0; i <= n; i++) { unsigned char c = p[i]; if (up && c >= 97 && c <= 122) c = c - 32; if (!up && c >= 65 && c <= 90) c = c + 32; if (i > 0 && p[i - 1] == 195) { if (up && c >= 160 && c <= 190 && c != 183) c = c - 32; if (!up && c >= 128 && c <= 158 && c != 151) c = c + 32; } r[i] = c; } return (long)(intptr_t)r; }")
  sys.screen.print("long l_join(long lp, long sep) { SList* s = (SList*)(intptr_t)lp; const char* q = (const char*)(intptr_t)sep; long m = strlen(q); long n = 1; for (long i = 0; i < s->len; i++) n += strlen((const char*)(intptr_t)s->data[i]) + m; char* r = (char*)malloc(n); r[0] = 0; for (long i = 0; i < s->len; i++) { if (i > 0) strcat(r, q); strcat(r, (const char*)(intptr_t)s->data[i]); } return (long)(intptr_t)r; }")
  sys.screen.print("long s_padleft(long s, long n) { const char* p = (const char*)(intptr_t)s; SL* e = s_info(p); long nb = e->nb; long pad = n - e->nl; if (pad <= 0) return s; char* r = (char*)malloc(nb + pad + 1); memset(r, 32, pad); memcpy(r + pad, p, nb + 1); return (long)(intptr_t)r; }")
  sys.screen.print("long s_padright(long s, long n) { const char* p = (const char*)(intptr_t)s; SL* e = s_info(p); long nb = e->nb; long pad = n - e->nl; if (pad <= 0) return s; char* r = (char*)malloc(nb + pad + 1); memcpy(r, p, nb); memset(r + nb, 32, pad); r[nb + pad] = 0; return (long)(intptr_t)r; }")
  sys.screen.print("long s_replace(long s, long from, long to) { const char* p = (const char*)(intptr_t)s; const char* f = (const char*)(intptr_t)from; const char* t = (const char*)(intptr_t)to; long fl = strlen(f); if (fl == 0) return s; long tl = strlen(t); long pl = strlen(p); long count = 0; const char* q = p; while ((q = strstr(q, f)) != 0) { count++; q += fl; } char* r = (char*)malloc(pl + count * (tl - fl) + 1); char* w = r; const char* a = p; while (1) { const char* hit = strstr(a, f); if (hit == 0) { strcpy(w, a); break; } long pre = hit - a; memcpy(w, a, pre); w += pre; memcpy(w, t, tl); w += tl; a = hit + fl; } return (long)(intptr_t)r; }")
  sys.screen.print("typedef struct { long* keys; long* vals; unsigned long* hs; int* tab; long len; long cap; long tcap; } SMap;")
  sys.screen.print("static unsigned long m_hash(const char* s) { unsigned long h = 1469598103934665603UL; while (*s) { h ^= (unsigned char)*s++; h *= 1099511628211UL; } return h; }")
  sys.screen.print("static long m_findh(SMap* m, const char* key, unsigned long h) { long mask = m->tcap - 1; long j = (long)(h & (unsigned long)mask); while (m->tab[j]) { long i = m->tab[j] - 1; if (m->hs[i] == h && strcmp((const char*)(intptr_t)m->keys[i], key) == 0) return i; j = (j + 1) & mask; } return -1; }")
