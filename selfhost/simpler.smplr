// The Simpler compiler, written in Simpler.
//
// This is the real self-hosted compiler, grown one stage at a time. It
// lexes source into tokens, parses them into an AST, and emits C, the
// same pipeline as the Rust bootstrap. The working subset now covers
// variant types (recursive, multi-payload) with `match`, record types
// with field access, functions with typed parameters and return types,
// integer and string locals, the `Str` methods, `if`/`else`, `while`,
// the arithmetic and comparison operators, and `print`.
//
// Everything is one machine word (a long): integers directly, strings and
// boxed values as pointers cast to long. Variants are a { tag, slots }
// object; records are real C structs. Method dispatch and field access
// need the receiver's type, so the emitter carries a context: a per-
// function environment mapping locals to types, plus the program's record
// names and function return types. That is the front half of the checker.
//
// It emits a complete C program on stdout; pipe that to a C compiler:
//
//     bootstrap/target/release/simpler run selfhost/simpler.smplr | cc -x c - -o /tmp/p && /tmp/p
//
// The subset grows toward the full language until the compiler can read
// its own source.

// --- the AST ------------------------------------------------------------

Expr = type {
  Num(Int)
  FloatLit(Str)
  Var(Str)
  StrLit(Str)
  ListLit(List[Expr])
  Bin(Str, Expr, Expr)
  Call(Str, List[Expr])
  Match(Expr, List[Arm])
  Field(Expr, Str)
  Method(Expr, Str, List[Expr])
  Each(Expr, Str, List[Stmt])
}

Arm = type {
  tag : Str
  binds : List[Str]
  body : Expr
}

Stmt = type {
  Let(Str, Str, Expr)
  Bare(Expr)
  If(Expr, List[Stmt], List[Stmt])
  While(Expr, List[Stmt])
  Ret(Expr)
  Line(Int)
  Jump(Str)
}

Fn = type {
  name : Str
  params : List[Str]
  ptypes : List[Str]
  ret : Str
  effs : List[Str]
  body : List[Stmt]
  line : Int
}

// The lexer's output: the tokens and a parallel line number for each.
Lexed = type {
  toks : List[Tok]
  lines : List[Int]
  files : List[Str]
}

// A module: a file brought in by a uses line. Its names get its name in front.
Mod = type {
  name : Str
  lx : Lexed
  names : List[Str]
}

Case = type {
  cname : Str
  arity : Int
  ptypes : List[Str]
}

TyDef = type {
  name : Str
  cases : List[Case]
  line : Int
}

RecDef = type {
  name : Str
  fields : List[Str]
  ftypes : List[Str]
  line : Int
}

PieceEx = type {
  node : Expr
  line : Int
}

Prog = type {
  pieces : List[PieceEx]
  types : List[TyDef]
  records : List[RecDef]
  fns : List[Fn]
  reads : List[Str]
  writes : List[Str]
  runs : List[Str]
  fetches : List[Str]
  mails : List[Str]
  examples : List[Str]
  limits : List[Str]
  files : List[Str]
}

// Local type environment: parallel names and their types.
TyEnv = type {
  names : List[Str]
  tys : List[Str]
}

// Program-wide signatures: record names, and each function's return type.
Sigs = type {
  recNames : List[Str]
  records : List[RecDef]
  types : List[TyDef]
  fns : List[Fn]
  fnNames : List[Str]
  fnRets : List[Str]
  boxedNullary : List[Str]
  retP : List[Str]
  mutP : List[Str]
  reads : List[Str]
  writes : List[Str]
  runs : List[Str]
  fetches : List[Str]
  mails : List[Str]
  files : List[Str]
}

// Emit context: the locals in scope plus the program signatures.
Ctx = type {
  env : TyEnv
  sigs : Sigs
}

Tok = type {
  Ident(Str)
  Str(Str)
  Int(Int)
  Float(Str)
  Punct(Str)
  Eof
}

Parsed = type {
  node : Expr
  next : Int
}

PStmt = type {
  node : Stmt
  next : Int
}

PArm = type {
  arm : Arm
  next : Int
}

PFn = type {
  fn : Fn
  next : Int
}

PTy = type {
  ty : TyDef
  next : Int
}

PRec = type {
  rec : RecDef
  next : Int
}

PNames = type {
  names : List[Str]
  types : List[Str]
  next : Int
}

PRet = type {
  ret : Str
  effs : List[Str]
  next : Int
}

PBody = type {
  body : List[Stmt]
  next : Int
}

PType = type {
  ty : Str
  next : Int
}

// The values of one call, after those that must run in order were moved
// into temporaries: `pre` declares the temporaries, `ops` are what is left.
Hoist = type {
  pre : Str
  ops : List[Expr]
}

PArgs = type {
  list : List[Expr]
  next : Int
}

reads "*.smplr"

main(sys) {
  src = sys.files.read("input.smplr")?
  files : List[Str] = ["input.smplr"]
  queue : List[Str] = []
  queueLines : List[Int] = []
  mainUses : List[Str] = []
  mainLx = qualify(takeUses(lex(src, files), mainUses, queue, queueLines), mainUses)
  mods : List[Mod] = []
  q = 0
  while q < queue.length {
    name = queue.at(q)
    if hasMod(mods, name).not {
      file = name.concat(".smplr")
      if sys.files.exists(file).not {
        fail(spot(files, queueLines.at(q)).concat("no module named ").concat(name).concat(": the file ").concat(file).concat(" was not found"))
      }
      msrc = sys.files.read(file)?
      files.push(file)
      mods.push(makeMod(name, msrc, files, queue, queueLines))
    }
    q = q + 1
  }
  lexed = mainLx
  if mods.length > 0 {
    lexed = joinMods(mods, mainLx)
  }
  prog = parse(lexed)
  sigs = buildSigs(prog)
  if prog.pieces.length > 0 {
    pieceFns(prog, sigs)
    sigs = buildSigs(prog)
  }
  if sys.args.length > 0 && sys.args.at(0) == "pieces" {
    retPass(prog, sigs)
    prog.fns.each { f in
      emitFn(f, sigs)
    }
    sys.screen.print(piecesProg(prog, sigs))
    return
  }
  // `simpler what` lists everything the program can touch, and writes no C.
  if sys.args.length > 0 && sys.args.at(0) == "what" {
    if hasName(sigs.fnNames, "main").not {
      fail("input.smplr:1: no main function found")
    }
    // every check runs first, so the list is given only for a program that compiles
    retPass(prog, sigs)
    prog.fns.each { f in
      emitFn(f, sigs)
    }
    sys.screen.print(whatProg(prog, sigs))
    return
  }
  sys.screen.print("#include <stdio.h>")
  sys.screen.print("#include <stdlib.h>")
  sys.screen.print("#include <stdint.h>")
  sys.screen.print("#include <math.h>")
  sys.screen.print("#include <string.h>")
  sys.screen.print("#include <dirent.h>")
  sys.screen.print("#include <sys/stat.h>")
  sys.screen.print("#include <errno.h>")
  sys.screen.print("#include <unistd.h>")
  sys.screen.print("#include <sys/wait.h>")
  sys.screen.print("#include <time.h>")
  sys.screen.print("#include <limits.h>")
  sys.screen.print("#include <termios.h>")
  sys.screen.print("#include <sys/ioctl.h>")
  sys.screen.print("#include <signal.h>")
  sys.screen.print("#include <poll.h>")
  sys.screen.print("#include <sys/inotify.h>")
  sys.screen.print("#include <sys/resource.h>")
  fl = "static const char* simpler_fl[] = {"
  q = 0
  while q < files.length {
    fl = fl.concat("\"").concat(files.at(q)).concat("\", ")
    q = q + 1
  }
  sys.screen.print(fl.concat("0};"))
  sys.screen.print("static const char* simpler_at(long line) { static char b[300]; snprintf(b, sizeof b, \"%s:%ld\", simpler_fl[line / 1000000], line % 1000000); return b; }")
  sys.screen.print("int simpler_dry = 0; void simpler_keep(const char* path); void simpler_note(const char* p, long n); void simpler_leave(int c);")
  sys.screen.print("#define exit(c) simpler_leave(c)")
  sys.screen.print("static int simpler_would(const char* what, const char* a, const char* to, const char* b) { if (!simpler_dry) return 0; if (b) printf(\"would %s \\\"%s\\\" %s \\\"%s\\\"\\n\", what, a, to, b); else printf(\"would %s \\\"%s\\\"\\n\", what, a); return 1; }")
  sys.screen.print("typedef struct { int tag; long v0; long v1; long v2; long v3; long v4; long v5; long v6; long v7; } Obj;")
  sys.screen.print("long mk(int tag, long v0, long v1, long v2) { Obj* o = malloc(4 * sizeof(long)); o->tag = tag; o->v0 = v0; o->v1 = v1; o->v2 = v2; return (long)(intptr_t)o; }")
  sys.screen.print("long mk8(int tag, long v0, long v1, long v2, long v3, long v4, long v5, long v6, long v7) { Obj* o = malloc(sizeof(Obj)); o->tag = tag; o->v0 = v0; o->v1 = v1; o->v2 = v2; o->v3 = v3; o->v4 = v4; o->v5 = v5; o->v6 = v6; o->v7 = v7; return (long)(intptr_t)o; }")
  sys.screen.print("typedef struct { long* data; long len; long cap; } SList;")
  sys.screen.print("long l_new() { SList* l = (SList*)malloc(sizeof(SList)); l->cap = 8; l->len = 0; l->data = (long*)malloc(sizeof(long) * l->cap); return (long)(intptr_t)l; }")
  sys.screen.print("long l_push(long lp, long x) { SList* l = (SList*)(intptr_t)lp; if (l->len == l->cap) { l->cap = l->cap * 2; l->data = (long*)realloc(l->data, sizeof(long) * l->cap); } l->data[l->len] = x; l->len = l->len + 1; return 0; }")
  sys.screen.print("long l_with(long lp, long x) { l_push(lp, x); return lp; }")
  sys.screen.print("long l_at(long lp, long i) { return ((SList*)(intptr_t)lp)->data[i]; }")
  sys.screen.print("long l_len(long lp) { return ((SList*)(intptr_t)lp)->len; }")
  // A text never changes and is never freed, so its length is remembered by
  // address: a loop that reads one text character by character measures it once.
  // A text is counted in letters, never in bytes: a text of three letters has length 3, and a slice cannot cut a letter in
  // half. A text of plain ASCII has as many letters as bytes and takes the short way. Any other text
  // keeps the place of the letter last asked for, so reading it from start to end stays one pass.
  // Long texts have four places of their own in the cache, so short ones never push them out.
  sys.screen.print("typedef struct { const char* p; long nb, nl, cl, cb; } SL; static SL sl_e[8]; static int sl_k[2]; static SL* sl_last = sl_e; static SL* s_info_slow(const char* p) { for (int k = 0; k < 8; k++) if (sl_e[k].p == p) { sl_last = &sl_e[k]; return sl_last; } long n = strlen(p), m = 0; for (long k = 0; k < n; k++) m += ((unsigned char)p[k] & 192) == 128; int big = n >= 512; SL* e = &sl_e[big * 4 + sl_k[big]]; sl_k[big] = (sl_k[big] + 1) & 3; sl_last = e; e->p = p; e->nb = n; e->nl = n - m; e->cl = 0; e->cb = 0; return e; } static inline SL* s_info(const char* p) { if (sl_last->p == p) return sl_last; return s_info_slow(p); }")
  sys.screen.print("static long s_off_slow(SL* e, long i) { if (i >= e->nl) return e->nb; if (i <= 0) return 0; const unsigned char* p = (const unsigned char*)e->p; long l = e->cl, b = e->cb; if (i < l - i) { l = 0; b = 0; } while (l < i) { b++; while ((p[b] & 192) == 128) b++; l++; } while (l > i) { b--; while (b > 0 && (p[b] & 192) == 128) b--; l--; } e->cl = l; e->cb = b; return b; } static inline long s_off(SL* e, long i) { if (e->nb == e->nl) return i; return s_off_slow(e, i); }")
  sys.screen.print("static char* s_ar; static long s_arn; static char* s_alloc(long n) { if (n > 256) return (char*)malloc(n); if (s_arn < n) { s_ar = (char*)malloc(65536); s_arn = 65536; } char* r = s_ar; s_ar += n; s_arn -= n; return r; } static long s_part(const char* p, long a, long b) { long n = b - a; char* r = s_alloc(n + 1); memcpy(r, p + a, n); r[n] = 0; return (long)(intptr_t)r; }")
  // A one-letter text is made once and shared, so reading a text letter by letter asks for no memory.
  sys.screen.print("static char s_one[512]; static char* s_mb[1024]; static long s_let(const char* p, long a, long b) { long n = b - a; if (n == 1) { if (!s_one[2]) for (int k = 0; k < 256; k++) s_one[2 * k] = (char)k; return (long)(intptr_t)&s_one[2 * (unsigned char)p[a]]; } if (n < 1) return s_part(p, a, a); unsigned h = 0; for (long k = 0; k < n; k++) h = h * 31 + (unsigned char)p[a + k]; char** e = &s_mb[h & 1023]; if (*e && strncmp(*e, p + a, n) == 0 && (*e)[n] == 0) return (long)(intptr_t)*e; *e = (char*)(intptr_t)s_part(p, a, b); return (long)(intptr_t)*e; }")
  sys.screen.print("static inline long s_each(long s, long* b) { const unsigned char* p = (const unsigned char*)(intptr_t)s; long a = *b, e = a + 1; while ((p[e] & 192) == 128) e++; *b = e; return s_let((const char*)p, a, e); } long s_lenp(const char* p) { return s_info(p)->nl; }")
  sys.screen.print("static inline long s_len(long s) { return s_info((const char*)(intptr_t)s)->nl; }")
  // A running program stops with its source line, never goes on with a wrong value.
  sys.screen.print("long l_setc(long lp, long i, long x, long line) { SList* l = (SList*)(intptr_t)lp; if (i < 0 || i >= l->len) { fprintf(stderr, \"%s: list index %ld, but the list has %ld items\\n\", simpler_at(line), i, l->len); exit(1); } l->data[i] = x; return 0; }")
  sys.screen.print("long l_removec(long lp, long i, long line) { SList* l = (SList*)(intptr_t)lp; if (i < 0 || i >= l->len) { fprintf(stderr, \"%s: list index %ld, but the list has %ld items\\n\", simpler_at(line), i, l->len); exit(1); } long x = l->data[i]; for (long k = i; k + 1 < l->len; k++) l->data[k] = l->data[k + 1]; l->len = l->len - 1; return x; }")
  sys.screen.print("long l_atc(long lp, long i, long line) { SList* l = (SList*)(intptr_t)lp; if (i < 0 || i >= l->len) { fprintf(stderr, \"%s: list index %ld, but the list has %ld items\\n\", simpler_at(line), i, l->len); exit(1); } return l->data[i]; }")
  sys.screen.print("static inline long s_atc(long s, long i, long line) { const char* p = (const char*)(intptr_t)s; SL* e = s_info(p); if (i < 0 || i >= e->nl) { fprintf(stderr, \"%s: text index %ld, but the text has %ld characters\\n\", simpler_at(line), i, e->nl); exit(1); } long a = s_off(e, i); long b = a + 1; while (((unsigned char)p[b] & 192) == 128) b++; return s_let(p, a, b); }")
  sys.screen.print("static inline long s_slicec(long s, long a, long b, long line) { const char* p = (const char*)(intptr_t)s; SL* e = s_info(p); if (a < 0 || b > e->nl) { fprintf(stderr, \"%s: slice %ld to %ld, but the text has %ld characters\\n\", simpler_at(line), a, b, e->nl); exit(1); } if (b < a) b = a; long x = s_off(e, a); return s_part(p, x, s_off(e, b)); }")
  sys.screen.print("long s_isint(long s) { const char* p = (const char*)(intptr_t)s; while (*p == 32 || *p == 9 || *p == 13 || *p == 10) p++; if (*p == 45 || *p == 43) p++; if (*p < 48 || *p > 57) return 0; while (*p >= 48 && *p <= 57) p++; while (*p == 32 || *p == 9 || *p == 13 || *p == 10) p++; return *p == 0; }")
  sys.screen.print("long s_tointc(long s, long line) { if (!s_isint(s)) { fprintf(stderr, \"%s: \\\"%s\\\" is not a whole number; test with .isInt first\\n\", simpler_at(line), (const char*)(intptr_t)s); exit(1); } return atol((const char*)(intptr_t)s); }")
  sys.screen.print("long i_div(long a, long b, long line) { if (b == 0) { fprintf(stderr, \"%s: division by zero\\n\", simpler_at(line)); exit(1); } return a / b; }")
  sys.screen.print("long i_mod(long a, long b, long line) { if (b == 0) { fprintf(stderr, \"%s: division by zero\\n\", simpler_at(line)); exit(1); } return a % b; }")
  sys.screen.print("static inline long s_at(long s, long i) { const char* p = (const char*)(intptr_t)s; SL* e = s_info(p); if (i < 0 || i >= e->nl) return (long)(intptr_t)\"\"; long a = s_off(e, i); long b = a + 1; while (((unsigned char)p[b] & 192) == 128) b++; return s_let(p, a, b); }")
  sys.screen.print("long s_code(long s) { const unsigned char* p = (const unsigned char*)(intptr_t)s; long c = p[0]; int n = c >= 240 ? 3 : c >= 224 ? 2 : c >= 192 ? 1 : 0; long v = c & (63 >> n); for (int k = 1; k <= n; k++) { if ((p[k] & 192) != 128) return c; v = (v << 6) | (p[k] & 63); } return n ? v : c; }")
  sys.screen.print("static inline long s_slice(long s, long a, long b) { const char* p = (const char*)(intptr_t)s; SL* e = s_info(p); if (b < a) b = a; long x = s_off(e, a); return s_part(p, x, s_off(e, b)); }")
  sys.screen.print("long s_concat(long a, long b) { const char* x = (const char*)(intptr_t)a; const char* y = (const char*)(intptr_t)b; char* r = (char*)malloc(strlen(x) + strlen(y) + 1); strcpy(r, x); strcat(r, y); return (long)(intptr_t)r; }")
  sys.screen.print("static inline long s_eq(long a, long b) { const char* x = (const char*)(intptr_t)a; const char* y = (const char*)(intptr_t)b; return x == y || (x[0] == y[0] && strcmp(x, y) == 0); }")
  sys.screen.print("long i_tostr(long n) { char* r = (char*)malloc(24); sprintf(r, \"%ld\", n); return (long)(intptr_t)r; }")
  sys.screen.print("double l2d(long x) { union { long l; double d; } u; u.l = x; return u.d; }")
  sys.screen.print("long d2l(double x) { union { long l; double d; } u; u.d = x; return u.l; }")
  sys.screen.print("long f_tostr(long x) { char* r = (char*)malloc(32); snprintf(r, 32, \"%.15g\", l2d(x)); return (long)(intptr_t)r; }")
  sys.screen.print("long s_tofloat(long s) { return d2l(atof((const char*)(intptr_t)s)); }")
  sys.screen.print("long i_tof(long n) { return d2l((double)n); }")
  sys.screen.print("long f_toi(long x) { return (long)l2d(x); }")
  sys.screen.print("long s_toint(long s) { return atol((const char*)(intptr_t)s); }")
  sys.screen.print("long s_split(long s, long d) { const char* p = (const char*)(intptr_t)s; const char* dl = (const char*)(intptr_t)d; long dn = strlen(dl); long l = l_new(); while (1) { const char* q = dn ? strstr(p, dl) : 0; long n = q ? (long)(q - p) : (long)strlen(p); char* r = (char*)malloc(n + 1); memcpy(r, p, n); r[n] = 0; l_push(l, (long)(intptr_t)r); if (!q) break; p = q + dn; } return l; }")
  sys.screen.print("long l_range(long a, long b) { long l = l_new(); for (long k = a; k < b; k++) l_push(l, k); return l; }")
  sys.screen.print("long l_slicec(long lp, long a, long b, long line) { SList* s = (SList*)(intptr_t)lp; if (a < 0 || b > s->len) { fprintf(stderr, \"%s: slice %ld to %ld, but the list has %ld items\\n\", simpler_at(line), a, b, s->len); exit(1); } long l = l_new(); for (long k = a; k < b; k++) l_push(l, s->data[k]); return l; }")
  sys.screen.print("long s_starts(long s, long t) { const char* p = (const char*)(intptr_t)s; const char* q = (const char*)(intptr_t)t; return strncmp(p, q, strlen(q)) == 0; }")
  sys.screen.print("long s_ends(long s, long t) { const char* p = (const char*)(intptr_t)s; const char* q = (const char*)(intptr_t)t; size_t a = strlen(p); size_t b = strlen(q); return b <= a && strcmp(p + a - b, q) == 0; }")
  sys.screen.print("long s_contains(long h, long n) { return strstr((const char*)(intptr_t)h, (const char*)(intptr_t)n) != 0; }")
  sys.screen.print("long s_trim(long s) { const char* p = (const char*)(intptr_t)s; long n = strlen(p); long a = 0; while (a < n && (p[a] == 32 || p[a] == 9 || p[a] == 13 || p[a] == 10)) a = a + 1; long b = n; while (b > a && (p[b - 1] == 32 || p[b - 1] == 9 || p[b - 1] == 13 || p[b - 1] == 10)) b = b - 1; long len = b - a; char* r = (char*)malloc(len + 1); for (long k = 0; k < len; k++) r[k] = p[a + k]; r[len] = 0; return (long)(intptr_t)r; }")
  sys.screen.print("long s_find(long h, long n) { const char* p = (const char*)(intptr_t)h; const char* q = strstr(p, (const char*)(intptr_t)n); if (!q) return -1; long m = 0; for (const char* c = p; c < q; c++) m += c == p || ((unsigned char)*c & 192) != 128; return m; }")
  sys.screen.print("static const char* js_ws(const char* p) { while (*p == 32 || *p == 9 || *p == 10 || *p == 13) p++; return p; }")
  sys.screen.print("static const char* js_str(const char* p) { p++; while (*p && *p != 34) { if (*p == 92 && p[1]) p++; p++; } if (*p) p++; return p; }")
  sys.screen.print("static const char* js_skip(const char* p) { p = js_ws(p); if (*p == 34) return js_str(p); if (*p == 123 || *p == 91) { long d = 0; while (*p) { if (*p == 34) { p = js_str(p); continue; } if (*p == 123 || *p == 91) d++; if (*p == 125 || *p == 93) { d--; if (d == 0) return p + 1; } p++; } return p; } while (*p && *p != 44 && *p != 125 && *p != 93 && *p != 32 && *p != 9 && *p != 10 && *p != 13) p++; return p; }")
  sys.screen.print("static long js_hex(const char* p) { long u = 0; for (int k = 0; k < 4; k++) { char h = p[k]; long v; if (h >= 48 && h <= 57) v = h - 48; else if ((h | 32) >= 97 && (h | 32) <= 102) v = (h | 32) - 87; else return -1; u = u * 16 + v; } return u; }")
  sys.screen.print("static long js_val(const char* p) { p = js_ws(p); const char* e = js_skip(p); char* r = (char*)malloc((e - p) + 1); long o = 0; if (*p != 34) { o = e - p; memcpy(r, p, o); r[o] = 0; return (long)(intptr_t)r; } p++; while (*p && *p != 34) { if (*p != 92 || p[1] == 0) { r[o++] = *p++; continue; } p++; char c = *p++; if (c == 110) r[o++] = 10; else if (c == 116) r[o++] = 9; else if (c == 114) r[o++] = 13; else if (c == 98) r[o++] = 8; else if (c == 102) r[o++] = 12; else if (c == 117) { long u = js_hex(p); if (u < 0) continue; p += 4; if (u >= 0xD800 && u <= 0xDBFF && p[0] == 92 && p[1] == 117) { long lo = js_hex(p + 2); if (lo >= 0xDC00 && lo <= 0xDFFF) { u = 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00); p += 6; } } if (u == 0) continue; if (u < 0x80) r[o++] = (char)u; else if (u < 0x800) { r[o++] = (char)(0xC0 | (u >> 6)); r[o++] = (char)(0x80 | (u & 63)); } else if (u < 0x10000) { r[o++] = (char)(0xE0 | (u >> 12)); r[o++] = (char)(0x80 | ((u >> 6) & 63)); r[o++] = (char)(0x80 | (u & 63)); } else { r[o++] = (char)(0xF0 | (u >> 18)); r[o++] = (char)(0x80 | ((u >> 12) & 63)); r[o++] = (char)(0x80 | ((u >> 6) & 63)); r[o++] = (char)(0x80 | (u & 63)); } } else r[o++] = c; } r[o] = 0; return (long)(intptr_t)r; }")
  sys.screen.print("static const char* js_next(const char* p) { p = js_ws(js_skip(p)); return *p == 44 ? js_ws(p + 1) : 0; }")
  sys.screen.print("long s_json(long t, long k) { const char* p = js_ws((const char*)(intptr_t)t); const char* key = (const char*)(intptr_t)k; if (*p == 123) { p = js_ws(p + 1); while (p && *p == 34) { long kv = js_val(p); p = js_ws(js_str(p)); if (*p == 58) p++; if (strcmp((const char*)(intptr_t)kv, key) == 0) return js_val(p); p = js_next(p); } } else if (*p == 91) { char* end; long want = strtol(key, &end, 10); long i = 0; if (end != key && *end == 0 && want >= 0) { p = js_ws(p + 1); while (p && *p && *p != 93) { if (i == want) return js_val(p); i++; p = js_next(p); } } } return (long)(intptr_t)strdup(\"\"); }")
  sys.screen.print("long s_jsonlist(long t, long keys) { long l = l_new(); const char* p = js_ws((const char*)(intptr_t)t); if (*p == 91 && !keys) { p = js_ws(p + 1); while (p && *p && *p != 93) { l_push(l, js_val(p)); p = js_next(p); } } else if (*p == 123) { p = js_ws(p + 1); while (p && *p == 34) { if (keys) l_push(l, js_val(p)); p = js_ws(js_str(p)); if (*p == 58) p++; if (!keys) l_push(l, js_val(p)); p = js_next(p); } } return l; }")
  sys.screen.print("typedef struct { long len; unsigned char* data; } SBytes;")
  sys.screen.print("long simpler_readbytes(const char* path) { SBytes* y = (SBytes*)malloc(sizeof(SBytes)); y->len = 0; size_t cap = 4096, got = 0, n; struct stat st; FILE* f = fopen(path, \"rb\"); if (f && fstat(fileno(f), &st) == 0 && st.st_size > 0) cap = (size_t)st.st_size + 1; y->data = (unsigned char*)malloc(cap); if (f) { while ((n = fread(y->data + got, 1, cap - got, f)) > 0) { got += n; if (got == cap) { cap *= 2; y->data = (unsigned char*)realloc(y->data, cap); } } fclose(f); } y->len = (long)got; return (long)(intptr_t)y; }")
  sys.screen.print("long y_find(long yp, long v, long from) { SBytes* y = (SBytes*)(intptr_t)yp; if (from < 0) from = 0; if (from >= y->len || v < 0 || v > 255) return -1; unsigned char* q = (unsigned char*)memchr(y->data + from, (int)v, (size_t)(y->len - from)); return q ? (long)(q - y->data) : -1; }")
  sys.screen.print("long y_len(long yp) { return ((SBytes*)(intptr_t)yp)->len; }")
