  sys.screen.print("static void simpler_jinit(void) { if (!simpler_wr[0] || simpler_dry) return; const char* st = getenv(\"XDG_STATE_HOME\"); const char* h = getenv(\"HOME\"); char root[PATH_MAX]; if (st && st[0] == '/') snprintf(root, sizeof root, \"%s/simpler\", st); else if (h) snprintf(root, sizeof root, \"%s/.local/state/simpler\", h); else return; unsigned long long x = 1469598103934665603ULL; for (const char* c = (const char*)(intptr_t)simpler_self(); *c; c++) { x ^= (unsigned char)*c; x *= 1099511628211ULL; } if (snprintf(simpler_jdir, sizeof simpler_jdir, \"%s/undo/%016llx\", root, x) >= (int)sizeof simpler_jdir) { simpler_jdir[0] = 0; return; } if (mkdir(simpler_jdir, 0700) == 0 || errno == EEXIST) return; char b[PATH_MAX]; strcpy(b, simpler_jdir); for (char* c = b + 1; *c; c++) if (*c == '/') { *c = 0; mkdir(b, 0700); *c = '/'; } if (mkdir(simpler_jdir, 0700) != 0 && errno != EEXIST) simpler_jdir[0] = 0; }")
  sys.screen.print("int simpler_keep_do(const char* ab, const char* flag) { static int opened = 0; static long num = 0; char f[PATH_MAX + 32]; if (!opened) { opened = 1; for (int k = 1; ; k++) { snprintf(f, sizeof f, \"%s/%d\", simpler_jdir, k); if (unlink(f) != 0) break; } snprintf(f, sizeof f, \"%s/log\", simpler_jdir); FILE* l = fopen(f, \"w\"); if (l) fclose(l); } struct stat st; long tag = 0; if (flag[0] == 0 && lstat(ab, &st) == 0) { if (!S_ISREG(st.st_mode) || st.st_size > (16L << 20)) tag = -1; else { tag = ++num; snprintf(f, sizeof f, \"%s/%ld\", simpler_jdir, tag); FILE* in = fopen(ab, \"rb\"); FILE* out = fopen(f, \"wb\"); if (in && out) { char buf[65536]; size_t r; while ((r = fread(buf, 1, sizeof buf, in)) > 0) fwrite(buf, 1, r, out); } else tag = -1; if (in) fclose(in); if (out) fclose(out); } } snprintf(f, sizeof f, \"%s/log\", simpler_jdir); FILE* l = fopen(f, \"a\"); if (l) { fprintf(l, \"%ld\\t%s\\n\", tag, ab); fclose(l); } return 0; }")
  sys.screen.print("static void simpler_undo(void) { if (!getenv(\"SIMPLER_UNDO\")) return; char f[PATH_MAX + 32]; snprintf(f, sizeof f, \"%s/log\", simpler_jdir); FILE* l = simpler_jdir[0] ? fopen(f, \"r\") : 0; static char* lines[4096]; int n = 0; static char buf[65536]; while (l && n < 4096 && fgets(buf, PATH_MAX + 64, l)) { size_t k = strlen(buf); if (k > 0 && buf[k - 1] == 10) buf[k - 1] = 0; lines[n++] = strdup(buf); } if (l) fclose(l); int done = 0; for (int k = n - 1; k >= 0; k--) { char* tab = strchr(lines[k], 9); if (!tab) continue; *tab = 0; const char* p = tab + 1; long tag = atol(lines[k]); if (tag == 0) { if (unlink(p) == 0) { printf(\"removed %s\\n\", p); done++; } } else if (tag < 0) { printf(\"not kept, so left as it is: %s\\n\", p); done++; } else { snprintf(f, sizeof f, \"%s/%ld\", simpler_jdir, tag); FILE* in = fopen(f, \"rb\"); FILE* out = in ? fopen(p, \"wb\") : 0; if (in && out) { size_t r; while ((r = fread(buf, 1, sizeof buf, in)) > 0) fwrite(buf, 1, r, out); printf(\"restored %s\\n\", p); done++; } else printf(\"could not restore %s\\n\", p); if (in) fclose(in); if (out) fclose(out); unlink(f); } } if (simpler_jdir[0]) { snprintf(f, sizeof f, \"%s/log\", simpler_jdir); unlink(f); } if (!done) printf(\"nothing to undo\\n\"); exit(0); }")
