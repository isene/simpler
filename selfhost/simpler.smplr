  sys.screen.print("static void simpler_allow_prog(const char* name) { char b[PATH_MAX], r[PATH_MAX]; if (strchr(name, '/')) { if (realpath(simpler_home(name), r)) simpler_allow(r, 1ULL | 4ULL); return; } const char* path = getenv(\"PATH\"); if (!path) return; while (*path) { size_t n = strcspn(path, \":\"); if (n > 0 && n + strlen(name) + 2 < sizeof b) { memcpy(b, path, n); b[n] = '/'; strcpy(b + n + 1, name); if (access(b, X_OK) == 0 && realpath(b, r)) { simpler_allow(b, 1ULL | 4ULL); simpler_allow(r, 1ULL | 4ULL); return; } } path += n; if (*path == ':') path++; } }")
