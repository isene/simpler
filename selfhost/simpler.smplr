  sys.screen.print("static void simpler_term_flush(void) { fflush(stdout); if (!simpler_back) return; char b[64]; simpler_on = 0; if (simpler_all) { simpler_o(\"\\033[0m\\033[2J\"); simpler_term_blank(simpler_front); simpler_all = 0; } long cur = -1, pr = -1, pc = -1; for (long r = 0; r < simpler_tr; r++) for (long c = 0; c < simpler_tc; c++) { SCell* k = simpler_back + r * simpler_tc + c; SCell* f = simpler_front + r * simpler_tc + c; if (memcmp(k, f, sizeof(SCell)) == 0) continue; if (pr == r && c > pc && c - pc <= 4) { long g = pc; while (g < c && simpler_back[r * simpler_tc + g].st == cur) g++; if (g == c) { for (g = pc; g < c; g++) simpler_o(simpler_back[r * simpler_tc + g].g); pc = c; } } if (pr != r || pc != c) { snprintf(b, sizeof b, \"\\033[%ld;%ldH\", r + 1, c + 1); simpler_o(b); } if (k->st != cur) { simpler_o(\"\\033[0\"); if (k->st) { simpler_o(\";\"); simpler_o(simpler_sty[k->st]); } simpler_o(\"m\"); cur = k->st; } simpler_o(k->g); *f = *k; pr = r; pc = c + 1; } if (simpler_on == 0) return; simpler_o(\"\\033[0m\"); long off = 0; while (off < simpler_on) { ssize_t n = write(1, simpler_ob + off, simpler_on - off); if (n <= 0) { if (n < 0 && errno == EINTR) continue; break; } off += n; } }")
  sys.screen.print("static void simpler_term_end(void) { if (!simpler_tty) return; simpler_tty = 0; fputs(\"\\033[0m\\033[?25h\\033[?1049l\", stdout); fflush(stdout); tcsetattr(0, TCSAFLUSH, &simpler_tio); if (simpler_err >= 0) { fflush(stderr); dup2(simpler_err, 2); close(simpler_err); simpler_err = -1; if (simpler_errf) { char b[512]; size_t n; rewind(simpler_errf); while ((n = fread(b, 1, sizeof b, simpler_errf)) > 0) fwrite(b, 1, n, stderr); fclose(simpler_errf); simpler_errf = 0; } } }")
  sys.screen.print("static void simpler_winch(int g) { (void)g; simpler_winched = 1; }")
  sys.screen.print("static void simpler_quit(int g) { exit(128 + g); }")
  sys.screen.print("static void simpler_term_on(void) { if (simpler_tty) return; if (tcgetattr(0, &simpler_tio) != 0) { fprintf(stderr, \"sys.term needs a terminal on standard input\\n\"); exit(1); } struct termios r = simpler_tio; cfmakeraw(&r); r.c_lflag |= ISIG; tcsetattr(0, TCSADRAIN, &r); static int once = 0; if (!once) { once = 1; atexit(simpler_term_end); struct sigaction sa; memset(&sa, 0, sizeof sa); sa.sa_handler = simpler_winch; sigaction(SIGWINCH, &sa, 0); sa.sa_handler = simpler_quit; sigaction(SIGINT, &sa, 0); sigaction(SIGTERM, &sa, 0); } simpler_errf = simpler_tmp(); if (simpler_errf) { fflush(stderr); simpler_err = dup(2); dup2(fileno(simpler_errf), 2); } simpler_tty = 1; fputs(\"\\033[?1049h\\033[?25l\", stdout); fflush(stdout); simpler_term_fit(); simpler_all = 1; }")
  sys.screen.print("long simpler_term_stop(void) { simpler_term_end(); return 0; }")
  sys.screen.print("long simpler_term_size(long cols) { if (!simpler_back) simpler_term_fit(); return cols ? simpler_tc : simpler_tr; }")
  sys.screen.print("long simpler_term_clear(void) { simpler_term_on(); simpler_term_blank(simpler_back); return 0; }")
  sys.screen.print("static const char* simpler_style(const char* w, long n) { static const char* k[] = {\"bold\",\"1\",\"dim\",\"2\",\"underline\",\"4\",\"reverse\",\"7\",\"black\",\"30\",\"red\",\"31\",\"green\",\"32\",\"yellow\",\"33\",\"blue\",\"34\",\"magenta\",\"35\",\"cyan\",\"36\",\"white\",\"37\",\"gray\",\"90\",0}; for (int i = 0; k[i]; i += 2) if ((long)strlen(k[i]) == n && strncmp(k[i], w, n) == 0) return k[i + 1]; int bg = n > 2 && w[0] == 'o' && w[1] == 'n'; long v = 0, d = 0; for (long i = bg ? 2 : 0; i < n; i++) { if (w[i] < '0' || w[i] > '9' || ++d > 3) return 0; v = v * 10 + (w[i] - '0'); } if (d == 0 || v > 255) return 0; static char b[32]; snprintf(b, sizeof b, \"%d;5;%ld\", bg ? 48 : 38, v); return b; }")
  sys.screen.print("long simpler_term_put(long row, long col, long text, long style, long line) { simpler_term_on(); const char* t = (const char*)(intptr_t)text; const char* y = (const char*)(intptr_t)style; long room = simpler_tc - col; if (row < 0 || col < 0 || row >= simpler_tr || room <= 0) return 0; char sg[40]; long sn = 0; while (*y) { while (*y == 32) y++; long n = 0; while (y[n] && y[n] != 32) n++; if (n == 0) break; const char* c = simpler_style(y, n); if (!c) { fprintf(stderr, \"%s: no style named \\\"%.*s\\\"; the styles are bold, dim, underline, reverse, black, red, green, yellow, blue, magenta, cyan, white, gray, a colour number 0 to 255, and on with a number for the background (on52)\\n\", simpler_at(line), (int)n, y); exit(1); } long cn = (long)strlen(c); if (sn + cn + 2 < (long)sizeof sg) { if (sn) sg[sn++] = 59; memcpy(sg + sn, c, cn); sn += cn; } y += n; } sg[sn] = 0; static int last = 0; int st = 0; if (sn) { if (strcmp(simpler_sty[last], sg) == 0) st = last; else { for (int k = 1; k < simpler_nsty && !st; k++) if (strcmp(simpler_sty[k], sg) == 0) st = k; if (!st && simpler_nsty < 1024) { st = simpler_nsty++; strcpy(simpler_sty[st], sg); } last = st; } } SCell* k = simpler_back + row * simpler_tc + col - 1; long gn = 5; for (; *t; t++) { unsigned char ch = (unsigned char)*t; if ((ch & 0xC0) != 0x80) { if (room == 0) break; room--; k++; memset(k, 0, sizeof(SCell)); k->st = (unsigned short)st; gn = 0; } if (gn < 4) k->g[gn++] = (char)(ch < 32 || ch == 127 ? 63 : ch); } return 0; }")
  sys.screen.print("static long simpler_keyname(const char* k) { return (long)(intptr_t)k; }")
  sys.screen.print("long simpler_term_key(void) { simpler_term_on(); if (simpler_winched) { simpler_winched = 0; simpler_term_fit(); return simpler_keyname(\"resize\"); } simpler_term_flush(); unsigned char b[16]; ssize_t n = read(0, b, 1); if (n < 0) { if (errno != EINTR) return simpler_keyname(\"eof\"); simpler_winched = 0; simpler_term_fit(); return simpler_keyname(\"resize\"); } if (n == 0) return simpler_keyname(\"eof\"); unsigned char c = b[0]; if (c == 27) { struct pollfd pf = {0, POLLIN, 0}; long m = 0; while (m < 8 && poll(&pf, 1, m == 0 ? 30 : 0) > 0 && read(0, b + m, 1) == 1) { m++; if (m > 1 && b[m - 1] >= 64) break; } if (m == 0) return simpler_keyname(\"esc\"); unsigned char e = b[m - 1]; if (m >= 2 && (b[0] == '[' || b[0] == 'O')) { if (e == 'A') return simpler_keyname(\"up\"); if (e == 'B') return simpler_keyname(\"down\"); if (e == 'C') return simpler_keyname(\"right\"); if (e == 'D') return simpler_keyname(\"left\"); if (e == 'H') return simpler_keyname(\"home\"); if (e == 'F') return simpler_keyname(\"end\"); if (e == '~') { if (b[1] == '1' || b[1] == '7') return simpler_keyname(\"home\"); if (b[1] == '4' || b[1] == '8') return simpler_keyname(\"end\"); if (b[1] == '3') return simpler_keyname(\"delete\"); if (b[1] == '5') return simpler_keyname(\"pgup\"); if (b[1] == '6') return simpler_keyname(\"pgdn\"); } } return simpler_keyname(\"other\"); } if (c == 13 || c == 10) return simpler_keyname(\"enter\"); if (c == 9) return simpler_keyname(\"tab\"); if (c == 127 || c == 8) return simpler_keyname(\"backspace\"); char* r = (char*)malloc(8); if (c < 32) { sprintf(r, \"ctrl-%c\", c + 96); return (long)(intptr_t)r; } long len = c >= 0xF0 ? 4 : c >= 0xE0 ? 3 : c >= 0xC0 ? 2 : 1; r[0] = (char)c; for (long i = 1; i < len; i++) if (read(0, r + i, 1) != 1) { len = i; break; } r[len] = 0; return (long)(intptr_t)r; }")
  sys.screen.print("long simpler_now() { return (long)time(0); }")
  sys.screen.print("long simpler_fetchwith(long url, long hdrs, long line) { SList* h = (SList*)(intptr_t)hdrs; for (long k = 0; k < h->len; k++) { const char* x = (const char*)(intptr_t)h->data[k]; if (k >= 16 || x[0] == '@' || !strchr(x, ':') || strchr(x, 10) || strchr(x, 13)) { fprintf(stderr, \"%s: a header is one line like \\\"Name: value\\\", and there are at most 16; got \\\"%s\\\"\\n\", simpler_at(line), x); exit(1); } } simpler_hdr = hdrs; long out = simpler_fetch(url, 0, 0, line); simpler_hdr = 0; return out; }")
  sys.screen.print("long simpler_stamp(long t, long pat) { time_t tt = (time_t)t; struct tm* m = localtime(&tt); char* r = (char*)malloc(256); if (strftime(r, 256, (const char*)(intptr_t)pat, m) == 0) r[0] = 0; return (long)(intptr_t)r; }")
  sys.screen.print("long simpler_secs(long text) { const char* s = (const char*)(intptr_t)text; struct tm m; memset(&m, 0, sizeof m); int y, mo, d, h = 0, mi = 0, se = 0, n = 0; if (sscanf(s, \"%d-%d-%d%n\", &y, &mo, &d, &n) != 3 || mo < 1 || mo > 12 || d < 1 || d > 31) return 0; s += n; if (*s == 'T' || *s == ' ') { n = 0; if (sscanf(s + 1, \"%d:%d%n\", &h, &mi, &n) != 2) return 0; s += 1 + n; n = 0; if (*s == ':' && sscanf(s + 1, \"%d%n\", &se, &n) == 1) s += 1 + n; if (*s == '.') { s++; while (*s >= '0' && *s <= '9') s++; } } m.tm_year = y - 1900; m.tm_mon = mo - 1; m.tm_mday = d; m.tm_hour = h; m.tm_min = mi; m.tm_sec = se; m.tm_isdst = -1; if (*s == 'Z') return (long)timegm(&m); if (*s == '+' || *s == '-') { int oh = 0, om = 0; if (sscanf(s + 1, \"%d:%d\", &oh, &om) < 1) return 0; if (oh > 99) { om = oh % 100; oh = oh / 100; } long off = oh * 3600L + om * 60L; return (long)timegm(&m) - (*s == '-' ? -off : off); } return (long)mktime(&m); }")
  sys.screen.print("long simpler_date(long t) { time_t tt = (time_t)t; struct tm* m = localtime(&tt); char* r = (char*)malloc(32); strftime(r, 32, \"%Y-%m-%d %H:%M:%S\", m); return (long)(intptr_t)r; }")
  sys.screen.print("long simpler_setenv(long name, long value) { const char* n = (const char*)(intptr_t)name; if (!n[0] || strchr(n, 61)) return 0; setenv(n, (const char*)(intptr_t)value, 1); return 1; }")
  sys.screen.print("static char* simpler_selfp = 0; void simpler_self_init() { const char* e = getenv(\"SIMPLER_SELF\"); if (e) { simpler_selfp = strdup(e); unsetenv(\"SIMPLER_SELF\"); } } long simpler_self() { if (!simpler_selfp) { char b[4096]; ssize_t n = readlink(\"/proc/self/exe\", b, sizeof b - 1); if (n > 0) { b[n] = 0; simpler_selfp = strdup(b); } else { char* r = realpath(simpler_argv[0], 0); simpler_selfp = r ? r : simpler_argv[0]; } } return (long)(intptr_t)simpler_selfp; }")
  sys.screen.print("long simpler_env(long name) { const char* v = getenv((const char*)(intptr_t)name); return (long)(intptr_t)(v ? v : \"\"); }")
  sys.screen.print("long simpler_stdin() { long cap = 1024; long len = 0; char* buf = (char*)malloc(cap); int c; while ((c = getchar()) != EOF) { if (len + 1 >= cap) { cap = cap * 2; buf = (char*)realloc(buf, cap); } buf[len] = (char)c; len = len + 1; } buf[len] = 0; simpler_note(buf, len); return (long)(intptr_t)buf; }")
  sys.screen.print("long fail(long msg) { fprintf(stderr, \"%s\\n\", (const char*)(intptr_t)msg); exit(1); return 0; }")
  sys.screen.print("long simpler_exit(long c) { exit((int)c); return 0; }")
  sys.screen.print("long simpler_failed = 0;")
  sys.screen.print("long s_assert(long c) { if (!c) simpler_failed = 1; return 0; }")
  prog.types.each { t in
    sys.screen.print(emitType(t))
  }
  prog.records.each { r in
    sys.screen.print(emitRecord(r))
  }
  prog.fns.each { f in
    if isMain(f.name).not {
      sys.screen.print(emitProto(f))
    }
  }
  // `simpler test` leaves main out and runs every test_* function instead.
  testing = sys.args.length > 0 && sys.args.at(0) == "test"
  if testing.not && hasName(sigs.fnNames, "main").not {
    fail("input.smplr:1: no main function found")
  }
  retPass(prog, sigs)
  prog.fns.each { f in
    if (testing && isMain(f.name)).not {
      sys.screen.print(emitFn(f, sigs))
    }
  }
  sys.screen.print(pieceTable(prog))
  if testing {
    sys.screen.print(emitTests(prog.fns))
  }
}

// --- pieces: examples for one function, and the reach of each function ---
// example double(4) == 8   is a check on one piece. Each becomes a hidden
// function that gives "" when the check is true and "gave <value>" when not.

exLeft(e : Expr) : Expr {
  e.match {
    Num(v) -> e
    FloatLit(t) -> e
    Var(t) -> e
    StrLit(t) -> e
    ListLit(es) -> e
    Bin(op, a, b) -> a
    Call(name, args) -> e
    Match(scrut, arms) -> e
    Field(recv, fld) -> e
    Method(recv, name, args) -> e
    Each(recv, param, body) -> e
  }
}

// The function an example is about: the first one it calls.
exPiece(e : Expr) : Str {
  e.match {
    Num(v) -> ""
    FloatLit(t) -> ""
    Var(t) -> ""
    StrLit(t) -> ""
    ListLit(es) -> ""
    Bin(op, a, b) -> exPiece(a)
    Call(name, args) -> name
    Match(scrut, arms) -> ""
    Field(recv, fld) -> exPiece(recv)
    Method(recv, name, args) -> exPiece(recv)
    Each(recv, param, body) -> ""
  }
}

isPieceFn(name : Str) : Bool {
  name.startsWith("simplerExample")
}

pieceFns(prog : Prog, sigs : Sigs) : Int !Mut {
  k = 0
  prog.pieces.each { p in
    ps : List[Str] = []
    pt : List[Str] = []
    ef : List[Str] = []
    b0 : List[Stmt] = []
    probe = Fn(name = "simplerExample".concat(k.toStr), params = ps, ptypes = pt, ret = "Str", effs = ef, body = b0, line = p.line)
    ctx = fnCtx(probe, sigs)
    if exprType(p.node, ctx) != "Bool" {
      fail(spot(prog.files, p.line).concat("an example for a function is a check that is true or false, as in: example double(4) == 8"))
    }
    left = exLeft(p.node)
    t = exprType(left, ctx)
    got = StrLit("another value")
    if t == "Str" {
      got = left
    }
    if (t == "Int") || (t == "Bool") || (t == "Float") {
      got = Field(left, "toStr")
    }
    yes : List[Stmt] = [Ret(StrLit(""))]
    no : List[Stmt] = []
    body : List[Stmt] = [Line(p.line), If(p.node, yes, no), Ret(Method(StrLit("gave "), "concat", [got]))]
    prog.fns.push(Fn(name = "simplerExample".concat(k.toStr), params = ps, ptypes = pt, ret = "Str", effs = ef, body = body, line = p.line))
    k = k + 1
  }
  0
}

// The C table of the hidden functions, and where each example stands.
pieceTable(prog : Prog) : Str {
  a = "long (*simpler_px[])() = {"
  b = "const char* simpler_pxw[] = {"
  k = 0
  prog.pieces.each { p in
    a = a.concat(mangle("simplerExample".concat(k.toStr))).concat(", ")
    b = b.concat("\"").concat(spot(prog.files, p.line)).concat("\", ")
    k = k + 1
  }
  a.concat("0};\n").concat(b).concat("0};")
}

// Every function a function reaches through calls, itself first.
pieceReach(name : Str, w : What) : List[Str] {
  r : List[Str] = [name]
  k = 0
  while k < r.length {
    j = 0
    while j < w.acts.length {
      if w.kinds.at(j) == "calls" && w.fns.at(j) == r.at(k) && hasName(r, w.acts.at(j)).not {
        r.push(w.acts.at(j))
      }
      j = j + 1
    }
    k = k + 1
  }
  r
}

// `simpler pieces`: each function with what it takes, what it touches (also
// through the functions it calls) and how many examples it has.
piecesProg(prog : Prog, sigs : Sigs) : Str !Mut {
  ks : List[Str] = []
  as : List[Str] = []
  fs : List[Str] = []
  w = What(kinds = ks, acts = as, fns = fs)
  prog.fns.each { f in
    whatBody(f.body, f.name, w, sigs)
  }
  out = ""
  prog.fns.each { f in
    if isPieceFn(f.name).not && f.name.contains("__").not {
      head = asWritten(f.name).concat("(")
      k = 0
      while k < f.params.length {
        if k > 0 {
          head = head.concat(", ")
        }
        head = head.concat(f.params.at(k))
        if f.ptypes.at(k) != "" && f.ptypes.at(k) != "Sys" {
          head = head.concat(" : ").concat(f.ptypes.at(k))
        }
        k = k + 1
      }
      head = head.concat(")")
      if f.ret != "" && isMain(f.name).not {
        head = head.concat(" : ").concat(f.ret)
      }
      out = out.concat(head).concat("\n")
      reach = pieceReach(f.name, w)
      seen : List[Str] = []
      ["screen", "files", "program", "net", "clock", "env", "term", "mail", "stdin", "args"].each { kind in
        j = 0
        while j < w.acts.length {
          line = kind.padRight(8).concat(w.acts.at(j))
          if w.kinds.at(j) == kind && hasName(reach, w.fns.at(j)) && hasName(seen, line).not {
            seen.push(line)
            out = out.concat("  ").concat(line).concat("\n")
          }
          j = j + 1
        }
      }
      if hasName(f.effs, "Mut") {
        seen.push("lists")
        out = out.concat("  lists   changes a list or map it was handed\n")
      }
      if seen.length == 0 {
        out = out.concat("  touches nothing\n")
      }
      n = 0
      prog.pieces.each { p in
        if exPiece(p.node) == f.name {
          n = n + 1
        }
      }
      if isMain(f.name) {
        n = prog.examples.length / 1
      }
      if n == 0 {
        out = out.concat("  no example\n")
      } else if n == 1 {
        out = out.concat("  1 example\n")
      } else {
        out = out.concat("  ").concat(n.toStr).concat(" examples\n")
      }
    }
  }
  out.concat("each piece touches only what is listed under it")
}

// --- what: everything a program can touch -------------------------------
// A program reaches the world only through main's `sys`, and the compiler
// refuses any other way. So the uses found here are all there are.

What = type {
  kinds : List[Str]
  acts : List[Str]
  fns : List[Str]
}

// A line at the top says which files the program may touch:
//   reads "notes.txt", "data/", args      writes "out/"
// A name ending in / is a folder; args is any file named on the command line.
isMayLine(toks : Lexed, i : Int) : Bool {
  ((isWord(toks, i, "reads") || isWord(toks, i, "writes")) && (isStrTok(toks, i + 1) || isWord(toks, i + 1, "args"))) || ((isWord(toks, i, "runs") || isWord(toks, i, "fetches") || isWord(toks, i, "mails")) && isStrTok(toks, i + 1))
}

isStrTok(toks : Lexed, i : Int) : Bool {
  tokAt(toks, i).match {
    Ident(s) -> false
    Int(v) -> false
    Float(f) -> false
    Str(s) -> true
    Punct(p) -> false
    Eof -> false
  }
}

strAt(toks : Lexed, i : Int) : Str {
  tokAt(toks, i).match {
    Ident(s) -> "?"
    Int(v) -> "?"
    Float(f) -> "?"
    Str(s) -> s
    Punct(p) -> "?"
    Eof -> "?"
  }
}

// A limits line at the top caps processor time and memory:   limits "2s", "50MB"
isLimitsLine(toks : Lexed, i : Int) : Bool {
  isWord(toks, i, "limits") && isStrTok(toks, i + 1)
}

parseLimits(toks : Lexed, i : Int, limits : List[Str]) : Int !Mut {
  j = i + 1
  more = true
  while more {
    if isStrTok(toks, j).not {
      failTok(toks, j, "a limit is a text in quotes, as in: limits \"2s\", \"50MB\"")
    }
    limits.push(strAt(toks, j))
    j = j + 1
    more = isPunct(toks, j, ",")
    if more {
      j = j + 1
    }
  }
  j
}

// A line at the top gives an example: the input, the output wanted, then any
// arguments.   example "3 4", "7"   A build runs each one and fails if one differs.
isExampleLine(toks : Lexed, i : Int) : Bool {
  isWord(toks, i, "example") && isStrTok(toks, i + 1)
}

parseExample(toks : Lexed, i : Int, examples : List[Str]) : Int !Mut {
  j = i + 1
  n = 0
  c = ""
  more = true
  while more {
    if isStrTok(toks, j).not {
      failTok(toks, j, "an example is texts in quotes: the input, the output wanted, then any arguments")
    }
    c = c.concat("\"").concat(cEscape(strAt(toks, j))).concat("\", ")
    n = n + 1
    j = j + 1
    more = isPunct(toks, j, ",")
    if more {
      j = j + 1
    }
  }
  if n < 2 {
    failTok(toks, i, "an example needs the input and the output wanted, as in: example \"3 4\", \"7\"")
  }
  examples.push(c.concat("0, "))
  j
}

exTable(examples : List[Str]) : Str {
  out = "const char* simpler_ex[] = {"
  examples.each { e in
    out = out.concat(e)
  }
  out.concat("0};")
}

parseMay(toks : Lexed, i : Int, reads : List[Str], writes : List[Str], runs : List[Str], fetches : List[Str], mails : List[Str]) : Int !Mut {
  w = isWord(toks, i, "writes")
  ml = isWord(toks, i, "mails")
  rn = isWord(toks, i, "runs") || ml
  ft = isWord(toks, i, "fetches")
  j = i + 1
  more = true
  while more {
    name = "<args>"
    if isWord(toks, j, "args").not || rn || ft {
      if isStrTok(toks, j).not && (rn || ft) {
        failTok(toks, j, "expected a name in quotes")
      }
      if isStrTok(toks, j).not {
        failTok(toks, j, "expected a file name in quotes, or the word args")
      }
      name = strAt(toks, j)
    }
    if w {
      writes.push(name)
    } else if ml {
      mails.push(name)
    } else if rn {
      runs.push(name)
    } else if ft {
      fetches.push(name)
    } else {
      reads.push(name)
    }
    j = j + 1
    more = isPunct(toks, j, ",")
    if more {
      j = j + 1
    }
  }
  j
}

// The C list of the names a reads or writes line gave, ended by 0.
mayTable(cname : Str, names : List[Str]) : Str {
  out = "const char* ".concat(cname).concat("[] = {")
  names.each { n in
    out = out.concat("\"").concat(cEscape(n)).concat("\", ")
  }
  out.concat("0};")
}

// Is the path s one the line allows: the same name, or under a folder it names?
// A * in a name at the top stands for any run of characters, but never for a /.
globOk(pat : Str, s : Str) : Bool {
  p = 0
  i = 0
  star = 0 - 1
  mark = 0
  while i < s.length {
    if p < pat.length && pat.at(p) == "*" {
      star = p
      mark = i
      p = p + 1
    } else if p < pat.length && pat.at(p) == s.at(i) {
      p = p + 1
      i = i + 1
    } else if star >= 0 && s.at(mark) != "/" {
      p = star + 1
      mark = mark + 1
      i = mark
    } else {
      return false
    }
  }
  while p < pat.length && pat.at(p) == "*" {
    p = p + 1
  }
  p == pat.length
}

// Is the name in the list, as it stands or through an entry with a * in it?
globName(names : List[Str], s : Str) : Bool {
  r = hasName(names, s)
  names.each { e in
    if e.contains("*") && globOk(e, s) {
      r = true
    }
  }
  r
}

mayName(s : Str, names : List[Str]) : Bool {
  r = false
  names.each { e in
    if e == s {
      r = true
    }
    if e.contains("*") && globOk(e, s) && s.contains("..").not {
      r = true
    }
    // "./" is the folder the program runs in: any path that does not start at the root
    if e == "./" {
      if s.length > 0 {
        if (s.at(0) == "/").not && s.contains("..").not {
          r = true
        }
      }
    }
    n = e.length
    if n > 0 {
      if s.length >= n {
        if e.at(n - 1) == "/" {
          if s.slice(0, n) == e {
            if s.contains("..").not {
              r = true
            }
          }
        }
      }
    }
  }
  r
}

// A path written out in the program is checked here; any other is checked while it runs.
mayCheck(arg : Expr, names : List[Str], verb : Str, word : Str, ctx : Ctx) : Int {
  if names.length == 0 {
    failAt("this program may not ".concat(verb).concat(" a file; say which at the top, as in: ").concat(word).concat(" \"notes.txt\""), ctx)
  }
  p = whatPath(arg)
  if p.at(0) == "\"" {
    lit = p.slice(1, p.length - 1)
    if verb == "list" {
      if lit.length == 0 {
        lit = "/"
      } else {
        if (lit.at(lit.length - 1) == "/").not {
          lit = lit.concat("/")
        }
      }
    }
    if mayName(lit, names).not {
      failAt("this program may not ".concat(verb).concat(" ").concat(p).concat("; add it to the ").concat(word).concat(" line at the top"), ctx)
    }
  }
  0
}

// The host of a web address: "https://a.b/c" gives "a.b"; "" when it is no web address.
hostOf(url : Str) : Str {
  rest = ""
  if url.startsWith("https://") {
    rest = url.slice(8, url.length)
  }
  if url.startsWith("http://") {
    rest = url.slice(7, url.length)
  }
  k = 0
  while k < rest.length {
    c = rest.at(k)
    if (c == "/") || (c == ":") || (c == "?") || (c == "#") {
      return rest.slice(0, k)
    }
    k = k + 1
  }
  rest
}

// A program name or a web address written out in the program is checked here; any other while it runs.
runCheck(arg : Expr, ctx : Ctx) : Int {
  if ctx.sigs.runs.length == 0 {
    failAt("this program may not run another program; say which at the top, as in: runs \"git\"", ctx)
  }
  p = whatPath(arg)
  if p.at(0) == "\"" {
    if hasName(ctx.sigs.runs, p.slice(1, p.length - 1)).not {
      failAt("this program may not run ".concat(p).concat("; add it to the runs line at the top"), ctx)
    }
  }
  0
}

// A mails line names whole addresses, or "@example.com" for everyone there.
mailCheck(arg : Expr, ctx : Ctx) : Int {
  if ctx.sigs.mails.length == 0 {
    failAt("this program may not send mail; say to whom at the top, as in: mails \"me@example.com\"", ctx)
  }
  p = whatPath(arg)
  if p.at(0) == "\"" {
    a = p.slice(1, p.length - 1)
    ok = false
    for m in ctx.sigs.mails {
      if (m == a) || (m.startsWith("@") && a.endsWith(m)) || (m.contains("*") && globOk(m, a)) {
        ok = true
      }
    }
    if !ok {
      failAt("this program may not mail ".concat(p).concat("; add it to the mails line at the top"), ctx)
    }
  }
  0
}

fetchCheck(arg : Expr, ctx : Ctx) : Int {
  if ctx.sigs.fetches.length == 0 {
    failAt("this program may not fetch from the network; say which hosts at the top, as in: fetches \"example.com\"", ctx)
  }
  p = whatPath(arg)
  if p.at(0) == "\"" {
    h = hostOf(p.slice(1, p.length - 1))
    if globName(ctx.sigs.fetches, h).not {
      failAt("this program may not fetch from \"".concat(h).concat("\"; add it to the fetches line at the top"), ctx)
    }
  }
  0
}

// What a reads or writes line allows, in words.
mayText(names : List[Str]) : Str {
  out = ""
  names.each { n in
    if (out == "").not {
      out = out.concat(", ")
    }
    if n == "<args>" {
      out = out.concat("any file named on the command line")
    } else {
      if n.length > 0 {
        if n.at(n.length - 1) == "/" {
          out = out.concat("anything under ")
        }
      }
      out = out.concat("\"").concat(n).concat("\"")
    }
  }
  out
}

whatProg(prog : Prog, sigs : Sigs) : Str {
  ks : List[Str] = []
  as : List[Str] = []
  fs : List[Str] = []
  w = What(kinds = ks, acts = as, fns = fs)
  prog.fns.each { f in
    whatBody(f.body, f.name, w, sigs)
  }
  out = ""
  ["screen", "files", "program", "net", "clock", "env", "term", "mail", "stdin", "args"].each { kind in
    out = out.concat(whatKind(w, kind))
  }
  muts = ""
  prog.fns.each { f in
    if hasName(f.effs, "Mut") {
      if (muts == "").not {
        muts = muts.concat(", ")
      }
      muts = muts.concat(f.name.replace("__", "."))
    }
  }
  if (muts == "").not {
    out = out.concat("lists   changes a list or map it was handed  (in ").concat(muts).concat(")\n")
  }
  if prog.reads.length > 0 {
    out = out.concat("may read   ").concat(mayText(prog.reads)).concat("\n")
  }
  if prog.writes.length > 0 {
    out = out.concat("may write  ").concat(mayText(prog.writes)).concat("\n")
  }
  if prog.runs.length > 0 {
    out = out.concat("may run    ").concat(mayText(prog.runs)).concat("\n")
  }
  if prog.fetches.length > 0 {
    out = out.concat("may fetch  ").concat(mayText(prog.fetches)).concat("\n")
  }
  if prog.mails.length > 0 {
    out = out.concat("may mail   ").concat(mayText(prog.mails)).concat("\n")
  }
  if prog.limits.length > 0 {
    out = out.concat("limits     ").concat(mayText(prog.limits)).concat("\n")
  }
  // a full-screen program draws through term, so say that on the screen row
  if out.contains("term    takes") {
    out = out.replace("screen  not used\n", "screen  prints no lines; term draws on it\n")
  }
  out.concat("nothing else: a program reaches the world only through what is listed here")
}

// One line per thing done with `kind`, with the functions that do it.
whatKind(w : What, kind : Str) : Str {
  out = ""
  done : List[Str] = []
  k = 0
  while k < w.acts.length {
    act = w.acts.at(k)
    if w.kinds.at(k) == kind && hasName(done, act).not {
      done.push(act)
      who = ""
      j = k
      while j < w.acts.length {
        if w.kinds.at(j) == kind && w.acts.at(j) == act {
          if (who == "").not {
            who = who.concat(", ")
          }
          who = who.concat(w.fns.at(j).replace("__", "."))
        }
        j = j + 1
      }
      out = out.concat(kind.padRight(8)).concat(act).concat("  (in ").concat(who).concat(")\n")
    }
    k = k + 1
  }
  if out == "" {
    out = kind.padRight(8).concat("not used\n")
  }
  out
}

whatAdd(w : What, kind : Str, act : Str, fn : Str) : Int !Mut {
  k = 0
  while k < w.acts.length {
    if w.kinds.at(k) == kind && w.acts.at(k) == act && w.fns.at(k) == fn {
      return 0
    }
    k = k + 1
  }
  w.kinds.push(kind)
  w.acts.push(act)
  w.fns.push(fn)
  0
}

whatBody(body : List[Stmt], fn : Str, w : What, sigs : Sigs) : Int !Mut {
  body.each { s in
    whatStmt(s, fn, w, sigs)
  }
  0
}

whatStmt(s : Stmt, fn : Str, w : What, sigs : Sigs) : Int !Mut {
  s.match {
    Let(name, ty, e) -> whatExpr(e, fn, w, sigs)
    Bare(e) -> whatExpr(e, fn, w, sigs)
    If(c, t, el) -> whatExpr(c, fn, w, sigs) + whatBody(t, fn, w, sigs) + whatBody(el, fn, w, sigs)
    While(c, b) -> whatExpr(c, fn, w, sigs) + whatBody(b, fn, w, sigs)
    Ret(e) -> whatExpr(e, fn, w, sigs)
    Line(n) -> 0
    Jump(w) -> 0
  }
}

whatExpr(e : Expr, fn : Str, w : What, sigs : Sigs) : Int !Mut {
  e.match {
    Num(v) -> 0
    FloatLit(s) -> 0
    Var(s) -> 0
    StrLit(s) -> 0
    ListLit(es) -> whatAll(es, fn, w, sigs)
    Bin(op, a, b) -> whatExpr(a, fn, w, sigs) + whatExpr(b, fn, w, sigs)
    Call(name, args) -> whatAdd(w, "calls", name, fn) + whatAll(args, fn, w, sigs)
    Match(scrut, arms) -> whatExpr(scrut, fn, w, sigs) + whatArms(arms, fn, w, sigs)
    Field(recv, fld) -> whatField(recv, fld, fn, w, sigs)
    Method(recv, name, args) -> whatMethod(recv, name, args, fn, w, sigs)
    Each(recv, param, body) -> whatExpr(recv, fn, w, sigs) + whatBody(body, fn, w, sigs)
  }
}

whatAll(es : List[Expr], fn : Str, w : What, sigs : Sigs) : Int !Mut {
  es.each { x in
    whatExpr(x, fn, w, sigs)
  }
  0
}

whatArms(arms : List[Arm], fn : Str, w : What, sigs : Sigs) : Int !Mut {
  arms.each { a in
    whatExpr(a.body, fn, w, sigs)
  }
  0
}

whatField(recv : Expr, fld : Str, fn : Str, w : What, sigs : Sigs) : Int !Mut {
  if fld == "stdin" {
    whatAdd(w, "stdin", "reads all of standard input", fn)
  }
  if fld == "stdinLine" {
    whatAdd(w, "stdin", "reads standard input line by line", fn)
  }
  if fld == "args" {
    whatAdd(w, "args", "reads the command line", fn)
  }
  if fld == "self" {
    whatAdd(w, "env", "reads its own path", fn)
  }
  if (fld == "now") || (fld == "millis") {
    whatAdd(w, "clock", "reads the time", fn)
  }
  if fld == "term" {
    whatAdd(w, "term", "takes the whole terminal and reads keys", fn)
  }
  whatExpr(recv, fn, w, sigs)
}

whatMethod(recv : Expr, name : Str, args : List[Expr], fn : Str, w : What, sigs : Sigs) : Int !Mut {
  if args.length > 0 {
    if (name == "print") || (name == "part") || (name == "error") {
      whatAdd(w, "screen", "prints", fn)
    }
    if name == "read" {
      whatAdd(w, "files", "reads ".concat(whatPath(args.at(0))), fn)
    }
    if name == "write" {
      whatAdd(w, "files", "writes ".concat(whatPath(args.at(0))), fn)
    }
    if name == "readBytes" {
      whatAdd(w, "files", "reads the bytes of ".concat(whatPath(args.at(0))), fn)
    }
    if name == "writeBytes" {
      whatAdd(w, "files", "writes bytes to ".concat(whatPath(args.at(0))), fn)
    }
    if name == "append" {
      whatAdd(w, "files", "adds to ".concat(whatPath(args.at(0))), fn)
    }
    if name == "list" {
      whatAdd(w, "files", "lists the folder ".concat(whatPath(args.at(0))), fn)
    }
    if name == "exists" {
      whatAdd(w, "files", "looks for ".concat(whatPath(args.at(0))), fn)
    }
    if name == "wait" {
      whatAdd(w, "files", "waits for a change in ".concat(whatPath(args.at(0))), fn)
    }
    if name == "sleep" {
      whatAdd(w, "clock", "waits", fn)
    }
    if name == "rename" {
      whatAdd(w, "files", "renames ".concat(whatPath(args.at(0))), fn)
    }
    if name == "delete" {
      whatAdd(w, "files", "deletes ".concat(whatPath(args.at(0))), fn)
    }
    if name == "send" {
      whatAdd(w, "mail", "sends to ".concat(whatPath(args.at(0)).replace("a path", "an address")), fn)
    }
    if (name == "run") || (name == "status") || (name == "start") || (name == "try") || (name == "feed") {
      whatAdd(w, "program", "runs ".concat(whatPath(args.at(0))), fn)
    }
    if (name == "fetch") || (name == "reach") || (name == "fetchWith") {
      whatAdd(w, "net", "fetches ".concat(whatPath(args.at(0))), fn)
    }
    if name == "post" {
      whatAdd(w, "net", "sends to ".concat(whatPath(args.at(0))), fn)
    }
    if name == "var" {
      whatAdd(w, "env", "reads the variable ".concat(whatPath(args.at(0))), fn)
    }
    if name == "setVar" {
      whatAdd(w, "env", "sets the variable ".concat(whatPath(args.at(0))).concat(" for itself and the programs it runs"), fn)
    }
  }
  whatExpr(recv, fn, w, sigs)
  whatAll(args, fn, w, sigs)
}

// A path written out in the program is shown; any other is made while it runs.
whatPath(e : Expr) : Str {
  e.match {
    StrLit(s) -> "\"".concat(s).concat("\"")
    Num(v) -> "a path made while running"
    FloatLit(s) -> "a path made while running"
    Var(s) -> "a path made while running"
    ListLit(es) -> "a path made while running"
    Bin(op, a, b) -> "a path made while running"
    Call(name, args) -> "a path made while running"
    Match(scrut, arms) -> "a path made while running"
    Field(recv, fld) -> "a path made while running"
    Method(recv, name, args) -> "a path made while running"
    Each(recv, param, body) -> "a path made while running"
  }
}

isTest(name : Str) : Bool {
  name.length > 5 && name.slice(0, 5) == "test_"
}

emitTests(fns : List[Fn]) : Str {
  out = "int main(void) {\n  long failures = 0;\n  long total = 0;"
  fns.each { f in
    if isTest(f.name) {
      c = mangle(f.name)
      out = out.concat("\n  simpler_failed = 0; total = total + 1; ").concat(c).concat("();")
      out = out.concat("\n  if (simpler_failed) { printf(\"FAIL ").concat(f.name).concat("\\n\"); failures = failures + 1; } else { printf(\"PASS ").concat(f.name).concat("\\n\"); }")
    }
  }
  out.concat("\n  printf(\"\\n%ld/%ld passed\\n\", total - failures, total);\n  return failures ? 1 : 0;\n}")
}

buildSigs(prog : Prog) : Sigs {
  recNames : List[Str] = []
  prog.records.each { r in
    recNames.push(r.name)
  }
  fnNames : List[Str] = []
  fnRets : List[Str] = []
  prog.fns.each { f in
    fnNames.push(f.name)
    fnRets.push(f.ret)
  }
  boxedNullary : List[Str] = []
  retP : List[Str] = []
  mutP : List[Str] = []
  prog.types.each { t in
    if hasPayload(t) {
      t.cases.each { c in
        if c.arity == 0 {
          boxedNullary.push(c.cname)
        }
      }
    }
  }
  Sigs(recNames = recNames, records = prog.records, types = prog.types, fns = prog.fns, fnNames = fnNames, fnRets = fnRets, boxedNullary = boxedNullary, retP = retP, mutP = mutP, reads = prog.reads, writes = prog.writes, runs = prog.runs, fetches = prog.fetches, mails = prog.mails, files = prog.files)
}

// --- parse: tokens to a program -----------------------------------------

// --- modules ---------------------------------------------------------------
// `uses "crust"` at the top brings in crust.smplr. Every top-level name of a
// module gets the module's name in front (crust__box), and the program
// writes crust.box. All of it is done on the tokens, before the parser, so
// the checks and `simpler what` see one whole program.

// A line number carries its file: file number * 1000000 + line.
spot(files : List[Str], line : Int) : Str {
  m = line / 1000000
  name = "input.smplr"
  if m < files.length {
    name = files.at(m)
  }
  name.concat(":").concat((line % 1000000).toStr).concat(": ")
}

hasMod(mods : List[Mod], name : Str) : Bool {
  found = false
  mods.each { m in
    if m.name == name {
      found = true
    }
  }
  found
}

modNameOk(name : Str) : Bool {
  ok = name.length > 0 && name != "input" && name.contains("__").not
  k = 0
  while k < name.length {
    if isAlnum(name.at(k).code).not {
      ok = false
    }
    k = k + 1
  }
  ok
}

// Takes the uses lines out of a file's tokens. `mine` gets the names for
// this file, the queue gets them for loading.
takeUses(lx : Lexed, mine : List[Str], queue : List[Str], queueLines : List[Int]) : Lexed !Mut {
  toks : List[Tok] = []
  lines : List[Int] = []
  depth = 0
  i = 0
  n = lx.toks.length
  while i < n {
    if isPunct(lx, i, "{") {
      depth = depth + 1
    }
    if isPunct(lx, i, "}") {
      depth = depth - 1
    }
    if depth == 0 && isWord(lx, i, "uses") && isStrTok(lx, i + 1) {
      name = strAt(lx, i + 1)
      if modNameOk(name).not {
        failLine(lx, i + 1, "a module name has only letters, digits and _")
      }
      mine.push(name)
      queue.push(name)
      queueLines.push(lx.lines.at(i))
      i = i + 2
    } else {
      toks.push(lx.toks.at(i))
      lines.push(lx.lines.at(i))
      i = i + 1
    }
  }
  Lexed(toks = toks, lines = lines, files = lx.files)
}

// crust.box becomes the one name crust__box, for each module this file uses.
qualify(lx : Lexed, mine : List[Str]) : Lexed !Mut {
  toks : List[Tok] = []
  lines : List[Int] = []
  i = 0
  n = lx.toks.length
  while i < n {
    id = ""
    if isIdent(lx, i) {
      id = identAt(lx, i)
    }
    afterDot = false
    if i > 0 {
      afterDot = isPunct(lx, i - 1, ".")
    }
    if id != "" && afterDot.not && hasName(mine, id) {
      named = false
      if isPunct(lx, i + 1, ".") {
        named = isIdent(lx, i + 2)
      }
      if named.not {
        failLine(lx, i, id.concat(" is a module here: write ").concat(id).concat(".name for something in it, and give a variable another name"))
      }
      toks.push(Ident(id.concat("__").concat(identAt(lx, i + 2))))
      lines.push(lx.lines.at(i))
      i = i + 3
    } else {
      toks.push(lx.toks.at(i))
      lines.push(lx.lines.at(i))
      i = i + 1
    }
  }
  Lexed(toks = toks, lines = lines, files = lx.files)
}

// Reads one module: its tokens, and the names it declares.
makeMod(name : Str, src : Str, files : List[Str], queue : List[Str], queueLines : List[Int]) : Mod !Mut {
  mine : List[Str] = []
  lx = qualify(takeUses(lex(src, files), mine, queue, queueLines), mine)
  p = parse(lx)
  first = spot(files, (files.length - 1) * 1000000 + 1)
  if p.reads.length + p.writes.length + p.runs.length + p.fetches.length + p.mails.length > 0 {
    fail(first.concat("a module has no reads, writes, runs, fetches or mails line; those belong to the program that uses it"))
  }
  names : List[Str] = []
  fields : List[Str] = []
  p.records.each { r in
    names.push(r.name)
    r.fields.each { f in
      fields.push(f)
    }
  }
  p.types.each { t in
    names.push(t.name)
    t.cases.each { c in
      names.push(c.cname)
    }
  }
  p.fns.each { f in
    if f.name == "main" {
      fail(spot(files, f.line).concat("a module has no main; main belongs to the program that uses it"))
    }
    names.push(f.name)
  }
  names.each { nm in
    if hasName(fields, nm) {
      fail(first.concat("in a module, a function or type may not have the name of a field: ").concat(nm))
    }
    if nm == "Str" || nm == "Int" || nm == "Float" || nm == "Bool" || nm == "List" || nm == "Map" {
      fail(first.concat("in a module, nothing may have the name of a built-in type: ").concat(nm))
    }
  }
  Mod(name = name, lx = lx, names = names)
}

// One token list for the parser: each module with its names renamed, then
// the program itself.
joinMods(mods : List[Mod], mainLx : Lexed) : Lexed !Mut {
  toks : List[Tok] = []
  lines : List[Int] = []
  mods.each { m in
    lx = m.lx
    pre = m.name.concat("__")
    i = 0
    n = lx.toks.length - 1
    while i < n {
      id = ""
      if isIdent(lx, i) {
        id = identAt(lx, i)
      }
      afterDot = false
      if i > 0 {
        afterDot = isPunct(lx, i - 1, ".")
      }
      if id != "" && afterDot.not && hasName(m.names, id) {
        toks.push(Ident(pre.concat(id)))
      } else {
        toks.push(lx.toks.at(i))
      }
      lines.push(lx.lines.at(i))
      i = i + 1
    }
  }
  i = 0
  while i < mainLx.toks.length {
    toks.push(mainLx.toks.at(i))
    lines.push(mainLx.lines.at(i))
    i = i + 1
  }
  Lexed(toks = toks, lines = lines, files = mainLx.files)
}

parse(toks : Lexed) : Prog {
  types : List[TyDef] = []
  records : List[RecDef] = []
  fns : List[Fn] = []
  seen : List[Str] = []
  i = 0
  reads : List[Str] = []
  writes : List[Str] = []
  runs : List[Str] = []
  fetches : List[Str] = []
  mails : List[Str] = []
  examples : List[Str] = []
  pieces : List[PieceEx] = []
  limits : List[Str] = []
  while notEof(toks, i) {
    if isMayLine(toks, i) {
      i = parseMay(toks, i, reads, writes, runs, fetches, mails)
    } else if isExampleLine(toks, i) {
      i = parseExample(toks, i, examples)
    } else if isWord(toks, i, "example") {
      // an example for one piece:   example double(4) == 8
      px = parseExpr(toks, i + 1)
      pieces.push(PieceEx(node = px.node, line = lineOf(toks, i)))
      i = px.next
    } else if isLimitsLine(toks, i) {
      i = parseLimits(toks, i, limits)
    } else {
      if isIdent(toks, i) {
        once(seen, identAt(toks, i), toks, i)
      }
      if isTypeDef(toks, i) {
        if isWord(toks, i + 2, "type").not {
          failTok(toks, i + 2, "expected the word type")
        }
        expect(toks, i + 3, "{")
        if isRecordDef(toks, i) {
          pr = parseRecord(toks, i)
          records.push(pr.rec)
          i = pr.next
        } else {
          pt = parseTypeDef(toks, i, seen)
          types.push(pt.ty)
          i = pt.next
        }
      } else {
        if (isIdent(toks, i) && isPunct(toks, i + 1, "(")).not {
          failTok(toks, i, "expected a function or a type")
        }
        pf = parseFn(toks, i)
        fns.push(pf.fn)
        i = pf.next
      }
    }
  }
  Prog(pieces = pieces, types = types, records = records, fns = fns, reads = reads, writes = writes, runs = runs, fetches = fetches, mails = mails, examples = examples, limits = limits, files = toks.files)
}

// --- parse errors: every one names the line and what stood there --------

tokAt(toks : Lexed, i : Int) : Tok {
  r = Eof
  if i < toks.toks.length {
    r = toks.toks.at(i)
  }
  r
}

lineOf(toks : Lexed, i : Int) : Int {
  r = toks.lines.at(toks.lines.length - 1)
  if i < toks.lines.length {
    r = toks.lines.at(i)
  }
  r
}

show(toks : Lexed, i : Int) : Str {
  tokAt(toks, i).match {
    Ident(s) -> s
    Int(v) -> v.toStr
    Float(f) -> f
    Str(s) -> "a text"
    Punct(p) -> showPunct(p)
    Eof -> "the end of the file"
  }
}

showPunct(p : Str) : Str {
  r = p
  if p == "s(" {
    r = "("
  }
  r
}

failLine(toks : Lexed, i : Int, msg : Str) : Int {
  fail(spot(toks.files, lineOf(toks, i)).concat(msg.replace("__", ".")))
}

failTok(toks : Lexed, i : Int, msg : Str) : Int {
  failLine(toks, i, msg.concat(", found ").concat(show(toks, i)))
}

// A name may be given once: adds it to the list, or stops if it is there.
once(seen : List[Str], name : Str, toks : Lexed, i : Int) : Str !Mut {
  if hasName(seen, name) {
    failLine(toks, i, "the name ".concat(name).concat(" is used twice"))
  }
  seen.push(name)
  name
}

// The token at i must be the mark p; gives the place after it.
expect(toks : Lexed, i : Int, p : Str) : Int {
  if isPunct(toks, i, p).not {
    failTok(toks, i, "expected ".concat(p))
  }
  i + 1
}

isKeyword(toks : Lexed, i : Int) : Bool {
  isWord(toks, i, "if") || isWord(toks, i, "else") || isWord(toks, i, "while") || isWord(toks, i, "return") || isWord(toks, i, "for") || isWord(toks, i, "break") || isWord(toks, i, "continue")
}

expectIdent(toks : Lexed, i : Int, what : Str) : Str {
  if isIdent(toks, i).not || isKeyword(toks, i) {
    failTok(toks, i, "expected ".concat(what))
  }
  identAt(toks, i)
}

// After one item of a list: a comma to step over, or the closing mark.
sep(toks : Lexed, j : Int, close : Str) : Int {
  r = j
  if isPunct(toks, j, ",") {
    r = j + 1
  } else {
    if isPunct(toks, j, close).not {
      failTok(toks, j, "expected , or ".concat(close))
    }
  }
  r
}

// `Name` or `Name[Inner]`. A second inner type (`Map[Str, Int]`) is read and dropped.
parseType(toks : Lexed, i : Int) : PType {
  ty = expectIdent(toks, i, "a type")
  k = i + 1
  if isPunct(toks, k, "[") {
    inner = parseType(toks, k + 1)
    ty = ty.concat("[").concat(inner.ty).concat("]")
    k = inner.next
    while isPunct(toks, k, ",") {
      more = parseType(toks, k + 1)
      k = more.next
    }
    k = expect(toks, k, "]")
  }
  if ty == "Map[Int]" {
    ty = "Map"
  }
  // models write String now and then; it is Str
  if ty == "String" {
    ty = "Str"
  }
  PType(ty = ty, next = k)
}

isTypeDef(toks : Lexed, i : Int) : Bool {
  isIdent(toks, i).and(isPunct(toks, i + 1, "="))
}

isRecordDef(toks : Lexed, i : Int) : Bool {
  isPunct(toks, i + 5, ":")
}

parseRecord(toks : Lexed, i : Int) : PRec {
  name = identAt(toks, i)
  fields : List[Str] = []
  ftypes : List[Str] = []
  j = i + 4
  while inBlock(toks, j) {
    once(fields, expectIdent(toks, j, "a field name"), toks, j)
    j = j + 1
    ty = "Int"
    if isPunct(toks, j, ":") {
      pt = parseType(toks, j + 1)
      ty = pt.ty
      j = pt.next
    }
    ftypes.push(ty)
    if isPunct(toks, j, ",") {
      j = j + 1
    }
  }
  PRec(rec = RecDef(name = name, fields = fields, ftypes = ftypes, line = lineOf(toks, i)), next = expect(toks, j, "}"))
}

parseTypeDef(toks : Lexed, i : Int, seen : List[Str]) : PTy !Mut {
  name = identAt(toks, i)
  cases : List[Case] = []
  j = i + 4
  while inBlock(toks, j) {
    cn = once(seen, expectIdent(toks, j, "a case name"), toks, j)
    j = j + 1
    ptypes : List[Str] = []
    if isPunct(toks, j, "(") {
      j = j + 1
      while inArgs(toks, j) {
        pt = parseType(toks, j)
        ptypes.push(pt.ty)
        j = sep(toks, pt.next, ")")
      }
      j = expect(toks, j, ")")
    }
    cases.push(Case(cname = cn, arity = ptypes.length, ptypes = ptypes))
  }
  PTy(ty = TyDef(name = name, cases = cases, line = lineOf(toks, i)), next = expect(toks, j, "}"))
}

parseFn(toks : Lexed, i : Int) : PFn {
  name = identAt(toks, i)
  pp = parseParams(toks, i + 1)
  rt = parseRet(toks, pp.next)
  pb = parseBlock(toks, rt.next)
  PFn(fn = Fn(name = name, params = pp.names, ptypes = pp.types, ret = rt.ret, effs = rt.effs, body = pb.body, line = lineOf(toks, i)), next = pb.next)
}

// `( name : Type , ... )` -> the parameter names and their types.
parseParams(toks : Lexed, i : Int) : PNames {
  names : List[Str] = []
  types : List[Str] = []
  j = i + 1
  while inArgs(toks, j) {
    once(names, expectIdent(toks, j, "a parameter name"), toks, j)
    j = j + 1
    ty = ""
    if isPunct(toks, j, ":") {
      pt = parseType(toks, j + 1)
      ty = pt.ty
      j = pt.next
    }
    types.push(ty)
    j = sep(toks, j, ")")
  }
  PNames(names = names, types = types, next = expect(toks, j, ")"))
}

// An optional `: Type` return annotation, then the declared effects (`!IO`,
// `!Fail`), up to the body.
parseRet(toks : Lexed, j : Int) : PRet {
  ret = "Int"
  effs : List[Str] = []
  k = j
  if isPunct(toks, k, ":") {
    pt = parseType(toks, k + 1)
    ret = pt.ty
    k = pt.next
  }
  while isPunct(toks, k, "!") {
    eff = expectIdent(toks, k + 1, "an effect name")
    if ((eff == "IO") || (eff == "Fail") || (eff == "Mut")).not {
      failLine(toks, k + 1, "no effect named ".concat(eff).concat("; the effects are !IO, !Fail and !Mut"))
    }
    effs.push(eff)
    k = k + 2
  }
  if isPunct(toks, k, ":") {
    failLine(toks, k, "the return type comes before the effects, as in f(x : Int) : Int !IO {")
  }
  PRet(ret = ret, effs = effs, next = k)
}

parseBlock(toks : Lexed, i : Int) : PBody {
  parseStmts(toks, expect(toks, i, "{"))
}

// The statements up to the closing `}`. Each one is led by a Line mark, so a
// later error can name the statement's own line.
parseStmts(toks : Lexed, start : Int) : PBody {
  body : List[Stmt] = []
  j = start
  while inBlock(toks, j) {
    body.push(Line(lineOf(toks, j)))
    p = parseStmt(toks, j)
    if isPunct(toks, p.next, "}").not {
      checkUseful(p.node, toks, j)
    }
    body.push(p.node)
    j = p.next
  }
  PBody(body = body, next = expect(toks, j, "}"))
}

// A value alone on a line does nothing, unless it is the last line of its block.
checkUseful(s : Stmt, toks : Lexed, i : Int) : Int {
  s.match {
    Bare(e) -> checkValueLine(e, toks, i)
    Let(name, ty, e) -> 0
    If(c, t, el) -> 0
    While(c, b) -> 0
    Ret(e) -> 0
    Line(n) -> 0
    Jump(w) -> 0
  }
}

checkValueLine(e : Expr, toks : Lexed, i : Int) : Int {
  if plainValue(e) {
    failLine(toks, i, "this line does nothing; a value alone belongs on the last line of a block")
  }
  0
}

plainValue(e : Expr) : Bool {
  e.match {
    Num(v) -> true
    FloatLit(s) -> true
    Var(s) -> true
    StrLit(s) -> true
    ListLit(es) -> true
    Bin(op, a, b) -> true
    Call(name, args) -> false
    Match(scrut, arms) -> false
    Field(recv, fld) -> false
    Method(recv, name, args) -> false
    Each(recv, param, body) -> false
  }
}

parseStmt(toks : Lexed, i : Int) : PStmt {
  if isWord(toks, i, "if") {
    return parseIf(toks, i)
  }
  if isWord(toks, i, "while") {
    return parseWhile(toks, i)
  }
  if isWord(toks, i, "return") {
    return parseReturn(toks, i)
  }
  if isWord(toks, i, "break") {
    return PStmt(node = Jump("break"), next = i + 1)
  }
  if isWord(toks, i, "continue") {
    return PStmt(node = Jump("continue"), next = i + 1)
  }
  if isWord(toks, i, "for") && isIdent(toks, i + 1) && isWord(toks, i + 2, "in") {
    return parseFor(toks, i)
  }
  if isTypedAssign(toks, i) {
    return parseTypedLet(toks, i)
  }
  if isAssign(toks, i) {
    ae = parseExpr(toks, i + 2)
    return PStmt(node = Let(expectIdent(toks, i, "a name"), "", ae.node), next = ae.next)
  }
  e = parseExpr(toks, i)
  // `p.x = v` sets a field of a record; it travels as the method `=x`
  if isPunct(toks, e.next, "=") && ((fieldName(e.node) == "").not) {
    v = parseExpr(toks, e.next + 1)
    return PStmt(node = Bare(Method(fieldRecv(e.node), "=".concat(fieldName(e.node)), [v.node])), next = v.next)
  }
  PStmt(node = Bare(e.node), next = e.next)
}

fieldName(e : Expr) : Str {
  e.match {
    Field(recv, fld) -> fld
    Var(s) -> ""
    Method(recv, name, args) -> ""
    ListLit(es) -> ""
    Call(name, args) -> ""
    Match(scrut, arms) -> ""
    Bin(op, a, b) -> ""
    Each(recv, param, body) -> ""
    Num(v) -> ""
    FloatLit(s) -> ""
    StrLit(s) -> ""
  }
}

fieldRecv(e : Expr) : Expr {
  e.match {
    Field(recv, fld) -> recv
    Var(s) -> e
    Method(recv, name, args) -> e
    ListLit(es) -> e
    Call(name, args) -> e
    Match(scrut, arms) -> e
    Bin(op, a, b) -> e
    Each(recv, param, body) -> e
    Num(v) -> e
    FloatLit(s) -> e
    StrLit(s) -> e
  }
}

isSetField(name : Str) : Bool {
  name.startsWith("=")
}

// `for x in xs { }` is xs.each { x in }; `for i in a..b { }` counts from a up to
// b - 1, and `a..=b` up to b.
parseFor(toks : Lexed, i : Int) : PStmt {
  param = expectIdent(toks, i + 1, "a name for each item")
  lo = parseAdd(toks, i + 3)
  recv = lo.node
  k = lo.next
  if isPunct(toks, k, "..") {
    k = k + 1
    more = 0
    if isPunct(toks, k, "=") {
      more = 1
      k = k + 1
    }
    hi = parseAdd(toks, k)
    recv = Call("l_range", [lo.node, Bin("+", hi.node, Num(more))])
    k = hi.next
  }
  k = expect(toks, k, "{")
  b = parseStmts(toks, k)
  PStmt(node = Bare(Each(recv, param, b.body)), next = b.next)
}

// A bare `return` just before `}` leaves a function that has no value.
parseReturn(toks : Lexed, i : Int) : PStmt {
  if isPunct(toks, i + 1, "}") {
    return PStmt(node = Ret(Num(0)), next = i + 1)
  }
  re = parseExpr(toks, i + 1)
  PStmt(node = Ret(re.node), next = re.next)
}

// `name : Type = expr`. The annotation is the binding's declared type; it
// matters for an empty collection (`xs : List[Str] = []`), whose value
// carries no element type to infer.
isTypedAssign(toks : Lexed, i : Int) : Bool {
  isIdent(toks, i).and(isPunct(toks, i + 1, ":"))
}

parseTypedLet(toks : Lexed, i : Int) : PStmt {
  name = expectIdent(toks, i, "a name")
  pt = parseType(toks, i + 2)
  ae = parseExpr(toks, expect(toks, pt.next, "="))
  PStmt(node = Let(name, pt.ty, ae.node), next = ae.next)
}

// `else if` is an else block that holds one if.
parseIf(toks : Lexed, i : Int) : PStmt {
  c = parseExpr(toks, i + 1)
  tb = parseBlock(toks, c.next)
  els : List[Stmt] = []
  nxt = tb.next
  if isWord(toks, tb.next, "else") {
    if isWord(toks, tb.next + 1, "if") {
      inner = parseIf(toks, tb.next + 1)
      els.push(inner.node)
      nxt = inner.next
    } else {
      eb = parseBlock(toks, tb.next + 1)
      els = eb.body
      nxt = eb.next
    }
  }
  PStmt(node = If(c.node, tb.body, els), next = nxt)
}

// A loop that never ends and never waits keeps the processor busy for nothing:
// while true { } with no break, no return, no call of a function and nothing
// that waits. Such a loop is refused.
spins(toks : Lexed, from : Int, to : Int) : Bool {
  r = true
  k = from
  while k < to {
    if isIdent(toks, k) {
      w = identAt(toks, k)
      if w == "break" || w == "return" || w == "stdinLine" || w == "stdin" || w == "wait" || w == "sleep" || w == "key" || w == "run" || w == "feed" || w == "status" || w == "try" || w == "fetch" || w == "fetchWith" || w == "post" || w == "reach" || w == "send" {
        r = false
      }
      if isPunct(toks, k + 1, "(") && isPunct(toks, k - 1, ".").not {
        r = false
      }
    }
    k = k + 1
  }
  r
}

parseWhile(toks : Lexed, i : Int) : PStmt {
  c = parseExpr(toks, i + 1)
  b = parseBlock(toks, c.next)
  if isWord(toks, i + 1, "true") && c.next == i + 2 && spins(toks, c.next, b.next) {
    failLine(toks, i, "this loop never ends and never waits, so it would keep the processor busy; wait in it with sys.stdinLine, sys.files.wait(path) or sys.clock.sleep(ms), or leave it with break")
  }
  PStmt(node = While(c.node, b.body), next = b.next)
}

parseExpr(toks : Lexed, pos : Int) : Parsed {
  p = parseAnd(toks, pos)
  node = p.node
  i = p.next
  while isPunct(toks, i, "||") {
    r = parseAnd(toks, i + 1)
    node = Bin("||", node, r.node)
    i = r.next
  }
  Parsed(node = node, next = i)
}

parseAnd(toks : Lexed, pos : Int) : Parsed {
  p = parseCmp(toks, pos)
  node = p.node
  i = p.next
  while isPunct(toks, i, "&&") {
    r = parseCmp(toks, i + 1)
    node = Bin("&&", node, r.node)
    i = r.next
  }
  Parsed(node = node, next = i)
}

parseCmp(toks : Lexed, pos : Int) : Parsed {
  p = parseAdd(toks, pos)
  node = p.node
  i = p.next
  while isCmpOp(toks, i) {
    op = punctAt(toks, i)
    r = parseAdd(toks, i + 1)
    if op == "!=" {
      node = Field(Bin("==", node, r.node), "not")
    } else {
      node = Bin(op, node, r.node)
    }
    i = r.next
  }
  Parsed(node = node, next = i)
}

parseAdd(toks : Lexed, pos : Int) : Parsed {
  p = parseTerm(toks, pos)
  node = p.node
  i = p.next
  while isAddOp(toks, i) {
    op = punctAt(toks, i)
    r = parseTerm(toks, i + 1)
    node = Bin(op, node, r.node)
    i = r.next
  }
  Parsed(node = node, next = i)
}

parseTerm(toks : Lexed, pos : Int) : Parsed {
  p = parsePostfix(toks, pos)
  node = p.node
  i = p.next
  while isMulOp(toks, i) {
    op = punctAt(toks, i)
    r = parsePostfix(toks, i + 1)
    node = Bin(op, node, r.node)
    i = r.next
  }
  Parsed(node = node, next = i)
}

// A factor, then a chain of `.match { ... }`, `.method(args)`, or `.field`.
parsePostfix(toks : Lexed, pos : Int) : Parsed {
  p = parseFactor(toks, pos)
  node = p.node
  i = p.next
  if isPunct(toks, i, "?") {
    i = i + 1
  }
  while isPunct(toks, i, ".") {
    if isWord(toks, i + 1, "match") {
      pm = parseMatch(toks, node, i)
      node = pm.node
      i = pm.next
    } else {
      if isWord(toks, i + 1, "each") {
        pe = parseEach(toks, node, i)
        node = pe.node
        i = pe.next
      } else {
        name = expectIdent(toks, i + 1, "a name after the dot")
        if isPunct(toks, i + 2, "(") {
          pa = parseArgs(toks, i + 2)
          node = Method(node, name, pa.list)
          i = pa.next
        } else {
          node = Field(node, name)
          i = i + 2
        }
      }
    }
    if isPunct(toks, i, "?") {
      i = i + 1
    }
  }
  Parsed(node = node, next = i)
}

// `recv.each { param in stmt* }`.
parseEach(toks : Lexed, recv : Expr, i : Int) : Parsed {
  expect(toks, i + 2, "{")
  param = expectIdent(toks, i + 3, "a name for each item")
  if isWord(toks, i + 4, "in").not {
    failTok(toks, i + 4, "expected the word in")
  }
  b = parseStmts(toks, i + 5)
  Parsed(node = Each(recv, param, b.body), next = b.next)
}

parseFactor(toks : Lexed, pos : Int) : Parsed {
  tokAt(toks, pos).match {
    Int(v) -> Parsed(node = Num(v), next = pos + 1)
    Float(s) -> Parsed(node = FloatLit(s), next = pos + 1)
    Str(s) -> Parsed(node = StrLit(s), next = pos + 1)
    Ident(s) -> parseIdentFactor(toks, pos)
    Punct(p) -> parsePunctFactor(toks, pos)
    Eof -> Parsed(node = Num(failTok(toks, pos, "expected a value")), next = pos)
  }
}

parsePunctFactor(toks : Lexed, pos : Int) : Parsed {
  if isPunct(toks, pos, "(") || isPunct(toks, pos, "s(") {
    return parseParen(toks, pos)
  }
  if isPunct(toks, pos, "[") {
    return parseList(toks, pos)
  }
  // prefix `!`: the same as .not on the value after it
  if isPunct(toks, pos, "!") {
    g = parsePostfix(toks, pos + 1)
    return Parsed(node = Field(g.node, "not"), next = g.next)
  }
  // prefix `-`: negate the following factor (`Bin("u-", ...)` carries it)
  if isPunct(toks, pos, "-").not {
    failTok(toks, pos, "expected a value")
  }
  // -x.n and -xs.at(0) negate the whole value; -5.toStr is the number -5
  if isIdent(toks, pos + 1) || isPunct(toks, pos + 1, "(") {
    g = parsePostfix(toks, pos + 1)
    return Parsed(node = Bin("u-", Num(0), g.node), next = g.next)
  }
  f = parseFactor(toks, pos + 1)
  Parsed(node = Bin("u-", Num(0), f.node), next = f.next)
}

// `[ expr , ... ]` -> a list literal.
parseList(toks : Lexed, pos : Int) : Parsed {
  elems : List[Expr] = []
  j = pos + 1
  while isPunct(toks, j, "]").not.and(notEof(toks, j)) {
    e = parseExpr(toks, j)
    elems.push(e.node)
    j = sep(toks, e.next, "]")
  }
  Parsed(node = ListLit(elems), next = expect(toks, j, "]"))
}

parseIdentFactor(toks : Lexed, pos : Int) : Parsed {
  name = expectIdent(toks, pos, "a value")
  // `Map[Str]()` is a new map with its type said
  if (name == "Map") && isPunct(toks, pos + 1, "[") {
    pt = parseType(toks, pos)
    if isPunct(toks, pt.next, "(") && isPunct(toks, pt.next + 1, ")") {
      return Parsed(node = Call(pt.ty, []), next = pt.next + 2)
    }
  }
  r = Parsed(node = Var(name), next = pos + 1)
  if isPunct(toks, pos + 1, "(") {
    pa = parseArgs(toks, pos + 1)
    r = Parsed(node = Call(name, pa.list), next = pa.next)
  }
  r
}

parseParen(toks : Lexed, pos : Int) : Parsed {
  inner = parseExpr(toks, pos + 1)
  Parsed(node = inner.node, next = expect(toks, inner.next, ")"))
}

parseArgs(toks : Lexed, i : Int) : PArgs {
  list : List[Expr] = []
  j = i + 1
  while inArgs(toks, j) {
    if isAssign(toks, j) {
      j = j + 2
    }
    e = parseExpr(toks, j)
    list.push(e.node)
    j = sep(toks, e.next, ")")
  }
  PArgs(list = list, next = expect(toks, j, ")"))
}

parseMatch(toks : Lexed, scrut : Expr, i : Int) : Parsed {
  arms : List[Arm] = []
  j = expect(toks, i + 2, "{")
  while inBlock(toks, j) {
    pa = parseArm(toks, j)
    arms.push(pa.arm)
    j = pa.next
  }
  Parsed(node = Match(scrut, arms), next = expect(toks, j, "}"))
}

parseArm(toks : Lexed, j : Int) : PArm {
  tag = expectIdent(toks, j, "a case name")
  binds : List[Str] = []
  k = j + 1
  if isPunct(toks, k, "(") {
    k = k + 1
    while inArgs(toks, k) {
      binds.push(expectIdent(toks, k, "a name"))
      k = sep(toks, k + 1, ")")
    }
    k = expect(toks, k, ")")
  }
  k = expect(toks, k, "->")
  if isPunct(toks, k, "{") {
    failLine(toks, k, "match case ".concat(tag).concat(": an arm is one expression, not a { } block; call a function for more"))
  }
  ae = parseExpr(toks, k)
  PArm(arm = Arm(tag = tag, binds = binds, body = ae.node), next = ae.next)
}

// --- emit: types and records --------------------------------------------

emitType(t : TyDef) : Str {
  r = emitEnumType(t)
  if hasPayload(t) {
    r = emitBoxedType(t)
  }
  r
}

emitEnumType(t : TyDef) : Str {
  out = "enum {"
  k = 0
  m = t.cases.length
  while k < m {
    if k > 0 {
      out = out.concat(",")
    }
    out = out.concat(" ").concat(t.cases.at(k).cname)
    k = k + 1
  }
  out.concat(" };")
}

emitBoxedType(t : TyDef) : Str {
  out = "enum {"
  k = 0
  m = t.cases.length
  while k < m {
    if k > 0 {
      out = out.concat(",")
    }
    out = out.concat(" T_").concat(t.cases.at(k).cname)
    k = k + 1
  }
  out = out.concat(" };")
  k = 0
  while k < m {
    cn = t.cases.at(k).cname
    ar = t.cases.at(k).arity
    if ar > 8 {
      fail("the case ".concat(cn).concat(" holds ").concat(ar.toStr).concat(" values; a case holds at most 8, so put them in a record"))
    }
    mkName = "mk"
    if ar > 3 {
      mkName = "mk8"
    }
    out = out.concat("\nlong ").concat(cn).concat("(").concat(ctorParams(ar)).concat(") { return ").concat(mkName).concat("(T_").concat(cn).concat(", ").concat(ctorArgs(ar)).concat("); }")
    k = k + 1
  }
  out
}

hasPayload(t : TyDef) : Bool {
  has = false
  k = 0
  m = t.cases.length
  while k < m {
    if t.cases.at(k).arity > 0 {
      has = true
    }
    k = k + 1
  }
  has
}

emitRecord(rec : RecDef) : Str {
  out = "typedef struct {"
  k = 0
  m = rec.fields.length
  while k < m {
    out = out.concat(" long ").concat(rec.fields.at(k)).concat(";")
    k = k + 1
  }
  out = out.concat(" } ").concat("R_").concat(rec.name).concat(";")
  out = out.concat("\nlong ").concat(rec.name).concat("(").concat(recParams(rec)).concat(") { R_").concat(rec.name).concat("* _o = malloc(sizeof(R_").concat(rec.name).concat("));")
  k = 0
  while k < m {
    fn = rec.fields.at(k)
    out = out.concat(" _o->").concat(fn).concat(" = ").concat(fn).concat(";")
    k = k + 1
  }
  out.concat(" return (long)(intptr_t)_o; }")
}

recParams(rec : RecDef) : Str {
  out = ""
  k = 0
  m = rec.fields.length
  while k < m {
    if k > 0 {
      out = out.concat(", ")
    }
    out = out.concat("long ").concat(rec.fields.at(k))
    k = k + 1
  }
  out
}

slotName(bi : Int) : Str {
  "v".concat(bi.toStr)
}

ctorParams(arity : Int) : Str {
  out = ""
  k = 0
  while k < arity {
    if k > 0 {
      out = out.concat(", ")
    }
    out = out.concat("long ").concat(slotName(k))
    k = k + 1
  }
  out
}

ctorArgs(arity : Int) : Str {
  out = ""
  k = 0
  top = 3
  if arity > 3 {
    top = 8
  }
  while k < top {
    if k > 0 {
      out = out.concat(", ")
    }
    slot = "0"
    if k < arity {
      slot = slotName(k)
    }
    out = out.concat(slot)
    k = k + 1
  }
  out
}

// --- emit: functions ----------------------------------------------------

// A user function's C name is prefixed, so it cannot collide with a C library
// symbol (the agent's `modf` clashed with libm's `modf`). main keeps its name;
// runtime helpers, Map, fail, and record/variant constructors are not user
// functions (not in fnNames) and so are left alone.
mangle(name : Str) : Str {
  "u_".concat(name)
}

emitProto(f : Fn) : Str {
  "long ".concat(mangle(f.name)).concat("(").concat(paramDecls(f)).concat(");")
}

emitFn(f : Fn, sigs : Sigs) : Str !Mut {
  rt = "long"
  sig = paramDecls(f)
  if isMain(f.name) {
    rt = "int"
    sig = "int argc, char** argv"
  }
  nm = f.name
  if isMain(f.name).not {
    nm = mangle(f.name)
  }
  out = rt.concat(" ").concat(nm).concat("(").concat(sig).concat(") {")
  if isMain(f.name) {
    out = out.concat("\n  simpler_argc = argc; simpler_argv = argv; simpler_self_init(); simpler_dry = getenv(\"SIMPLER_DRY\") != 0; simpler_examples(); simpler_replay(); argc = simpler_argc; argv = simpler_argv; simpler_limits(); simpler_jinit(); simpler_undo(); simpler_rinit(); tzset(); simpler_lock();")
  }
  ctx = fnCtx(f, sigs)
  checkReturn(f, ctx)
  checkEffects(f, ctx)
  decls = collectLets(f.body)
  d = 0
  dn = decls.length
  while d < dn {
    if hasName(f.params, decls.at(d)).not {
      out = out.concat("\n  long ").concat(decls.at(d)).concat(" = 0;")
    }
    d = d + 1
  }
  k = 0
  m = f.body.length
  while k < m {
    last = (k + 1 == m).and(isMain(f.name).not)
    out = out.concat("\n").concat(emitStmt(f.body.at(k), last, ctx))
    k = k + 1
  }
  out.concat("\n  return 0;\n}")
}

// A function's names and their types, before any of it is emitted.
fnCtx(f : Fn, sigs : Sigs) : Ctx !Mut {
  env = newEnv()
  pk = 0
  pn = f.params.length
  while pk < pn {
    envPut(env, f.params.at(pk), f.ptypes.at(pk))
    pk = pk + 1
  }
  ctx = Ctx(env = env, sigs = sigs)
  envPut(env, "__line__", f.line.toStr)
  if isMain(f.name) {
    envPut(env, "__ret__", "__main__")
    if f.params.length > 0 {
      envPut(env, f.params.at(0), "Sys")
    }
  } else {
    if hasName(f.ptypes, "Sys") {
      failAt("only main holds the world; hand down sys.screen or sys.files", ctx)
    }
    envPut(env, "__ret__", f.ret)
  }
  seedEnv(f.body, ctx)
  setLine(f.line, ctx)
  ctx
}

paramDecls(f : Fn) : Str {
  out = ""
  k = 0
  m = f.params.length
  while k < m {
    if k > 0 {
      out = out.concat(", ")
    }
    out = out.concat("long ").concat(f.params.at(k))
    k = k + 1
  }
  out
}

// --- the type context ---------------------------------------------------

newEnv() : TyEnv {
  ns : List[Str] = []
  ts : List[Str] = []
  TyEnv(names = ns, tys = ts)
}

envPut(env : TyEnv, name : Str, ty : Str) : Int !Mut {
  env.names.push(name)
  env.tys.push(ty)
  0
}

// A name lives only inside its match arm or each loop. Before it is bound,
// envOld keeps what the name was; envPut of that value afterwards ends it.
envOld(env : TyEnv, name : Str) : Str {
  r = "__gone__"
  if hasName(env.names, name) {
    r = envGet(env, name)
  }
  r
}

envOlds(env : TyEnv, names : List[Str]) : List[Str] {
  olds : List[Str] = []
  names.each { n in
    olds.push(envOld(env, n))
  }
  olds
}

envRestore(env : TyEnv, names : List[Str], olds : List[Str]) : Int !Mut {
  k = 0
  while k < names.length {
    envPut(env, names.at(k), olds.at(k))
    k = k + 1
  }
  0
}

envGet(env : TyEnv, name : Str) : Str {
  r = "Int"
  k = 0
  m = env.names.length
  while k < m {
    if env.names.at(k) == name {
      r = env.tys.at(k)
    }
    k = k + 1
  }
  r
}

// Before emitting a function, record the type of every binding it makes,
// including those nested in if/while bodies and the parameter of an each
// loop, so field access and method dispatch resolve everywhere.
seedEnv(body : List[Stmt], ctx : Ctx) : Int !Mut {
  k = 0
  m = body.length
  while k < m {
    s = body.at(k)
    if envOld(ctx.env, "__anyren__") != "__gone__" {
      s = renTop(s, ctx)
      body.set(k, s)
    }
    nn = shadowName(s, ctx)
    if nn != "" {
      s = reLet(s, nn)
      body.set(k, s)
    }
    seedStmt(s, ctx)
    k = k + 1
  }
  0
}

// --- a name bound again with another type ---------------------------------
// `c = "x"` and later `c = 5` makes a second variable, c__2, that stands for
// c from there to the end of its block. Each variable so keeps one type, and
// a read after the block gets the first c with its own value. The statements
// are rewritten in place the first time a function is seeded.
shadowName(s : Stmt, ctx : Ctx) : Str !Mut {
  s.match {
    Let(name, ty, e) -> shadowLet(name, letType(ty, e, ctx), ctx)
    Bare(e) -> ""
    If(c, t, el) -> ""
    While(c, b) -> ""
    Ret(e) -> ""
    Line(n) -> ""
    Jump(w) -> ""
  }
}

shadowLet(name : Str, ty : Str, ctx : Ctx) : Str !Mut {
  old = envOld(ctx.env, name)
  if (old == "__gone__") || (ty == "List") {
    return ""
  }
  if compatible(old, ty, ctx) {
    return ""
  }
  src = envOld(ctx.env, "__src__".concat(name))
  if src == "__gone__" {
    src = name
  }
  n = 2
  fresh = src.concat("__").concat(n.toStr)
  while hasName(ctx.env.names, fresh) || hasName(ctx.env.names, "__src__".concat(fresh)) {
    n = n + 1
    fresh = src.concat("__").concat(n.toStr)
  }
  envPut(ctx.env, "__src__".concat(fresh), src)
  envPut(ctx.env, "__ren__".concat(src), fresh)
  envPut(ctx.env, "__ren__".concat(name), fresh)
  envPut(ctx.env, "__anyren__", "1")
  fresh
}

reLet(s : Stmt, nn : Str) : Stmt {
  s.match {
    Let(name, ty, e) -> Let(nn, ty, e)
    Bare(e) -> s
    If(c, t, el) -> s
    While(c, b) -> s
    Ret(e) -> s
    Line(n) -> s
    Jump(w) -> s
  }
}

renOf(name : Str, ctx : Ctx) : Str {
  r = name
  go = true
  while go {
    nx = envOld(ctx.env, "__ren__".concat(r))
    if (nx == "__gone__") || (nx == "") || (nx == r) {
      go = false
    } else {
      r = nx
    }
  }
  r
}

// Inside an each loop or a match arm the name it binds is its own again.
renMask(names : List[Str], ctx : Ctx) : List[Str] !Mut {
  olds : List[Str] = []
  names.each { n in
    o = envOld(ctx.env, "__ren__".concat(n))
    if o == "__gone__" {
      o = ""
    }
    olds.push(o)
    envPut(ctx.env, "__ren__".concat(n), "")
  }
  olds
}

renUnmask(names : List[Str], olds : List[Str], ctx : Ctx) : Int !Mut {
  k = 0
  while k < names.length {
    envPut(ctx.env, "__ren__".concat(names.at(k)), olds.at(k))
    k = k + 1
  }
  0
}

// The statement itself; the bodies of an if or while stay the same lists,
// since seedEnv walks into them next and rewrites them in place.
renTop(s : Stmt, ctx : Ctx) : Stmt !Mut {
  s.match {
    Let(name, ty, e) -> Let(renOf(name, ctx), ty, renExpr(e, ctx))
    Bare(e) -> Bare(renExpr(e, ctx))
    If(c, t, el) -> If(renExpr(c, ctx), t, el)
    While(c, b) -> While(renExpr(c, ctx), b)
    Ret(e) -> Ret(renExpr(e, ctx))
    Line(n) -> s
    Jump(w) -> s
  }
}

renDeep(s : Stmt, ctx : Ctx) : Stmt !Mut {
  s.match {
    Let(name, ty, e) -> Let(renOf(name, ctx), ty, renExpr(e, ctx))
    Bare(e) -> Bare(renExpr(e, ctx))
    If(c, t, el) -> If(renExpr(c, ctx), renBody(t, ctx), renBody(el, ctx))
    While(c, b) -> While(renExpr(c, ctx), renBody(b, ctx))
    Ret(e) -> Ret(renExpr(e, ctx))
    Line(n) -> s
    Jump(w) -> s
  }
}

renBody(body : List[Stmt], ctx : Ctx) : List[Stmt] !Mut {
  out : List[Stmt] = []
  body.each { s in
    out.push(renDeep(s, ctx))
  }
  out
}

renList(es : List[Expr], ctx : Ctx) : List[Expr] !Mut {
  out : List[Expr] = []
  es.each { e in
    out.push(renExpr(e, ctx))
  }
  out
}

renEach(recv : Expr, param : Str, body : List[Stmt], ctx : Ctx) : Expr !Mut {
  r = renExpr(recv, ctx)
  olds = renMask([param], ctx)
  b = renBody(body, ctx)
  renUnmask([param], olds, ctx)
  Each(r, param, b)
}

renArms(arms : List[Arm], ctx : Ctx) : List[Arm] !Mut {
  out : List[Arm] = []
  arms.each { a in
    olds = renMask(a.binds, ctx)
    out.push(Arm(tag = a.tag, binds = a.binds, body = renExpr(a.body, ctx)))
    renUnmask(a.binds, olds, ctx)
  }
  out
}

renExpr(e : Expr, ctx : Ctx) : Expr !Mut {
  e.match {
    Num(v) -> e
    FloatLit(s) -> e
    Var(s) -> Var(renOf(s, ctx))
    StrLit(s) -> e
    ListLit(es) -> ListLit(renList(es, ctx))
    Bin(op, a, b) -> Bin(op, renExpr(a, ctx), renExpr(b, ctx))
    Call(name, args) -> Call(name, renList(args, ctx))
    Match(scrut, arms) -> Match(renExpr(scrut, ctx), renArms(arms, ctx))
    Field(recv, fld) -> Field(renExpr(recv, ctx), fld)
    Method(recv, name, args) -> Method(renExpr(recv, ctx), name, renList(args, ctx))
    Each(recv, param, body) -> renEach(recv, param, body, ctx)
  }
}

// A block: what it renamed ends with it.
seedBlock(body : List[Stmt], ctx : Ctx) : Int !Mut {
  n0 = ctx.env.names.length
  seedEnv(body, ctx)
  if envOld(ctx.env, "__anyren__") != "__gone__" {
    n1 = ctx.env.names.length
    j = n0
    while j < n1 {
      key = ctx.env.names.at(j)
      if key.startsWith("__ren__") {
        was = ""
        i = 0
        while i < n0 {
          if ctx.env.names.at(i) == key {
            was = ctx.env.tys.at(i)
          }
          i = i + 1
        }
        envPut(ctx.env, key, was)
      }
      j = j + 1
    }
  }
  0
}

seedStmt(s : Stmt, ctx : Ctx) : Int !Mut {
  s.match {
    Let(name, ty, e) -> seedLet(name, letType(ty, e, ctx), ctx)
    Bare(e) -> seedExpr(e, ctx)
    If(c, t, el) -> seedIf(t, el, ctx)
    While(c, b) -> seedBlock(b, ctx)
    Ret(e) -> seedExpr(e, ctx)
    Line(n) -> setLine(n, ctx)
    Jump(w) -> 0
  }
}

// A name keeps one type through a function. Binding it again with another
// type is refused here, since every later use would be read with the wrong one.
seedLet(name : Str, ty0 : Str, ctx : Ctx) : Int !Mut {
  ty = ty0
  // `xs = []` on a list that already has a type empties it
  if (ty0 == "List") && envOld(ctx.env, name).startsWith("List[") {
    ty = envOld(ctx.env, name)
  }
  if ty == "List" {
    failAt("an empty [] needs a type, as in ".concat(name).concat(" : List[Int] = []"), ctx)
  }
  old = envOld(ctx.env, name)
  if (old == "__gone__").not {
    if compatible(old, ty, ctx).not {
      failAt(name.concat(" is ").concat(old).concat(" and cannot become ").concat(ty).concat("; use a new name"), ctx)
    }
  }
  envPut(ctx.env, name, ty)
}

seedIf(t : List[Stmt], el : List[Stmt], ctx : Ctx) : Int !Mut {
  seedBlock(t, ctx)
  seedBlock(el, ctx)
  0
}

seedExpr(e : Expr, ctx : Ctx) : Int !Mut {
  e.match {
    Each(recv, param, body) -> seedEach(recv, param, body, ctx)
    Num(v) -> 0
    FloatLit(s) -> 0
    Var(s) -> 0
    StrLit(s) -> 0
    ListLit(es) -> 0
    Bin(op, a, b) -> 0
    Call(name, args) -> 0
    Match(scrut, arms) -> 0
    Field(recv, fld) -> 0
    Method(recv, name, args) -> 0
  }
}

seedEach(recv : Expr, param : Str, body : List[Stmt], ctx : Ctx) : Int !Mut {
  old = envOld(ctx.env, param)
  envPut(ctx.env, param, loopItem(exprType(recv, ctx)))
  olds = renMask([param], ctx)
  seedBlock(body, ctx)
  renUnmask([param], olds, ctx)
  envPut(ctx.env, param, old)
  0
}

inferType(e : Expr, ctx : Ctx) : Str !Mut {
  exprType(e, ctx)
}

// A binding's type: its declared annotation when it has one, otherwise
// inferred from the value. The annotation wins because an empty collection
// has no element type to infer from its value.
letType(ty : Str, e : Expr, ctx : Ctx) : Str !Mut {
  r = inferType(e, ctx)
  if typeKnown(ty, ctx.sigs).not {
    failAt(noType(ty), ctx)
  }
  if (ty == "").not {
    r = ty
  }
  r
}

// The type a call produces: a record constructor yields its record, a variant
// constructor yields its variant, a function yields its declared return type.
callRet(name : Str, ctx : Ctx) : Str {
  r = "Int"
  if name == "Map" {
    r = "Map"
  }
  if isMapType(name) {
    r = name
  }
  if name == "l_range" {
    r = "List[Int]"
  }
  if hasName(ctx.sigs.recNames, name) {
    r = name
  }
  vt = variantOf(name, ctx)
  if (vt == "").not {
    r = vt
  }
  k = 0
  m = ctx.sigs.fnNames.length
  while k < m {
    if ctx.sigs.fnNames.at(k) == name {
      r = ctx.sigs.fnRets.at(k)
    }
    k = k + 1
  }
  r
}

// The variant type that has a case named `name`, or "" if none.
variantOf(name : Str, ctx : Ctx) : Str {
  r = ""
  types = ctx.sigs.types
  k = 0
  m = types.length
  while k < m {
    t = types.at(k)
    if hasCase(t, name) {
      r = t.name
    }
    k = k + 1
  }
  r
}

hasCase(t : TyDef, name : Str) : Bool {
  found = false
  k = 0
  m = t.cases.length
  while k < m {
    if t.cases.at(k).cname == name {
      found = true
    }
    k = k + 1
  }
  found
}

isRec(ty : Str, ctx : Ctx) : Bool {
  hasName(ctx.sigs.recNames, ty)
}

// --- hoisting -----------------------------------------------------------

collectLets(body : List[Stmt]) : List[Str] {
  names : List[Str] = []
  collectBody(body, names)
  names
}

collectBody(body : List[Stmt], names : List[Str]) : Int !Mut {
  k = 0
  m = body.length
  while k < m {
    collectStmt(body.at(k), names)
    k = k + 1
  }
  0
}

collectStmt(s : Stmt, names : List[Str]) : Int !Mut {
  s.match {
    Let(name, ty, e) -> pushUnique(names, name)
    Bare(e) -> collectExpr(e, names)
    If(c, t, el) -> collectIf(t, el, names)
    While(c, b) -> collectBody(b, names)
    Ret(e) -> collectExpr(e, names)
    Line(n) -> 0
    Jump(w) -> 0
  }
}

// A bare `.each { x in ... }` carries its own block; its bindings are real
// locals and must be hoisted too. Other expressions hold no statements.
collectExpr(e : Expr, names : List[Str]) : Int !Mut {
  e.match {
    Each(recv, param, body) -> collectBody(body, names)
    Num(v) -> 0
    FloatLit(s) -> 0
    Var(s) -> 0
    StrLit(s) -> 0
    ListLit(es) -> 0
    Bin(op, a, b) -> 0
    Call(name, args) -> 0
    Match(scrut, arms) -> 0
    Field(recv, fld) -> 0
    Method(recv, name, args) -> 0
  }
}

collectIf(t : List[Stmt], el : List[Stmt], names : List[Str]) : Int !Mut {
  collectBody(t, names)
  collectBody(el, names)
  0
}

pushUnique(names : List[Str], name : Str) : Int !Mut {
  if hasName(names, name).not {
    names.push(name)
  }
  0
}

hasName(names : List[Str], name : Str) : Bool {
  found = false
  k = 0
  m = names.length
  while k < m {
    if names.at(k) == name {
      found = true
    }
    k = k + 1
  }
  found
}

// --- emit: statements ---------------------------------------------------

emitStmt(s : Stmt, asReturn : Bool, ctx : Ctx) : Str !Mut {
  s.match {
    Let(name, ty, e) -> "  ".concat(name).concat(" = ").concat(emitExpr(e, ctx)).concat(";")
    Bare(e) -> emitBare(e, asReturn, ctx)
    If(c, t, el) -> emitIf(c, t, el, asReturn, ctx)
    While(c, b) -> emitWhile(c, b, ctx)
    Ret(e) -> emitRet(e, ctx)
    Line(n) -> emitLine(n, ctx)
    Jump(w) -> "  ".concat(w).concat(";")
  }
}

// `return e` leaves the function at once. Its type is checked against the
// declared return type, which emitFn keeps in the env as `__ret__`.
emitRet(e : Expr, ctx : Ctx) : Str !Mut {
  ret = envGet(ctx.env, "__ret__")
  if (ret == "__main__").not {
    checkRetExpr(e, ret, ctx)
  }
  emitReturn(e, ctx)
}

emitIf(c : Expr, t : List[Stmt], el : List[Stmt], asReturn : Bool, ctx : Ctx) : Str !Mut {
  // the condition is written first, in a statement of its own, so that an
  // error in it names its own line and not a line of the block
  cc = emitExpr(c, ctx)
  out = "  if (".concat(cc).concat(") {").concat(emitBlock(t, asReturn, ctx)).concat("\n  }")
  if el.length > 0 {
    out = out.concat(" else {").concat(emitBlock(el, asReturn, ctx)).concat("\n  }")
  }
  out
}

emitWhile(c : Expr, b : List[Stmt], ctx : Ctx) : Str !Mut {
  cc = emitExpr(c, ctx)
  "  while (".concat(cc).concat(") {").concat(emitBlock(b, false, ctx)).concat("\n  }")
}

// With asReturn the block's last statement gives the function's value.
emitBlock(body : List[Stmt], asReturn : Bool, ctx : Ctx) : Str !Mut {
  out = ""
  k = 0
  m = body.length
  while k < m {
    out = out.concat("\n").concat(emitStmt(body.at(k), asReturn && (k + 1 == m), ctx))
    k = k + 1
  }
  out
}

emitBare(e : Expr, asReturn : Bool, ctx : Ctx) : Str !Mut {
  r = stmtExpr(e, ctx)
  if asReturn && stmtOnly(e).not {
    r = emitReturn(e, ctx)
  }
  r
}

// A print or an `.each` loop has no value. As the last line of a function it
// must still run; the function then returns 0 (emitFn adds that).
stmtOnly(e : Expr) : Bool {
  e.match {
    Each(recv, param, body) -> true
    Method(recv, name, args) -> name == "print"
    Match(scrut, arms) -> false
    Num(v) -> false
    FloatLit(s) -> false
    Var(s) -> false
    StrLit(s) -> false
    ListLit(es) -> false
    Bin(op, a, b) -> false
    Call(name, args) -> false
    Field(recv, fld) -> false
  }
}

// A bare statement: an `each` loop, a `print`, or a plain expression.
stmtExpr(e : Expr, ctx : Ctx) : Str !Mut {
  e.match {
    Each(recv, param, body) -> emitEach(recv, param, body, ctx)
    Call(name, args) -> emitCallStmt(name, args, e, ctx)
    Num(v) -> exprStmt(e, ctx)
    FloatLit(s) -> exprStmt(e, ctx)
    Var(s) -> exprStmt(e, ctx)
    StrLit(s) -> exprStmt(e, ctx)
    ListLit(es) -> exprStmt(e, ctx)
    Bin(op, a, b) -> exprStmt(e, ctx)
    Match(scrut, arms) -> exprStmt(e, ctx)
    Field(recv, fld) -> exprStmt(e, ctx)
    Method(recv, name, args) -> emitMethodStmt(name, args, e, ctx)
  }
}

exprStmt(e : Expr, ctx : Ctx) : Str !Mut {
  "  ".concat(emitExpr(e, ctx)).concat(";")
}

// `print(x)` chooses its format from the argument type; any other call is
// just a C statement.
emitCallStmt(name : Str, args : List[Expr], e : Expr, ctx : Ctx) : Str !Mut {
  r = "  ".concat(emitExpr(e, ctx)).concat(";")
  if name == "print" && args.length == 1 {
    r = "  ".concat(emitPrint(args.at(0), ctx)).concat(";")
  }
  r
}

// `sys.screen.print(x)` is a capability call: the receiver path is erased,
// only the print at the end matters.
emitMethodStmt(name : Str, args : List[Expr], e : Expr, ctx : Ctx) : Str !Mut {
  r = "  ".concat(emitExpr(e, ctx)).concat(";")
  if name == "print" && args.length == 1 && calm(args.at(0)) {
    r = "  ".concat(emitPrint(args.at(0), ctx)).concat(";")
  }
  r
}

emitPrint(arg : Expr, ctx : Ctx) : Str !Mut {
  fmt = "%ld"
  cast = ""
  val = emitExpr(arg, ctx)
  t = exprType(arg, ctx)
  if t == "Str" {
    fmt = "%s"
    cast = "(const char*)(intptr_t)"
  }
  if t == "Float" {
    fmt = "%s"
    cast = "(const char*)(intptr_t)"
    val = "f_tostr(".concat(val).concat(")")
  }
  if t == "Bool" {
    fmt = "%s"
    val = "(".concat(val).concat(" ? \"true\" : \"false\")")
  }
  "printf(\"".concat(fmt).concat("\\n\", ").concat(cast).concat(val).concat(")")
}

// `recv.each { x in body }` lowers to a counted C loop over the list. The
// receiver is evaluated once into a temp: it may be an expensive expression or
// an effectful one like sys.stdin, and re-running it per iteration would be
// wrong (stdin consumed once) as well as wasteful. The block scopes the temps
// so nested .each loops shadow cleanly.
emitEach(recv : Expr, param : Str, body : List[Stmt], ctx : Ctx) : Str !Mut {
  recvC = emitExpr(recv, ctx)
  old = envOld(ctx.env, param)
  envPut(ctx.env, param, loopItem(exprType(recv, ctx)))
  rt = exprType(recv, ctx)
  len = "l_len"
  at = "l_at"
  if rt == "Str" {
    len = "s_len"
    at = "s_at"
  }
  if (rt != "Str") && isListType(rt).not {
    failAt("a loop goes over a list or the letters of a text, not ".concat(rt), ctx)
  }
  out = "  {"
  out = out.concat("\n  long _lst = ").concat(recvC).concat(";")
  if rt == "Str" {
    out = out.concat("\n  long _b = 0;")
    out = out.concat("\n  while (((const char*)(intptr_t)_lst)[_b]) {")
    out = out.concat("\n  long ").concat(param).concat(" = s_each(_lst, &_b);")
  } else {
    out = out.concat("\n  long _n = ").concat(len).concat("(_lst);")
    out = out.concat("\n  for (long _i = 0; _i < _n; _i = _i + 1) {")
    out = out.concat("\n  long ").concat(param).concat(" = ").concat(at).concat("(_lst, _i);")
  }
  out = out.concat(emitBlock(body, false, ctx))
  envPut(ctx.env, param, old)
  out = out.concat("\n  }")
  out = out.concat("\n  }")
  out
}

// "List[Fn]" has element type "Fn"; a bare "List" or a non-list has none.
isListType(t : Str) : Bool {
  r = false
  if t.length > 3 {
    if t.slice(0, 4) == "List" {
      r = true
    }
  }
  r
}

// What one round of a loop gets: an item of a list, or one letter of a text.
loopItem(t : Str) : Str {
  r = elemOf(t)
  if t == "Str" {
    r = "Str"
  }
  r
}

elemOf(t : Str) : Str {
  r = "Int"
  if isListType(t) {
    r = t.slice(5, t.length - 1)
  }
  r
}

// `Map[Str]` is a Str-valued map; a bare `Map` defaults to Int values.
anyMap(t : Str) : Bool {
  (t == "Map") || isMapType(t)
}

isMapType(t : Str) : Bool {
  r = false
  if t.length > 4 {
    if t.slice(0, 4) == "Map[" {
      r = true
    }
  }
  r
}

mapValueOf(t : Str) : Str {
  r = "Int"
  if isMapType(t) {
    r = t.slice(4, t.length - 1)
  }
  r
}

emitReturn(e : Expr, ctx : Ctx) : Str !Mut {
  e.match {
    Match(scrut, arms) -> emitSwitch(scrut, arms, ctx)
    Num(v) -> retVal(e, ctx)
    FloatLit(s) -> retVal(e, ctx)
    Var(s) -> retVal(e, ctx)
    StrLit(s) -> retVal(e, ctx)
    ListLit(es) -> retVal(e, ctx)
    Bin(op, a, b) -> retVal(e, ctx)
    Call(name, args) -> retVal(e, ctx)
    Field(recv, fld) -> retVal(e, ctx)
    Method(recv, name, args) -> retVal(e, ctx)
    Each(recv, param, body) -> retVal(e, ctx)
  }
}

retVal(e : Expr, ctx : Ctx) : Str !Mut {
  "  return ".concat(emitExpr(e, ctx)).concat(";")
}

emitSwitch(scrut : Expr, arms : List[Arm], ctx : Ctx) : Str !Mut {
  boxed = armHasBind(arms)
  scrutC = emitExpr(scrut, ctx)
  styp = exprType(scrut, ctx)
  checkExhaustive(styp, arms, ctx)
  head = scrutC
  if boxed {
    head = boxField(scrutC, "tag")
  }
  out = "  switch (".concat(head).concat(") {")
  k = 0
  m = arms.length
  while k < m {
    out = out.concat("\n").concat(emitArm(arms.at(k), scrutC, boxed, styp, "return ", ";", ctx))
    k = k + 1
  }
  out = out.concat("\n  }")
  out.concat("\n  return 0;")
}

// Each bound payload is given its declared type, so comparisons and method
// dispatch inside the arm body resolve correctly.
// A match used as a value, in the middle of a function: the chosen arm's
// value lands in _m (a GNU C statement expression).
emitMatchExpr(scrut : Expr, arms : List[Arm], ctx : Ctx) : Str !Mut {
  boxed = armHasBind(arms)
  scrutC = emitExpr(scrut, ctx)
  styp = exprType(scrut, ctx)
  checkExhaustive(styp, arms, ctx)
  head = scrutC
  if boxed {
    head = boxField(scrutC, "tag")
  }
  out = "({ long _m = 0; switch (".concat(head).concat(") {")
  k = 0
  m = arms.length
  while k < m {
    out = out.concat(emitArm(arms.at(k), scrutC, boxed, styp, "_m = ", "; break;", ctx))
    k = k + 1
  }
  out.concat(" } _m; })")
}

emitArm(a : Arm, scrutC : Str, boxed : Bool, styp : Str, pre : Str, post : Str, ctx : Ctx) : Str !Mut {
  r = ""
  olds = envOlds(ctx.env, a.binds)
  if boxed {
    // type the payload bindings before emitting the body, so checks in it see
    // the right types
    decls = ""
    bi = 0
    while bi < a.binds.length {
      envPut(ctx.env, a.binds.at(bi), payloadType(styp, a.tag, bi, ctx))
      decls = decls.concat(" long ").concat(a.binds.at(bi)).concat(" = ").concat(boxField(scrutC, slotName(bi))).concat(";")
      bi = bi + 1
    }
    r = "  case T_".concat(a.tag).concat(": {").concat(decls).concat(" ").concat(pre).concat(emitExpr(a.body, ctx)).concat(post).concat(" }")
  } else {
    r = "  case ".concat(a.tag).concat(": ").concat(pre).concat(emitExpr(a.body, ctx)).concat(post)
  }
  envRestore(ctx.env, a.binds, olds)
  r
}

// The declared type of payload `idx` of case `caseTag` in variant `tyName`.
payloadType(tyName : Str, caseTag : Str, idx : Int, ctx : Ctx) : Str {
  r = "Int"
  types = ctx.sigs.types
  k = 0
  m = types.length
  while k < m {
    t = types.at(k)
    if t.name == tyName {
      r = casePayloadType(t, caseTag, idx)
    }
    k = k + 1
  }
  r
}

casePayloadType(t : TyDef, caseTag : Str, idx : Int) : Str {
  r = "Int"
  k = 0
  m = t.cases.length
  while k < m {
    c = t.cases.at(k)
    if c.cname == caseTag {
      if idx < c.ptypes.length {
        r = c.ptypes.at(idx)
      }
    }
    k = k + 1
  }
  r
}

boxField(scrutC : Str, field : Str) : Str {
  "((Obj*)(intptr_t)".concat(scrutC).concat(")->").concat(field)
}

// Every case of the matched variant must have an arm. A missing one is a
// compile error, the same rule the Rust bootstrap enforces.
checkExhaustive(styp : Str, arms : List[Arm], ctx : Ctx) : Int {
  types = ctx.sigs.types
  k = 0
  m = types.length
  while k < m {
    t = types.at(k)
    if t.name == styp {
      checkCases(t, arms, ctx)
      checkArities(t, arms, ctx)
    }
    k = k + 1
  }
  0
}

// Each arm must bind exactly as many values as its case carries.
checkArities(t : TyDef, arms : List[Arm], ctx : Ctx) : Int {
  k = 0
  m = arms.length
  while k < m {
    a = arms.at(k)
    ar = caseArityIn(t, a.tag)
    if ar < 0 {
      failAt(t.name.concat(" has no case ").concat(a.tag), ctx)
    }
    if (ar < 0).not {
      if (a.binds.length == ar).not {
        failAt("match case ".concat(a.tag).concat(" binds ").concat(a.binds.length.toStr).concat(", expected ").concat(ar.toStr), ctx)
      }
    }
    k = k + 1
  }
  0
}

// Each statement sets the line that an error in it will name.
setLine(n : Int, ctx : Ctx) : Int !Mut {
  envPut(ctx.env, "__line__", n.toStr)
}

emitLine(n : Int, ctx : Ctx) : Str !Mut {
  setLine(n, ctx)
  ""
}

// Report a compile error at the statement being read.
failAt(msg : Str, ctx : Ctx) : Int {
  fail(spot(ctx.sigs.files, envGet(ctx.env, "__line__").toInt).concat(msg.replace("__", ".")))
}

// --- effects: a function must declare every effect its body uses --------
// IO comes from a capability call (.print/.read/.send); Fail from .read; both
// also come transitively from calling a function that declares them. main is
// exempt: it implicitly holds all effects.

// A function may not change a list or map it was handed unless it declares
// !Mut. "Handed" means the parameters and every local that may point into
// one: a copy of the name, an item taken out, a loop or match name, a local
// list that had a handed value put in. The env keeps them as __h__<name>.
// Text and numbers cannot be changed, so they are never handed.

plainType(t : Str) : Bool {
  (t == "Int").or(t == "Str").or(t == "Bool").or(t == "Float").or(t == "Screen").or(t == "Files").or(t == "Mail").or(t == "Programs").or(t == "Net").or(t == "Clock").or(t == "Env").or(t == "Term").or(t == "Bytes").or(t == "Sys")
}

isHanded(s : Str, ctx : Ctx) : Bool {
  hasName(ctx.env.names, "__h__".concat(s))
}

// A list, map or record of the function's own that had a handed value put in. Adding to it
// changes nothing the caller has, but what it holds may be the caller's. The env keeps the
// depth as __i__<name>: 1 when its items are the caller's, 2 when the items of its items are.
holdOf(s : Str, ctx : Ctx) : Int {
  r = 0
  if hasName(ctx.env.names, "__i__".concat(s)) {
    r = envGet(ctx.env, "__i__".concat(s)).toInt
  }
  r
}

setHolding(s : Str, d : Int, ctx : Ctx) : Int !Mut {
  if (s == "").not && isHanded(s, ctx).not {
    cur = holdOf(s, ctx)
    if (cur == 0) || (d < cur) {
      envPut(ctx.env, "__i__".concat(s), d.toStr)
    }
  }
  0
}

oneLess(d : Int) : Int {
  r = 0
  if d > 1 {
    r = d - 1
  }
  r
}

// A record or a variant case made here is the function's own, like a list
// written out: it holds what it was given, one step in.
isMaker(name : Str, ctx : Ctx) : Bool {
  hasName(ctx.sigs.fnNames, name).not && (hasName(ctx.sigs.recNames, name) || (variantOf(name, ctx) != ""))
}

makerDepth(name : Str, args : List[Expr], ctx : Ctx) : Int !Mut {
  r = 0
  if isMaker(name, ctx) {
    r = 1 + minLevel(args, ctx)
  }
  r
}

// A returned record that holds the caller's values passes them on.
retKeeps(e : Expr, ctx : Ctx) : Bool !Mut {
  r = handed(e, ctx)
  if r.not && (holdDepth(e, ctx) > 0) {
    t = exprType(e, ctx)
    r = isRec(t, ctx) || isVariant(t, ctx)
  }
  r
}

// A part of a list is a new list of the same items: it holds what the list held.
holdMethod(recv : Expr, name : Str, ctx : Ctx) : Int !Mut {
  if (name == "slice") && isListType(exprType(recv, ctx)) {
    if plainType(elemOf(exprType(recv, ctx))) {
      return 0
    }
    if handed(recv, ctx) {
      return 1
    }
    return holdDepth(recv, ctx)
  }
  oneLess(holdDepth(recv, ctx))
}

// 0: holds nothing of the caller's (or is the caller's itself, which handed() answers).
holdDepth(e : Expr, ctx : Ctx) : Int !Mut {
  e.match {
    Var(s) -> holdOf(s, ctx)
    Field(recv, fld) -> oneLess(holdDepth(recv, ctx))
    Method(recv, name, args) -> holdMethod(recv, name, ctx)
    ListLit(es) -> 1 + minLevel(es, ctx)
    Call(name, args) -> makerDepth(name, args, ctx)
    Match(scrut, arms) -> 0
    Bin(op, a, b) -> 0
    Each(recv, param, body) -> 0
    Num(v) -> 0
    FloatLit(s) -> 0
    StrLit(s) -> 0
  }
}

// The nearest caller's value in a list of values: 0 when one is the caller's itself,
// its depth when one holds some, -1 when none does.
minLevel(es : List[Expr], ctx : Ctx) : Int !Mut {
  r = 0 - 1
  es.each { x in
    l = 0 - 1
    if handed(x, ctx) {
      l = 0
    } else {
      d = holdDepth(x, ctx)
      if d > 0 {
        l = d
      }
    }
    if (l >= 0) && ((r < 0) || (l < r)) {
      r = l
    }
  }
  r
}

// How many steps (.at, .get, a field) lie between an expression and its first name.
pathLen(e : Expr) : Int {
  e.match {
    Field(recv, fld) -> 1 + pathLen(recv)
    Method(recv, name, args) -> 1 + pathLen(recv)
    Var(s) -> 0
    ListLit(es) -> 0
    Call(name, args) -> 0
    Match(scrut, arms) -> 0
    Bin(op, a, b) -> 0
    Each(recv, param, body) -> 0
    Num(v) -> 0
    FloatLit(s) -> 0
    StrLit(s) -> 0
  }
}

setHanded(s : Str, ctx : Ctx) : Int !Mut {
  if isHanded(s, ctx).not {
    envPut(ctx.env, "__h__".concat(s), "1")
  }
  0
}

// A type whose values cannot be changed in place: a plain one. A record can (`p.x = 5`).
// Putting such a value from a handed list into a new list changes nothing the caller has.
fixedType(t : Str, ctx : Ctx, depth : Int) : Bool {
  plainType(t)
}

handed(e : Expr, ctx : Ctx) : Bool !Mut {
  if fixedType(exprType(e, ctx), ctx, 0) {
    return false
  }
  e.match {
    Var(s) -> isHanded(s, ctx)
    Field(recv, fld) -> handedField(recv, fld, ctx) || (holdDepth(recv, ctx) == 1)
    Method(recv, name, args) -> ((name == "at").or(name == "get")).and(handed(recv, ctx) || (holdDepth(recv, ctx) == 1))
    ListLit(es) -> false
    Call(name, args) -> callHanded(name, args, ctx)
    Match(scrut, arms) -> armsHanded(scrut, arms, ctx)
    Bin(op, a, b) -> false
    Each(recv, param, body) -> false
    Num(v) -> false
    FloatLit(s) -> false
    StrLit(s) -> false
  }
}

// keys and byValue are new lists of text; sort is a new list of the same items.
handedField(recv : Expr, fld : Str, ctx : Ctx) : Bool !Mut {
  if (fld == "keys") || (fld == "byValue") || (fld == "jsonItems") || (fld == "jsonKeys") || (fld == "bytes") {
    return false
  }
  if fld == "sort" {
    if plainType(elemOf(exprType(recv, ctx))) {
      return false
    }
  }
  if useUFCS(exprType(recv, ctx), fld, ctx) {
    return callHanded(fld, [recv], ctx)
  }
  handed(recv, ctx)
}

// A call gives back something handed only when it passes a handed value in
// a position the function can return (found by retPass). A record or variant made here keeps it.
callHanded(name : Str, args : List[Expr], ctx : Ctx) : Bool !Mut {
  if isMaker(name, ctx) {
    return false
  }
  if hasName(ctx.sigs.fnNames, name).not {
    return anyHanded(args, ctx)
  }
  r = false
  j = 0
  while j < args.length {
    if hasName(ctx.sigs.retP, name.concat(":").concat(j.toStr)) && handed(args.at(j), ctx) {
      r = true
    }
    j = j + 1
  }
  r
}

markFn(f : Fn, ctx : Ctx) : Int !Mut {
  k = 0
  while k < f.params.length {
    if plainType(f.ptypes.at(k)).not {
      setHanded(f.params.at(k), ctx)
    }
    k = k + 1
  }
  markAgain(f, ctx)
}

// Three rounds, so a name handed on late in the body is known early in it.
markAgain(f : Fn, ctx : Ctx) : Int !Mut {
  markBody(f.body, ctx)
  markBody(f.body, ctx)
  markBody(f.body, ctx)
}

// What a function does with each value it is given: can it return it (or a
// part of it), and, when it declares !Mut, does it change it? The function
// is read with that one value alone handed. Kept as "name:position". A
// function that calls another is read again until nothing new is found.
paramFacts(f : Fn, sigs : Sigs) : Bool !Mut {
  found = false
  k = 0
  while k < f.params.length {
    key = f.name.concat(":").concat(k.toStr)
    needR = plainType(f.ret).not && hasName(sigs.retP, key).not
    needM = hasName(f.effs, "Mut") && hasName(sigs.mutP, key).not
    if plainType(f.ptypes.at(k)).not && (needR || needM) {
      ctx = fnCtx(f, sigs)
      setHanded(f.params.at(k), ctx)
      markAgain(f, ctx)
      if needR && lastHanded(f.body, ctx).or(anyRets(f.body, ctx)) {
        sigs.retP.push(key)
        found = true
      }
      used : List[Str] = []
      effBody(f.body, used, ctx)
      if needM && hasName(used, "Mut") {
        sigs.mutP.push(key)
        found = true
      }
    }
    // does it change what the value holds, and not only the value itself?
    if plainType(f.ptypes.at(k)).not && hasName(f.effs, "Mut") && hasName(sigs.mutP, "deep:".concat(key)).not {
      ctx2 = fnCtx(f, sigs)
      setHolding(f.params.at(k), 1, ctx2)
      markAgain(f, ctx2)
      used2 : List[Str] = []
      effBody(f.body, used2, ctx2)
      if hasName(used2, "Mut") {
        sigs.mutP.push("deep:".concat(key))
        found = true
      }
    }
    k = k + 1
  }
  found
}

// A type name nobody declared (`str`, `string`, `int`) is refused where it is written.
typeBase(t : Str) : Str {
  r = t
  if t.length > 5 {
    if t.slice(0, 5) == "List[" {
      r = typeBase(t.slice(5, t.length - 1))
    }
  }
  if t.length > 4 {
    if t.slice(0, 4) == "Map[" {
      r = typeBase(t.slice(4, t.length - 1))
    }
  }
  r
}

typeKnown(t : Str, sigs : Sigs) : Bool {
  b = typeBase(t)
  r = b == "" || plainType(b) || b == "List" || b == "Map" || hasName(sigs.recNames, b)
  sigs.types.each { td in
    if td.name == b {
      r = true
    }
  }
  r
}

// A name as the program wrote it, without the "_c" the lexer added.
asWritten(n : Str) : Str {
  b = n
  if b.length > 2 {
    cut = b.slice(0, b.length - 2)
    if safeName(cut, cTaken()) == b {
      b = cut
    }
  }
  b
}

noType(t : Str) : Str {
  b = asWritten(typeBase(t))
  "no type named ".concat(b).concat("; the types are Int, Float, Str, Bool, List[T], Map, Map[T] and the ones the program declares")
}

checkTypes(prog : Prog, sigs : Sigs) : Int {
  prog.records.each { r in
    r.ftypes.each { t in
      if typeKnown(t, sigs).not {
        fail(spot(sigs.files, r.line).concat(noType(t)))
      }
    }
  }
  prog.types.each { td in
    td.cases.each { c in
      c.ptypes.each { t in
        if typeKnown(t, sigs).not {
          fail(spot(sigs.files, td.line).concat(noType(t)))
        }
      }
    }
  }
  prog.fns.each { f in
    f.ptypes.each { t in
      if typeKnown(t, sigs).not {
        fail(spot(sigs.files, f.line).concat(noType(t)))
      }
    }
    if typeKnown(f.ret, sigs).not {
      fail(spot(sigs.files, f.line).concat(noType(f.ret)))
    }
  }
  0
}

// break and continue belong inside a loop.
jumpBody(fl : List[Str], body : List[Stmt], inLoop : Bool) : Int {
  line = 0
  body.each { s in
    line = jumpStmt(fl, s, inLoop, line)
  }
  0
}

jumpStmt(fl : List[Str], s : Stmt, inLoop : Bool, line : Int) : Int {
  s.match {
    Let(name, ty, e) -> line
    Bare(e) -> jumpExpr(fl, e, inLoop, line)
    If(c, t, el) -> line + jumpBody(fl, t, inLoop) + jumpBody(fl, el, inLoop)
    While(c, b) -> line + jumpBody(fl, b, true)
    Ret(e) -> line
    Line(n) -> n
    Jump(w) -> jumpAt(fl, w, inLoop, line)
  }
}

jumpAt(fl : List[Str], w : Str, inLoop : Bool, line : Int) : Int {
  if inLoop.not {
    fail(spot(fl, line).concat(w).concat(" is only for inside a loop"))
  }
  line
}

jumpExpr(fl : List[Str], e : Expr, inLoop : Bool, line : Int) : Int {
  e.match {
    Num(n) -> line
    FloatLit(t) -> line
    Var(n) -> line
    StrLit(t) -> line
    ListLit(es) -> line
    Bin(op, a, b) -> line
    Call(name, args) -> line
    Match(scrut, arms) -> line
    Field(recv, fld) -> line
    Method(recv, name, args) -> line
    Each(recv, param, body) -> line + jumpBody(fl, body, true)
  }
}

retPass(prog : Prog, sigs : Sigs) : Int !Mut {
  checkTypes(prog, sigs)
  prog.fns.each { f in
    jumpBody(sigs.files, f.body, false)
  }
  changed = true
  while changed {
    changed = false
    prog.fns.each { f in
      if isMain(f.name).not {
        if paramFacts(f, sigs) {
          changed = true
        }
      }
    }
  }
  0
}

// The value of a block is its last statement.
lastHanded(body : List[Stmt], ctx : Ctx) : Bool !Mut {
  r = false
  body.each { s in
    r = lastStmt(s, r, ctx)
  }
  r
}

lastStmt(s : Stmt, prev : Bool, ctx : Ctx) : Bool !Mut {
  s.match {
    Line(n) -> prev
    Jump(w) -> prev
    Bare(e) -> retKeeps(e, ctx)
    Ret(e) -> retKeeps(e, ctx)
    If(c, t, el) -> lastBlock(t, ctx).or(lastBlock(el, ctx))
    Let(name, ty, e) -> false
    While(c, b) -> false
  }
}

anyRets(body : List[Stmt], ctx : Ctx) : Bool !Mut {
  r = false
  body.each { s in
    if stmtRets(s, ctx) {
      r = true
    }
  }
  r
}

stmtRets(s : Stmt, ctx : Ctx) : Bool !Mut {
  s.match {
    Ret(e) -> retKeeps(e, ctx)
    If(c, t, el) -> retsBlock(t, ctx).or(retsBlock(el, ctx))
    While(c, b) -> anyRets(b, ctx)
    Bare(e) -> eachRets(e, ctx)
    Let(name, ty, e) -> false
    Line(n) -> false
    Jump(w) -> false
  }
}

eachRets(e : Expr, ctx : Ctx) : Bool !Mut {
  e.match {
    Each(recv, param, body) -> anyRets(body, ctx)
    Var(s) -> false
    Field(recv, fld) -> false
    Method(recv, name, args) -> false
    ListLit(es) -> false
    Call(name, args) -> false
    Match(scrut, arms) -> false
    Bin(op, a, b) -> false
    Num(v) -> false
    FloatLit(s) -> false
    StrLit(s) -> false
  }
}

anyHanded(es : List[Expr], ctx : Ctx) : Bool !Mut {
  r = false
  es.each { x in
    if handed(x, ctx) {
      r = true
    }
  }
  r
}

armsHanded(scrut : Expr, arms : List[Arm], ctx : Ctx) : Bool !Mut {
  r = false
  styp = exprType(scrut, ctx)
  arms.each { a in
    olds = bindArm(styp, a, ctx)
    if handed(a.body, ctx) {
      r = true
    }
    envRestore(ctx.env, a.binds, olds)
  }
  r
}

// Give an arm's names their types for as long as the arm is read.
bindArm(styp : Str, a : Arm, ctx : Ctx) : List[Str] !Mut {
  olds = envOlds(ctx.env, a.binds)
  bi = 0
  while bi < a.binds.length {
    envPut(ctx.env, a.binds.at(bi), payloadType(styp, a.tag, bi, ctx))
    bi = bi + 1
  }
  olds
}

// The variable an expression reaches into: box in box.items.at(0).
rootVar(e : Expr) : Str {
  e.match {
    Var(s) -> s
    Field(recv, fld) -> rootVar(recv)
    Method(recv, name, args) -> rootVar(recv)
    ListLit(es) -> ""
    Call(name, args) -> ""
    Match(scrut, arms) -> ""
    Bin(op, a, b) -> ""
    Each(recv, param, body) -> ""
    Num(v) -> ""
    FloatLit(s) -> ""
    StrLit(s) -> ""
  }
}

markBody(body : List[Stmt], ctx : Ctx) : Int !Mut {
  body.each { s in
    markStmt(s, ctx)
  }
  0
}

markStmt(s : Stmt, ctx : Ctx) : Int !Mut {
  s.match {
    Let(name, ty, e) -> markLet(name, e, ctx)
    Bare(e) -> markExpr(e, ctx)
    If(c, t, el) -> markExpr(c, ctx) + markBlock(t, ctx) + markBlock(el, ctx)
    While(c, b) -> markExpr(c, ctx) + markBody(b, ctx)
    Ret(e) -> markExpr(e, ctx)
    Line(n) -> 0
    Jump(w) -> 0
  }
}

// A block that ends in return: what it put into the function's own lists
// cannot reach the code after it. So what such a block learned about them
// is dropped at its end, and read again when the block itself is checked.
endsRet(b : List[Stmt]) : Bool {
  r = false
  b.each { s in
    r = s.match {
      Ret(e) -> true
      Line(n) -> r
      Let(name, ty, e) -> false
      Bare(e) -> false
      If(c, t, el) -> false
      While(c, w) -> false
      Jump(w) -> false
    }
  }
  r
}

dropHeld(n0 : Int, ctx : Ctx) : Int !Mut {
  n1 = ctx.env.names.length
  j = n0
  while j < n1 {
    key = ctx.env.names.at(j)
    if key.startsWith("__i__") {
      was = "0"
      i = 0
      while i < n0 {
        if ctx.env.names.at(i) == key {
          was = ctx.env.tys.at(i)
        }
        i = i + 1
      }
      envPut(ctx.env, key, was)
    }
    j = j + 1
  }
  0
}

markBlock(b : List[Stmt], ctx : Ctx) : Int !Mut {
  n0 = ctx.env.names.length
  markBody(b, ctx)
  if endsRet(b) {
    dropHeld(n0, ctx)
  }
  0
}

// Before a returning block is checked, it is read again for what it holds.
reMark(b : List[Stmt], ctx : Ctx) : Int !Mut {
  n0 = ctx.env.names.length
  if endsRet(b) {
    markBody(b, ctx)
    markBody(b, ctx)
    markBody(b, ctx)
  }
  n0
}

unMark(b : List[Stmt], n0 : Int, ctx : Ctx) : Int !Mut {
  if endsRet(b) {
    dropHeld(n0, ctx)
  }
  0
}

lastBlock(b : List[Stmt], ctx : Ctx) : Bool !Mut {
  n0 = reMark(b, ctx)
  r = lastHanded(b, ctx)
  unMark(b, n0, ctx)
  r
}

retsBlock(b : List[Stmt], ctx : Ctx) : Bool !Mut {
  n0 = reMark(b, ctx)
  r = anyRets(b, ctx)
  unMark(b, n0, ctx)
  r
}

effBlock(b : List[Stmt], used : List[Str], ctx : Ctx) : Int !Mut {
  n0 = reMark(b, ctx)
  effBody(b, used, ctx)
  unMark(b, n0, ctx)
}

markLet(name : Str, e : Expr, ctx : Ctx) : Int !Mut {
  if handed(e, ctx) {
    setHanded(name, ctx)
  }
  hd = holdDepth(e, ctx)
  if hd > 0 {
    setHolding(name, hd, ctx)
  }
  markExpr(e, ctx)
}

markExpr(e : Expr, ctx : Ctx) : Int !Mut {
  e.match {
    Each(recv, param, body) -> markEach(recv, param, body, ctx)
    Match(scrut, arms) -> markMatch(scrut, arms, ctx)
    Method(recv, name, args) -> markMethod(recv, name, args, ctx)
    Field(recv, fld) -> markExpr(recv, ctx)
    ListLit(es) -> markAll(es, ctx)
    Call(name, args) -> markAll(args, ctx)
    Bin(op, a, b) -> markExpr(a, ctx) + markExpr(b, ctx)
    Var(s) -> 0
    Num(v) -> 0
    FloatLit(s) -> 0
    StrLit(s) -> 0
  }
}

markAll(es : List[Expr], ctx : Ctx) : Int !Mut {
  es.each { x in
    markExpr(x, ctx)
  }
  0
}

markEach(recv : Expr, param : Str, body : List[Stmt], ctx : Ctx) : Int !Mut {
  et = loopItem(exprType(recv, ctx))
  if plainType(et).not {
    ed = holdDepth(recv, ctx)
    if handed(recv, ctx) || (ed == 1) {
      setHanded(param, ctx)
    }
    if ed > 1 {
      setHolding(param, ed - 1, ctx)
    }
  }
  markExpr(recv, ctx)
  old = envOld(ctx.env, param)
  envPut(ctx.env, param, et)
  markBody(body, ctx)
  envPut(ctx.env, param, old)
}

markMatch(scrut : Expr, arms : List[Arm], ctx : Ctx) : Int !Mut {
  h = handed(scrut, ctx) || (holdDepth(scrut, ctx) > 0)
  markExpr(scrut, ctx)
  styp = exprType(scrut, ctx)
  arms.each { a in
    olds = bindArm(styp, a, ctx)
    if h {
      a.binds.each { b in
        if plainType(envGet(ctx.env, b)).not {
          setHanded(b, ctx)
        }
      }
    }
    markExpr(a.body, ctx)
    envRestore(ctx.env, a.binds, olds)
  }
  0
}

// A handed value put into a local list or map makes that local handed too.
markMethod(recv : Expr, name : Str, args : List[Expr], ctx : Ctx) : Int !Mut {
  if (name == "push") || (name == "set") || (name == "remove") || isSetField(name) {
    root = rootVar(recv)
    ml = minLevel(args, ctx)
    if ml >= 0 {
      setHolding(root, ml + 1 + pathLen(recv), ctx)
    }
  }
  markExpr(recv, ctx)
  markAll(args, ctx)
}

checkEffects(f : Fn, ctx : Ctx) : Int !Mut {
  if isMain(f.name).not {
    markFn(f, ctx)
    used : List[Str] = []
    effBody(f.body, used, ctx)
    k = 0
    m = used.length
    while k < m {
      e = used.at(k)
      // !Fail may be written, but nothing asks for it: the compiler knows it.
      if hasName(f.effs, e).not && e != "Fail" {
        if e == "Mut" {
          failAt(asWritten(f.name).concat(" changes a list or map it was handed; add !Mut after its return type"), ctx)
        }
        failAt("uses !".concat(e).concat(" but does not declare it"), ctx)
      }
      k = k + 1
    }
  }
  0
}

effBody(body : List[Stmt], used : List[Str], ctx : Ctx) : Int !Mut {
  k = 0
  m = body.length
  while k < m {
    effStmt(body.at(k), used, ctx)
    k = k + 1
  }
  0
}

effStmt(s : Stmt, used : List[Str], ctx : Ctx) : Int !Mut {
  s.match {
    Let(name, ty, e) -> effExpr(e, used, ctx)
    Bare(e) -> effExpr(e, used, ctx)
    If(c, t, el) -> effIf(c, t, el, used, ctx)
    While(c, b) -> effWhile(c, b, used, ctx)
    Ret(e) -> effExpr(e, used, ctx)
    Line(n) -> 0
    Jump(w) -> 0
  }
}

effIf(c : Expr, t : List[Stmt], el : List[Stmt], used : List[Str], ctx : Ctx) : Int !Mut {
  effExpr(c, used, ctx)
  effBlock(t, used, ctx)
  effBlock(el, used, ctx)
  0
}

effWhile(c : Expr, b : List[Stmt], used : List[Str], ctx : Ctx) : Int !Mut {
  effExpr(c, used, ctx)
  effBody(b, used, ctx)
  0
}

effExpr(e : Expr, used : List[Str], ctx : Ctx) : Int !Mut {
  e.match {
    Method(recv, name, args) -> effMethodE(recv, name, args, used, ctx)
    Call(name, args) -> effCallE(name, args, used, ctx)
    Bin(op, a, b) -> effBin(a, b, used, ctx)
    Match(scrut, arms) -> effMatchE(scrut, arms, used, ctx)
    Field(recv, fld) -> effFieldE(recv, fld, used, ctx)
    Each(recv, param, body) -> effEachE(recv, param, body, used, ctx)
    ListLit(es) -> effArgs(es, used, ctx)
    Num(v) -> 0
    FloatLit(s) -> 0
    Var(s) -> 0
    StrLit(s) -> 0
  }
}

effMethodE(recv : Expr, name : Str, args : List[Expr], used : List[Str], ctx : Ctx) : Int !Mut {
  if (name == "print") || (name == "part") || (name == "error") || (name == "fetchWith") || (name == "readBytes") || (name == "writeBytes") {
    used.push("IO")
  }
  if (name == "send") || (name == "run") || (name == "status") || (name == "start") || (name == "try") || (name == "feed") || (name == "fetch") || (name == "post") || (name == "reach") {
    used.push("IO")
  }
  if name == "read" {
    used.push("IO")
    used.push("Fail")
  }
  if name == "write" {
    used.push("IO")
  }
  if (name == "append") || (name == "list") || (name == "exists") || (name == "wait") || (name == "rename") || (name == "delete") {
    used.push("IO")
  }
  if (name == "push") || (name == "set") || (name == "remove") || isSetField(name) {
    if handed(recv, ctx) {
      used.push("Mut")
    }
  }
  effExpr(recv, used, ctx)
  effArgs(args, used, ctx)
  0
}

// x.f with no values is the call f(x) when f is a function.
effFieldE(recv : Expr, fld : Str, used : List[Str], ctx : Ctx) : Int !Mut {
  if useUFCS(exprType(recv, ctx), fld, ctx) {
    return effCallE(fld, [recv], used, ctx)
  }
  effExpr(recv, used, ctx)
}

effCallE(name : Str, args : List[Expr], used : List[Str], ctx : Ctx) : Int !Mut {
  fns = ctx.sigs.fns
  k = 0
  m = fns.length
  while k < m {
    g = fns.at(k)
    if g.name == name {
      g.effs.each { x in
        if (x == "Mut").not {
          used.push(x)
        }
      }
      if hasName(g.effs, "Mut") {
        j = 0
        while j < args.length {
          if hasName(ctx.sigs.mutP, name.concat(":").concat(j.toStr)) && handed(args.at(j), ctx) {
            used.push("Mut")
          }
          if hasName(ctx.sigs.mutP, "deep:".concat(name).concat(":").concat(j.toStr)) && (holdDepth(args.at(j), ctx) > 0) {
            used.push("Mut")
          }
          j = j + 1
        }
      }
    }
    k = k + 1
  }
  effArgs(args, used, ctx)
  0
}

effBin(a : Expr, b : Expr, used : List[Str], ctx : Ctx) : Int !Mut {
  effExpr(a, used, ctx)
  effExpr(b, used, ctx)
  0
}

effMatchE(scrut : Expr, arms : List[Arm], used : List[Str], ctx : Ctx) : Int !Mut {
  effExpr(scrut, used, ctx)
  styp = exprType(scrut, ctx)
  arms.each { a in
    olds = bindArm(styp, a, ctx)
    effExpr(a.body, used, ctx)
    envRestore(ctx.env, a.binds, olds)
  }
  0
}

effEachE(recv : Expr, param : Str, body : List[Stmt], used : List[Str], ctx : Ctx) : Int !Mut {
  effExpr(recv, used, ctx)
  old = envOld(ctx.env, param)
  envPut(ctx.env, param, loopItem(exprType(recv, ctx)))
  effBody(body, used, ctx)
  envPut(ctx.env, param, old)
  0
}

effArgs(args : List[Expr], used : List[Str], ctx : Ctx) : Int !Mut {
  k = 0
  m = args.length
  while k < m {
    effExpr(args.at(k), used, ctx)
    k = k + 1
  }
  0
}

addAll(src : List[Str], dst : List[Str]) : Int !Mut {
  k = 0
  m = src.length
  while k < m {
    dst.push(src.at(k))
    k = k + 1
  }
  0
}

caseArityIn(t : TyDef, tag : Str) : Int {
  r = 0 - 1
  k = 0
  m = t.cases.length
  while k < m {
    c = t.cases.at(k)
    if c.cname == tag {
      r = c.arity
    }
    k = k + 1
  }
  r
}

checkCases(t : TyDef, arms : List[Arm], ctx : Ctx) : Int {
  k = 0
  m = t.cases.length
  while k < m {
    c = t.cases.at(k)
    if armCovers(arms, c.cname).not {
      failAt("non-exhaustive match in ".concat(t.name).concat(", missing case: ").concat(c.cname), ctx)
    }
    k = k + 1
  }
  0
}

armCovers(arms : List[Arm], cname : Str) : Bool {
  found = false
  k = 0
  m = arms.length
  while k < m {
    if arms.at(k).tag == cname {
      found = true
    }
    k = k + 1
  }
  found
}

armHasBind(arms : List[Arm]) : Bool {
  has = false
  k = 0
  m = arms.length
  while k < m {
    if arms.at(k).binds.length > 0 {
      has = true
    }
    k = k + 1
  }
  has
}

// --- emit: expressions --------------------------------------------------

emitExpr(e : Expr, ctx : Ctx) : Str !Mut {
  e.match {
    Num(v) -> v.toStr.concat("L")
    FloatLit(s) -> "d2l(".concat(s).concat(")")
    Var(s) -> emitVar(s, ctx)
    StrLit(s) -> "(long)(intptr_t)\"".concat(cEscape(s)).concat("\"")
    ListLit(es) -> emitList(es, ctx)
    Bin(op, a, b) -> emitBin(op, a, b, ctx)
    Call(name, args) -> emitCall(name, args, ctx)
    Match(scrut, arms) -> emitMatchExpr(scrut, arms, ctx)
    Field(recv, fld) -> emitField(recv, fld, ctx)
    Method(recv, name, args) -> emitMethod(recv, name, args, ctx)
    Each(recv, param, body) -> "0".concat(failAt("an each loop has no value", ctx).toStr)
  }
}

// --- order: the values of a call run left to right ----------------------
// C does not say which argument of a call runs first. Simpler does: left to
// right. Where two or more values of one call could do work (a call, a list
// read), each is put in a temporary of its own, in order, before the call.

// A calm value does no work and cannot be changed by another value's work:
// a literal, a local name, or arithmetic on those.
calm(e : Expr) : Bool {
  e.match {
    Num(v) -> true
    FloatLit(s) -> true
    Var(s) -> true
    StrLit(s) -> true
    ListLit(es) -> es.length == 0
    Field(recv, fld) -> isCapField(fld) && calm(recv)
    Bin(op, a, b) -> (op == "/").not && (op == "%").not && calm(a) && calm(b)
    Call(name, args) -> false
    Match(scrut, arms) -> false
    Method(recv, name, args) -> false
    Each(recv, param, body) -> false
  }
}

hoist(ops : List[Expr], ctx : Ctx) : Hoist !Mut {
  busy = 0
  ops.each { o in
    if calm(o).not {
      busy = busy + 1
    }
  }
  pre = ""
  out : List[Expr] = []
  ops.each { o in
    if busy > 1 && calm(o).not {
      c = emitExpr(o, ctx)
      ty = exprType(o, ctx)
      name = "_t".concat(ctx.env.names.length.toStr)
      envPut(ctx.env, name, ty)
      pre = pre.concat("long ").concat(name).concat(" = ").concat(c).concat("; ")
      out.push(Var(name))
    } else {
      out.push(o)
    }
  }
  Hoist(pre = pre, ops = out)
}

// A GNU C statement expression: the temporaries, then the call itself.
inOrder(pre : Str, c : Str) : Str {
  r = c
  if (pre == "").not {
    r = "({ ".concat(pre).concat(c).concat("; })")
  }
  r
}

emitBin(op : Str, a : Expr, b : Expr, ctx : Ctx) : Str !Mut {
  // && and || stop at the first value that settles them, so they keep their form
  if (op == "&&") || (op == "||") || (op == "u-") {
    return emitBin0(op, a, b, ctx)
  }
  h = hoist([a, b], ctx)
  inOrder(h.pre, emitBin0(op, h.ops.at(0), h.ops.at(1), ctx))
}

emitCall(name : Str, args : List[Expr], ctx : Ctx) : Str !Mut {
  h = hoist(args, ctx)
  inOrder(h.pre, emitCall0(name, h.ops, ctx))
}

emitMethod(recv : Expr, name : Str, args : List[Expr], ctx : Ctx) : Str !Mut {
  // `s.slice(a)` runs to the end
  if (name == "slice") && (args.length == 1) {
    return emitMethod(recv, name, [args.at(0), Field(recv, "length")], ctx)
  }
  if (name == "and") || (name == "or") {
    return emitMethod0(recv, name, args, ctx)
  }
  all : List[Expr] = [recv]
  args.each { a in
    all.push(a)
  }
  h = hoist(all, ctx)
  rest : List[Expr] = []
  k = 1
  while k < h.ops.length {
    rest.push(h.ops.at(k))
    k = k + 1
  }
  inOrder(h.pre, emitMethod0(h.ops.at(0), name, rest, ctx))
}

emitList(es : List[Expr], ctx : Ctx) : Str !Mut {
  h = hoist(es, ctx)
  inOrder(h.pre, emitList0(h.ops, ctx))
}

// A list literal: start empty, then add each element in order.
emitList0(es : List[Expr], ctx : Ctx) : Str !Mut {
  r = "l_new()"
  k = 0
  m = es.length
  while k < m {
    r = "l_with(".concat(r).concat(", ").concat(emitExpr(es.at(k), ctx)).concat(")")
    k = k + 1
  }
  r
}

listType(es : List[Expr], ctx : Ctx) : Str !Mut {
  r = "List"
  if es.length > 0 {
    r = "List[".concat(exprType(es.at(0), ctx)).concat("]")
  }
  r
}

// `==` on strings is a library call. Float values are stored as the bits of
// a double, so float math reinterprets through l2d/d2l; integer math is the
// plain C operator.
emitBin0(op : Str, a : Expr, b : Expr, ctx : Ctx) : Str !Mut {
  checkBinOp(op, a, b, ctx)
  ca = emitExpr(a, ctx)
  cb = emitExpr(b, ctx)
  r = "(".concat(ca).concat(" ").concat(op).concat(" ").concat(cb).concat(")")
  // whole-number division stops on a zero divisor, naming the line
  if op == "/" {
    r = "i_div(".concat(ca).concat(", ").concat(cb).concat(", ").concat(envGet(ctx.env, "__line__")).concat(")")
  }
  if op == "%" {
    r = "i_mod(".concat(ca).concat(", ").concat(cb).concat(", ").concat(envGet(ctx.env, "__line__")).concat(")")
  }
  if op == "==" {
    if exprType(a, ctx) == "Str" {
      r = "s_eq(".concat(ca).concat(", ").concat(cb).concat(")")
    }
  }
  if exprType(a, ctx) == "Float" {
    inner = "(l2d(".concat(ca).concat(") ").concat(op).concat(" l2d(").concat(cb).concat(")) ")
    r = inner
    if op == "%" {
      inner = "fmod(l2d(".concat(ca).concat("), l2d(").concat(cb).concat("))")
    }
    if isFloatArith(op) {
      r = "d2l(".concat(inner).concat(")")
    }
  }
  if textOp(op, a, b, ctx) {
    r = "(strcmp((const char*)(intptr_t)".concat(ca).concat(", (const char*)(intptr_t)").concat(cb).concat(") ").concat(op).concat(" 0)")
    if op == "+" {
      r = "s_concat(".concat(ca).concat(", ").concat(cb).concat(")")
    }
  }
  // unary minus: integer negation, or float negation through the bits
  if op == "u-" {
    if ((exprType(b, ctx) == "Int") || (exprType(b, ctx) == "Float")).not {
      failAt("- needs a number, got ".concat(exprType(b, ctx)), ctx)
    }
    r = "(-".concat(cb).concat(")")
    if exprType(b, ctx) == "Float" {
      r = "d2l(-l2d(".concat(cb).concat("))")
    }
  }
  r
}

// `+` joins two texts, and `< > <= >=` put two texts in byte order.
textOp(op : Str, a : Expr, b : Expr, ctx : Ctx) : Bool !Mut {
  r = false
  if (op == "+") || (op == "<") || (op == ">") || (op == "<=") || (op == ">=") {
    if exprType(a, ctx) == "Str" {
      if exprType(b, ctx) == "Str" {
        r = true
      }
    }
  }
  r
}

// `+ - * /` produce a Float; `< > ==` produce a Bool (no d2l re-wrap).
isFloatArith(op : Str) : Bool {
  (op == "+").or(op == "-").or(op == "*").or(op == "/").or(op == "%")
}

// Arithmetic and ordering need numeric operands (Int or Float), and the two
// must not be mixed (convert with .toFloat / .toInt). `==` is left alone: it
// is overloaded over Int and Str. Operands of a clearly non-numeric type are
// rejected; unknowns stay permissive.
checkBinOp(op : Str, a : Expr, b : Expr, ctx : Ctx) : Int !Mut {
  if textOp(op, a, b, ctx) {
    return 0
  }
  if isArithOp(op) {
    ta = exprType(a, ctx)
    tb = exprType(b, ctx)
    if op == "+" {
      if (ta == "Str") || (tb == "Str") {
        failAt("+ adds two numbers or joins two texts; turn the number into text with .toStr", ctx)
      }
    }
    if notInt(ta, ctx) {
      failAt("operator ".concat(op).concat(" needs Int operands"), ctx)
    }
    if notInt(tb, ctx) {
      failAt("operator ".concat(op).concat(" needs Int operands"), ctx)
    }
    if mixedFloat(ta, tb) {
      failAt("operator ".concat(op).concat(" mixes Int and Float; convert with .toFloat or .toInt"), ctx)
    }
  }
  0
}

// One operand is a Float and the other is not.
mixedFloat(a : Str, b : Str) : Bool {
  r = false
  if (a == "Float").and((b == "Float").not) {
    r = true
  }
  if (b == "Float").and((a == "Float").not) {
    r = true
  }
  r
}

isArithOp(op : Str) : Bool {
  (op == "+").or(op == "-").or(op == "*").or(op == "/").or(op == "<").or(op == ">").or(op == "<=").or(op == ">=").or(op == "%")
}

// A call must name something that exists: a function of this program, a
// record, a variant case, or one of the three built-ins.
knownCall(name : Str, ctx : Ctx) : Bool {
  r = hasName(ctx.sigs.fnNames, name).or(hasName(ctx.sigs.recNames, name))
  if (variantOf(name, ctx) == "").not {
    r = true
  }
  if (name == "Map").or(name == "fail").or(name == "exit").or(name == "exit_c").or(name == "assert").or(name == "l_range") {
    r = true
  }
  r
}

emitCall0(name : Str, args : List[Expr], ctx : Ctx) : Str !Mut {
  if isMapType(name) {
    if typeKnown(name, ctx.sigs).not {
      failAt(noType(name), ctx)
    }
    return "Map()"
  }
  if knownCall(name, ctx).not {
    failAt("no function named ".concat(name), ctx)
  }
  checkCall(name, args, ctx)
  cn = name
  if name == "assert" {
    cn = "s_assert"
    if (args.length == 1).not {
      failAt("assert takes one Bool", ctx)
    }
    if (exprType(args.at(0), ctx) == "Bool").not {
      failAt("assert needs a Bool, got ".concat(exprType(args.at(0), ctx)), ctx)
    }
  }
  if ((name == "exit") || (name == "exit_c")) && hasName(ctx.sigs.fnNames, name).not {
    cn = "simpler_exit"
    if (args.length == 1).not {
      failAt("exit takes the exit status, one Int", ctx)
    }
    if (exprType(args.at(0), ctx) == "Int").not {
      failAt("exit takes the exit status as an Int, got ".concat(exprType(args.at(0), ctx)), ctx)
    }
  }
  if hasName(ctx.sigs.fnNames, name) {
    cn = mangle(name)
  }
  cn.concat("(").concat(emitArgs(args, ctx)).concat(")")
}

// A function's value (its last bare expression) must match its declared return
// type. `match` bodies are skipped: their type is not inferred. main has no
// return type.
checkReturn(f : Fn, ctx : Ctx) : Int !Mut {
  if isMain(f.name).not {
    n = f.body.length
    if n > 0 {
      checkReturnStmt(f.body.at(n - 1), f.ret, ctx)
    }
  }
  0
}

checkReturnStmt(s : Stmt, ret : Str, ctx : Ctx) : Int !Mut {
  s.match {
    Bare(e) -> checkRetExpr(e, ret, ctx)
    Let(name, ty, v) -> 0
    If(c, t, el) -> 0
    While(c, b) -> 0
    Ret(e) -> checkRetExpr(e, ret, ctx)
    Line(n) -> 0
    Jump(w) -> 0
  }
}

checkRetExpr(e : Expr, ret : Str, ctx : Ctx) : Int !Mut {
  if isMatchExpr(e).not {
    at = exprType(e, ctx)
    if compatible(ret, at, ctx).not {
      failAt("return type mismatch: declared ".concat(ret).concat(", got ").concat(at), ctx)
    }
  }
  0
}

isMatchExpr(e : Expr) : Bool {
  e.match {
    Match(scrut, arms) -> true
    Num(v) -> false
    FloatLit(s) -> false
    Var(s) -> false
    StrLit(s) -> false
    ListLit(es) -> false
    Bin(op, a, b) -> false
    Call(name, args) -> false
    Field(recv, fld) -> false
    Method(recv, name, args) -> false
    Each(recv, param, body) -> false
  }
}

// A call to a user function checks arguments against the declared parameter
// types; a record constructor checks them against the field types (positional,
// in declaration order, which the emitter requires). Variant constructors and
// builtins are in neither table and are skipped.
checkCall(name : Str, args : List[Expr], ctx : Ctx) : Int !Mut {
  fns = ctx.sigs.fns
  k = 0
  m = fns.length
  while k < m {
    f = fns.at(k)
    if f.name == name {
      if (args.length == f.params.length).not {
        failAt(name.concat(" takes ").concat(f.params.length.toStr).concat(" values, got ").concat(args.length.toStr), ctx)
      }
      checkArgTypes(name, f.ptypes, args, ctx)
    }
    k = k + 1
  }
  recs = ctx.sigs.records
  k = 0
  m = recs.length
  while k < m {
    rec = recs.at(k)
    if rec.name == name {
      if (args.length == rec.ftypes.length).not {
        failAt(name.concat(" has ").concat(rec.ftypes.length.toStr).concat(" fields, got ").concat(args.length.toStr).concat(": a missing field or one too many"), ctx)
      }
      checkArgTypes(name, rec.ftypes, args, ctx)
    }
    k = k + 1
  }
  types = ctx.sigs.types
  k = 0
  m = types.length
  while k < m {
    ar = caseArityIn(types.at(k), name)
    if (ar < 0).not && (args.length == ar).not {
      failAt("case ".concat(name).concat(" takes ").concat(ar.toStr).concat(" values, got ").concat(args.length.toStr), ctx)
    }
    k = k + 1
  }
  0
}

checkArgTypes(name : Str, ptypes : List[Str], args : List[Expr], ctx : Ctx) : Int !Mut {
  n = args.length
  if n == ptypes.length {
    k = 0
    while k < n {
      pt = ptypes.at(k)
      at = exprType(args.at(k), ctx)
      if compatible(pt, at, ctx).not {
        failAt("argument ".concat((k + 1).toStr).concat(" of ").concat(name).concat(": expects ").concat(pt).concat(", got ").concat(at), ctx)
      }
      k = k + 1
    }
  }
  0
}

// Two types are compatible when they match, when either is unknown (the
// inference is permissive on purpose), or when both are lists (the uniform
// representation makes element types interchangeable for passing).
compatible(want : Str, got : Str, ctx : Ctx) : Bool {
  r = false
  if want == got {
    r = true
  }
  if want == "" {
    r = true
  }
  if got == "" {
    r = true
  }
  if intLike(want).and(intLike(got)) {
    r = true
  }
  if isListType(want).and(isListType(got)) {
    r = true
  }
  r
}

// Bool is represented as Int, so the two are interchangeable for passing.
intLike(t : Str) : Bool {
  (t == "Int").or(t == "Bool")
}

// A type that is clearly not an Int: a string, a list, or a user type.
notInt(t : Str, ctx : Ctx) : Bool {
  r = false
  if t == "Str" {
    r = true
  }
  if isListType(t) {
    r = true
  }
  if isRec(t, ctx) {
    r = true
  }
  if isVariant(t, ctx) {
    r = true
  }
  r
}

// A bare name is a local, or a payload-less variant constructor (which has
// the variant's type, e.g. `Neg` is a `Sign`).
varType(s : Str, ctx : Ctx) : Str {
  r = envGet(ctx.env, s)
  if (s == "true") || (s == "false") {
    r = "Bool"
  }
  vt = variantOf(s, ctx)
  if (vt == "").not {
    r = vt
  }
  r
}

isVariant(t : Str, ctx : Ctx) : Bool {
  found = false
  types = ctx.sigs.types
  k = 0
  m = types.length
  while k < m {
    if types.at(k).name == t {
      found = true
    }
    k = k + 1
  }
  found
}

// The full-screen terminal: sizes, one key, clear and stop.
emitTermField(fld : Str, ctx : Ctx) : Str {
  r = ""
  if fld == "key" {
    r = "simpler_term_key()"
  }
  if fld == "rows" {
    r = "simpler_term_size(0)"
  }
  if fld == "cols" {
    r = "simpler_term_size(1)"
  }
  if fld == "clear" {
    r = "simpler_term_clear()"
  }
  if fld == "stop" {
    r = "simpler_term_stop()"
  }
  if r == "" {
    failAt("a Term has key, rows, cols, clear, stop and put(row, col, text, style); it has no ".concat(fld), ctx)
  }
  r
}

// A `.field` is a record field read, or a no-argument method on a builtin.
emitField(recv : Expr, fld : Str, ctx : Ctx) : Str !Mut {
  t = exprType(recv, ctx)
  if t == "Term" {
    return emitTermField(fld, ctx)
  }
  checkSysField(t, fld, ctx)
  checkField(t, fld, ctx)
  recvC = emitExpr(recv, ctx)
  r = "((R_".concat(t).concat("*)(intptr_t)").concat(recvC).concat(")->").concat(fld)
  if isRec(t, ctx).not {
    if fld == "length" {
      r = "s_len(".concat(recvC).concat(")")
      if t == "Bytes" {
        r = "y_len(".concat(recvC).concat(")")
      }
      if isListType(t) {
        r = "l_len(".concat(recvC).concat(")")
      }
    }
    if fld == "code" {
      r = "s_code(".concat(recvC).concat(")")
    }
    if fld == "toStr" {
      r = "i_tostr(".concat(recvC).concat(")")
      if t == "Float" {
        r = "f_tostr(".concat(recvC).concat(")")
      }
      if t == "Bool" {
        r = "(long)(intptr_t)((".concat(recvC).concat(") ? \"true\" : \"false\")")
      }
    }
    if fld == "isInt" {
      r = "s_isint(".concat(recvC).concat(")")
    }
    if fld == "toInt" {
      r = "s_tointc(".concat(recvC).concat(", ").concat(envGet(ctx.env, "__line__")).concat(")")
      if t == "Float" {
        r = "f_toi(".concat(recvC).concat(")")
      }
    }
    if fld == "toFloat" {
      r = "i_tof(".concat(recvC).concat(")")
      if t == "Str" {
        r = "s_tofloat(".concat(recvC).concat(")")
      }
    }
    if fld == "trim" {
      r = "s_trim(".concat(recvC).concat(")")
    }
    if fld == "upper" {
      r = "s_case(".concat(recvC).concat(", 1)")
    }
    if fld == "bytes" {
      r = "s_bytes(".concat(recvC).concat(")")
    }
    if fld == "jsonItems" {
      r = "s_jsonlist(".concat(recvC).concat(", 0)")
    }
    if fld == "jsonKeys" {
      r = "s_jsonlist(".concat(recvC).concat(", 1)")
    }
    if fld == "lower" {
      r = "s_case(".concat(recvC).concat(", 0)")
    }
    if fld == "sin" {
      r = "d2l(sin(l2d(".concat(recvC).concat(")))")
    }
    if fld == "cos" {
      r = "d2l(cos(l2d(".concat(recvC).concat(")))")
    }
    if fld == "tan" {
      r = "d2l(tan(l2d(".concat(recvC).concat(")))")
    }
    if fld == "asin" {
      r = "d2l(asin(l2d(".concat(recvC).concat(")))")
    }
    if fld == "acos" {
      r = "d2l(acos(l2d(".concat(recvC).concat(")))")
    }
    if fld == "sqrt" {
      r = "d2l(sqrt(l2d(".concat(recvC).concat(")))")
    }
    if fld == "floor" {
      r = "d2l(floor(l2d(".concat(recvC).concat(")))")
    }
    if fld == "abs" {
      r = "d2l(fabs(l2d(".concat(recvC).concat(")))")
      if t == "Int" {
        r = "labs(".concat(recvC).concat(")")
      }
    }
    if fld == "atan" {
      r = "d2l(atan(l2d(".concat(recvC).concat(")))")
    }
    if (fld == "ceil") || (fld == "ceil_c") {
      r = "d2l(ceil(l2d(".concat(recvC).concat(")))")
    }
    if (fld == "round") || (fld == "round_c") {
      r = "d2l(round(l2d(".concat(recvC).concat(")))")
    }
    if fld == "ln" {
      r = "d2l(log(l2d(".concat(recvC).concat(")))")
    }
    if fld == "exp" {
      r = "d2l(exp(l2d(".concat(recvC).concat(")))")
    }
    if fld == "not" {
      r = "(!".concat(recvC).concat(")")
    }
    if isCapField(fld) {
      r = "0"
    }
    if fld == "args" {
      r = "simpler_args(argc, argv)"
    }
    if fld == "stdin" {
      r = "simpler_stdin()"
    }
    if fld == "stdinLine" {
      r = "simpler_stdinline()"
    }
    if fld == "now" {
      if t != "Clock" {
        failAt(".now needs a Clock handed down from main, got ".concat(capShow(t)), ctx)
      }
      r = "simpler_now()"
    }
    if fld == "self" {
      if t != "Env" {
        failAt(".self is the program's own path and needs sys.env, got ".concat(capShow(t)), ctx)
      }
      r = "simpler_self()"
    }
    if fld == "millis" {
      if t != "Clock" {
        failAt(".millis needs a Clock handed down from main, got ".concat(capShow(t)), ctx)
      }
      r = "simpler_millis()"
    }
    if (fld == "char") || (fld == "char_c") {
      if t != "Int" {
        failAt(".char turns a number into its character and needs an Int, got ".concat(capShow(t)), ctx)
      }
      r = "i_char(".concat(recvC).concat(")")
    }
    if fld == "keys" {
      r = "m_keys(".concat(recvC).concat(")")
    }
    if fld == "byValue" {
      r = "m_byvalue(".concat(recvC).concat(")")
    }
    if fld == "sort" {
      flag = "0"
      if elemOf(t) == "Str" {
        flag = "1"
      }
      r = "l_sort(".concat(recvC).concat(", ").concat(flag).concat(")")
    }
  }
  if useUFCS(t, fld, ctx) {
    r = mangle(fld).concat("(").concat(recvC).concat(")")
  }
  r
}

// The capability accessors on `sys`: erased at runtime, so they emit as 0.
isCapField(fld : Str) : Bool {
  (fld == "screen").or(fld == "files").or(fld == "mail").or(fld == "programs").or(fld == "net").or(fld == "clock").or(fld == "env").or(fld == "term")
}

// The no-argument builtin fields, so UFCS never shadows one.
isBuiltinField(fld : Str) : Bool {
  (fld == "length").or(fld == "code").or(fld == "toStr").or(fld == "toInt").or(fld == "isInt").or(fld == "toFloat").or(fld == "trim").or(fld == "upper").or(fld == "lower").or(fld == "jsonItems").or(fld == "jsonKeys").or(fld == "bytes").or(fld == "not").or(fld == "keys").or(fld == "byValue").or(fld == "sort").or(fld == "args").or(fld == "stdin").or(fld == "stdinLine").or(fld == "now").or(fld == "millis").or(fld == "self").or(fld == "char").or(fld == "char_c").or(isMathField(fld)).or(isCapField(fld))
}

// The unary Float math fields, wrappers over libm (programs that use them link
// with -lm). Each is Float -> Float.
isMathField(fld : Str) : Bool {
  (fld == "sin").or(fld == "cos").or(fld == "tan").or(fld == "asin").or(fld == "acos").or(fld == "atan").or(fld == "sqrt").or(fld == "floor").or(fld == "ceil").or(fld == "round").or(fld == "ceil_c").or(fld == "round_c").or(fld == "ln").or(fld == "exp").or(fld == "abs")
}

// Does record type `t` declare a field named `fld`?
recHasField(t : Str, fld : Str, ctx : Ctx) : Bool {
  found = false
  recs = ctx.sigs.records
  k = 0
  m = recs.length
  while k < m {
    rec = recs.at(k)
    if rec.name == t {
      if hasName(rec.fields, fld) {
        found = true
      }
    }
    k = k + 1
  }
  found
}

// Uniform function call: `x.f` means `f(x)` when `f` is a user function and is
// not a builtin field or a real field of `x`. This makes a user function and a
// method the same kind of brick, so `data.parse.normalize.render` is exactly
// `render(normalize(parse(data)))` and you can package that into one word.
useUFCS(t : Str, fld : Str, ctx : Ctx) : Bool {
  r = false
  if hasName(ctx.sigs.fnNames, fld) {
    if isBuiltinField(fld).not {
      if recHasField(t, fld, ctx).not {
        r = true
      }
    }
  }
  r
}

// A `.method(args)` on a builtin value.
// --- capabilities: a function reaches the world only through a value it
// was handed. `.print` needs a Screen, file calls a Files, `.send` a Mail, and
// those come only from `sys`, which only main holds.
capNeed(name : Str) : Str {
  r = ""
  if (name == "print") || (name == "part") || (name == "error") {
    r = "Screen"
  }
  if (name == "read").or(name == "write").or(name == "readBytes").or(name == "writeBytes").or(name == "append").or(name == "list").or(name == "exists").or(name == "wait").or(name == "rename").or(name == "delete") {
    r = "Files"
  }
  if name == "send" {
    r = "Mail"
  }
  if (name == "run") || (name == "status") || (name == "start") || (name == "try") || (name == "feed") {
    r = "Programs"
  }
  if (name == "fetch") || (name == "post") || (name == "reach") || (name == "fetchWith") {
    r = "Net"
  }
  if (name == "date") || (name == "dateAs") || (name == "secsOf") || (name == "sleep") {
    r = "Clock"
  }
  if (name == "var") || (name == "setVar") {
    r = "Env"
  }
  r
}

checkCap(recv : Expr, name : Str, ctx : Ctx) : Int !Mut {
  need = capNeed(name)
  if (need == "").not {
    t = exprType(recv, ctx)
    if (t == need).not {
      failAt(".".concat(name).concat(" needs a ").concat(need).concat(" handed down from main, got ").concat(capShow(t)), ctx)
    }
  }
  0
}

wantType(e : Expr, want : Str, name : Str, ctx : Ctx) : Int !Mut {
  got = exprType(e, ctx)
  if compatible(want, got, ctx).not {
    failAt(name.concat(" expects ").concat(want).concat(", got ").concat(got), ctx)
  }
  0
}

capShow(t : Str) : Str {
  r = t
  if t == "" {
    r = "a value with no type"
  }
  r
}

// A field or a no-argument method must exist on the type it is read from.
checkField(t : Str, fld : Str, ctx : Ctx) : Int {
  if useUFCS(t, fld, ctx).not {
    if isRec(t, ctx) && recHasField(t, fld, ctx).not {
      failAt(t.concat(" has no field ").concat(fld), ctx)
    }
    if isVariant(t, ctx) {
      failAt(t.concat(" is a variant and has no field ").concat(fld).concat("; read it with match"), ctx)
    }
    if isNumType(t) && isTextField(fld) {
      failAt(t.concat(" has no method ").concat(fld), ctx)
    }
    if (t == "Bytes") && (fld != "length") {
      failAt("Bytes has length, at(i), intAt(i, n), floatAt(i), textAt(i, n) and findByte(n, from); no ".concat(fld), ctx)
    }
    if isRec(t, ctx).not && isBuiltinField(fld).not {
      failAt("no field or function named ".concat(fld), ctx)
    }
  }
  0
}

isNumType(t : Str) : Bool {
  (t == "Int") || (t == "Float") || (t == "Bool")
}

isTextField(fld : Str) : Bool {
  (fld == "length") || (fld == "trim") || (fld == "upper") || (fld == "lower") || (fld == "jsonItems") || (fld == "jsonKeys") || (fld == "bytes") || (fld == "code") || (fld == "isInt") || (fld == "keys") || (fld == "byValue") || (fld == "sort")
}

isTextMethod(name : Str) : Bool {
  (name == "concat") || (name == "slice") || (name == "split") || (name == "contains") || (name == "find") || (name == "json") || (name == "reTest") || (name == "reFind") || (name == "reAll") || (name == "reSplit") || (name == "reReplace") || (name == "join") || (name == "startsWith") || (name == "endsWith") || (name == "replace") || (name == "at") || (name == "push") || (name == "padLeft") || (name == "padRight")
}

// A method must exist on its receiver, and `at` / `push` take the right type.
checkMethod(t : Str, name : Str, args : List[Expr], ctx : Ctx) : Int !Mut {
  if true {
    if isNumType(t) && isTextMethod(name) {
      failAt(t.concat(" has no method ").concat(name), ctx)
    }
    if (t == "Bytes") && (name != "at") && (name != "intAt") && (name != "floatAt") && (name != "textAt") && (name != "findByte") {
      failAt("Bytes has length, at(i), intAt(i, n), floatAt(i), textAt(i, n) and findByte(n, from); no ".concat(name), ctx)
    }
    if (name == "at") && (args.length == 1) {
      at = exprType(args.at(0), ctx)
      if (at == "Str") || (at == "Float") {
        failAt("at expects Int, got ".concat(at), ctx)
      }
    }
    if (name == "push") && isListType(t) && (args.length == 1) {
      pt = exprType(args.at(0), ctx)
      if compatible(elemOf(t), pt, ctx).not {
        failAt("push expects ".concat(elemOf(t)).concat(", got ").concat(pt), ctx)
      }
    }
    if (name == "set") && isListType(t) && (args.length == 2) {
      if exprType(args.at(0), ctx) != "Int" {
        failAt("set on a list expects the place as an Int, got ".concat(exprType(args.at(0), ctx)), ctx)
      }
      pt = exprType(args.at(1), ctx)
      if compatible(elemOf(t), pt, ctx).not {
        failAt("set expects ".concat(elemOf(t)).concat(", got ").concat(pt), ctx)
      }
    }
    if (name == "join") && (args.length == 1) {
      if t != "List[Str]" {
        failAt("join puts a list of texts together; ".concat(t).concat(" has no method join"), ctx)
      }
      if exprType(args.at(0), ctx) != "Str" {
        failAt("join expects the text to put between, got ".concat(exprType(args.at(0), ctx)), ctx)
      }
    }
    if name == "findByte" {
      if (t != "Bytes") || (exprType(args.at(0), ctx) != "Int") || (exprType(args.at(1), ctx) != "Int") {
        failAt("findByte(n, from) gives the place of the next byte n in Bytes, or -1", ctx)
      }
    }
    if (name == "textAt") || (name == "intAt") || (name == "floatAt") {
      if (t != "List[Int]") && (t != "Bytes") {
        failAt(name.concat(" reads from Bytes or a List[Int]; got ").concat(t), ctx)
      }
      for a in args {
        if exprType(a, ctx) != "Int" {
          failAt(name.concat(" expects Int, got ").concat(exprType(a, ctx)), ctx)
        }
      }
    }
    if (name == "writeBytes") && (args.length == 2) {
      if exprType(args.at(1), ctx) != "List[Int]" {
        failAt("writeBytes takes a path and a List[Int] of bytes, got ".concat(exprType(args.at(1), ctx)), ctx)
      }
    }
    if ((name == "print") || (name == "part") || (name == "error")) && (args.length == 1) {
      if exprType(args.at(0), ctx) == "Bytes" {
        failAt("Bytes cannot be printed; print a part with textAt(i, n) or a number with at(i)", ctx)
      }
    }
    if (name == "reTest") || (name == "reFind") || (name == "reAll") || (name == "reSplit") || (name == "reReplace") {
      if t != "Str" {
        failAt(name.concat(" looks for a pattern in a text; got ").concat(t), ctx)
      }
      for a in args {
        if exprType(a, ctx) != "Str" {
          failAt(name.concat(" takes its pattern as a text, got ").concat(exprType(a, ctx)), ctx)
        }
      }
    }
    if (name == "json") && (args.length == 1) {
      if (t != "Str") || (exprType(args.at(0), ctx) != "Str") {
        failAt("json takes a key or a place as a text, and gives the value there as a text", ctx)
      }
    }
    if (name == "find") && (args.length == 1) {
      if (t != "Str") || (exprType(args.at(0), ctx) != "Str") {
        failAt("find looks for a text in a text and gives its place, or -1", ctx)
      }
    }
    if (name == "remove") && anyMap(t) {
      if exprType(args.at(0), ctx) != "Str" {
        failAt("remove on a map expects the key as a Str, got ".concat(exprType(args.at(0), ctx)), ctx)
      }
    }
    if (name == "remove") && anyMap(t).not {
      if isListType(t).not {
        failAt("remove takes an item out of a list or a key out of a map; ".concat(t).concat(" has no method remove"), ctx)
      }
      if exprType(args.at(0), ctx) != "Int" {
        failAt("remove expects the place as an Int, got ".concat(exprType(args.at(0), ctx)), ctx)
      }
    }
  }
  0
}

isSysField(fld : Str) : Bool {
  isCapField(fld).or(fld == "args").or(fld == "stdin").or(fld == "stdinLine")
}

checkSysField(t : Str, fld : Str, ctx : Ctx) : Int {
  if isSysField(fld) {
    if isRec(t, ctx).not {
      if (t == "Sys").not {
        failAt(".".concat(fld).concat(" exists only on main's world value; pass it down as a parameter"), ctx)
      }
    }
  }
  0
}

// How many values a built-in method takes; -1 for a name that is no method.
methodArgs(name : Str) : Int {
  r = 0 - 1
  if isTextMethod(name) || (name == "print") || (name == "read") || (name == "list") || (name == "exists") || (name == "wait") || (name == "sleep") || (name == "delete") || (name == "remove") || (name == "bitAnd") || (name == "bitOr") || (name == "bitXor") || (name == "shl") || (name == "shr") || (name == "fetch") || (name == "reach") || (name == "part") || (name == "error") || (name == "atan2") || (name == "pow") || (name == "atan2_c") || (name == "pow_c") || (name == "readBytes") || (name == "floatAt") || (name == "secsOf") || (name == "date") || (name == "var") || (name == "mod") || (name == "atan2") || (name == "get") || (name == "has") || (name == "ge") || (name == "le") || (name == "and") || (name == "or") || (name == "send") {
    r = 1
  }
  if (name == "setVar") || (name == "slice") || (name == "replace") || (name == "write") || (name == "append") || (name == "rename") || (name == "set") || (name == "run") || (name == "status") || (name == "start") || (name == "try") || (name == "post") || (name == "fetchWith") || (name == "dateAs") || (name == "writeBytes") || (name == "textAt") || (name == "intAt") || (name == "findByte") || (name == "reReplace") {
    r = 2
  }
  if (name == "feed") || (name == "send") {
    r = 3
  }
  r
}

emitSetField(recv : Expr, fld : Str, args : List[Expr], ctx : Ctx) : Str !Mut {
  t = exprType(recv, ctx)
  if isRec(t, ctx).not {
    failAt("only a field of a record can be set with =, and this is ".concat(capShow(t)), ctx)
  }
  checkField(t, fld, ctx)
  wantType(args.at(0), fieldType(recv, fld, ctx), ".".concat(fld), ctx)
  recvC = emitExpr(recv, ctx)
  "(((R_".concat(t).concat("*)(intptr_t)").concat(recvC).concat(")->").concat(fld).concat(" = ").concat(emitExpr(args.at(0), ctx)).concat(", 0L)")
}

emitMethod0(recv : Expr, name : Str, args : List[Expr], ctx : Ctx) : Str !Mut {
  if isSetField(name) {
    return emitSetField(recv, name.slice(1, name.length), args, ctx)
  }
  rv = rootVar(recv)
  if (rv != "") && (capNeed(name) == "") && (rv != "sys") && (rv != "true") && (rv != "false") && (variantOf(rv, ctx) == "") && (envOld(ctx.env, rv) == "__gone__") {
    failAt("no variable named ".concat(rv).concat("; if it is a module, put  uses \"").concat(rv).concat("\"  at the top"), ctx)
  }
  t = exprType(recv, ctx)
  if t == "Term" {
    if (name != "put") || (args.length != 4) {
      failAt("a Term has key, rows, cols, clear, stop and put(row, col, text, style)", ctx)
    }
    wantType(args.at(0), "Int", "put", ctx)
    wantType(args.at(1), "Int", "put", ctx)
    wantType(args.at(2), "Str", "put", ctx)
    wantType(args.at(3), "Str", "put", ctx)
    return "simpler_term_put(".concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(emitExpr(args.at(2), ctx)).concat(", ").concat(emitExpr(args.at(3), ctx)).concat(", ").concat(envGet(ctx.env, "__line__")).concat(")")
  }
  checkCap(recv, name, ctx)
  want = methodArgs(name)
  if want < 0 {
    failAt("no method named ".concat(name), ctx)
  }
  if (args.length == want).not {
    failAt(name.concat(" takes ").concat(want.toStr).concat(" values, got ").concat(args.length.toStr), ctx)
  }
  if name == "print" {
    if exprType(args.at(0), ctx) == "Bytes" {
      failAt("Bytes cannot be printed; print a part with textAt(i, n) or a number with at(i)", ctx)
    }
    emitExpr(recv, ctx)
    return "(".concat(emitPrint(args.at(0), ctx)).concat(", 0L)")
  }
  checkMethod(t, name, args, ctx)
  recvC = emitExpr(recv, ctx)
  ln = envGet(ctx.env, "__line__")
  r = "0"
  if name == "concat" {
    r = "s_concat(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "slice" {
    cut = "s_slicec("
    if isListType(t) {
      cut = "l_slicec("
    }
    wantType(args.at(0), "Int", name, ctx)
    wantType(args.at(1), "Int", name, ctx)
    r = cut.concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(ln).concat(")")
  }
  if name == "at" {
    r = "s_atc(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(ln).concat(")")
    if t == "Bytes" {
      r = "y_atc(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(ln).concat(")")
    }
    if isListType(t) {
      r = "l_atc(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(ln).concat(")")
    }
  }
  if name == "push" {
    r = "l_push(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if (name == "run") || (name == "status") || (name == "start") || (name == "try") {
    runCheck(args.at(0), ctx)
    wantType(args.at(0), "Str", name, ctx)
    wantType(args.at(1), "List[Str]", name, ctx)
    mid = ", "
    if name == "run" {
      mid = ", 0, "
    }
    r = "simpler_".concat(name).concat("(").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(mid).concat(ln).concat(")")
  }
  if name == "feed" {
    runCheck(args.at(0), ctx)
    wantType(args.at(0), "Str", name, ctx)
    wantType(args.at(1), "List[Str]", name, ctx)
    wantType(args.at(2), "Str", name, ctx)
    r = "simpler_run(".concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(emitExpr(args.at(2), ctx)).concat(", ").concat(ln).concat(")")
  }
  if name == "reach" {
    fetchCheck(args.at(0), ctx)
    wantType(args.at(0), "Str", name, ctx)
    r = "simpler_reach(".concat(emitExpr(args.at(0), ctx)).concat(", ").concat(ln).concat(")")
  }
  if name == "send" {
    mailCheck(args.at(0), ctx)
    wantType(args.at(0), "Str", name, ctx)
    wantType(args.at(1), "Str", name, ctx)
    wantType(args.at(2), "Str", name, ctx)
    r = "simpler_send(".concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(emitExpr(args.at(2), ctx)).concat(", ").concat(ln).concat(")")
  }
  if name == "fetch" {
    fetchCheck(args.at(0), ctx)
    wantType(args.at(0), "Str", name, ctx)
    r = "simpler_fetch(".concat(emitExpr(args.at(0), ctx)).concat(", 0, 0, ").concat(ln).concat(")")
  }
  if name == "post" {
    fetchCheck(args.at(0), ctx)
    wantType(args.at(0), "Str", name, ctx)
    wantType(args.at(1), "Str", name, ctx)
    r = "simpler_fetch(".concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", 1, ").concat(ln).concat(")")
  }
  if name == "date" {
    wantType(args.at(0), "Int", name, ctx)
    r = "simpler_date(".concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "dateAs" {
    wantType(args.at(0), "Int", name, ctx)
    wantType(args.at(1), "Str", name, ctx)
    r = "simpler_stamp(".concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(")")
  }
  if name == "sleep" {
    wantType(args.at(0), "Int", name, ctx)
    r = "simpler_sleep(".concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "wait" {
    mayCheck(args.at(0), ctx.sigs.reads, "read", "reads", ctx)
    r = "simpler_wait(simpler_may(".concat(emitExpr(args.at(0), ctx)).concat(", simpler_rd, ").concat(ln).concat(", \"read\"), ").concat(ln).concat(")")
  }
  if name == "secsOf" {
    wantType(args.at(0), "Str", name, ctx)
    r = "simpler_secs(".concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "error" {
    wantType(args.at(0), "Str", name, ctx)
    r = "(fflush(stdout), fputs((const char*)(intptr_t)".concat(emitExpr(args.at(0), ctx)).concat(", stderr), fputc(10, stderr), 0L)")
  }
  if name == "part" {
    wantType(args.at(0), "Str", name, ctx)
    r = "(fputs((const char*)(intptr_t)".concat(emitExpr(args.at(0), ctx)).concat(", stdout), 0L)")
  }
  if name == "fetchWith" {
    fetchCheck(args.at(0), ctx)
    wantType(args.at(0), "Str", name, ctx)
    wantType(args.at(1), "List[Str]", name, ctx)
    r = "simpler_fetchwith(".concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(ln).concat(")")
  }
  if name == "var" {
    wantType(args.at(0), "Str", name, ctx)
    r = "simpler_env(".concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "setVar" {
    wantType(args.at(0), "Str", name, ctx)
    wantType(args.at(1), "Str", name, ctx)
    r = "simpler_setenv(".concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(")")
  }
  if name == "read" {
    mayCheck(args.at(0), ctx.sigs.reads, "read", "reads", ctx)
    r = "(long)(intptr_t)simpler_read((const char*)(intptr_t)simpler_may(".concat(emitExpr(args.at(0), ctx)).concat(", simpler_rd, ").concat(ln).concat(", \"read\"))")
  }
  if name == "readBytes" {
    mayCheck(args.at(0), ctx.sigs.reads, "read", "reads", ctx)
    r = "simpler_readbytes((const char*)(intptr_t)simpler_may(".concat(emitExpr(args.at(0), ctx)).concat(", simpler_rd, ").concat(ln).concat(", \"read\"))")
  }
  if name == "writeBytes" {
    mayCheck(args.at(0), ctx.sigs.writes, "write", "writes", ctx)
    r = "simpler_writebytes(simpler_may(".concat(emitExpr(args.at(0), ctx)).concat(", simpler_wr, ").concat(ln).concat(", \"write\"), ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(ln).concat(")")
  }
  if name == "findByte" {
    r = "y_find(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(")")
  }
  if name == "textAt" {
    r = "b_text(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(ln).concat(")")
    if t == "Bytes" {
      r = "y_text(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(ln).concat(")")
    }
  }
  if name == "intAt" {
    r = "b_int(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(ln).concat(")")
    if t == "Bytes" {
      r = "y_int(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(ln).concat(")")
    }
  }
  if (name == "atan2") || (name == "pow") || (name == "atan2_c") || (name == "pow_c") {
    if (t != "Float") || (exprType(args.at(0), ctx) != "Float") {
      failAt("atan2 and pow work on two Float numbers: y.atan2(x), x.pow(y)", ctx)
    }
    cf = "pow"
    if name.startsWith("atan2") {
      cf = "atan2"
    }
    r = "d2l(".concat(cf).concat("(l2d(").concat(recvC).concat("), l2d(").concat(emitExpr(args.at(0), ctx)).concat(")))")
  }
  if name == "floatAt" {
    r = "b_float(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(ln).concat(")")
    if t == "Bytes" {
      r = "y_float(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(ln).concat(")")
    }
  }
  if name == "write" {
    mayCheck(args.at(0), ctx.sigs.writes, "write", "writes", ctx)
    r = "simpler_write(simpler_may(".concat(emitExpr(args.at(0), ctx)).concat(", simpler_wr, ").concat(ln).concat(", \"write\"), ").concat(emitExpr(args.at(1), ctx)).concat(")")
  }
  if name == "append" {
    mayCheck(args.at(0), ctx.sigs.writes, "write", "writes", ctx)
    r = "simpler_append(simpler_may(".concat(emitExpr(args.at(0), ctx)).concat(", simpler_wr, ").concat(ln).concat(", \"write\"), ").concat(emitExpr(args.at(1), ctx)).concat(")")
  }
  if name == "list" {
    mayCheck(args.at(0), ctx.sigs.reads, "list", "reads", ctx)
    r = "simpler_list(simpler_may(simpler_dir(".concat(emitExpr(args.at(0), ctx)).concat("), simpler_rd, ").concat(ln).concat(", \"list\"))")
  }
  if name == "exists" {
    mayCheck(args.at(0), ctx.sigs.reads, "read", "reads", ctx)
    r = "simpler_exists(simpler_may(".concat(emitExpr(args.at(0), ctx)).concat(", simpler_rd, ").concat(ln).concat(", \"read\"))")
  }
  if name == "rename" {
    mayCheck(args.at(0), ctx.sigs.writes, "write", "writes", ctx)
    mayCheck(args.at(1), ctx.sigs.writes, "write", "writes", ctx)
    r = "simpler_rename(simpler_may(".concat(emitExpr(args.at(0), ctx)).concat(", simpler_wr, ").concat(ln).concat(", \"write\"), simpler_may(").concat(emitExpr(args.at(1), ctx)).concat(", simpler_wr, ").concat(ln).concat(", \"write\"), ").concat(ln).concat(")")
  }
  if name == "delete" {
    mayCheck(args.at(0), ctx.sigs.writes, "write", "writes", ctx)
    r = "simpler_delete(simpler_may(".concat(emitExpr(args.at(0), ctx)).concat(", simpler_wr, ").concat(ln).concat(", \"write\"), ").concat(ln).concat(")")
  }
  if name == "split" {
    r = "s_split(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "contains" {
    r = "s_contains(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "find" {
    r = "s_find(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if (name == "reTest") || (name == "reFind") || (name == "reAll") || (name == "reSplit") {
    r = "re_".concat(name.slice(2, name.length).lower).concat("(").concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(ln).concat(")")
  }
  if name == "reReplace" {
    r = "re_replace(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(ln).concat(")")
  }
  if name == "json" {
    r = "s_json(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "join" {
    r = "l_join(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "startsWith" {
    r = "s_starts(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "endsWith" {
    r = "s_ends(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "replace" {
    r = "s_replace(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(")")
  }
  if name == "mod" {
    r = "i_mod(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(ln).concat(")")
  }
  if name == "atan2" {
    r = "d2l(atan2(l2d(".concat(recvC).concat("), l2d(").concat(emitExpr(args.at(0), ctx)).concat(")))")
  }
  if name == "padLeft" {
    r = "s_padleft(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "padRight" {
    r = "s_padright(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "set" {
    r = "m_set(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(")")
    if isListType(t) {
      r = "l_setc(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(emitExpr(args.at(1), ctx)).concat(", ").concat(ln).concat(")")
    }
  }
  if name == "remove" {
    r = "l_removec(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(ln).concat(")")
    if anyMap(t) {
      r = "m_remove(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
    }
  }
  if (name == "bitAnd") || (name == "bitOr") || (name == "bitXor") || (name == "shl") || (name == "shr") {
    wantType(recv, "Int", name, ctx)
    wantType(args.at(0), "Int", name, ctx)
    bop = "&"
    if name == "bitOr" {
      bop = "|"
    }
    if name == "bitXor" {
      bop = "^"
    }
    r = "(".concat(recvC).concat(" ").concat(bop).concat(" ").concat(emitExpr(args.at(0), ctx)).concat(")")
    if name == "shl" {
      r = "(long)((unsigned long)".concat(recvC).concat(" << (").concat(emitExpr(args.at(0), ctx)).concat(" & 63))")
    }
    if name == "shr" {
      r = "(".concat(recvC).concat(" >> (").concat(emitExpr(args.at(0), ctx)).concat(" & 63))")
    }
  }
  if name == "get" {
    r = "m_get(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
    // a Str-valued map returns "" for an absent key, never a null pointer
    mv = mapValueOf(t)
    if mv == "Str" {
      r = "m_gets(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
    }
    // a map of lists or own types has no empty value to give: an absent key stops the program
    if isMapType(t) && (plainType(mv).not) {
      r = "m_getp(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(", ").concat(ln).concat(")")
    }
  }
  if name == "has" {
    r = "m_has(".concat(recvC).concat(", ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "ge" {
    r = "(".concat(recvC).concat(" >= ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "le" {
    r = "(".concat(recvC).concat(" <= ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "and" {
    r = "(".concat(recvC).concat(" && ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  if name == "or" {
    r = "(".concat(recvC).concat(" || ").concat(emitExpr(args.at(0), ctx)).concat(")")
  }
  r
}

// Re-escape a string for a C literal: the lexer already turned `\n` into a
// real newline, so turn it (and quotes and backslashes) back.
cEscape(s : Str) : Str {
  out = ""
  k = 0
  n = s.length
  while k < n {
    c = s.at(k).code
    piece = s.at(k)
    if c == 34 {
      piece = "\\\""
    }
    if c == 92 {
      piece = "\\\\"
    }
    if c == 10 {
      piece = "\\n"
    }
    if c == 9 {
      piece = "\\t"
    }
    if c == 13 {
      piece = "\\r"
    }
    out = out.concat(piece)
    k = k + 1
  }
  out
}

// A bare name is a local or enum constant, unless it is a payload-less
// constructor of a boxed variant, which needs a constructor call.
caseArity(name : Str, ctx : Ctx) : Int {
  r = 0 - 1
  ctx.sigs.types.each { t in
    a = caseArityIn(t, name)
    if a > r {
      r = a
    }
  }
  r
}

emitVar(s : Str, ctx : Ctx) : Str {
  vt = variantOf(s, ctx)
  if vt == "" {
    if (envOld(ctx.env, s) == "__gone__") && (s == "true").not && (s == "false").not {
      failAt("no variable named ".concat(s), ctx)
    }
  } else {
    ar = caseArity(s, ctx)
    if ar > 0 {
      failAt("case ".concat(s).concat(" takes ").concat(ar.toStr).concat(" values, got 0"), ctx)
    }
  }
  r = s
  if hasName(ctx.sigs.boxedNullary, s) {
    r = s.concat("()")
  }
  // main's world value has no form in C; a second name for it is just 0
  if vt == "" && envGet(ctx.env, s) == "Sys" {
    r = "0"
  }
  r
}

emitArgs(args : List[Expr], ctx : Ctx) : Str !Mut {
  out = ""
  k = 0
  m = args.length
  while k < m {
    if k > 0 {
      out = out.concat(", ")
    }
    out = out.concat(emitExpr(args.at(k), ctx))
    k = k + 1
  }
  out
}

// `a + b` on Floats is a Float; on Ints, an Int. Ordering and equality are
// always a Bool (Int), whatever the operands.
binType(op : Str, a : Expr, b : Expr, ctx : Ctx) : Str !Mut {
  r = "Int"
  if (op == "==") || (op == "<") || (op == ">") || (op == "<=") || (op == ">=") || (op == "&&") || (op == "||") {
    r = "Bool"
  }
  if op == "u-" {
    return exprType(b, ctx)
  }
  if r == "Bool" {
    return r
  }
  // Ask for the left side's type once: asking twice doubles the work at each + of a chain.
  ta = exprType(a, ctx)
  if op == "+" {
    if ta == "Str" {
      r = "Str"
    }
  }
  if ta == "Float" {
    if isFloatArith(op) {
      r = "Float"
    }
  }
  r
}

// The static type of an expression, enough to dispatch methods and print.
exprType(e : Expr, ctx : Ctx) : Str !Mut {
  e.match {
    Num(v) -> "Int"
    FloatLit(s) -> "Float"
    Var(s) -> varType(s, ctx)
    StrLit(s) -> "Str"
    ListLit(es) -> listType(es, ctx)
    Bin(op, a, b) -> binType(op, a, b, ctx)
    Call(name, args) -> callRet(name, ctx)
    Match(scrut, arms) -> matchType(scrut, arms, ctx)
    Field(recv, fld) -> fieldType(recv, fld, ctx)
    Method(recv, name, args) -> methodRet(recv, name, ctx)
    Each(recv, param, body) -> "Int"
  }
}

// A match has the type of its first arm, read with that arm's names typed.
matchType(scrut : Expr, arms : List[Arm], ctx : Ctx) : Str !Mut {
  r = "Int"
  if arms.length > 0 {
    a = arms.at(0)
    styp = exprType(scrut, ctx)
    olds = envOlds(ctx.env, a.binds)
    bi = 0
    while bi < a.binds.length {
      envPut(ctx.env, a.binds.at(bi), payloadType(styp, a.tag, bi, ctx))
      bi = bi + 1
    }
    r = exprType(a.body, ctx)
    envRestore(ctx.env, a.binds, olds)
  }
  r
}

// A `.field`: the declared type of a record field, or the result type of a
// no-arg method (`.toStr` yields a Str, the rest are Int-ish).
fieldType(recv : Expr, fld : Str, ctx : Ctx) : Str !Mut {
  t = exprType(recv, ctx)
  r = "Int"
  if (fld == "toStr") || (fld == "char") || (fld == "char_c") || (fld == "self") {
    r = "Str"
  }
  if fld == "toFloat" {
    r = "Float"
  }
  if (fld == "trim") || (fld == "upper") || (fld == "lower") {
    r = "Str"
  }
  if fld == "not" {
    r = "Bool"
  }
  if fld == "isInt" {
    r = "Bool"
  }
  if isMathField(fld) {
    r = "Float"
    if (fld == "abs") && (exprType(recv, ctx) == "Int") {
      r = "Int"
    }
  }
  if fld == "screen" {
    r = "Screen"
  }
  if fld == "files" {
    r = "Files"
  }
  if fld == "mail" {
    r = "Mail"
  }
  if fld == "programs" {
    r = "Programs"
  }
  if fld == "net" {
    r = "Net"
  }
  if fld == "clock" {
    r = "Clock"
  }
  if fld == "term" {
    r = "Term"
  }
  if t == "Term" {
    r = "Int"
    if fld == "key" {
      r = "Str"
    }
  }
  if fld == "env" {
    r = "Env"
  }
  if fld == "args" {
    r = "List[Str]"
  }
  if (fld == "stdin") || (fld == "stdinLine") {
    r = "Str"
  }
  if (fld == "keys") || (fld == "jsonItems") || (fld == "jsonKeys") {
    r = "List[Str]"
  }
  if fld == "bytes" {
    r = "List[Int]"
  }
  if fld == "byValue" {
    r = "List[Str]"
  }
  if fld == "sort" {
    r = t
  }
  if isRec(t, ctx) {
    r = recFieldType(t, fld, ctx)
  }
  if useUFCS(t, fld, ctx) {
    r = callRet(fld, ctx)
  }
  r
}

recFieldType(tyName : Str, fld : Str, ctx : Ctx) : Str {
  r = "Int"
  recs = ctx.sigs.records
  k = 0
  m = recs.length
  while k < m {
    rec = recs.at(k)
    if rec.name == tyName {
      r = fieldTypeIn(rec, fld)
    }
    k = k + 1
  }
  r
}

fieldTypeIn(rec : RecDef, fld : Str) : Str {
  r = "Int"
  k = 0
  m = rec.fields.length
  while k < m {
    if rec.fields.at(k) == fld {
      r = rec.ftypes.at(k)
    }
    k = k + 1
  }
  r
}

methodRet(recv : Expr, name : Str, ctx : Ctx) : Str !Mut {
  r = "Int"
  if name == "concat" {
    r = "Str"
  }
  if name == "slice" {
    r = "Str"
    if isListType(exprType(recv, ctx)) {
      r = exprType(recv, ctx)
    }
  }
  if (name == "read") || (name == "textAt") {
    r = "Str"
  }
  if name == "readBytes" {
    r = "Bytes"
  }
  if (name == "intAt") || (name == "findByte") {
    r = "Int"
  }
  if (name == "floatAt") || (name == "atan2") || (name == "pow") || (name == "atan2_c") || (name == "pow_c") {
    r = "Float"
  }
  if name == "exists" {
    r = "Bool"
  }
  if (name == "run") || (name == "try") || (name == "feed") || (name == "fetch") || (name == "post") || (name == "fetchWith") || (name == "dateAs") || (name == "date") || (name == "var") || (name == "wait") {
    r = "Str"
  }
  if (name == "split") || (name == "list") {
    r = "List[Str]"
  }
  if (name == "contains") || (name == "startsWith") || (name == "endsWith") {
    r = "Bool"
  }
  if (name == "replace") || (name == "json") || (name == "reReplace") {
    r = "Str"
  }
  if name == "reTest" {
    r = "Bool"
  }
  if (name == "reFind") || (name == "reSplit") {
    r = "List[Str]"
  }
  if name == "reAll" {
    r = "List[List[Str]]"
  }
  if name == "find" {
    r = "Int"
  }
  if name == "join" {
    r = "Str"
  }
  if name == "padLeft" {
    r = "Str"
  }
  if name == "padRight" {
    r = "Str"
  }
  if name == "atan2" {
    r = "Float"
  }
  if (name == "has") || (name == "and") || (name == "or") || (name == "ge") || (name == "le") {
    r = "Bool"
  }
  if name == "get" {
    r = mapValueOf(exprType(recv, ctx))
  }
  if name == "remove" {
    r = elemOf(exprType(recv, ctx))
    if anyMap(exprType(recv, ctx)) {
      r = "Int"
    }
  }
  if name == "at" {
    r = "Str"
    rt = exprType(recv, ctx)
    if rt == "Bytes" {
      r = "Int"
    }
    if isListType(rt) {
      r = elemOf(rt)
    }
  }
  r
}

// --- token helpers ------------------------------------------------------

isMain(name : Str) : Bool {
  name == "main"
}

notEof(toks : Lexed, i : Int) : Bool {
  tokAt(toks, i).match {
    Eof -> false
    Ident(s) -> true
    Int(v) -> true
    Float(f) -> true
    Str(s) -> true
    Punct(p) -> true
  }
}

inBlock(toks : Lexed, j : Int) : Bool {
  isPunct(toks, j, "}").not.and(notEof(toks, j))
}

inArgs(toks : Lexed, j : Int) : Bool {
  isPunct(toks, j, ")").not.and(notEof(toks, j))
}

isIdent(toks : Lexed, i : Int) : Bool {
  tokAt(toks, i).match {
    Ident(s) -> true
    Int(v) -> false
    Float(f) -> false
    Str(s) -> false
    Punct(p) -> false
    Eof -> false
  }
}

isWord(toks : Lexed, i : Int, w : Str) : Bool {
  tokAt(toks, i).match {
    Ident(s) -> s == w
    Int(v) -> false
    Float(f) -> false
    Str(s) -> false
    Punct(p) -> false
    Eof -> false
  }
}

isAssign(toks : Lexed, i : Int) : Bool {
  isIdent(toks, i).and(isPunct(toks, i + 1, "="))
}

identAt(toks : Lexed, i : Int) : Str {
  tokAt(toks, i).match {
    Ident(s) -> s
    Int(v) -> "?"
    Float(f) -> "?"
    Str(s) -> "?"
    Punct(p) -> "?"
    Eof -> "?"
  }
}

punctAt(toks : Lexed, i : Int) : Str {
  tokAt(toks, i).match {
    Punct(p) -> p
    Ident(s) -> "?"
    Int(v) -> "?"
    Float(f) -> "?"
    Str(s) -> "?"
    Eof -> "?"
  }
}

isPunct(toks : Lexed, i : Int, op : Str) : Bool {
  tokAt(toks, i).match {
    Punct(p) -> p == op
    Ident(s) -> false
    Int(v) -> false
    Float(f) -> false
    Str(s) -> false
    Eof -> false
  }
}

isCmpOp(toks : Lexed, i : Int) : Bool {
  isPunct(toks, i, "==").or(isPunct(toks, i, "!=")).or(isPunct(toks, i, "<")).or(isPunct(toks, i, ">")).or(isPunct(toks, i, "<=")).or(isPunct(toks, i, ">="))
}

isAddOp(toks : Lexed, i : Int) : Bool {
  isPunct(toks, i, "+").or(isPunct(toks, i, "-"))
}

isMulOp(toks : Lexed, i : Int) : Bool {
  isPunct(toks, i, "*").or(isPunct(toks, i, "/")).or(isPunct(toks, i, "%"))
}

// --- lex: the full Simpler token set ------------------------------------

lex(src : Str, files : List[Str]) : Lexed {
  toks : List[Tok] = []
  lines : List[Int] = []
  taken = cTaken()
  n = src.length
  i = 0
  line = (files.length - 1) * 1000000 + 1
  while i < n {
    c = src.at(i).code
    if isSpace(c) {
      if c == 10 {
        line = line + 1
      }
      i = i + 1
    } else {
      if isComment(src, i, n) {
        while (i < n).and((src.at(i).code == 10).not) {
          i = i + 1
        }
      } else {
        if (c == 34).or(c == 39) {
          j = i + 1
          s = ""
          while (j < n).and((src.at(j).code == c).not) {
            if src.at(j).code == 10 {
              fail(spot(files, line).concat("a text is missing its closing quote"))
            }
            if src.at(j).code == 92 {
              j = j + 1
              if j == n {
                fail(spot(files, line).concat("a text is missing its closing quote"))
              }
              s = s.concat(esc(src, j))
            } else {
              s = s.concat(src.at(j))
            }
            j = j + 1
          }
          if j == n {
            fail(spot(files, line).concat("a text is missing its closing quote"))
          }
          toks.push(Str(s))
          lines.push(line)
          i = j + 1
        } else {
          if isDigit(c) {
            start = i
            num = 0
            while (i < n).and(isDigit(src.at(i).code)) {
              num = num * 10 + (src.at(i).code - 48)
              i = i + 1
            }
            // a `.` followed by a digit makes it a float literal; keep the
            // source text, since the value is a double the lexer can't hold
            if (i + 1 < n).and(src.at(i).code == 46).and(isDigit(src.at(i + 1).code)) {
              i = i + 1
              while (i < n).and(isDigit(src.at(i).code)) {
                i = i + 1
              }
              // optional exponent: e or E, an optional sign, then digits (1.5e-9)
              if (i < n).and((src.at(i).code == 101).or(src.at(i).code == 69)) {
                j = i + 1
                if (j < n).and((src.at(j).code == 43).or(src.at(j).code == 45)) {
                  j = j + 1
                }
                if (j < n).and(isDigit(src.at(j).code)) {
                  i = j
                  while (i < n).and(isDigit(src.at(i).code)) {
                    i = i + 1
                  }
                }
              }
              toks.push(Float(src.slice(start, i)))
              lines.push(line)
            } else {
              toks.push(Int(num))
              lines.push(line)
            }
          } else {
            if isAlpha(c) {
              j = i
              while (j < n).and(isAlnum(src.at(j).code)) {
                j = j + 1
              }
              toks.push(Ident(safeName(src.slice(i, j), taken)))
              lines.push(line)
              i = j
            } else {
              if isTwoCharOp(src, i, n) {
                toks.push(Punct(src.slice(i, i + 2)))
                lines.push(line)
                i = i + 2
              } else {
                // a `(` that opens a line is a grouping paren starting a new
                // statement, never a method-call's argument list. Mark it `s(`
                // so the parser does not glue `expr.field` to a following
                // `(...)` line into a bogus method call.
                fol = (lines.length == 0).or((lines.at(lines.length - 1) == line).not)
                if (src.at(i).code == 40).and(fol) {
                  toks.push(Punct("s("))
                } else {
                  toks.push(Punct(src.at(i)))
                }
                lines.push(line)
                i = i + 1
              }
            }
          }
        }
      }
    }
  }
  toks.push(Eof)
  lines.push(line)
  Lexed(toks = toks, lines = lines, files = files)
}

esc(src : Str, j : Int) : Str {
  c = src.at(j).code
  r = src.at(j)
  if c == 110 { r = "\n" }
  if c == 116 { r = "\t" }
  if c == 114 { r = "\r" }
  if (c != 110) && (c != 116) && (c != 114) && (c != 92) && (c != 34) && (c != 39) {
    r = "\\".concat(r)
  }
  r
}

isComment(src : Str, i : Int, n : Int) : Bool {
  (i + 1 < n).and(src.at(i).code == 47).and(src.at(i + 1).code == 47)
}

isTwoCharOp(src : Str, i : Int, n : Int) : Bool {
  twoIs(src, i, n, 45, 62).or(twoIs(src, i, n, 61, 61)).or(twoIs(src, i, n, 60, 61)).or(twoIs(src, i, n, 62, 61)).or(twoIs(src, i, n, 38, 38)).or(twoIs(src, i, n, 124, 124)).or(twoIs(src, i, n, 33, 61)).or(twoIs(src, i, n, 46, 46))
}

twoIs(src : Str, i : Int, n : Int, a : Int, b : Int) : Bool {
  (i + 1 < n).and(src.at(i).code == a).and(src.at(i + 1).code == b)
}

isDigit(c : Int) : Bool {
  c.ge(48).and(c.le(57))
}

// Names the C output already uses. A program's own name that matches one gets
// "_c" added, so the C always compiles (a case named Obj, a variable named int).
cTaken() : List[Str] {
  ["auto", "case", "char", "const", "default", "do", "double", "enum", "extern", "float",
   "goto", "inline", "int", "long", "register", "restrict", "short", "signed", "sizeof", "static", "struct", "switch",
   "typedef", "union", "unsigned", "void", "volatile", "Obj", "SList", "SMap", "FILE", "NULL", "EOF", "NAN", "INFINITY",
   "BUFSIZ", "DIR", "errno", "RAND_MAX", "EXIT_SUCCESS", "EXIT_FAILURE", "SEEK_SET", "SEEK_CUR", "SEEK_END", "HUGE_VAL", "mk", "l2d",
   "d2l", "argc", "argv", "printf", "fprintf", "sprintf", "snprintf", "malloc", "realloc",
   "free", "exit", "strlen", "strcmp", "strcpy", "strcat", "strstr", "memcpy", "atol", "atof", "qsort", "getchar",
   "fopen", "fclose", "fputs", "fread", "fseek", "ftell", "pow", "fmod", "ceil", "fabs", "round",
   "asm", "typeof", "typeof_unqual", "unix", "linux", "labs", "bool", "intptr_t", "static_assert", "alignof", "alignas",
   "thread_local", "constexpr", "nullptr"]
}

safeName(s : Str, taken : List[Str]) : Str {
  r = s
  n = s.length
  if n > 1 {
    c0 = s.at(0).code
    c1 = s.at(1).code
    if c0 == 95 || (c1 == 95 && (c0 == 108 || c0 == 115 || c0 == 109 || c0 == 105 || c0 == 102 || c0 == 117 || c0 == 84)) {
      r = s.concat("_c")
    } else {
      if hasName(taken, s) {
        r = s.concat("_c")
      }
      if n > 3 {
        if s.slice(0, 4) == "cmp_" {
          r = s.concat("_c")
        }
      }
      if n > 7 {
        if s.slice(0, 8) == "simpler_" {
          r = s.concat("_c")
        }
      }
    }
  }
  r
}

isAlpha(c : Int) : Bool {
  c.ge(65).and(c.le(90)).or(c.ge(97).and(c.le(122))).or(c == 95)
}

isAlnum(c : Int) : Bool {
  isAlpha(c).or(isDigit(c))
}

isSpace(c : Int) : Bool {
  (c == 32).or(c == 9).or(c == 10).or(c == 13)
}
