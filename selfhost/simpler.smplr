  sys.screen.print("static void simpler_allow(const char* path, unsigned long long rights) { int fd = open(path, O_PATH | O_CLOEXEC); if (fd < 0) return; struct stat st; if (fstat(fd, &st) == 0 && !S_ISDIR(st.st_mode)) rights &= SL_FILE; struct landlock_path_beneath_attr a; memset(&a, 0, sizeof a); a.allowed_access = rights & simpler_ll_fs; a.parent_fd = fd; if (a.allowed_access) syscall(SYS_landlock_add_rule, simpler_ll, LANDLOCK_RULE_PATH_BENEATH, &a, 0); close(fd); }")
