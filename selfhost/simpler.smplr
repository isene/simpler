  sys.screen.print("static void simpler_allow_one(const char* e, unsigned long long rights, int make) { char d[PATH_MAX]; size_t n = strlen(e); if (n == 0 || n >= PATH_MAX) return; if (strchr(e, '*')) { size_t m = strcspn(e, \"*\"); while (m > 0 && e[m - 1] != '/') m--; if (m == 0) strcpy(d, \".\"); else { memcpy(d, e, m); d[m] = 0; } simpler_allow(d, rights); return; } struct stat st; if (make && e[n - 1] != '/' && lstat(e, &st) != 0) { int fd = open(e, O_CREAT | O_EXCL | O_WRONLY | O_CLOEXEC, 0666); if (fd >= 0) { close(fd); if (simpler_nmade < 64) { if (simpler_nmade == 0) atexit(simpler_unmade); simpler_made[simpler_nmade++] = strdup(e); } } } simpler_allow(e, rights); }")
