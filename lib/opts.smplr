// opts: options on the command line, such as -v, -o file, --out=file.
// Hand parse the arguments from main: o = opts.parse(sys.args, "v|verbose h|help", "o|out n")

// What the command line said. rest holds the arguments that are no options, in order.
// bad is "" when all was well, else one line that says what was wrong.
Opts = type {
  on : List[Str]
  names : List[Str]
  values : List[Str]
  rest : List[Str]
  bad : Str
}

// The first name of the option that word is, or "" when none in spec has it.
// spec is names with a space between; a|b says a and b are the same option.
first_name(spec : Str, word : Str) : Str {
  for group in spec.split(" ") {
    for n in group.split("|") {
      if n == word && n.length > 0 {
        return group.split("|").at(0)
      }
    }
  }
  ""
}

// Read the arguments. flags are the options with no value, valued the ones that take one.
// A name of one letter is written -v, a longer one --verbose. Understood: -abc (three flags),
// -o file, -ofile, --out file, --out=file, and -- (all after it is rest).
// o = opts.parse(sys.args, "v|verbose h|help", "o|out n"), then check o.bad first.
parse(argv : List[Str], flags : Str, valued : Str) : Opts {
  on : List[Str] = []
  names : List[Str] = []
  values : List[Str] = []
  rest : List[Str] = []
  bad = ""
  i = 0
  while i < argv.length {
    a = argv.at(i)
    i = i + 1
    if a == "--" {
      while i < argv.length {
        rest.push(argv.at(i))
        i = i + 1
      }
    } else if a.startsWith("--") {
      word = a.slice(2, a.length)
      given = ""
      eq = word.find("=")
      if eq >= 0 {
        given = word.slice(eq + 1, word.length)
        word = word.slice(0, eq)
      }
      f = first_name(flags, word)
      v = first_name(valued, word)
      if f.length > 0 && eq < 0 {
        on.push(f)
      } else if v.length > 0 {
        if eq < 0 {
          if i < argv.length {
            given = argv.at(i)
            i = i + 1
          } else if bad.length == 0 {
            bad = "--" + word + " needs a value"
          }
        }
        names.push(v)
        values.push(given)
      } else if bad.length == 0 {
        bad = "no option named --" + word
      }
    } else if a.startsWith("-") && a.length > 1 {
      k = 1
      while k < a.length {
        c = a.at(k)
        k = k + 1
        f = first_name(flags, c)
        v = first_name(valued, c)
        if f.length > 0 {
          on.push(f)
        } else if v.length > 0 {
          given = a.slice(k, a.length)
          k = a.length
          if given.length == 0 {
            if i < argv.length {
              given = argv.at(i)
              i = i + 1
            } else if bad.length == 0 {
              bad = "-" + c + " needs a value"
            }
          }
          names.push(v)
          values.push(given)
        } else if bad.length == 0 {
          bad = "no option named -" + c
        }
      }
    } else {
      rest.push(a)
    }
  }
  Opts(on = on, names = names, values = values, rest = rest, bad = bad)
}

// Was this flag given? Ask with the first name of the option.
has(o : Opts, name : Str) : Bool {
  for n in o.on {
    if n == name {
      return true
    }
  }
  false
}

// How many times the flag was given (-vvv is 3).
count(o : Opts, name : Str) : Int {
  c = 0
  for n in o.on {
    if n == name {
      c = c + 1
    }
  }
  c
}

// The value of an option, or otherwise when it was not given. The last one given wins.
get(o : Opts, name : Str, otherwise : Str) : Str {
  out = otherwise
  for i in 0..o.names.length {
    if o.names.at(i) == name {
      out = o.values.at(i)
    }
  }
  out
}

test_parse() {
  o = parse(["-vx", "-n", "3", "a.txt", "--out=b.txt", "--verbose", "-ofinal", "--", "-z"], "v|verbose x h|help", "o|out n")
  assert(o.bad == "")
  assert(count(o, "v") == 2)
  assert(has(o, "x"))
  assert(!has(o, "h"))
  assert(get(o, "n", "1") == "3")
  assert(get(o, "o", "") == "final")
  assert(get(o, "none", "dflt") == "dflt")
  assert(o.rest.join(",") == "a.txt,-z")
}

test_bad() {
  assert(parse(["-q"], "v", "o").bad == "no option named -q")
  assert(parse(["--out"], "v", "o|out").bad == "--out needs a value")
  assert(parse(["-"], "v", "o").rest.at(0) == "-")
  assert(parse(["--verbose=1"], "v|verbose", "").bad == "no option named --verbose")
}
