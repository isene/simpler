star_no(i : Int) : Star {
  n = star_nums()
  Star(name = star_names().at(i), con = star_cons().at(i), spectral = star_specs().at(i), ra = n.at(i * 6), dec = n.at(i * 6 + 1), mag = n.at(i * 6 + 2), ly = n.at(i * 6 + 3))
}

star_index(name : Str) : Int {
  all = star_names()
  want = name.lower
  for i in 0..all.length {
    if all.at(i).lower == want {
      return i
    }
  }
  -1
}

// The 105 bright and named stars, brightest first.
stars() : List[Star] {
  out : List[Star] = []
  for i in 0..star_names().length {
    out.push(star_no(i))
  }
  out
}

// One star by name ("Sirius", any case). No such star: a Star with the name "".
star(name : Str) : Star {
  i = star_index(name)
  if i < 0 {
    return Star(name = "", con = "", spectral = "", ra = 0.0, dec = 0.0, mag = 0.0, ly = 0.0)
  }
  star_no(i)
}

star_place(s : Sky, i : Int) : Pos {
  n = star_nums()
  yrs = (jd_of(s) - 2451545.0) / 365.25
  dec0 = n.at(i * 6 + 1) + n.at(i * 6 + 5) / 3600000.0 * yrs
  ra0 = n.at(i * 6) + n.at(i * 6 + 4) / 3600000.0 / cs(n.at(i * 6 + 1)) * yrs
  p = precess(ra0, dec0, 2451545.0, jd_of(s))
  e = to_ecliptic(p.ra, p.dec, s.ecl)
  Pos(ra = p.ra, dec = p.dec, dist = 0.0, gra = p.ra, gdec = p.dec, lon = e.lon, lat = e.lat, sun_dist = 0.0, tdist = 0.0)
}

// Where a star is in a sky, moved to the sky's own day. Its height: horizon(s, p.ra, p.dec).
// Its rise and set: times(s, p.ra, p.dec, -0.5667). No such star: all 0.0.
star_pos(s : Sky, name : Str) : Pos {
  i = star_index(name)
  if i < 0 {
    return Pos(ra = 0.0, dec = 0.0, dist = 0.0, gra = 0.0, gdec = 0.0, lon = 0.0, lat = 0.0, sun_dist = 0.0, tdist = 0.0)
  }
  star_place(s, i)
}

// The stars that stand higher than min_alt degrees in a sky, brightest first.
stars_up(s : Sky, min_alt : Float) : List[Star] {
  out : List[Star] = []
  for i in 0..star_names().length {
    p = star_place(s, i)
    if horizon(s, p.ra, p.dec).alt > min_alt {
      out.push(star_no(i))
    }
  }
  out
}

// The eleven big meteor showers of the year.
showers() : List[Shower] {
  names = ["Quadrantids", "Lyrids", "Eta Aquariids", "Delta Aquariids", "Perseids", "Draconids", "Orionids", "Taurids", "Leonids", "Geminids", "Ursids"]
  n = [1, 3, 110, 230, 49, 4, 22, 18, 271, 34, 5, 6, 50, 338, -1, 7, 30, 25, 340, -16, 8, 12, 100, 48, 58, 10, 8, 10, 262, 54, 10, 21, 20, 95, 16, 11, 5, 5, 52, 15, 11, 17, 15, 152, 22, 12, 14, 150, 112, 33, 12, 22, 10, 217, 76]
  out : List[Shower] = []
  for i in 0..names.length {
    out.push(Shower(name = names.at(i), month = n.at(i * 5), day = n.at(i * 5 + 1), rate = n.at(i * 5 + 2), ra = n.at(i * 5 + 3).toFloat, dec = n.at(i * 5 + 4).toFloat))
  }
  out
}

// The sign of a body, as text and not as a wide picture.
sign(name : Str) : Str {
  i = index_of(name)
  if i < 0 {
    return "?"
  }
  ["☀", "☾", "☿", "♀", "♂", "♃", "♄", "♅", "♆"].at(i) + 65038.char
}

// The colour number (0 to 255) a body is drawn in, as a style word for a terminal.
colour(name : Str) : Str {
  i = index_of(name)
  if i < 0 {
    return "255"
  }
  ["220", "248", "137", "216", "196", "208", "229", "117", "33"].at(i)
}

// "sun" as "Sun".
title(name : Str) : Str {
  if name.length == 0 {
    return name
  }
  name.slice(0, 1).upper + name.slice(1, name.length)
}

body_of(year : Int, month : Int, day : Int, n : Str, lat : Float, lon : Float, tz : Float) : Body {
  s = sky(year, month, day, lat, lon, tz)
  p = pos(s, n)
  t = body_times(year, month, day, n, lat, lon, tz)
  Body(name = n, ra = p.ra, dec = p.dec, dist = p.dist, rise = t.rise, transit = t.transit, set = t.set, mag = magnitude(s, n), lit = lit_part(s, n), size = diameter(s, n), con = constellation(p.gra, p.gdec, jd_of(s)))
}

// Every body for one day: where it is, when it rises, transits and sets, how bright.
bodies(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : List[Body] {
  out : List[Body] = []
  for n in names() {
    out.push(body_of(year, month, day, n, lat, lon, tz))
  }
  out
}

// Is a body up at a local clock hour, going by its rise and set?
is_up(b : Body, hour : Float) : Bool {
  if b.rise == "always" {
    return true
  }
  if b.rise == "never" {
    return false
  }
  if b.rise == "none" {
    return hour <= hours_of(b.set)
  }
  if b.set == "none" {
    return hour >= hours_of(b.rise)
  }
  r = hours_of(b.rise)
  st = hours_of(b.set)
  if r > st {
    return hour >= r || hour <= st
  }
  hour >= r && hour <= st
}

// The planets (Mercury to Saturn) to see in the night that starts on a day: more than 5
// degrees up at some full hour while the sun is more than 6 degrees down.
visible_planets(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : List[Body] {
  dark : List[Float] = []
  for i in 12..37 {
    s = sky_at(year, month, day, i.toFloat, lat, lon, tz)
    if horizon(s, s.sun_ra, s.sun_dec).alt < -6.0 {
      dark.push(i.toFloat)
    }
  }
  out : List[Body] = []
  for n in ["mercury", "venus", "mars", "jupiter", "saturn"] {
    seen = false
    for h in dark {
      if !seen && where(sky_at(year, month, day, h, lat, lon, tz), n).alt > 5.0 {
        seen = true
      }
    }
    if seen {
      out.push(body_of(year, month, day, n, lat, lon, tz))
    }
  }
  out
}

pad(s : Str, n : Int) : Str {
  out = s
  while out.length < n {
    out = out + " "
  }
  out
}

// A table of bodies as lines of text: name, RA, Dec, distance, magnitude, rise, transit,
// set, constellation.
table(list : List[Body]) : List[Str] {
  out = ["Body      │ RA      │ Dec      │ Dist    │ Mag   │ Rise  │ Trans │ Set   │ In", "──────────┼─────────┼──────────┼─────────┼───────┼───────┼───────┼───────┼─────────────"]
  for b in list {
    out.push(pad(title(b.name), 9) + " │ " + ra_text(b.ra) + " │ " + dec_text(b.dec) + " │ " + fixed(b.dist, 4).padLeft(7) + " │ " + fixed(b.mag, 1).padLeft(5) + " │ " + pad(b.rise.slice(0, 5), 5) + " │ " + pad(b.transit, 5) + " │ " + pad(b.set.slice(0, 5), 5) + " │ " + b.con)
  }
  out
}

// The constellations high in the evening sky in a month (the south gets the other
// half-year).
overhead(month : Int, lat : Float) : List[Str] {
  m = month
  if lat < 0.0 {
    m = (month + 5) % 12 + 1
  }
  all = ["Orion, Taurus, Auriga, Gemini", "Orion, Canis Major, Gemini, Auriga", "Leo, Cancer, Gemini, Hydra", "Leo, Virgo, Ursa Major", "Virgo, Boötes, Coma Berenices", "Boötes, Hercules, Corona Borealis", "Lyra, Cygnus, Hercules, Scorpius", "Cygnus, Lyra, Aquila, Sagittarius", "Pegasus, Andromeda, Cygnus, Capricornus", "Pegasus, Andromeda, Pisces, Aquarius", "Andromeda, Triangulum, Aries, Perseus", "Taurus, Orion, Perseus, Auriga"]
  if m < 1 || m > 12 {
    return []
  }
  all.at(m - 1).split(", ")
}

// What a day (UT) is known for: a notable moon phase, an eclipse, a season's start, a
// meteor shower's peak.
events(year : Int, month : Int, day : Int) : List[Str] {
  out : List[Str] = []
  stamp = year.toStr + "-" + two(month) + "-" + two(day)
  for l in phases_in_month(year, month) {
    if l.split(" ").at(0) == day.toStr {
      out.push(l.slice(l.find(" ") + 1, l.length) + " UT")
    }
  }
  e = next_eclipse(jd(year, month, day), "")
  if jd_text(e.when).slice(0, 10) == stamp {
    out.push(eclipse_text(e) + " " + jd_text(e.when).slice(11, 16) + " UT")
  }
  names = ["☀ March equinox", "☀ June solstice", "☀ September equinox", "☀ December solstice"]
  for w in 0..4 {
    when = jd_text(season(year, w))
    if when.slice(0, 10) == stamp {
      out.push(names.at(w) + " " + when.slice(11, 16) + " UT")
    }
  }
  for sh in showers() {
    if sh.month == month && sh.day == day {
      out.push("☄ " + sh.name + " peak, up to " + sh.rate.toStr + " an hour")
    }
  }
  out
}

// Tonight in a few lines: the moon, the planets to see, what is overhead, the day's events.
tonight(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : List[Str] {
  out : List[Str] = []
  mp = moon_phase(year, month, day)
  mt = moon_times(year, month, day, lat, lon, tz)
  line = "Moon: " + mp.symbol + " " + mp.name + " " + (mp.lit * 100.0).round.toInt.toStr + "%"
  if mt.rise.length == 5 {
    line = line + ", rises " + mt.rise
  }
  if mt.set.length == 5 {
    line = line + ", sets " + mt.set
  }
  out.push(line)
  parts : List[Str] = []
  for p in visible_planets(year, month, day, lat, lon, tz) {
    parts.push(sign(p.name) + " " + title(p.name) + " " + fixed(p.mag, 1) + " in " + p.con)
  }
  if parts.length == 0 {
    out.push("Planets: none in the dark sky")
  } else {
    out.push("Planets: " + parts.join(", "))
  }
  out.push("Overhead: " + overhead(month, lat).join(", "))
  for e in events(year, month, day) {
    out.push("Today: " + e)
  }
  out
}

sort_events(raw : List[Event]) : List[Event] {
  out : List[Event] = []
  for e in raw {
    next : List[Event] = []
    placed = false
    for o in out {
      if !placed && e.when < o.when {
        next.push(e)
        placed = true
      }
      next.push(o)
    }
    if !placed {
      next.push(e)
    }
    out = next
  }
  out
}

// All that happens in the sky in a year, in order (UT): moon phases, eclipses, seasons,
// meteor showers, oppositions, Mercury and Venus farthest from the sun, the moon nearest
// and farthest, the earth nearest and farthest from the sun. Print a line as
// jd_text(e.when) + " " + e.text.
almanac(year : Int) : List[Event] {
  raw : List[Event] = []
  a = jd(year, 1, 1)
  b = jd(year + 1, 1, 1)
  names = ["☀ March equinox", "☀ June solstice", "☀ September equinox", "☀ December solstice"]
  for w in 0..4 {
    raw.push(Event(when = season(year, w), text = names.at(w)))
  }
  q = ((a - 2451550.09766) / 29.530588861 * 4.0).floor - 3.0
  for i in 0..60 {
    kq = q + i.toFloat
    t = phase_time(kq / 4.0)
    if t >= a && t < b {
      idx = ((kq % 4.0 + 4.0) % 4.0).round.toInt * 2
      raw.push(Event(when = t, text = phase_symbol(idx) + " " + phase_name(idx)))
    }
  }
  for e in eclipses(year) {
    raw.push(Event(when = e.when, text = eclipse_text(e)))
  }
  for sh in showers() {
    raw.push(Event(when = jd(year, sh.month, sh.day) + 0.5, text = "☄ " + sh.name + " peak, up to " + sh.rate.toStr + " an hour"))
  }
  for n in ["mars", "jupiter", "saturn", "uranus", "neptune"] {
    t = find_zero("opp", n, "", a, b - a, 1.0)
    if t > 0.0 && t < b {
      raw.push(Event(when = t, text = sign(n) + " " + title(n) + " opposite the sun, magnitude " + fixed(magnitude(sky_jd(t, 0.0, 0.0, 0.0), n), 1)))
    }
  }
  for n in ["mercury", "venus"] {
    t = a
    while t > 0.0 && b - t > 3.0 {
      g = find_peak("elong", n, t, b - t, 1.0, true)
      t = 0.0
      if g > 0.0 && g < b {
        s = sky_jd(g, 0.0, 0.0, 0.0)
        side = "morning"
        if evening(s, n) {
          side = "evening"
        }
        raw.push(Event(when = g, text = sign(n) + " " + title(n) + " farthest from the sun, " + fixed(elongation(s, n), 0) + "° in the " + side + " sky"))
        t = g + 20.0
      }
    }
  }
  t = a
  while t > 0.0 && t < b {
    g = next_perigee(t)
    t = 0.0
    if g > 0.0 && g < b {
      raw.push(Event(when = g, text = "☾ Moon nearest, " + fixed(measure("dist", g, "moon", "") * 6378.14, 0) + " km"))
      t = g + 20.0
    }
  }
  t = a
  while t > 0.0 && t < b {
    g = next_apogee(t)
    t = 0.0
    if g > 0.0 && g < b {
      raw.push(Event(when = g, text = "☾ Moon farthest, " + fixed(measure("dist", g, "moon", "") * 6378.14, 0) + " km"))
      t = g + 20.0
    }
  }
  ph = next_perihelion(a - 5.0)
  if ph >= a && ph < b {
    raw.push(Event(when = ph, text = "Earth nearest the sun"))
  }
  ah = next_aphelion(a)
  if ah > 0.0 && ah < b {
    raw.push(Event(when = ah, text = "Earth farthest from the sun"))
  }
  sort_events(raw)
}

// One of Jupiter's four big moons as seen from the earth. x and y are counted in widths of
// half the planet (Jupiter's edge is at 1.0): x runs along the planet's belts, positive to
// the west, and y towards its north pole.
// state is "" (seen beside the planet), "transit" (in front of it) or "hidden" (behind it).
JMoon = type {
  name : Str
  x : Float
  y : Float
  state : Str
}

// Saturn's rings as seen from the earth. tilt: how far they are opened towards us, in
// degrees (positive: we see their north side, 0.0: edge-on and gone). sun_tilt: the same for
// the sun. wide and high: the size of the outer ring in seconds of arc. angle: the direction
// the planet's north pole points, counted from north towards east.
Rings = type {
  tilt : Float
  sun_tilt : Float
  wide : Float
  high : Float
  angle : Float
}

// Jupiter's four big moons at a moment (a Julian date): Io, Europa, Ganymede, Callisto.
// Good to a tenth of the planet's width.
jupiter_moons(j : Float) : List[JMoon] {
  d = j + delta_t(2000.0 + (j - 2451545.0) / 365.25) / 86400.0 - 2451545.0
  v = 172.74 + 0.00111588 * d
  m = 357.529 + 0.9856003 * d
  n = 20.02 + 0.0830853 * d + 0.329 * sn(v)
  jj = 66.115 + 0.9025179 * d - 0.329 * sn(v)
  a = 1.915 * sn(m) + 0.02 * sn(2.0 * m)
  b = 5.555 * sn(n) + 0.168 * sn(2.0 * n)
  k = jj + a - b
  re = 1.00014 - 0.01671 * cs(m) - 0.00014 * cs(2.0 * m)
  r = 5.20872 - 0.25208 * cs(n) - 0.00611 * cs(2.0 * n)
  dist = (r * r + re * re - 2.0 * r * re * cs(k)).sqrt
  psi = to_deg(clamp1(re / dist * sn(k)).asin)
  lam = 34.35 + 0.083091 * d + 0.329 * sn(v) + b
  ds = 3.12 * sn(lam + 42.8)
  de = ds - 2.22 * sn(psi) * cs(lam + 22.0) - 1.3 * (r - dist) / dist * sn(lam - 100.5)
  t = d - dist / 173.0
  u1 = 163.8069 + 203.4058646 * t + psi - b
  u2 = 358.414 + 101.2916335 * t + psi - b
  u3 = 5.7176 + 50.234518 * t + psi - b
  u4 = 224.8092 + 21.48798 * t + psi - b
  g = 331.18 + 50.310482 * t
  h = 87.45 + 21.569231 * t
  us = [u1 + 0.473 * sn(2.0 * (u1 - u2)), u2 + 1.065 * sn(2.0 * (u2 - u3)), u3 + 0.165 * sn(g), u4 + 0.843 * sn(h)]
  rs = [5.9057 - 0.0244 * cs(2.0 * (u1 - u2)), 9.3966 - 0.0882 * cs(2.0 * (u2 - u3)), 14.9883 - 0.0216 * cs(g), 26.3627 - 0.1939 * cs(h)]
  names = ["Io", "Europa", "Ganymede", "Callisto"]
  out : List[JMoon] = []
  for i in 0..4 {
    x = rs.at(i) * sn(us.at(i))
    y = -rs.at(i) * cs(us.at(i)) * sn(de)
    state = ""
    if x * x + y * y * 1.148 < 1.0 {
      state = "hidden"
      if cs(us.at(i)) > 0.0 {
        state = "transit"
      }
    }
    out.push(JMoon(name = names.at(i), x = x, y = y, state = state))
  }
  out
}

// Jupiter and its moons as one line of text, as a telescope with north up shows them: east
// to the left. O is the planet; I, E, G and C are the moons. A moon in front of the planet
// or behind it is not drawn. width is the number of characters (61 is a good one).
moons_line(j : Float, width : Int) : Str {
  mid = width / 2
  cells : List[Str] = []
  for i in 0..width {
    cells.push(" ")
  }
  for mo in jupiter_moons(j) {
    col = mid + (mo.x / 27.0 * mid.toFloat).round.toInt
    if mo.state == "" && col >= 0 && col < width {
      cells.set(col, mo.name.at(0))
    }
  }
  cells.set(mid, "O")
  cells.join("")
}

// Saturn's rings at a moment (a Julian date).
saturn_rings(j : Float) : Rings {
  s = sky_jd(j, 0.0, 0.0, 0.0)
  p = pos(s, "saturn")
  e = to_ecliptic(p.gra, p.gdec, s.ecl)
  t = (j - 2451545.0) / 36525.0
  i = 28.075216 - 0.012998 * t + 0.000004 * t * t
  om = 169.50847 + 1.394681 * t + 0.000412 * t * t
  tilt = to_deg(clamp1(sn(i) * cs(e.lat) * sn(e.lon - om) - cs(i) * sn(e.lat)).asin)
  x = p.dist * cs(e.lat) * cs(e.lon) - s.xs
  y = p.dist * cs(e.lat) * sn(e.lon) - s.ys
  z = p.dist * sn(e.lat)
  hl = to_deg(y.atan2(x))
  hb = to_deg(z.atan2((x * x + y * y).sqrt))
  sun_tilt = to_deg(clamp1(sn(i) * cs(hb) * sn(hl - om) - cs(i) * sn(hb)).asin)
  pole = to_equatorial(om - 90.0, 90.0 - i, s.ecl)
  angle = to_deg((cs(pole.dec) * sn(pole.ra - p.gra)).atan2(sn(pole.dec) * cs(p.gdec) - cs(pole.dec) * sn(p.gdec) * cs(pole.ra - p.gra)))
  wide = 375.35 / p.dist
  Rings(tilt = tilt, sun_tilt = sun_tilt, wide = wide, high = wide * sn(tilt).abs, angle = angle)
}

near(a : Float, b : Float, tol : Float) : Bool {
  (a - b).abs <= tol
}

oslo(year : Int, month : Int, day : Int) : Sky {
  sky(year, month, day, 59.9139, 10.7522, 1.0)
}

// The numbers in these tests were checked against the XEphem library (PyEphem 4.2), which
// shares no code with this file.
test_dates() {
  assert(jd(2000, 1, 1) == 2451544.5)
  assert(jd_text(jd_at(2026, 11, 16, 9, 30, 0)) == "2026-11-16 09:30")
  assert(jd_local(jd_at(2026, 11, 16, 23, 30, 0), 1.0) == "2026-11-17 00:30")
  assert(date_of(jd_at(2026, 11, 16, 9, 30, 0)).at(3) == 9)
  assert(days_in_month(2024, 2) == 29 && days_in_month(2100, 2) == 28)
  assert(day_of_year(2026, 11, 16) == 320 && weekday(2026, 11, 16) == "Monday")
  assert(easter(2026) == "2026-04-05" && easter(2027) == "2027-03-28")
  assert(hhmm(7.999) == "08:00" && hhmm(-0.5) == "23:30")
  assert(hours_of("06:30") == 6.5 && hours_of("never") == -1.0)
  assert(ra_text(77.9) == "05h 12m" && dec_text(-19.08) == "-19° 05′")
  assert(compass(200.0) == "SSW" && fixed(3.14159, 2) == "3.14")
}

test_positions() {
  s = oslo(2026, 11, 16)
  sun = pos(s, "sun")
  assert(near(sun.ra, 231.2561, 0.001) && near(sun.dec, -18.6816, 0.001) && near(sun.dist, 0.9891, 0.0001))
  moon = pos(s, "moon")
  assert(near(moon.ra, 309.5851, 0.001) && near(moon.dec, -20.6358, 0.001) && near(moon.dist, 63.1437, 0.001))
  sat = pos(s, "saturn")
  assert(near(sat.ra, 8.8257, 0.001) && near(sat.dec, 0.9333, 0.001) && near(sat.dist, 8.7202, 0.001))
  nep = pos(s, "neptune")
  assert(near(nep.ra, 2.2173, 0.001) && near(nep.dec, -0.5729, 0.001))
  far = orbit_pos(s, pluto())
  assert(near(far.ra, 306.6589, 0.001) && near(far.dec, -23.5575, 0.001) && near(far.dist, 35.9755, 0.001))
  assert(near(equation_of_time(s), 15.33, 0.01) && near(sidereal(s), 65.84, 0.01))
  assert(jd_of(s) == 2461360.5 && near(delta_t(2026.0), 75.0, 1.0))
}

test_times() {
  t = sun_times(2026, 11, 16, 59.9139, 10.7522, 1.0)
  assert(t.rise == "08:17" && t.transit == "12:02" && t.set == "15:46")
  m = moon_times(2026, 11, 16, 59.9139, 10.7522, 1.0)
  assert(m.rise == "13:55" && m.transit == "17:47" && m.set == "21:53")
  u = body_times(2026, 11, 16, "uranus", 59.9139, 10.7522, 1.0)
  assert(u.rise == "15:52" && u.transit == "00:45" && u.set == "09:34")
  dusk = twilight(2026, 11, 16, 6.0, 59.9139, 10.7522, 1.0)
  assert(dusk.rise == "07:28" && dusk.set == "16:35")
  assert(near(day_length(2026, 11, 16, 59.9139, 10.7522, 1.0), 7.48, 0.02))
  // Tromsø: midnight sun and polar night.
  assert(day_length(2026, 6, 21, 69.6492, 18.9553, 2.0) == 24.0)
  assert(day_length(2026, 12, 21, 69.6492, 18.9553, 1.0) == 0.0)
  assert(sun_times(2026, 6, 21, 69.6492, 18.9553, 2.0).rise == "always")
  // Uranus over Tromsø on 1995-07-09 was up for ten minutes: no full hour sees it.
  brief = body_times(1995, 7, 9, "uranus", 69.6492, 18.9553, 1.0)
  assert(hours_of(brief.rise) > 0.5 && hours_of(brief.set) - hours_of(brief.rise) < 0.3)
  // Svalbard: the moon rises and does not set that day.
  assert(moon_times(2026, 3, 20, 78.2232, 15.6267, 1.0).set == "none")
}

test_brightness() {
  s = oslo(2026, 11, 16)
  assert(near(magnitude(s, "venus"), -4.61, 0.02) && near(magnitude(s, "saturn"), 0.50, 0.02))
  assert(near(lit_part(s, "venus"), 0.143, 0.002) && near(moon_lit(s), 0.360, 0.002))
  assert(near(diameter(s, "jupiter"), 37.39, 0.05) && near(diameter(s, "sun"), 1940.5, 1.0))
  assert(near(elongation(s, "uranus"), 169.54, 0.02) && !evening(s, "venus"))
  assert(near(refraction(0.0), 0.483, 0.001) && near(airmass(30.0), 1.994, 0.001))
  assert(near(separation(0.0, 0.0, 90.0, 0.0), 90.0, 0.0001))
}

test_moon() {
  from = jd(2026, 11, 1)
  assert(jd_text(next_phase(from, 0)) == "2026-11-09 07:02")
  assert(jd_text(next_phase(from, 1)) == "2026-11-17 11:48")
  assert(jd_text(next_phase(from, 2)) == "2026-11-24 14:53")
  assert(jd_text(next_phase(from, 3)) == "2026-11-01 20:28")
  p = moon_phase(2026, 11, 16)
  assert(p.name == "Waxing Crescent" && p.index == 1)
  assert(phases_in_month(2026, 11).at(3) == "24 🌕 Full Moon 14:53")
  assert(notable_phase(2026, 11, 24) && !notable_phase(2026, 11, 26))
  assert(jd_text(next_perigee(jd(2026, 1, 1))) == "2026-01-01 21:46")
  assert(jd_text(next_apogee(jd(2026, 1, 1))) == "2026-01-13 20:48")
}

test_eclipses() {
  all = eclipses(2026)
  assert(all.length == 4)
  assert(jd_text(all.at(0).when) == "2026-02-17 12:13" && eclipse_text(all.at(0)) == "Annular solar eclipse, magnitude 0.96")
  assert(jd_text(all.at(1).when) == "2026-03-03 11:34" && eclipse_text(all.at(1)) == "Total lunar eclipse, magnitude 1.15")
  assert(near(all.at(1).total, 57.5, 1.0) && all.at(3).form == "partial")
  e = next_eclipse(jd(2026, 4, 1), "solar")
  assert(jd_text(e.when) == "2026-08-12 17:46" && e.form == "total")
  seen = local_eclipse(e.when, 59.9139, 10.7522, 2.0)
  assert(jd_text(seen.peak) == "2026-08-12 17:58" && near(seen.mag, 0.858, 0.005) && near(seen.alt, 8.3, 0.2))
  assert(near(sun_cover(sky_jd(seen.peak, 59.9139, 10.7522, 2.0)), seen.mag, 0.001))
  assert(local_eclipse(e.when, -33.8688, 151.2093, 10.0).mag == 0.0)
}

test_year() {
  assert(jd_text(season(2026, 0)) == "2026-03-20 14:45")
  assert(jd_text(season(2026, 1)) == "2026-06-21 08:25")
  assert(jd_text(season(2026, 2)) == "2026-09-23 00:05")
  assert(jd_text(season(2026, 3)) == "2026-12-21 20:50")
  start = jd(2026, 1, 1)
  assert(jd_text(next_opposition("mars", start)).slice(0, 10) == "2027-02-19")
  assert(jd_text(next_opposition("jupiter", start)).slice(0, 10) == "2026-01-10")
  assert(jd_text(next_opposition("saturn", start)).slice(0, 10) == "2026-10-04")
  assert(jd_text(next_greatest_elongation("mercury", start)).slice(0, 10) == "2026-02-19")
  assert(jd_text(next_greatest_elongation("venus", start)).slice(0, 10) == "2026-08-15")
  assert(jd_text(next_conjunction("venus", "jupiter", start, 365.0)).slice(0, 10) == "2026-06-09")
  assert(next_conjunction("mars", "saturn", jd(2026, 11, 1), 10.0) == 0.0)
  assert(jd_text(next_perihelion(start)).slice(0, 10) == "2026-01-03")
  assert(jd_text(next_aphelion(start)).slice(0, 10) == "2026-07-05")
  year = almanac(2026)
  assert(year.length == 109 && year.at(0).text.startsWith("☾ Moon nearest"))
  for i in 1..year.length {
    assert(year.at(i).when >= year.at(i - 1).when)
  }
}

test_stars() {
  assert(stars().length == 105 && stars().at(0).name == "Sirius")
  v = star("vega")
  assert(v.name == "Vega" && v.con == "Lyra" && v.spectral == "A0" && near(v.ly, 25.0, 0.5))
  assert(star("Sirius").con == "Canis Major" && star("nothing").name == "")
  night = sky_at(2026, 11, 16, 21.0, 59.9139, 10.7522, 1.0)
  p = star_pos(night, "Capella")
  h = horizon(night, p.ra, p.dec)
  assert(near(h.alt, 46.42, 0.02) && near(h.az, 74.42, 0.02))
  up = stars_up(night, 30.0)
  assert(up.length == 31 && up.at(0).name == "Vega")
  s = oslo(2026, 11, 16)
  assert(constellation(s.sun_ra, s.sun_dec, jd_of(s)) == "Libra")
  assert(constellation(83.82, -5.39, 2451545.0) == "Orion")
  assert(constellations().length == 88 && con_short("Ursa Major") == "UMa")
  centre = galactic(266.405, -28.936)
  assert(near(centre.lon, 0.0, 0.01) && near(centre.lat, 0.0, 0.01))
  e = to_ecliptic(s.sun_ra, s.sun_dec, s.ecl)
  back = to_equatorial(e.lon, e.lat, s.ecl)
  assert(near(e.lat, 0.0, 0.001) && near(back.ra, s.sun_ra, 0.0001) && near(back.dec, s.sun_dec, 0.0001))
  moved = precess(101.287, -16.716, 2451545.0, jd(2026, 11, 16))
  assert(near(moved.ra, 101.587, 0.002) && near(moved.dec, -16.746, 0.002))
}

test_tonight() {
  list = bodies(2026, 11, 16, 59.9139, 10.7522, 1.0)
  assert(list.length == 9 && list.at(0).con == "Libra" && list.at(6).name == "saturn")
  assert(table(list).length == 11 && table(list).at(2).startsWith("Sun"))
  seen = visible_planets(2026, 11, 16, 59.9139, 10.7522, 1.0)
  assert(seen.length == 5 && seen.at(0).name == "mercury")
  day = events(2026, 8, 12)
  assert(day.length == 3 && day.at(1) == "Total solar eclipse, magnitude 1.03 17:46 UT")
  assert(overhead(11, 59.9).at(0) == "Andromeda" && showers().length == 11)
  assert(tonight(2026, 11, 16, 59.9139, 10.7522, 1.0).length > 2)
  assert(title("sun") == "Sun" && names().length == 9)
}

test_moons_and_rings() {
  at = jd(2026, 11, 16)
  four = jupiter_moons(at)
  assert(four.length == 4 && four.at(0).name == "Io" && four.at(3).name == "Callisto")
  assert(near(four.at(0).x, 5.44, 0.05) && near(four.at(2).x, -10.69, 0.05) && four.at(1).state == "")
  assert(jupiter_moons(at + 0.3).at(0).state == "hidden" && jupiter_moons(at + 40.1).at(0).state == "transit")
  line = moons_line(at, 61)
  assert(line.length == 61 && line.at(30) == "O" && line.find("G") < line.find("E") && line.find("I") < line.find("C"))
  r = saturn_rings(at)
  assert(near(r.tilt, -6.26, 0.03) && near(r.sun_tilt, -8.33, 0.03) && near(r.wide, 43.04, 0.05) && near(r.high, 4.70, 0.05))
  assert(near(saturn_rings(at - 3000.2).tilt, 26.57, 0.05))
}
