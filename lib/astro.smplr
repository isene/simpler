// astro: the sun, the moon, the planets, Pluto, 100 bright stars and the 88 constellations.
// Where they are, when they rise and set, how bright they are, moon phases to the minute,
// eclipses, seasons, twilight, oppositions and a year's almanac.
// Rules for all of it: angles are in degrees. lat is north-positive, lon is east-positive,
// tz is hours ahead of UT (Oslo in winter: 1.0). A moment is a Julian date (a Float, UT):
// make one with jd_at or jd_of_unix(sys.clock.now), print one with jd_text or jd_local.
// A body is named "sun", "moon", "mercury", "venus", "mars", "jupiter", "saturn", "uranus"
// or "neptune". Good to a minute of arc for the sun and the moon, a few for the planets,
// between 1900 and 2100.
// A Sky is one place at one moment. Make it with sky_at, sky_jd or sky; hand it to the rest.
Sky = type {
  lat : Float
  lon : Float
  tz : Float
  d : Float
  ecl : Float
  ls : Float
  xs : Float
  ys : Float
  sidtime : Float
  sun_ra : Float
  sun_dec : Float
  sun_lon : Float
  sun_dist : Float
  mj : Float
  ms : Float
}

// A place in the sky. ra, dec: as seen by the observer. gra, gdec: as seen from the centre
// of the earth. lon, lat: along and above the sun's path (ecliptic). dist: distance in AU
// (earth radii for the moon). sun_dist: distance from the sun in AU.
Pos = type {
  ra : Float
  dec : Float
  dist : Float
  gra : Float
  gdec : Float
  lon : Float
  lat : Float
  sun_dist : Float
  tdist : Float
}

// Height above the horizon and compass direction (0 north, 90 east).
Hor = type {
  alt : Float
  az : Float
}

// Rise, transit and set as "HH:MM" local time. Up all day: rise "always", set "never".
// Down all day: rise "never", set "always". "none": it does not happen on this day.
Times = type {
  rise : Str
  transit : Str
  set : Str
}

// One body on one day: place (at 0h UT), times, brightness (mag, lower is brighter), the lit
// part (0 to 1), width in seconds of arc, and the constellation it stands in.
Body = type {
  name : Str
  ra : Float
  dec : Float
  dist : Float
  rise : Str
  transit : Str
  set : Str
  mag : Float
  lit : Float
  size : Float
  con : Str
}

// The moon's phase: lit is the lit part (0 to 1), age the part of the month gone (0 to 1),
// index 0 new, 2 first quarter, 4 full, 6 last quarter (odd numbers are in between).
Phase = type {
  lit : Float
  age : Float
  index : Int
  name : Str
  symbol : Str
}

// Two angles: ra and dec.
Spot = type {
  ra : Float
  dec : Float
}

// Two angles: along (lon) and above (lat) the ecliptic or the Milky Way.
LonLat = type {
  lon : Float
  lat : Float
}

// A star: ra and dec for the year 2000, mag (lower is brighter), ly the distance in
// light-years (0.0 when not known), con the constellation, spectral its class ("A1").
Star = type {
  name : Str
  con : Str
  spectral : Str
  ra : Float
  dec : Float
  mag : Float
  ly : Float
}

// A meteor shower: the day it peaks, meteors an hour at best, and where they come from.
Shower = type {
  name : Str
  month : Int
  day : Int
  rate : Int
  ra : Float
  dec : Float
}

// Something that happens at a moment (a Julian date).
Event = type {
  when : Float
  text : Str
}

// An eclipse at its greatest (when). kind: "solar" or "lunar". form: "total", "annular",
// "hybrid", "partial" or "penumbral". mag: the part of the width covered (over 1 is total).
// gamma: how far from the centre the shadow passes. partial and total: minutes that phase
// lasts (lunar only). form is "" when there is no eclipse.
Eclipse = type {
  when : Float
  kind : Str
  form : Str
  mag : Float
  gamma : Float
  partial : Float
  total : Float
}

// A solar eclipse seen from one place: start, peak and stop as Julian dates, mag the part of
// the sun's width covered at the peak, cover the part of its face, alt the sun's height then.
// mag is 0.0 when the place sees nothing.
Local = type {
  start : Float
  peak : Float
  stop : Float
  mag : Float
  cover : Float
  alt : Float
}

// A path round the sun, for a comet, an asteroid or a dwarf planet. node, incl and peri are
// the usual three angles (for the year 2000), a the half width in AU, e the stretch (under 1),
// m0 the mean anomaly at the moment epoch (a Julian date), daily the degrees it moves a day
// (0.0: worked out from a).
Orbit = type {
  name : Str
  node : Float
  incl : Float
  peri : Float
  a : Float
  e : Float
  m0 : Float
  epoch : Float
  daily : Float
}

pi() : Float {
  3.141592653589793
}

rad(x : Float) : Float {
  x * 3.141592653589793 / 180.0
}

to_deg(r : Float) : Float {
  r * 180.0 / 3.141592653589793
}

sn(x : Float) : Float {
  (x * 3.141592653589793 / 180.0).sin
}

cs(x : Float) : Float {
  (x * 3.141592653589793 / 180.0).cos
}

log10(x : Float) : Float {
  x.ln / 10.0.ln
}

turn(x : Float) : Float {
  // An angle brought into 0 to 360.
  r = x % 360.0
  if r < 0.0 {
    r = r + 360.0
  }
  r
}

swing(x : Float) : Float {
  // An angle brought into -180 to 180.
  r = turn(x)
  if r > 180.0 {
    r = r - 360.0
  }
  r
}

clamp1(x : Float) : Float {
  r = x
  if r > 1.0 {
    r = 1.0
  }
  if r < -1.0 {
    r = -1.0
  }
  r
}

two(n : Int) : Str {
  s = n.toStr
  if n < 10 {
    s = "0" + s
  }
  s
}

// A number with a fixed count of decimals: fixed(3.14159, 2) is "3.14".
fixed(x : Float, places : Int) : Str {
  scale = 10.0.pow(places.toFloat)
  n = (x.abs * scale).round
  whole = (n / scale).floor
  out = whole.toInt.toStr
  if places > 0 {
    frac = (n - whole * scale).round.toInt.toStr
    while frac.length < places {
      frac = "0" + frac
    }
    out = out + "." + frac
  }
  if x < 0.0 && n > 0.0 {
    out = "-" + out
  }
  out
}

// Hours as "HH:MM".
hhmm(hours : Float) : Str {
  h = hours % 24.0
  if h < 0.0 {
    h = h + 24.0
  }
  hh = h.floor.toInt
  mm = ((h - hh.toFloat) * 60.0).round.toInt
  if mm >= 60 {
    hh = (hh + 1) % 24
    mm = 0
  }
  two(hh) + ":" + two(mm)
}

// "HH:MM" as hours, or -1.0 for "always", "never" and "none".
hours_of(s : Str) : Float {
  if s.length < 5 || !s.slice(0, 2).isInt {
    return -1.0
  }
  s.slice(0, 2).toInt.toFloat + s.slice(3, 5).toInt.toFloat / 60.0
}

// A right ascension as "05h 12m".
ra_text(ra : Float) : Str {
  h = turn(ra) / 15.0
  hh = h.floor.toInt
  mm = ((h - hh.toFloat) * 60.0).round.toInt
  if mm >= 60 {
    hh = (hh + 1) % 24
    mm = 0
  }
  two(hh) + "h " + two(mm) + "m"
}

// A declination as "+19° 05′".
dec_text(dec : Float) : Str {
  mark = "+"
  if dec < 0.0 {
    mark = "-"
  }
  a = dec.abs
  dd = a.floor.toInt
  mm = ((a - dd.toFloat) * 60.0).round.toInt
  if mm >= 60 {
    dd = dd + 1
    mm = 0
  }
  mark + two(dd) + "° " + two(mm) + "′"
}

// A compass direction as one of 16 words: compass(200.0) is "SSW".
compass(az : Float) : Str {
  i = (turn(az) / 22.5 + 0.5).floor.toInt % 16
  ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"].at(i)
}

is_leap(year : Int) : Bool {
  (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
}

// The number of days in a month.
days_in_month(year : Int, month : Int) : Int {
  n = 31
  if month == 4 || month == 6 || month == 9 || month == 11 {
    n = 30
  }
  if month == 2 {
    n = 28
    if is_leap(year) {
      n = 29
    }
  }
  n
}

// The number of a day in its year: 1 for 1 January.
day_of_year(year : Int, month : Int, day : Int) : Int {
  n = day
  for m in 1..month {
    n = n + days_in_month(year, m)
  }
  n
}

// The Julian date at 0h UT of a day.
jd(year : Int, month : Int, day : Int) : Float {
  y = year.toFloat
  m = month.toFloat
  (367.0 * y) - ((7.0 * (y + ((m + 9.0) / 12.0).floor)) / 4.0).floor + ((275.0 * m) / 9.0).floor + day.toFloat + 1721013.5
}

// The Julian date of a day and a time of day (UT).
jd_at(year : Int, month : Int, day : Int, hour : Int, minute : Int, sec : Int) : Float {
  jd(year, month, day) + (hour * 3600 + minute * 60 + sec).toFloat / 86400.0
}

// The Julian date of a clock value: jd_of_unix(sys.clock.now) is now.
jd_of_unix(secs : Int) : Float {
  secs.toFloat / 86400.0 + 2440587.5
}

// A Julian date as five numbers: year, month, day, hour, minute (UT, to the nearest minute).
date_of(j : Float) : List[Int] {
  mins = ((j + 0.5) * 1440.0).round
  z = (mins / 1440.0).floor
  left = (mins - z * 1440.0).round.toInt
  a = z
  if z >= 2299161.0 {
    al = ((z - 1867216.25) / 36524.25).floor
    a = z + 1.0 + al - (al / 4.0).floor
  }
  b = a + 1524.0
  c = ((b - 122.1) / 365.25).floor
  dd = (365.25 * c).floor
  e = ((b - dd) / 30.6001).floor
  day = (b - dd - (30.6001 * e).floor).toInt
  month = e.toInt - 1
  if month > 12 {
    month = month - 12
  }
  year = c.toInt - 4716
  if month <= 2 {
    year = year + 1
  }
  [year, month, day, left / 60, left % 60]
}

// A Julian date as "2026-03-20 14:46" (UT).
jd_text(j : Float) : Str {
  p = date_of(j)
  p.at(0).toStr + "-" + two(p.at(1)) + "-" + two(p.at(2)) + " " + two(p.at(3)) + ":" + two(p.at(4))
}

// A Julian date as "2026-03-20 15:46" on the clock of a time zone.
jd_local(j : Float, tz : Float) : Str {
  jd_text(j + tz / 24.0)
}

// The day of the week: "Monday".
weekday(year : Int, month : Int, day : Int) : Str {
  i = (jd(year, month, day) + 1.5).floor.toInt % 7
  ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"].at(i)
}

// Easter Sunday of a year, as "2026-04-05".
easter(year : Int) : Str {
  a = year % 19
  b = year / 100
  c = year % 100
  h = (19 * a + b - b / 4 - (b - (b + 8) / 25 + 1) / 3 + 15) % 30
  l = (32 + 2 * (b % 4) + 2 * (c / 4) - h - c % 4) % 7
  m = (a + 11 * h + 22 * l) / 451
  n = h + l - 7 * m + 114
  year.toStr + "-" + two(n / 31) + "-" + two(n % 31 + 1)
}

// Seconds the even time of the planets (TT) runs ahead of clock time (UT) in a year.
delta_t(year : Float) : Float {
  if year >= 2005.0 && year < 2050.0 {
    t = year - 2000.0
    return 62.92 + 0.32217 * t + 0.005589 * t * t
  }
  if year >= 1986.0 && year < 2005.0 {
    t = year - 2000.0
    return 63.86 + 0.3345 * t - 0.060374 * t * t + 0.0017275 * t * t * t + 0.000651814 * t * t * t * t + 0.00002373599 * t * t * t * t * t
  }
  if year >= 1961.0 && year < 1986.0 {
    t = year - 1975.0
    return 45.45 + 1.067 * t - t * t / 260.0 - t * t * t / 718.0
  }
  if year >= 1941.0 && year < 1961.0 {
    t = year - 1950.0
    return 29.07 + 0.407 * t - t * t / 233.0 + t * t * t / 2547.0
  }
  if year >= 1920.0 && year < 1941.0 {
    t = year - 1920.0
    return 21.2 + 0.84493 * t - 0.0761 * t * t + 0.0020936 * t * t * t
  }
  if year >= 1900.0 && year < 1920.0 {
    t = year - 1900.0
    return -2.79 + 1.494119 * t - 0.0598939 * t * t + 0.0061966 * t * t * t - 0.000197 * t * t * t * t
  }
  u = (year - 1820.0) / 100.0
  -20.0 + 32.0 * u * u
}

to_ut(jde : Float) : Float {
  // From the even time of the planets to clock time.
  jde - delta_t(2000.0 + (jde - 2451545.0) / 365.25) / 86400.0
}

sky_d(d : Float, ut : Float, lat : Float, lon : Float, tz : Float) : Sky {
  // d: days since 1999-12-31 0h UT, with the part of the day. ut: hours.
  t = d / 36525.0
  ecl = 23.439279444 - 46.815 / 3600.0 * t - 0.00059 / 3600.0 * t * t + 0.001813 / 3600.0 * t * t * t
  sw = 282.9404 + 4.70935e-5 * d
  se = 0.016709 - 1.151e-9 * d
  sm = 356.047 + 0.9856002585 * d
  ws = (sw + 360.0) % 360.0
  ms = sm % 360.0
  es = ms + (180.0 / pi()) * se * rad(ms).sin * (1.0 + se * rad(ms).cos)
  x = rad(es).cos - se
  y = rad(es).sin * (1.0 - se * se).sqrt
  v = to_deg(y.atan2(x))
  r = (x * x + y * y).sqrt
  tlon = (v + ws) % 360.0
  xs = r * rad(tlon).cos
  ys = r * rad(tlon).sin
  ye = ys * rad(ecl).cos
  ze = ys * rad(ecl).sin
  sun_ra = (to_deg(ye.atan2(xs)) + 360.0) % 360.0
  sun_dec = to_deg(ze.atan2((xs * xs + ye * ye).sqrt))
  ls = (ws + ms) % 360.0
  gmst0 = (ls + 180.0) / 15.0 % 24.0
  Sky(lat = lat, lon = lon, tz = tz, d = d, ecl = ecl, ls = ls, xs = xs, ys = ys, sidtime = gmst0 + ut + lon / 15.0, sun_ra = sun_ra, sun_dec = sun_dec, sun_lon = turn(tlon), sun_dist = r, mj = (19.895 + 0.0830853001 * d) % 360.0, ms = (316.967 + 0.0334442282 * d) % 360.0)
}

// The sky over a place at an hour of Universal Time on a day.
sky_ut(year : Int, month : Int, day : Int, ut : Float, lat : Float, lon : Float, tz : Float) : Sky {
  d = (367 * year - 7 * (year + (month + 9) / 12) / 4 + 275 * month / 9 + day - 730530).toFloat + ut / 24.0
  sky_d(d, ut, lat, lon, tz)
}

// The sky over a place on a day, at 0h UT.
sky(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : Sky {
  sky_ut(year, month, day, 0.0, lat, lon, tz)
}

// The sky over a place at a local clock hour (17.5 is half past five; 25.0 is 01:00 the
// next day).
sky_at(year : Int, month : Int, day : Int, hour : Float, lat : Float, lon : Float, tz : Float) : Sky {
  sky_ut(year, month, day, hour - tz, lat, lon, tz)
}

// The sky over a place at a moment (a Julian date). For a place-free question (a phase, a
// conjunction) give 0.0 for lat, lon and tz.
sky_jd(j : Float, lat : Float, lon : Float, tz : Float) : Sky {
  d = j - 2451543.5
  sky_d(d, (d - d.floor) * 24.0, lat, lon, tz)
}

// The moment of a sky, as a Julian date.
jd_of(s : Sky) : Float {
  s.d + 2451543.5
}

// The local sidereal time of a sky, in degrees.
sidereal(s : Sky) : Float {
  ((s.sidtime % 24.0 + 24.0) % 24.0) * 15.0
}

// Minutes a sundial runs ahead of the clock (the equation of time).
equation_of_time(s : Sky) : Float {
  swing(s.ls - s.sun_ra) * 4.0
}

elements(name : Str, d : Float) : List[Float] {
  // The six orbit numbers of a body: n, i, w, a, e, m.
  out = [0.0, 0.0, 282.9404 + 4.70935e-5 * d, 1.0, 0.016709 - 1.151e-9 * d, 356.047 + 0.9856002585 * d]
  if name == "mercury" {
    out = [48.3313 + 3.24587e-5 * d, 7.0047 + 5.0e-8 * d, 29.1241 + 1.01444e-5 * d, 0.387098, 0.205635 + 5.59e-10 * d, 168.6562 + 4.0923344368 * d]
  }
  if name == "venus" {
    out = [76.6799 + 2.4659e-5 * d, 3.3946 + 2.75e-8 * d, 54.891 + 1.38374e-5 * d, 0.72333, 0.006773 - 1.302e-9 * d, 48.0052 + 1.6021302244 * d]
  }
  if name == "mars" {
    out = [49.5574 + 2.11081e-5 * d, 1.8497 - 1.78e-8 * d, 286.5016 + 2.92961e-5 * d, 1.523688, 0.093405 + 2.516e-9 * d, 18.6021 + 0.5240207766 * d]
  }
  if name == "jupiter" {
    out = [100.4542 + 2.76854e-5 * d, 1.303 - 1.557e-7 * d, 273.8777 + 1.64505e-5 * d, 5.20256, 0.048498 + 4.469e-9 * d, 19.895 + 0.0830853001 * d]
  }
  if name == "saturn" {
    out = [113.6634 + 2.3898e-5 * d, 2.4886 - 1.081e-7 * d, 339.3939 + 2.97661e-5 * d, 9.55475, 0.055546 - 9.499e-9 * d, 316.967 + 0.0334442282 * d]
  }
  if name == "uranus" {
    out = [74.0005 + 1.3978e-5 * d, 0.7733 + 1.9e-8 * d, 96.6612 + 3.0565e-5 * d, 19.18171 - 1.55e-8 * d, 0.047318 + 7.45e-9 * d, 142.5905 + 0.011725806 * d]
  }
  if name == "neptune" {
    out = [131.7806 + 3.0173e-5 * d, 1.77 - 2.55e-7 * d, 272.8461 - 6.027e-6 * d, 30.05826 + 3.313e-8 * d, 0.008606 + 2.15e-9 * d, 260.2471 + 0.005995147 * d]
  }
  out
}

