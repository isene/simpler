// astro: where the sun, the moon and the planets are, when they rise and set, moon phases,
// twilight, equinoxes and solstices. A port of the orbit library (Schlyter's elements for
// the planets, Meeus chapter 47 for the moon). Angles are in degrees, hours are local clock
// hours, lat is north-positive, lon is east-positive, tz is hours ahead of UT (Oslo in
// winter: 1.0). A body is named "sun", "moon", "mercury", "venus", "mars", "jupiter",
// "saturn", "uranus" or "neptune". Good to about a minute of arc for the moon and a few
// for the planets, between 1900 and 2100.

// The sky for one place and one instant. Make it with sky or sky_at, hand it to the rest.
Sky = type {
  lat : Float
  lon : Float
  tz : Float
  d : Float
  ecl : Float
  ls : Float
  xs : Float
  ys : Float
  sidtime : Float
  sun_ra : Float
  sun_dec : Float
  mj : Float
  ms : Float
}

// A place in the sky: ra and dec as seen from the observer, dist (AU; earth radii for the
// moon), and gra, gdec as seen from the centre of the earth.
Pos = type {
  ra : Float
  dec : Float
  dist : Float
  gra : Float
  gdec : Float
}

// Height above the horizon and compass direction (0 north, 90 east).
Hor = type {
  alt : Float
  az : Float
}

// Rise, transit and set as "HH:MM" local time. A body that never sets has rise "always"
// and set "never"; one that never rises has rise "never" and set "always".
Times = type {
  rise : Str
  transit : Str
  set : Str
}

// All about one body for one day.
Body = type {
  name : Str
  ra : Float
  dec : Float
  dist : Float
  rise : Str
  transit : Str
  set : Str
}

// The moon's phase: lit is the lit part (0 to 1), age the part of the month gone (0 to 1),
// index 0 new, 2 first quarter, 4 full, 6 last quarter.
Phase = type {
  lit : Float
  age : Float
  index : Int
  name : Str
  symbol : Str
}

pi() : Float {
  3.141592653589793
}

rad(d : Float) : Float {
  d * 3.141592653589793 / 180.0
}

to_deg(r : Float) : Float {
  r * 180.0 / 3.141592653589793
}

turn(x : Float) : Float {
  // An angle brought into 0 to 360.
  r = x % 360.0
  if r < 0.0 {
    r = r + 360.0
  }
  r
}

two(n : Int) : Str {
  s = n.toStr
  if n < 10 {
    s = "0" + s
  }
  s
}

// Hours as "HH:MM".
hhmm(hours : Float) : Str {
  h = hours % 24.0
  if h < 0.0 {
    h = h + 24.0
  }
  hh = h.floor.toInt
  mm = ((h - hh.toFloat) * 60.0).round.toInt
  if mm >= 60 {
    hh = (hh + 1) % 24
    mm = 0
  }
  two(hh) + ":" + two(mm)
}

// "HH:MM" as hours, or -1.0 for "always" and "never".
hours_of(s : Str) : Float {
  if s.length < 5 || !s.slice(0, 2).isInt {
    return -1.0
  }
  s.slice(0, 2).toInt.toFloat + s.slice(3, 5).toInt.toFloat / 60.0
}

// A right ascension as "05h 12m".
ra_text(ra : Float) : Str {
  h = ra / 15.0
  if h < 0.0 {
    h = h + 24.0
  }
  hh = h.floor.toInt
  mm = ((h - hh.toFloat) * 60.0).round.toInt
  if mm >= 60 {
    hh = (hh + 1) % 24
    mm = 0
  }
  two(hh) + "h " + two(mm) + "m"
}

// A declination as "+19° 05′".
dec_text(dec : Float) : Str {
  sign = "+"
  if dec < 0.0 {
    sign = "-"
  }
  a = dec.abs
  dd = a.floor.toInt
  mm = ((a - dd.toFloat) * 60.0).round.toInt
  if mm >= 60 {
    dd = dd + 1
    mm = 0
  }
  sign + two(dd) + "° " + two(mm) + "′"
}

is_leap(year : Int) : Bool {
  (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
}

days_in_month(year : Int, month : Int) : Int {
  n = 31
  if month == 4 || month == 6 || month == 9 || month == 11 {
    n = 30
  }
  if month == 2 {
    n = 28
    if is_leap(year) {
      n = 29
    }
  }
  n
}

// The Julian date at 0h UT of a day.
jd(year : Int, month : Int, day : Int) : Float {
  y = year.toFloat
  m = month.toFloat
  (367.0 * y) - ((7.0 * (y + ((m + 9.0) / 12.0).floor)) / 4.0).floor + ((275.0 * m) / 9.0).floor + day.toFloat + 1721013.5
}

// The Julian date of a day and a time of day (UT).
jd_at(year : Int, month : Int, day : Int, hour : Int, minute : Int, sec : Int) : Float {
  jd(year, month, day) + (hour * 3600 + minute * 60 + sec).toFloat / 86400.0
}

// A Julian date as "2026-03-20 14:46" (UT).
jd_text(j : Float) : Str {
  z = (j + 0.5).floor
  f = j + 0.5 - z
  a = z
  if z >= 2299161.0 {
    al = ((z - 1867216.25) / 36524.25).floor
    a = z + 1.0 + al - (al / 4.0).floor
  }
  b = a + 1524.0
  c = ((b - 122.1) / 365.25).floor
  dd = (365.25 * c).floor
  e = ((b - dd) / 30.6001).floor
  day = (b - dd - (30.6001 * e).floor).toInt
  month = e.toInt - 1
  if month > 12 {
    month = month - 12
  }
  year = c.toInt - 4716
  if month <= 2 {
    year = year + 1
  }
  mins = (f * 1440.0).round.toInt
  if mins >= 1440 {
    mins = 1439
  }
  year.toStr + "-" + two(month) + "-" + two(day) + " " + two(mins / 60) + ":" + two(mins % 60)
}

phase_name(i : Int) : Str {
  ["New Moon", "Waxing Crescent", "First Quarter", "Waxing Gibbous", "Full Moon", "Waning Gibbous", "Last Quarter", "Waning Crescent"].at(i)
}

phase_symbol(i : Int) : Str {
  ["🌑", "🌒", "🌓", "🌔", "🌕", "🌖", "🌗", "🌘"].at(i)
}

// The moon's phase on a day (at 0h UT), from the mean length of the month.
moon_phase(year : Int, month : Int, day : Int) : Phase {
  since = jd(year, month, day) - 2451550.1
  p = (since / 29.530588853) % 1.0
  if p < 0.0 {
    p = p + 1.0
  }
  lit = (1.0 - (p * 2.0 * pi()).cos) / 2.0
  idx = (p * 8.0).floor.toInt % 8
  Phase(lit = (lit * 10000.0).round / 10000.0, age = (p * 10000.0).round / 10000.0, index = idx, name = phase_name(idx), symbol = phase_symbol(idx))
}

// Is this the day the moon turns new, first quarter, full or last quarter?
notable_phase(year : Int, month : Int, day : Int) : Bool {
  t = moon_phase(year, month, day)
  if t.index % 2 != 0 {
    return false
  }
  py = year
  pm = month
  pd = day - 1
  if pd < 1 {
    pm = month - 1
    if pm < 1 {
      pm = 12
      py = year - 1
    }
    pd = days_in_month(py, pm)
  }
  moon_phase(py, pm, pd).index != t.index
}

// The days of a month with a notable phase, each as "14 🌕 Full Moon".
phases_in_month(year : Int, month : Int) : List[Str] {
  out : List[Str] = []
  for d in 1..=days_in_month(year, month) {
    if notable_phase(year, month, d) {
      p = moon_phase(year, month, d)
      out.push(d.toStr + " " + p.symbol + " " + p.name)
    }
  }
  out
}

// When a season starts, as a Julian date (UT, good to a few minutes). which is 0 for the
// March equinox, 1 the June solstice, 2 the September equinox, 3 the December solstice.
season(year : Int, which : Int) : Float {
  y = (year - 2000).toFloat / 1000.0
  j = 2451623.80984 + 365242.37404 * y + 0.05169 * y * y - 0.00411 * y * y * y - 0.00057 * y * y * y * y
  if which == 1 {
    j = 2451716.56767 + 365241.62603 * y + 0.00325 * y * y + 0.00888 * y * y * y - 0.0003 * y * y * y * y
  }
  if which == 2 {
    j = 2451810.21715 + 365242.01767 * y - 0.11575 * y * y + 0.00337 * y * y * y + 0.00078 * y * y * y * y
  }
  if which == 3 {
    j = 2451900.05952 + 365242.74049 * y - 0.06223 * y * y - 0.00823 * y * y * y + 0.00032 * y * y * y * y
  }
  t = (j - 2451545.0) / 36525.0
  w = 35999.373 * t - 2.47
  dl = 1.0 + 0.0334 * rad(w).cos + 0.0007 * rad(2.0 * w).cos
  a = [485.0, 203.0, 199.0, 182.0, 156.0, 136.0, 77.0, 74.0, 70.0, 58.0, 52.0, 50.0, 45.0, 44.0, 29.0, 18.0, 17.0, 16.0, 14.0, 12.0, 12.0, 12.0, 9.0, 8.0]
  b = [324.96, 337.23, 342.08, 27.85, 73.14, 171.52, 222.54, 296.72, 243.58, 119.81, 297.17, 21.02, 247.54, 325.15, 60.93, 155.12, 288.79, 198.04, 199.76, 95.39, 287.11, 320.81, 227.73, 15.45]
  c = [1934.136, 32964.467, 20.186, 445267.112, 45036.886, 22518.443, 65928.934, 3034.906, 9037.513, 33718.147, 150.678, 2281.226, 29929.562, 31555.956, 4443.417, 67555.328, 4562.452, 62894.029, 31436.921, 14577.848, 31931.756, 34777.259, 1222.114, 16859.074]
  s = 0.0
  for i in 0..24 {
    s = s + a.at(i) * rad(b.at(i) + c.at(i) * t).cos
  }
  // Dynamical time runs about 70 seconds ahead of UT in this century.
  j + 0.00001 * s / dl - 70.0 / 86400.0
}

// What a day is known for: a notable moon phase, a season's start, a meteor shower's peak.
events(year : Int, month : Int, day : Int) : List[Str] {
  out : List[Str] = []
  if notable_phase(year, month, day) {
    p = moon_phase(year, month, day)
    out.push(p.symbol + " " + p.name)
  }
  names = ["☀ Vernal Equinox", "☀ Summer Solstice", "☀ Autumnal Equinox", "❄ Winter Solstice"]
  stamp = year.toStr + "-" + two(month) + "-" + two(day)
  for w in 0..4 {
    when = jd_text(season(year, w))
    if when.slice(0, 10) == stamp {
      out.push(names.at(w) + " " + when.slice(11, 16) + " UT")
    }
  }
  key = month * 100 + day
  days = [103, 422, 506, 730, 812, 1008, 1021, 1105, 1117, 1214, 1222]
  showers = ["Quadrantids", "Lyrids", "Eta Aquariids", "Delta Aquariids", "Perseids", "Draconids", "Orionids", "Taurids", "Leonids", "Geminids", "Ursids"]
  for i in 0..days.length {
    if days.at(i) == key {
      out.push("☄ " + showers.at(i) + " peak")
    }
  }
  out
}

// The sky over a place at an hour of Universal Time on a day.
sky_ut(year : Int, month : Int, day : Int, ut : Float, lat : Float, lon : Float, tz : Float) : Sky {
  d = (367 * year - 7 * (year + (month + 9) / 12) / 4 + 275 * month / 9 + day - 730530).toFloat + ut / 24.0
  t = d / 36525.0
  ecl = 23.439279444 - 46.815 / 3600.0 * t - 0.00059 / 3600.0 * t * t + 0.001813 / 3600.0 * t * t * t
  sw = 282.9404 + 4.70935e-5 * d
  se = 0.016709 - 1.151e-9 * d
  sm = 356.047 + 0.9856002585 * d
  ws = (sw + 360.0) % 360.0
  ms = sm % 360.0
  es = ms + (180.0 / pi()) * se * rad(ms).sin * (1.0 + se * rad(ms).cos)
  x = rad(es).cos - se
  y = rad(es).sin * (1.0 - se * se).sqrt
  v = to_deg(y.atan2(x))
  r = (x * x + y * y).sqrt
  tlon = (v + ws) % 360.0
  xs = r * rad(tlon).cos
  ys = r * rad(tlon).sin
  ye = ys * rad(ecl).cos
  ze = ys * rad(ecl).sin
  sun_ra = (to_deg(ye.atan2(xs)) + 360.0) % 360.0
  sun_dec = to_deg(ze.atan2((xs * xs + ye * ye).sqrt))
  ls = (ws + ms) % 360.0
  gmst0 = (ls + 180.0) / 15.0 % 24.0
  Sky(lat = lat, lon = lon, tz = tz, d = d, ecl = ecl, ls = ls, xs = xs, ys = ys, sidtime = gmst0 + ut + lon / 15.0, sun_ra = sun_ra, sun_dec = sun_dec, mj = (19.895 + 0.0830853001 * d) % 360.0, ms = (316.967 + 0.0334442282 * d) % 360.0)
}

// The sky over a place for a day (at 0h UT): right for rise and set times.
sky(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : Sky {
  sky_ut(year, month, day, 0.0, lat, lon, tz)
}

// The sky over a place at a local clock hour (17.5 is half past five): right for where
// things are at that moment.
sky_at(year : Int, month : Int, day : Int, hour : Float, lat : Float, lon : Float, tz : Float) : Sky {
  sky_ut(year, month, day, hour - tz, lat, lon, tz)
}

// The local sidereal time of a sky, in degrees.
sidereal(s : Sky) : Float {
  ((s.sidtime % 24.0 + 24.0) % 24.0) * 15.0
}

elements(name : Str, d : Float) : List[Float] {
  // The six orbit numbers of a body: n, i, w, a, e, m.
  out = [0.0, 0.0, 282.9404 + 4.70935e-5 * d, 1.0, 0.016709 - 1.151e-9 * d, 356.047 + 0.9856002585 * d]
  if name == "mercury" {
    out = [48.3313 + 3.24587e-5 * d, 7.0047 + 5.0e-8 * d, 29.1241 + 1.01444e-5 * d, 0.387098, 0.205635 + 5.59e-10 * d, 168.6562 + 4.0923344368 * d]
  }
  if name == "venus" {
    out = [76.6799 + 2.4659e-5 * d, 3.3946 + 2.75e-8 * d, 54.891 + 1.38374e-5 * d, 0.72333, 0.006773 - 1.302e-9 * d, 48.0052 + 1.6021302244 * d]
  }
  if name == "mars" {
    out = [49.5574 + 2.11081e-5 * d, 1.8497 - 1.78e-8 * d, 286.5016 + 2.92961e-5 * d, 1.523688, 0.093405 + 2.516e-9 * d, 18.6021 + 0.5240207766 * d]
  }
  if name == "jupiter" {
    out = [100.4542 + 2.76854e-5 * d, 1.303 - 1.557e-7 * d, 273.8777 + 1.64505e-5 * d, 5.20256, 0.048498 + 4.469e-9 * d, 19.895 + 0.0830853001 * d]
  }
  if name == "saturn" {
    out = [113.6634 + 2.3898e-5 * d, 2.4886 - 1.081e-7 * d, 339.3939 + 2.97661e-5 * d, 9.55475, 0.055546 - 9.499e-9 * d, 316.967 + 0.0334442282 * d]
  }
  if name == "uranus" {
    out = [74.0005 + 1.3978e-5 * d, 0.7733 + 1.9e-8 * d, 96.6612 + 3.0565e-5 * d, 19.18171 - 1.55e-8 * d, 0.047318 + 7.45e-9 * d, 142.5905 + 0.011725806 * d]
  }
  if name == "neptune" {
    out = [131.7806 + 3.0173e-5 * d, 1.77 - 2.55e-7 * d, 272.8461 - 6.027e-6 * d, 30.05826 + 3.313e-8 * d, 0.008606 + 2.15e-9 * d, 260.2471 + 0.005995147 * d]
  }
  out
}

moon_lr() : List[Int] {
  // Meeus table 47.A, six numbers a row: D, M, M', F, the longitude term, the distance term.
  [
    0, 0, 1, 0, 6288774, -20905355, 2, 0, -1, 0, 1274027, -3699111, 2, 0, 0, 0, 658314, -2955968, 0, 0, 2, 0, 213618, -569925,
    0, 1, 0, 0, -185116, 48888, 0, 0, 0, 2, -114332, -3149, 2, 0, -2, 0, 58793, 246158, 2, -1, -1, 0, 57066, -152138,
    2, 0, 1, 0, 53322, -170733, 2, -1, 0, 0, 45758, -204586, 0, 1, -1, 0, -40923, -129620, 1, 0, 0, 0, -34720, 108743,
    0, 1, 1, 0, -30383, 104755, 2, 0, 0, -2, 15327, 10321, 0, 0, 1, 2, -12528, 0, 0, 0, 1, -2, 10980, 79661,
    4, 0, -1, 0, 10675, -34782, 0, 0, 3, 0, 10034, -23210, 4, 0, -2, 0, 8548, -21636, 2, 1, -1, 0, -7888, 24208,
    2, 1, 0, 0, -6766, 30824, 1, 0, -1, 0, -5163, -8379, 1, 1, 0, 0, 4987, -16675, 2, -1, 1, 0, 4036, -12831,
    2, 0, 2, 0, 3994, -10445, 4, 0, 0, 0, 3861, -11650, 2, 0, -3, 0, 3665, 14403, 0, 1, -2, 0, -2689, -7003,
    2, 0, -1, 2, -2602, 0, 2, -1, -2, 0, 2390, 10056, 1, 0, 1, 0, -2348, 6322, 2, -2, 0, 0, 2236, -9884,
    0, 1, 2, 0, -2120, 5751, 0, 2, 0, 0, -2069, 0, 2, -2, -1, 0, 2048, -4950, 2, 0, 1, -2, -1773, 4130,
    2, 0, 0, 2, -1595, 0, 4, -1, -1, 0, 1215, -3958, 0, 0, 2, 2, -1110, 0, 3, 0, -1, 0, -892, 3258,
    2, 1, 1, 0, -810, 2616, 4, -1, -2, 0, 759, -1897, 0, 2, -1, 0, -713, -2117, 2, 2, -1, 0, -700, 2354,
    2, 1, -2, 0, 691, 0, 2, -1, 0, -2, 596, 0, 4, 0, 1, 0, 549, -1423, 0, 0, 4, 0, 537, -1117,
    4, -1, 0, 0, 520, -1571, 1, 0, -2, 0, -487, -1739, 2, 1, 0, -2, -399, 0, 0, 0, 2, -2, -381, -4421,
    1, 1, 1, 0, 351, 0, 3, 0, -2, 0, -340, 0, 4, 0, -3, 0, 330, 0, 2, -1, 2, 0, 327, 0,
    0, 2, 1, 0, -323, 1165, 1, 1, -1, 0, 299, 0, 2, 0, 3, 0, 294, 0, 2, 0, -1, -2, 0, 8752
  ]
}

