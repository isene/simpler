    2, 1, 0, 0, -6766, 30824, 1, 0, -1, 0, -5163, -8379, 1, 1, 0, 0, 4987, -16675, 2, -1, 1, 0, 4036, -12831,
    2, 0, 2, 0, 3994, -10445, 4, 0, 0, 0, 3861, -11650, 2, 0, -3, 0, 3665, 14403, 0, 1, -2, 0, -2689, -7003,
    2, 0, -1, 2, -2602, 0, 2, -1, -2, 0, 2390, 10056, 1, 0, 1, 0, -2348, 6322, 2, -2, 0, 0, 2236, -9884,
    0, 1, 2, 0, -2120, 5751, 0, 2, 0, 0, -2069, 0, 2, -2, -1, 0, 2048, -4950, 2, 0, 1, -2, -1773, 4130,
    2, 0, 0, 2, -1595, 0, 4, -1, -1, 0, 1215, -3958, 0, 0, 2, 2, -1110, 0, 3, 0, -1, 0, -892, 3258,
    2, 1, 1, 0, -810, 2616, 4, -1, -2, 0, 759, -1897, 0, 2, -1, 0, -713, -2117, 2, 2, -1, 0, -700, 2354,
    2, 1, -2, 0, 691, 0, 2, -1, 0, -2, 596, 0, 4, 0, 1, 0, 549, -1423, 0, 0, 4, 0, 537, -1117,
    4, -1, 0, 0, 520, -1571, 1, 0, -2, 0, -487, -1739, 2, 1, 0, -2, -399, 0, 0, 0, 2, -2, -381, -4421,
    1, 1, 1, 0, 351, 0, 3, 0, -2, 0, -340, 0, 4, 0, -3, 0, 330, 0, 2, -1, 2, 0, 327, 0,
    0, 2, 1, 0, -323, 1165, 1, 1, -1, 0, 299, 0, 2, 0, 3, 0, 294, 0, 2, 0, -1, -2, 0, 8752
  ]
}

moon_b() : List[Int] {
  // Meeus table 47.B, five numbers a row: D, M, M', F, the latitude term.
  [
    0, 0, 0, 1, 5128122, 0, 0, 1, 1, 280602, 0, 0, 1, -1, 277693, 2, 0, 0, -1, 173237,
    2, 0, -1, 1, 55413, 2, 0, -1, -1, 46271, 2, 0, 0, 1, 32573, 0, 0, 2, 1, 17198,
    2, 0, 1, -1, 9266, 0, 0, 2, -1, 8822, 2, -1, 0, -1, 8216, 2, 0, -2, -1, 4324,
    2, 0, 1, 1, 4200, 2, 1, 0, -1, -3359, 2, -1, -1, 1, 2463, 2, -1, 0, 1, 2211,
    2, -1, -1, -1, 2065, 0, 1, -1, -1, -1870, 4, 0, -1, -1, 1828, 0, 1, 0, 1, -1794,
    0, 0, 0, 3, -1749, 0, 1, -1, 1, -1565, 1, 0, 0, 1, -1491, 0, 1, 1, 1, -1475,
    0, 1, 1, -1, -1410, 0, 1, 0, -1, -1344, 1, 0, 0, -1, -1335, 0, 0, 3, 1, 1107,
    4, 0, 0, -1, 1021, 4, 0, -1, 1, 833, 0, 0, 1, -3, 777, 4, 0, -2, 1, 671,
    2, 0, 0, -3, 607, 2, 0, 2, -1, 596, 2, -1, 1, -1, 491, 2, 0, -2, 1, -451,
    0, 0, 3, -1, 439, 2, 0, 2, 1, 422, 2, 0, -3, -1, 421, 2, 1, -1, 1, -366,
    2, 1, 0, 1, -351, 4, 0, 0, 1, 331, 2, -1, 1, 1, 315, 2, -2, 0, -1, 302,
    0, 0, 1, 3, -283, 2, 1, 1, -1, -229, 1, 1, 0, -1, 223, 1, 1, 0, 1, 223,
    0, 1, -2, -1, -220, 2, 1, -1, -1, -220, 1, 0, 1, 1, -185, 2, -1, -2, -1, 181,
    0, 1, 2, 1, -177, 4, 0, -2, -1, 176, 4, -1, -1, -1, 166, 1, 0, 1, -1, -164,
    4, 0, 1, -1, 132, 1, 0, -1, -1, -119, 4, -1, 0, -1, 115, 2, -2, 0, 1, 107
  ]
}

moon_centre(s : Sky) : List[Float] {
  // The moon seen from the centre of the earth: ra, dec, distance in earth radii, and its
  // place along and above the ecliptic.
  t = (s.d - 1.5) / 36525.0
  t2 = t * t
  t3 = t2 * t
  t4 = t3 * t
  lp = 218.3164477 + 481267.88123421 * t - 0.0015786 * t2 + t3 / 538841.0 - t4 / 65194000.0
  dm = 297.8501921 + 445267.1114034 * t - 0.0018819 * t2 + t3 / 545868.0 - t4 / 113065000.0
  m = 357.5291092 + 35999.0502909 * t - 0.0001536 * t2 + t3 / 24490000.0
  mp = 134.9633964 + 477198.8675055 * t + 0.0087414 * t2 + t3 / 69699.0 - t4 / 14712000.0
  f = 93.272095 + 483202.0175233 * t - 0.0036539 * t2 - t3 / 3526000.0 + t4 / 863310000.0
  a1 = 119.75 + 131.849 * t
  a2 = 53.09 + 479264.29 * t
  a3 = 313.45 + 481266.484 * t
  e = 1.0 - 0.002516 * t - 0.0000074 * t2
  dr = rad(dm)
  mr = rad(m)
  mpr = rad(mp)
  fr = rad(f)
  sl = 0.0
  sr = 0.0
  lr = moon_lr()
  k = 0
  while k < lr.length {
    arg = lr.at(k).toFloat * dr + lr.at(k + 1).toFloat * mr + lr.at(k + 2).toFloat * mpr + lr.at(k + 3).toFloat * fr
    scale = 1.0
    mi = lr.at(k + 1)
    if mi == 1 || mi == -1 {
      scale = e
    }
    if mi > 1 || mi < -1 {
      scale = e * e
    }
    sl = sl + lr.at(k + 4).toFloat * scale * arg.sin
    sr = sr + lr.at(k + 5).toFloat * scale * arg.cos
    k = k + 6
  }
  sb = 0.0
  bt = moon_b()
  k = 0
  while k < bt.length {
    argb = bt.at(k).toFloat * dr + bt.at(k + 1).toFloat * mr + bt.at(k + 2).toFloat * mpr + bt.at(k + 3).toFloat * fr
    scaleb = 1.0
    mb = bt.at(k + 1)
    if mb == 1 || mb == -1 {
      scaleb = e
    }
    if mb > 1 || mb < -1 {
      scaleb = e * e
    }
    sb = sb + bt.at(k + 4).toFloat * scaleb * argb.sin
    k = k + 5
  }
  sl = sl + 3958.0 * rad(a1).sin + 1962.0 * rad(lp - f).sin + 318.0 * rad(a2).sin
  sb = sb - 2235.0 * rad(lp).sin + 382.0 * rad(a3).sin + 175.0 * rad(a1 - f).sin + 175.0 * rad(a1 + f).sin + 127.0 * rad(lp - mp).sin - 115.0 * rad(lp + mp).sin
  lam = rad(turn(lp + sl / 1000000.0))
  bet = rad(sb / 1000000.0)
  eps = rad(s.ecl)
  ra = to_deg((lam.sin * eps.cos - bet.tan * eps.sin).atan2(lam.cos))
  if ra < 0.0 {
    ra = ra + 360.0
  }
  sd = clamp1(bet.sin * eps.cos + bet.cos * eps.sin * lam.sin)
  [ra, to_deg(sd.asin), (385000.56 + sr / 1000.0) / 6378.14, to_deg(lam), to_deg(bet)]
}

observed(s : Sky, c : List[Float]) : Pos {
  // From the centre of the earth to the observer. c: ra, dec, dist, sun_dist, lon, lat,
  // and the parallax in degrees.
  ra = c.at(0)
  dec = c.at(1)
  u = (0.99664719 * rad(s.lat).tan).atan
  rs = 0.99664719 * u.sin
  rc = u.cos
  sp = rad(c.at(6)).sin
  ha = rad(s.sidtime * 15.0 - ra)
  ax = rad(dec).cos * ha.sin
  bx = rad(dec).cos * ha.cos - rc * sp
  cx = rad(dec).sin - rs * sp
  q = (ax * ax + bx * bx + cx * cx).sqrt
  tra = turn(s.sidtime * 15.0 - to_deg(ax.atan2(bx)))
  tdec = to_deg(clamp1(cx / q).asin)
  Pos(ra = tra, dec = tdec, dist = c.at(2), gra = ra, gdec = dec, lon = c.at(4), lat = c.at(5), sun_dist = c.at(3), tdist = c.at(2) * q)
}

kepler(m : Float, e : Float) : Float {
  // The eccentric anomaly, in degrees.
  e1 = m + (180.0 / pi()) * e * rad(m).sin * (1.0 + e * rad(m).cos)
  if e > 0.8 {
    e1 = 180.0
  }
  n = 0
  going = true
  while going && n < 80 {
    e0 = e1
    e1 = e0 - (e0 - (180.0 / pi()) * e * rad(e0).sin - m) / (1.0 - e * rad(e0).cos)
    going = (e1 - e0).abs > 0.00005
    n = n + 1
  }
  e1
}

helio(nb : Float, ib : Float, wb : Float, ab : Float, eb : Float, mb : Float) : List[Float] {
  // Round the sun: along the ecliptic, above it, and the distance.
  e1 = kepler(turn(mb), eb)
  x = ab * (rad(e1).cos - eb)
  y = ab * (1.0 - eb * eb).sqrt * rad(e1).sin
  r = (x * x + y * y).sqrt
  v = (to_deg(y.atan2(x)) + 360.0) % 360.0
  xe = r * (rad(nb).cos * rad(v + wb).cos - rad(nb).sin * rad(v + wb).sin * rad(ib).cos)
  ye = r * (rad(nb).sin * rad(v + wb).cos + rad(nb).cos * rad(v + wb).sin * rad(ib).cos)
  ze = r * rad(v + wb).sin * rad(ib).sin
  [turn(to_deg(ye.atan2(xe))), to_deg(ze.atan2((xe * xe + ye * ye).sqrt)), (xe * xe + ye * ye + ze * ze).sqrt]
}

from_earth(s : Sky, lon : Float, lat : Float, rb : Float, is_sun : Bool) : List[Float] {
  // From round the sun to round the earth: ra, dec, dist, sun_dist, lon, lat, parallax.
  xh = rb * rad(lon).cos * rad(lat).cos
  yh = rb * rad(lon).sin * rad(lat).cos
  zh = rb * rad(lat).sin
  if !is_sun {
    xh = xh + s.xs
    yh = yh + s.ys
  }
  yq = yh * rad(s.ecl).cos - zh * rad(s.ecl).sin
  zq = yh * rad(s.ecl).sin + zh * rad(s.ecl).cos
  dist = (xh * xh + yq * yq + zq * zq).sqrt
  sd = rb
  if is_sun {
    sd = 0.0
  }
  [turn(to_deg(yq.atan2(xh))), to_deg(zq.atan2((xh * xh + yq * yq).sqrt)), dist, sd, turn(to_deg(yh.atan2(xh))), to_deg(zh.atan2((xh * xh + yh * yh).sqrt)), (8.794 / 3600.0) / dist]
}

// The nine body names, in the order bodies gives them.
names() : List[Str] {
  ["sun", "moon", "mercury", "venus", "mars", "jupiter", "saturn", "uranus", "neptune"]
}

index_of(name : Str) : Int {
  all = names()
  for i in 0..all.length {
    if all.at(i) == name {
      return i
    }
  }
  -1
}

// Where a body is in a sky. A name that is no body gives the sun.
pos(s : Sky, name : Str) : Pos {
  if name == "moon" {
    mc = moon_centre(s)
    return observed(s, [mc.at(0), mc.at(1), mc.at(2), s.sun_dist, mc.at(3), mc.at(4), to_deg((1.0 / mc.at(2)).asin)])
  }
  el = elements(name, s.d)
  h = helio(el.at(0), el.at(1), (el.at(2) + 360.0) % 360.0, el.at(3), el.at(4), el.at(5))
  lon = h.at(0)
  lat = h.at(1)
  mj = s.mj
  ms = s.ms
  if name == "jupiter" {
    lon = lon - 0.332 * rad(2.0 * mj - 5.0 * ms - 67.6).sin - 0.056 * rad(2.0 * mj - 2.0 * ms + 21.0).sin + 0.042 * rad(3.0 * mj - 5.0 * ms + 21.0).sin - 0.036 * rad(mj - 2.0 * ms).sin + 0.022 * rad(mj - ms).cos + 0.023 * rad(2.0 * mj - 3.0 * ms + 52.0).sin - 0.016 * rad(mj - 5.0 * ms - 69.0).sin
  }
  if name == "saturn" {
    lon = lon + 0.812 * rad(2.0 * mj - 5.0 * ms - 67.6).sin - 0.229 * rad(2.0 * mj - 4.0 * ms - 2.0).cos + 0.119 * rad(mj - 2.0 * ms - 3.0).sin + 0.046 * rad(2.0 * mj - 6.0 * ms - 69.0).sin + 0.014 * rad(mj - 3.0 * ms + 32.0).sin
    lat = lat - 0.02 * rad(2.0 * mj - 4.0 * ms - 2.0).cos + 0.018 * rad(2.0 * mj - 6.0 * ms - 49.0).sin
  }
  observed(s, from_earth(s, lon, lat, h.at(2), index_of(name) < 1))
}

// Pluto's path, good to a few minutes of arc from 1800 to 2050.
pluto() : Orbit {
  Orbit(name = "pluto", node = 110.30393684, incl = 17.14001206, peri = 113.76497945, a = 39.48211675, e = 0.2488273, m0 = 14.86012204, epoch = 2451545.0, daily = 0.003975577)
}

// Where a body on a path round the sun is in a sky: orbit_pos(s, astro.pluto()), or a comet
// or an asteroid with numbers from a catalogue.
orbit_pos(s : Sky, o : Orbit) : Pos {
  n = o.daily
  if n == 0.0 {
    n = 0.9856076686 / o.a.pow(1.5)
  }
  h = helio(o.node, o.incl, o.peri, o.a, o.e, o.m0 + n * (jd_of(s) - o.epoch))
  // The numbers are for the year 2000; the sky is for its own day.
  observed(s, from_earth(s, h.at(0) + 3.82394e-5 * (s.d - 1.5), h.at(1), h.at(2), false))
}

// Height and direction of a place in the sky (ra, dec).
horizon(s : Sky, ra : Float, dec : Float) : Hor {
  ha = rad(s.sidtime * 15.0 - ra)
  x = ha.cos * rad(dec).cos
  y = ha.sin * rad(dec).cos
  z = rad(dec).sin
  xh = x * rad(s.lat).sin - z * rad(s.lat).cos
  zh = x * rad(s.lat).cos + z * rad(s.lat).sin
  Hor(alt = to_deg(clamp1(zh).asin), az = (to_deg(y.atan2(xh)) + 180.0) % 360.0)
}

// Height and direction of a body. The height is the true one; add refraction(alt) for the
// height the eye sees.
where(s : Sky, name : Str) : Hor {
  p = pos(s, name)
  horizon(s, p.ra, p.dec)
}

// How much the air lifts a thing at a true height, in degrees (0.48 at the horizon).
refraction(alt : Float) : Float {
  if alt < -1.0 {
    return 0.0
  }
  1.02 / rad(alt + 10.3 / (alt + 5.11)).tan / 60.0
}

// How much air the light passes at a height: 1.0 straight up, 38 at the horizon.
airmass(alt : Float) : Float {
  if alt < 0.0 {
    return 38.0
  }
  1.0 / (rad(alt).sin + 0.50572 * (alt + 6.07995).pow(-1.6364))
}

// The height a body's centre has when it is seen to rise or set.
rise_height(name : Str) : Float {
  h = -0.5667
  if name == "sun" || name == "moon" {
    h = -0.8333
  }
  h
}

// Rise, transit and set of a fixed place in the sky (a star), for the day of a sky made
// with sky. h0 is the height that counts as rising, as a rule -0.5667.
times(s : Sky, ra : Float, dec : Float, h0 : Float) : Times {
  tr = ((ra - s.ls - s.lon) / 15.0 + 12.0 + s.tz + 24.0) % 24.0
  phi = rad(s.lat)
  del = rad(dec)
  den = phi.cos * del.cos
  if den.abs < 1.0e-12 {
    return Times(rise = "never", transit = hhmm(tr), set = "always")
  }
  c = (rad(h0).sin - phi.sin * del.sin) / den
  if c < -1.0 {
    return Times(rise = "always", transit = hhmm(tr), set = "never")
  }
  if c > 1.0 {
    return Times(rise = "never", transit = hhmm(tr), set = "always")
  }
  lha = to_deg(c.acos) / 15.04107
  Times(rise = hhmm((tr - lha + 24.0) % 24.0), transit = hhmm(tr), set = hhmm((tr + lha + 24.0) % 24.0))
}

probe(year : Int, month : Int, day : Int, hour : Float, name : Str, lat : Float, lon : Float, tz : Float) : List[Float] {
  // A body at a local hour: its height, and the sine and cosine of its hour angle.
  s = sky_at(year, month, day, hour, lat, lon, tz)
  p = pos(s, name)
  ha = rad(s.sidtime * 15.0 - p.ra)
  [horizon(s, p.ra, p.dec).alt, ha.sin, ha.cos]
}

root(year : Int, month : Int, day : Int, name : Str, lat : Float, lon : Float, tz : Float, lo : Float, hi : Float, k : Int, off : Float) : Float {
  // The hour between lo and hi where number k of probe passes off.
  a = lo
  b = hi
  fa = probe(year, month, day, a, name, lat, lon, tz).at(k) - off
  for i in 0..13 {
    mid = (a + b) / 2.0
    fm = probe(year, month, day, mid, name, lat, lon, tz).at(k) - off
    if fa * fm > 0.0 {
      a = mid
      fa = fm
    } else {
      b = mid
    }
  }
  (a + b) / 2.0
}

// Rise, transit and set of a body on a local day, found by following the body through the
// day. h0 is the height that counts as rising: rise_height(name).
day_times(year : Int, month : Int, day : Int, name : Str, h0 : Float, lat : Float, lon : Float, tz : Float) : Times {
  rise = ""
  set = ""
  transit = "none"
  ups = 0
  last = probe(year, month, day, 0.0, name, lat, lon, tz)
  if last.at(0) > h0 {
    ups = 1
  }
  for i in 0..24 {
    lo = i.toFloat
    now = probe(year, month, day, lo + 1.0, name, lat, lon, tz)
    if now.at(0) > h0 {
      ups = ups + 1
    }
    if rise == "" && last.at(0) <= h0 && now.at(0) > h0 {
      rise = hhmm(root(year, month, day, name, lat, lon, tz, lo, lo + 1.0, 0, h0))
    }
    if set == "" && last.at(0) > h0 && now.at(0) <= h0 {
      set = hhmm(root(year, month, day, name, lat, lon, tz, lo, lo + 1.0, 0, h0))
    }
    if transit == "none" && last.at(1) < 0.0 && now.at(1) >= 0.0 && now.at(2) > 0.0 {
      top = root(year, month, day, name, lat, lon, tz, lo, lo + 1.0, 1, 0.0)
      transit = hhmm(top)
      // A body that is up for less than an hour: both ends of the hour are below.
      if last.at(0) <= h0 && now.at(0) <= h0 && probe(year, month, day, top, name, lat, lon, tz).at(0) > h0 {
        ups = ups + 1
        if rise == "" {
          rise = hhmm(root(year, month, day, name, lat, lon, tz, lo, top, 0, h0))
        }
        if set == "" {
          set = hhmm(root(year, month, day, name, lat, lon, tz, top, lo + 1.0, 0, h0))
        }
      }
    }
    last = now
  }
  if rise == "" {
    rise = "none"
    if ups == 25 {
      rise = "always"
    }
    if ups == 0 {
      rise = "never"
    }
  }
  if set == "" {
    set = "none"
    if ups == 25 {
      set = "never"
    }
    if ups == 0 {
      set = "always"
    }
  }
  Times(rise = rise, transit = transit, set = set)
}

// Rise, transit and set of a body on a day.
body_times(year : Int, month : Int, day : Int, name : Str, lat : Float, lon : Float, tz : Float) : Times {
  day_times(year, month, day, name, rise_height(name), lat, lon, tz)
}

// Sunrise, noon and sunset on a day.
sun_times(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : Times {
  day_times(year, month, day, "sun", -0.8333, lat, lon, tz)
}

// Moonrise and moonset on a day.
moon_times(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : Times {
  day_times(year, month, day, "moon", -0.8333, lat, lon, tz)
}

// Dawn and dusk: rise is when the sun climbs past depth degrees below the horizon, set
// when it sinks past it. depth is 6.0 (civil), 12.0 (nautical) or 18.0 (astronomical).
twilight(year : Int, month : Int, day : Int, depth : Float, lat : Float, lon : Float, tz : Float) : Times {
  day_times(year, month, day, "sun", -depth, lat, lon, tz)
}

// Hours of daylight on a day: 24.0 in the midnight sun, 0.0 in the polar night.
day_length(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : Float {
  t = sun_times(year, month, day, lat, lon, tz)
  if t.rise == "always" {
    return 24.0
  }
  if t.rise == "never" {
    return 0.0
  }
  if t.rise == "none" {
    return hours_of(t.set)
  }
  if t.set == "none" {
    return 24.0 - hours_of(t.rise)
  }
  (hours_of(t.set) - hours_of(t.rise) + 24.0) % 24.0
}

// The angle between two places in the sky.
separation(ra1 : Float, dec1 : Float, ra2 : Float, dec2 : Float) : Float {
  to_deg(clamp1(rad(dec1).sin * rad(dec2).sin + rad(dec1).cos * rad(dec2).cos * rad(ra1 - ra2).cos).acos)
}

// How far a body stands from the sun in the sky.
elongation(s : Sky, name : Str) : Float {
  p = pos(s, name)
  separation(p.gra, p.gdec, s.sun_ra, s.sun_dec)
}

// Is a body east of the sun, so that it is seen in the evening? (Otherwise: the morning.)
evening(s : Sky, name : Str) : Bool {
  swing(pos(s, name).lon - s.sun_lon) > 0.0
}

// The angle sun, body, earth: 0 when the body is fully lit, 180 when it is dark.
phase_angle(s : Sky, name : Str) : Float {
  if name == "sun" {
    return 0.0
  }
  p = pos(s, name)
  if name == "moon" {
    el = rad(separation(p.gra, p.gdec, s.sun_ra, s.sun_dec))
    md = p.dist * 6378.14 / 149597870.7
    return to_deg((s.sun_dist * el.sin).atan2(md - s.sun_dist * el.cos))
  }
  to_deg(clamp1((p.sun_dist * p.sun_dist + p.dist * p.dist - s.sun_dist * s.sun_dist) / (2.0 * p.sun_dist * p.dist)).acos)
}

// The lit part of a body's disc, 0 to 1.
lit_part(s : Sky, name : Str) : Float {
  (1.0 + rad(phase_angle(s, name)).cos) / 2.0
}

// The lit part of the moon, 0 to 1.
moon_lit(s : Sky) : Float {
  lit_part(s, "moon")
}

// How bright a body is, as a magnitude: lower is brighter (Venus -4, Saturn about 1, the
// eye sees down to 6).
magnitude(s : Sky, name : Str) : Float {
  if name == "sun" {
    return -26.74
  }
  p = pos(s, name)
  fv = phase_angle(s, name)
  if name == "moon" {
    return 0.23 + 5.0 * log10(s.sun_dist * p.dist * 6378.14 / 149597870.7) + 0.026 * fv + 4.0e-9 * fv.pow(4.0)
  }
  base = 5.0 * log10(p.sun_dist * p.dist)
  if name == "mercury" {
    return -0.36 + base + 0.027 * fv + 2.2e-13 * fv.pow(6.0)
  }
  if name == "venus" {
    return -4.34 + base + 0.013 * fv + 4.2e-7 * fv.pow(3.0)
  }
  if name == "mars" {
    return -1.51 + base + 0.016 * fv
  }
  if name == "jupiter" {
    return -9.25 + base + 0.014 * fv
  }
  if name == "saturn" {
    tilt = clamp1(sn(p.lat) * cs(28.06) - cs(p.lat) * sn(28.06) * sn(p.lon - 169.51 - 3.82e-5 * s.d)).asin
    return -9.0 + base + 0.044 * fv - 2.6 * tilt.sin.abs + 1.2 * tilt.sin * tilt.sin
  }
  if name == "uranus" {
    return -7.15 + base + 0.001 * fv
  }
  -6.9 + base + 0.001 * fv
}

// How wide a body looks, in seconds of arc (the sun and the moon: about 1900).
diameter(s : Sky, name : Str) : Float {
  p = pos(s, name)
  if name == "moon" {
    return 2.0 * to_deg((0.2725076 / p.tdist).asin) * 3600.0
  }
  i = index_of(name)
  if i < 0 {
    return 0.0
  }
  [1919.26, 0.0, 6.74, 16.92, 9.36, 196.94, 165.6, 65.8, 62.2].at(i) / p.dist
}

phase_time(k : Float) : Float {
  // The moment (UT) of moon phase number k: a whole number is a new moon (0.0 is the one
  // of 2000-01-06), .25 a first quarter, .5 a full moon, .75 a last quarter.
  w = ((k - k.floor) * 4.0).round.toInt
  t = k / 1236.85
  t2 = t * t
  t3 = t2 * t
  t4 = t3 * t
  j = 2451550.09766 + 29.530588861 * k + 0.00015437 * t2 - 0.00000015 * t3 + 0.00000000073 * t4
  e = 1.0 - 0.002516 * t - 0.0000074 * t2
  m = 2.5534 + 29.1053567 * k - 0.0000014 * t2 - 0.00000011 * t3
  mp = 201.5643 + 385.81693528 * k + 0.0107582 * t2 + 0.00001238 * t3 - 0.000000058 * t4
  f = 160.7108 + 390.67050284 * k - 0.0016118 * t2 - 0.00000227 * t3 + 0.000000011 * t4
  om = 124.7746 - 1.56375588 * k + 0.0020672 * t2 + 0.00000215 * t3
  c = 0.0
  if w == 0 || w == 2 {
    q = [0.4072, 0.17241, 0.01608, 0.01039, 0.00739, 0.00514, 0.00208]
    if w == 2 {
      q = [0.40614, 0.17302, 0.01614, 0.01043, 0.00734, 0.00515, 0.00209]
    }
    c = 0.0 - q.at(0) * sn(mp) + q.at(1) * e * sn(m) + q.at(2) * sn(2.0 * mp) + q.at(3) * sn(2.0 * f) + q.at(4) * e * sn(mp - m) - q.at(5) * e * sn(mp + m) + q.at(6) * e * e * sn(2.0 * m)
    c = c - 0.00111 * sn(mp - 2.0 * f) - 0.00057 * sn(mp + 2.0 * f) + 0.00056 * e * sn(2.0 * mp + m) - 0.00042 * sn(3.0 * mp) + 0.00042 * e * sn(m + 2.0 * f) + 0.00038 * e * sn(m - 2.0 * f) - 0.00024 * e * sn(2.0 * mp - m) - 0.00017 * sn(om) - 0.00007 * sn(mp + 2.0 * m)
    c = c + 0.00004 * sn(2.0 * mp - 2.0 * f) + 0.00004 * sn(3.0 * m) + 0.00003 * sn(mp + m - 2.0 * f) + 0.00003 * sn(2.0 * mp + 2.0 * f) - 0.00003 * sn(mp + m + 2.0 * f) + 0.00003 * sn(mp - m + 2.0 * f) - 0.00002 * sn(mp - m - 2.0 * f) - 0.00002 * sn(3.0 * mp + m) + 0.00002 * sn(4.0 * mp)
  } else {
    c = 0.0 - 0.62801 * sn(mp) + 0.17172 * e * sn(m) - 0.01183 * e * sn(mp + m) + 0.00862 * sn(2.0 * mp) + 0.00804 * sn(2.0 * f) + 0.00454 * e * sn(mp - m) + 0.00204 * e * e * sn(2.0 * m) - 0.0018 * sn(mp - 2.0 * f) - 0.0007 * sn(mp + 2.0 * f)
    c = c - 0.0004 * sn(3.0 * mp) - 0.00034 * e * sn(2.0 * mp - m) + 0.00032 * e * sn(m + 2.0 * f) + 0.00032 * e * sn(m - 2.0 * f) - 0.00028 * e * e * sn(mp + 2.0 * m) + 0.00027 * e * sn(2.0 * mp + m) - 0.00017 * sn(om) - 0.00005 * sn(mp - m - 2.0 * f)
    c = c + 0.00004 * sn(2.0 * mp + 2.0 * f) - 0.00004 * sn(mp + m + 2.0 * f) + 0.00004 * sn(mp - 2.0 * m) + 0.00003 * sn(mp + m - 2.0 * f) + 0.00003 * sn(3.0 * m) + 0.00002 * sn(2.0 * mp - 2.0 * f) + 0.00002 * sn(mp - m + 2.0 * f) - 0.00002 * sn(3.0 * mp + m)
    wq = 0.00306 - 0.00038 * e * cs(m) + 0.00026 * cs(mp) - 0.00002 * cs(mp - m) + 0.00002 * cs(mp + m) + 0.00002 * cs(2.0 * f)
    if w == 1 {
      c = c + wq
    } else {
      c = c - wq
    }
  }
  a0 = [299.77, 251.88, 251.83, 349.42, 84.66, 141.74, 207.14, 154.84, 34.52, 207.19, 291.34, 161.72, 239.56, 331.55]
  a1 = [0.107408, 0.016321, 26.651886, 36.412478, 18.206239, 53.303771, 2.453732, 7.30686, 27.261239, 0.121824, 1.844379, 24.198154, 25.513099, 3.592518]
  a2 = [325.0, 165.0, 164.0, 126.0, 110.0, 62.0, 60.0, 56.0, 47.0, 42.0, 40.0, 37.0, 35.0, 23.0]
  c = c + 0.000325 * sn(299.77 + 0.107408 * k - 0.009173 * t2)
  for i in 1..14 {
    c = c + a2.at(i) / 1000000.0 * sn(a0.at(i) + a1.at(i) * k)
  }
  to_ut(j + c)
}

// The next moment (a Julian date, UT) the moon is new (which 0), at first quarter (1),
// full (2) or at last quarter (3), at or after a moment. Good to a minute.
next_phase(from : Float, which : Int) : Float {
  k = ((from - 2451550.09766) / 29.530588861 - which.toFloat / 4.0).floor - 1.0 + which.toFloat / 4.0
  j = phase_time(k)
  while j < from {
    k = k + 1.0
    j = phase_time(k)
  }
  j
}

// Days since the last new moon, at a moment.
moon_age(j : Float) : Float {
  k = ((j - 2451550.09766) / 29.530588861).floor + 1.0
  t = phase_time(k)
  while t > j {
    k = k - 1.0
    t = phase_time(k)
  }
  j - t
}

phase_name(i : Int) : Str {
  ["New Moon", "Waxing Crescent", "First Quarter", "Waxing Gibbous", "Full Moon", "Waning Gibbous", "Last Quarter", "Waning Crescent"].at(i)
}

phase_symbol(i : Int) : Str {
  ["🌑", "🌒", "🌓", "🌔", "🌕", "🌖", "🌗", "🌘"].at(i)
}

// The moon's phase on a day (UT). The day a new moon, a quarter or a full moon falls on
// gets that name; the days between get the name of what the moon is on its way to.
moon_phase(year : Int, month : Int, day : Int) : Phase {
  j0 = jd(year, month, day)
  idx = -1
  q = ((j0 - 2451550.09766) / 29.530588861 * 4.0).floor - 3.0
  for i in 0..8 {
    kq = q + i.toFloat
    t = phase_time(kq / 4.0)
    if t >= j0 && t < j0 + 1.0 {
      idx = ((kq % 4.0 + 4.0) % 4.0).round.toInt * 2
    }
  }
  s = sky_jd(j0 + 0.5, 0.0, 0.0, 0.0)
  el = turn(pos(s, "moon").lon - s.sun_lon)
  if idx < 0 {
    idx = 1 + 2 * (el / 90.0).floor.toInt
  }
  Phase(lit = (moon_lit(s) * 10000.0).round / 10000.0, age = (el / 360.0 * 10000.0).round / 10000.0, index = idx, name = phase_name(idx), symbol = phase_symbol(idx))
}

// Is this the day (UT) the moon turns new, first quarter, full or last quarter?
notable_phase(year : Int, month : Int, day : Int) : Bool {
  moon_phase(year, month, day).index % 2 == 0
}

// The days of a month with a notable phase, each as "14 🌕 Full Moon 14:53" (UT).
phases_in_month(year : Int, month : Int) : List[Str] {
  out : List[Str] = []
  j = jd(year, month, 1)
  stop = j + days_in_month(year, month).toFloat
  q = ((j - 2451550.09766) / 29.530588861 * 4.0).floor - 3.0
  for i in 0..12 {
    kq = q + i.toFloat
    t = phase_time(kq / 4.0)
    if t >= j && t < stop {
      idx = ((kq % 4.0 + 4.0) % 4.0).round.toInt * 2
      out.push(date_of(t).at(2).toStr + " " + phase_symbol(idx) + " " + phase_name(idx) + " " + jd_text(t).slice(11, 16))
    }
  }
  out
}

no_eclipse() : Eclipse {
  Eclipse(when = 0.0, kind = "", form = "", mag = 0.0, gamma = 0.0, partial = 0.0, total = 0.0)
}

eclipse_of(k : Float) : Eclipse {
  // The eclipse at moon phase number k (a whole number: of the sun; .5: of the moon), or
  // one with form "" when the moon misses.
  lunar = k - k.floor > 0.25
  t = k / 1236.85
  t2 = t * t
  t3 = t2 * t
  t4 = t3 * t
  f = 160.7108 + 390.67050284 * k - 0.0016118 * t2 - 0.00000227 * t3 + 0.000000011 * t4
  if sn(f).abs > 0.36 {
    return no_eclipse()
  }
  j = 2451550.09766 + 29.530588861 * k + 0.00015437 * t2 - 0.00000015 * t3 + 0.00000000073 * t4
  e = 1.0 - 0.002516 * t - 0.0000074 * t2
  m = 2.5534 + 29.1053567 * k - 0.0000014 * t2 - 0.00000011 * t3
  mp = 201.5643 + 385.81693528 * k + 0.0107582 * t2 + 0.00001238 * t3 - 0.000000058 * t4
  om = 124.7746 - 1.56375588 * k + 0.0020672 * t2 + 0.00000215 * t3
  f1 = f - 0.02665 * sn(om)
  a1 = 299.77 + 0.107408 * k - 0.009173 * t2
  c = 0.0 - 0.4075 * sn(mp) + 0.1721 * e * sn(m)
  if lunar {
    c = 0.0 - 0.4065 * sn(mp) + 0.1727 * e * sn(m)
  }
  c = c + 0.0161 * sn(2.0 * mp) - 0.0097 * sn(2.0 * f1) + 0.0073 * e * sn(mp - m) - 0.005 * e * sn(mp + m) - 0.0023 * sn(mp - 2.0 * f1) + 0.0021 * e * sn(2.0 * m) + 0.0012 * sn(mp + 2.0 * f1) + 0.0006 * e * sn(2.0 * mp + m)
  c = c - 0.0004 * sn(3.0 * mp) - 0.0003 * e * sn(m + 2.0 * f1) + 0.0003 * sn(a1) - 0.0002 * e * sn(m - 2.0 * f1) - 0.0002 * e * sn(2.0 * mp - m) - 0.0002 * sn(om)
  p = 0.207 * e * sn(m) + 0.0024 * e * sn(2.0 * m) - 0.0392 * sn(mp) + 0.0116 * sn(2.0 * mp) - 0.0073 * e * sn(mp + m) + 0.0067 * e * sn(mp - m) + 0.0118 * sn(2.0 * f1)
  q = 5.2207 - 0.0048 * e * cs(m) + 0.002 * e * cs(2.0 * m) - 0.3299 * cs(mp) - 0.006 * e * cs(mp + m) + 0.0041 * e * cs(mp - m)
  g = (p * cs(f1) + q * sn(f1)) * (1.0 - 0.0048 * cs(f1).abs)
  u = 0.0059 + 0.0046 * e * cs(m) - 0.0182 * cs(mp) + 0.0004 * cs(2.0 * mp) - 0.0005 * cs(m + mp)
  when = to_ut(j + c)
  ga = g.abs
  if lunar {
    pen = (1.5573 + u - ga) / 0.545
    umb = (1.0128 - u - ga) / 0.545
    if pen <= 0.0 {
      return no_eclipse()
    }
    if umb <= 0.0 {
      return Eclipse(when = when, kind = "lunar", form = "penumbral", mag = pen, gamma = g, partial = 0.0, total = 0.0)
    }
    n = 0.5458 + 0.04 * cs(mp)
    pp = 1.0128 - u
    tt = 0.4678 - u
    part = 120.0 / n * (pp * pp - g * g).sqrt
    if tt * tt - g * g <= 0.0 {
      return Eclipse(when = when, kind = "lunar", form = "partial", mag = umb, gamma = g, partial = part, total = 0.0)
    }
    return Eclipse(when = when, kind = "lunar", form = "total", mag = umb, gamma = g, partial = part, total = 120.0 / n * (tt * tt - g * g).sqrt)
  }
  if ga > 1.5433 + u {
    return no_eclipse()
  }
  form = "partial"
  size = (1.5433 + u - ga) / (0.5461 + 2.0 * u)
  if ga < 0.9972 + u.abs {
    size = 0.5461 / (0.5461 + 2.0 * u)
    form = "annular"
    if u < 0.0 {
      form = "total"
    }
    if ga < 0.9972 && u >= 0.0 && u <= 0.0047 && u < 0.00464 * (1.0 - g * g).sqrt {
      form = "hybrid"
    }
  }
  Eclipse(when = when, kind = "solar", form = form, mag = size, gamma = g, partial = 0.0, total = 0.0)
}

// The eclipses of a year (UT), of the sun and of the moon, in order.
eclipses(year : Int) : List[Eclipse] {
  out : List[Eclipse] = []
  k = ((year - 2000).toFloat * 12.3685).floor - 1.0
  for i in 0..30 {
    e = eclipse_of(k + i.toFloat / 2.0)
    if e.form != "" && date_of(e.when).at(0) == year {
      out.push(e)
    }
  }
  out
}

// The next eclipse at or after a moment. kind: "solar", "lunar", or "" for any.
next_eclipse(from : Float, kind : Str) : Eclipse {
  k = ((from - 2451550.09766) / 29.530588861).floor - 1.0
  for i in 0..80 {
    e = eclipse_of(k + i.toFloat / 2.0)
    if e.form != "" && e.when >= from && (kind == "" || kind == e.kind) {
      return e
    }
  }
  no_eclipse()
}

// An eclipse in words: "Total lunar eclipse, magnitude 1.15".
eclipse_text(e : Eclipse) : Str {
  if e.form == "" {
    return "no eclipse"
  }
  e.form.slice(0, 1).upper + e.form.slice(1, e.form.length) + " " + e.kind + " eclipse, magnitude " + fixed(e.mag, 2)
}

sun_moon(s : Sky) : List[Float] {
  // The angle between sun and moon as the observer sees them, and the half width of each.
  a = pos(s, "sun")
  b = pos(s, "moon")
  [separation(a.ra, a.dec, b.ra, b.dec), 959.63 / 3600.0 / a.dist, to_deg((0.2725076 / b.tdist).asin)]
}

// The part of the sun's width the moon covers right now at the place of a sky: 0.0 when
// there is no eclipse there, 1.0 or more when it is total.
sun_cover(s : Sky) : Float {
  v = sun_moon(s)
  m = (v.at(1) + v.at(2) - v.at(0)) / (2.0 * v.at(1))
  if m < 0.0 {
    m = 0.0
  }
  m
}

face_cover(d : Float, r : Float, b : Float) : Float {
  // The part of a disc of half width r that a disc of half width b hides, centres d apart.
  if d >= r + b {
    return 0.0
  }
  if d <= (b - r).abs {
    if b >= r {
      return 1.0
    }
    return b * b / (r * r)
  }
  a1 = r * r * clamp1((d * d + r * r - b * b) / (2.0 * d * r)).acos
  a2 = b * b * clamp1((d * d + b * b - r * r) / (2.0 * d * b)).acos
  a3 = 0.5 * ((r + b - d) * (d + r - b) * (d - r + b) * (d + r + b)).sqrt
  (a1 + a2 - a3) / (pi() * r * r)
}

// A solar eclipse seen from a place: give the moment of the eclipse (Eclipse.when) and the
// place. Looks three hours to each side; good to a minute or two.
local_eclipse(when : Float, lat : Float, lon : Float, tz : Float) : Local {
  best = 0.0
  peak = when
  start = 0.0
  stop = 0.0
  for i in 0..361 {
    j = when + (i - 180).toFloat / 1440.0
    m = sun_cover(sky_jd(j, lat, lon, tz))
    if m > 0.0 {
      if start == 0.0 {
        start = j
      }
      stop = j
    }
    if m > best {
      best = m
      peak = j
    }
  }
  if best == 0.0 {
    return Local(start = 0.0, peak = 0.0, stop = 0.0, mag = 0.0, cover = 0.0, alt = 0.0)
  }
  s = sky_jd(peak, lat, lon, tz)
  v = sun_moon(s)
  Local(start = start, peak = peak, stop = stop, mag = best, cover = face_cover(v.at(0), v.at(1), v.at(2)), alt = where(s, "sun").alt)
}

measure(what : Str, j : Float, a : Str, b : Str) : Float {
  // A number that changes with time, seen from the centre of the earth.
  s = sky_jd(j, 0.0, 0.0, 0.0)
  if what == "sun_dist" {
    return s.sun_dist
  }
  p = pos(s, a)
  if what == "dist" {
    return p.dist
  }
  if what == "elong" {
    return separation(p.gra, p.gdec, s.sun_ra, s.sun_dec)
  }
  if what == "opp" {
    return swing(p.lon - s.sun_lon - 180.0)
  }
  if b == "sun" {
    return swing(p.lon - s.sun_lon)
  }
  swing(p.lon - pos(s, b).lon)
}

find_zero(what : Str, a : Str, b : Str, from : Float, days : Float, step : Float) : Float {
  // The first moment the number passes zero, or 0.0.
  f0 = measure(what, from, a, b)
  n = (days / step).ceil.toInt
  for i in 0..n {
    t1 = from + (i + 1).toFloat * step
    f1 = measure(what, t1, a, b)
    if f0 * f1 <= 0.0 && (f0 - f1).abs < 180.0 {
      lo = t1 - step
      hi = t1
      flo = f0
      for k in 0..24 {
        mid = (lo + hi) / 2.0
        fm = measure(what, mid, a, b)
        if flo * fm > 0.0 {
          lo = mid
          flo = fm
        } else {
          hi = mid
        }
      }
      return (lo + hi) / 2.0
    }
    f0 = f1
  }
  0.0
}

find_peak(what : Str, a : Str, from : Float, days : Float, step : Float, up : Bool) : Float {
  // The first moment the number is at its highest (up) or lowest, or 0.0.
  sg = 1.0
  if !up {
    sg = -1.0
  }
  f0 = sg * measure(what, from, a, "")
  f1 = sg * measure(what, from + step, a, "")
  n = (days / step).ceil.toInt
  for i in 1..n {
    t2 = from + (i + 1).toFloat * step
    f2 = sg * measure(what, t2, a, "")
    if f1 > f0 && f1 >= f2 {
      lo = t2 - 2.0 * step
      hi = t2
      for k in 0..40 {
        m1 = lo + (hi - lo) / 3.0
        m2 = hi - (hi - lo) / 3.0
        if sg * measure(what, m1, a, "") < sg * measure(what, m2, a, "") {
          lo = m1
        } else {
          hi = m2
        }
      }
      return (lo + hi) / 2.0
    }
    f0 = f1
    f1 = f2
  }
  0.0
}

// The next moment two bodies stand at the same place along the ecliptic, within days from
// a moment; 0.0 when they do not. b may be "sun".
next_conjunction(a : Str, b : Str, from : Float, days : Float) : Float {
  step = 1.0
  if a == "moon" || b == "moon" {
    step = 0.25
  }
  find_zero("lon", a, b, from, days, step)
}

// The next moment a planet stands opposite the sun (Mars to Neptune), or 0.0.
next_opposition(name : Str, from : Float) : Float {
  find_zero("opp", name, "", from, 800.0, 1.0)
}

// The next moment Mercury or Venus stands farthest from the sun in the sky.
next_greatest_elongation(name : Str, from : Float) : Float {
  find_peak("elong", name, from, 620.0, 1.0, true)
}

// The next moment the moon is nearest the earth.
next_perigee(from : Float) : Float {
  find_peak("dist", "moon", from, 40.0, 0.5, false)
}

// The next moment the moon is farthest from the earth.
next_apogee(from : Float) : Float {
  find_peak("dist", "moon", from, 40.0, 0.5, true)
}

// The next moment the earth is nearest the sun (early January).
next_perihelion(from : Float) : Float {
  find_peak("sun_dist", "sun", from, 380.0, 1.0, false)
}

// The next moment the earth is farthest from the sun (early July).
next_aphelion(from : Float) : Float {
  find_peak("sun_dist", "sun", from, 380.0, 1.0, true)
}

// When a season starts, as a Julian date (UT, good to a minute). which is 0 for the March
// equinox, 1 the June solstice, 2 the September equinox, 3 the December solstice.
season(year : Int, which : Int) : Float {
  y = (year - 2000).toFloat / 1000.0
  j = 2451623.80984 + 365242.37404 * y + 0.05169 * y * y - 0.00411 * y * y * y - 0.00057 * y * y * y * y
  if which == 1 {
    j = 2451716.56767 + 365241.62603 * y + 0.00325 * y * y + 0.00888 * y * y * y - 0.0003 * y * y * y * y
  }
  if which == 2 {
    j = 2451810.21715 + 365242.01767 * y - 0.11575 * y * y + 0.00337 * y * y * y + 0.00078 * y * y * y * y
  }
  if which == 3 {
    j = 2451900.05952 + 365242.74049 * y - 0.06223 * y * y - 0.00823 * y * y * y + 0.00032 * y * y * y * y
  }
  t = (j - 2451545.0) / 36525.0
  w = 35999.373 * t - 2.47
  dl = 1.0 + 0.0334 * rad(w).cos + 0.0007 * rad(2.0 * w).cos
  a = [485.0, 203.0, 199.0, 182.0, 156.0, 136.0, 77.0, 74.0, 70.0, 58.0, 52.0, 50.0, 45.0, 44.0, 29.0, 18.0, 17.0, 16.0, 14.0, 12.0, 12.0, 12.0, 9.0, 8.0]
  b = [324.96, 337.23, 342.08, 27.85, 73.14, 171.52, 222.54, 296.72, 243.58, 119.81, 297.17, 21.02, 247.54, 325.15, 60.93, 155.12, 288.79, 198.04, 199.76, 95.39, 287.11, 320.81, 227.73, 15.45]
  c = [1934.136, 32964.467, 20.186, 445267.112, 45036.886, 22518.443, 65928.934, 3034.906, 9037.513, 33718.147, 150.678, 2281.226, 29929.562, 31555.956, 4443.417, 67555.328, 4562.452, 62894.029, 31436.921, 14577.848, 31931.756, 34777.259, 1222.114, 16859.074]
  s = 0.0
  for i in 0..24 {
    s = s + a.at(i) * rad(b.at(i) + c.at(i) * t).cos
  }
  to_ut(j + 0.00001 * s / dl)
}

// A place moved from the grid of one moment to the grid of another (both Julian dates),
// since the earth's axis slowly turns. The year 2000 is 2451545.0.
precess(ra : Float, dec : Float, from : Float, to : Float) : Spot {
  tt = (from - 2451545.0) / 36525.0
  t = (to - from) / 36525.0
  zeta = ((2306.2181 + 1.39656 * tt - 0.000139 * tt * tt) * t + (0.30188 - 0.000344 * tt) * t * t + 0.017998 * t * t * t) / 3600.0
  z = ((2306.2181 + 1.39656 * tt - 0.000139 * tt * tt) * t + (1.09468 + 0.000066 * tt) * t * t + 0.018203 * t * t * t) / 3600.0
  th = ((2004.3109 - 0.8533 * tt - 0.000217 * tt * tt) * t - (0.42665 + 0.000217 * tt) * t * t - 0.041833 * t * t * t) / 3600.0
  a = cs(dec) * sn(ra + zeta)
  b = cs(th) * cs(dec) * cs(ra + zeta) - sn(th) * sn(dec)
  c = sn(th) * cs(dec) * cs(ra + zeta) + cs(th) * sn(dec)
  Spot(ra = turn(to_deg(a.atan2(b)) + z), dec = to_deg(clamp1(c).asin))
}

// From ra and dec to along and above the ecliptic. ecl is the tilt of the earth: s.ecl.
to_ecliptic(ra : Float, dec : Float, ecl : Float) : LonLat {
  LonLat(lon = turn(to_deg((sn(ra) * cs(ecl) + rad(dec).tan * sn(ecl)).atan2(cs(ra)))), lat = to_deg(clamp1(sn(dec) * cs(ecl) - cs(dec) * sn(ecl) * sn(ra)).asin))
}

// From along and above the ecliptic to ra and dec.
to_equatorial(lon : Float, lat : Float, ecl : Float) : Spot {
  Spot(ra = turn(to_deg((sn(lon) * cs(ecl) - rad(lat).tan * sn(ecl)).atan2(cs(lon)))), dec = to_deg(clamp1(sn(lat) * cs(ecl) + cs(lat) * sn(ecl) * sn(lon)).asin))
}

// From ra and dec (for the year 2000) to along and above the Milky Way.
galactic(ra : Float, dec : Float) : LonLat {
  b = clamp1(sn(dec) * sn(27.12825) + cs(dec) * cs(27.12825) * cs(ra - 192.85948)).asin
  l = 122.93192 - to_deg((cs(dec) * sn(ra - 192.85948)).atan2(sn(dec) * cs(27.12825) - cs(dec) * sn(27.12825) * cs(ra - 192.85948)))
  LonLat(lon = turn(l), lat = to_deg(b))
}

