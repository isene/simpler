// The constellation a place in the sky is in, by the official borders. ra and dec are for
// the moment j (for a Pos: p.gra, p.gdec and jd_of(s); for a Star: 2451545.0).
constellation(ra : Float, dec : Float, j : Float) : Str {
  p = precess(ra, dec, j, 2405889.25855)
  h = p.ra / 15.0
  b = bounds()
  k = 0
  while k < b.length {
    if p.dec >= b.at(k + 2) && h >= b.at(k) && h < b.at(k + 1) {
      return constellations().at(bound_cons().at(k / 3))
    }
    k = k + 3
  }
  ""
}

