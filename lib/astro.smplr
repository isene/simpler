    2, 1, 0, 1, -351, 4, 0, 0, 1, 331, 2, -1, 1, 1, 315, 2, -2, 0, -1, 302,
    0, 0, 1, 3, -283, 2, 1, 1, -1, -229, 1, 1, 0, -1, 223, 1, 1, 0, 1, 223,
    0, 1, -2, -1, -220, 2, 1, -1, -1, -220, 1, 0, 1, 1, -185, 2, -1, -2, -1, 181,
    0, 1, 2, 1, -177, 4, 0, -2, -1, 176, 4, -1, -1, -1, 166, 1, 0, 1, -1, -164,
    4, 0, 1, -1, 132, 1, 0, -1, -1, -119, 4, -1, 0, -1, 115, 2, -2, 0, 1, 107
  ]
}

moon_centre(s : Sky) : List[Float] {
  // The moon seen from the centre of the earth: ra, dec, and its distance in earth radii.
  t = (s.d - 1.5) / 36525.0
  t2 = t * t
  t3 = t2 * t
  t4 = t3 * t
  lp = 218.3164477 + 481267.88123421 * t - 0.0015786 * t2 + t3 / 538841.0 - t4 / 65194000.0
  dm = 297.8501921 + 445267.1114034 * t - 0.0018819 * t2 + t3 / 545868.0 - t4 / 113065000.0
  m = 357.5291092 + 35999.0502909 * t - 0.0001536 * t2 + t3 / 24490000.0
  mp = 134.9633964 + 477198.8675055 * t + 0.0087414 * t2 + t3 / 69699.0 - t4 / 14712000.0
  f = 93.272095 + 483202.0175233 * t - 0.0036539 * t2 - t3 / 3526000.0 + t4 / 863310000.0
  a1 = 119.75 + 131.849 * t
  a2 = 53.09 + 479264.29 * t
  a3 = 313.45 + 481266.484 * t
  e = 1.0 - 0.002516 * t - 0.0000074 * t2
  dr = rad(dm)
  mr = rad(m)
  mpr = rad(mp)
  fr = rad(f)
  sl = 0.0
  sr = 0.0
  lr = moon_lr()
  k = 0
  while k < lr.length {
    arg = lr.at(k).toFloat * dr + lr.at(k + 1).toFloat * mr + lr.at(k + 2).toFloat * mpr + lr.at(k + 3).toFloat * fr
    scale = 1.0
    mi = lr.at(k + 1)
    if mi == 1 || mi == -1 {
      scale = e
    }
    if mi > 1 || mi < -1 {
      scale = e * e
    }
    sl = sl + lr.at(k + 4).toFloat * scale * arg.sin
    sr = sr + lr.at(k + 5).toFloat * scale * arg.cos
    k = k + 6
  }
  sb = 0.0
  bt = moon_b()
  k = 0
  while k < bt.length {
    argb = bt.at(k).toFloat * dr + bt.at(k + 1).toFloat * mr + bt.at(k + 2).toFloat * mpr + bt.at(k + 3).toFloat * fr
    scaleb = 1.0
    mb = bt.at(k + 1)
    if mb == 1 || mb == -1 {
      scaleb = e
    }
    if mb > 1 || mb < -1 {
      scaleb = e * e
    }
    sb = sb + bt.at(k + 4).toFloat * scaleb * argb.sin
    k = k + 5
  }
  sl = sl + 3958.0 * rad(a1).sin + 1962.0 * rad(lp - f).sin + 318.0 * rad(a2).sin
  sb = sb - 2235.0 * rad(lp).sin + 382.0 * rad(a3).sin + 175.0 * rad(a1 - f).sin + 175.0 * rad(a1 + f).sin + 127.0 * rad(lp - mp).sin - 115.0 * rad(lp + mp).sin
  lam = rad(turn(lp + sl / 1000000.0))
  bet = rad(sb / 1000000.0)
  eps = rad(s.ecl)
  ra = to_deg((lam.sin * eps.cos - bet.tan * eps.sin).atan2(lam.cos))
  if ra < 0.0 {
    ra = ra + 360.0
  }
  sd = bet.sin * eps.cos + bet.cos * eps.sin * lam.sin
  if sd > 1.0 {
    sd = 1.0
  }
  if sd < -1.0 {
    sd = -1.0
  }
  [ra, to_deg(sd.asin), (385000.56 + sr / 1000.0) / 6378.14]
}

observed(s : Sky, ra : Float, dec : Float, dist : Float, par : Float) : Pos {
  // From the centre of the earth to the observer: par is the parallax in degrees.
  gclat = s.lat - 0.1924 * rad(2.0 * s.lat).sin
  rho = 0.99833 + 0.00167 * rad(2.0 * s.lat).cos
  ha = (s.sidtime * 15.0 - ra + 360.0) % 360.0
  cd = rad(dec).cos
  tra = ra
  if cd.abs >= 1.0e-9 {
    tra = ra - par * rho * rad(gclat).cos * rad(ha).sin / cd
  }
  tdec = dec - par * rho * (rad(gclat).sin * cd - rad(gclat).cos * rad(ha).cos * rad(dec).sin)
  Pos(ra = tra, dec = tdec, dist = dist, gra = ra, gdec = dec)
}

// Where a body is in a sky.
pos(s : Sky, name : Str) : Pos {
  if name == "moon" {
    mc = moon_centre(s)
    return observed(s, mc.at(0), mc.at(1), mc.at(2), to_deg((1.0 / mc.at(2)).asin))
  }
  el = elements(name, s.d)
  nb = el.at(0)
  ib = el.at(1)
  wb = (el.at(2) + 360.0) % 360.0
  ab = el.at(3)
  eb = el.at(4)
  mb = el.at(5) % 360.0
  e1 = mb + (180.0 / pi()) * eb * rad(mb).sin * (1.0 + eb * rad(mb).cos)
  going = true
  while going {
    e0 = e1
    e1 = e0 - (e0 - (180.0 / pi()) * eb * rad(e0).sin - mb) / (1.0 - eb * rad(e0).cos)
    going = (e1 - e0).abs > 0.0005
  }
  x = ab * (rad(e1).cos - eb)
  y = ab * (1.0 - eb * eb).sqrt * rad(e1).sin
  r = (x * x + y * y).sqrt
  v = (to_deg(y.atan2(x)) + 360.0) % 360.0
  xe = r * (rad(nb).cos * rad(v + wb).cos - rad(nb).sin * rad(v + wb).sin * rad(ib).cos)
  ye = r * (rad(nb).sin * rad(v + wb).cos + rad(nb).cos * rad(v + wb).sin * rad(ib).cos)
  ze = r * rad(v + wb).sin * rad(ib).sin
  lon = (to_deg(ye.atan2(xe)) + 360.0) % 360.0
  lat = to_deg(ze.atan2((xe * xe + ye * ye).sqrt))
  rb = (xe * xe + ye * ye + ze * ze).sqrt
  mj = s.mj
  ms = s.ms
  if name == "jupiter" {
    lon = lon - 0.332 * rad(2.0 * mj - 5.0 * ms - 67.6).sin - 0.056 * rad(2.0 * mj - 2.0 * ms + 21.0).sin + 0.042 * rad(3.0 * mj - 5.0 * ms + 21.0).sin - 0.036 * rad(mj - 2.0 * ms).sin + 0.022 * rad(mj - ms).cos + 0.023 * rad(2.0 * mj - 3.0 * ms + 52.0).sin - 0.016 * rad(mj - 5.0 * ms - 69.0).sin
  }
  if name == "saturn" {
    lon = lon + 0.812 * rad(2.0 * mj - 5.0 * ms - 67.6).sin - 0.229 * rad(2.0 * mj - 4.0 * ms - 2.0).cos + 0.119 * rad(mj - 2.0 * ms - 3.0).sin + 0.046 * rad(2.0 * mj - 6.0 * ms - 69.0).sin + 0.014 * rad(mj - 3.0 * ms + 32.0).sin
    lat = lat - 0.02 * rad(2.0 * mj - 4.0 * ms - 2.0).cos + 0.018 * rad(2.0 * mj - 6.0 * ms - 49.0).sin
  }
  xh = rb * rad(lon).cos * rad(lat).cos
  yh = rb * rad(lon).sin * rad(lat).cos
  zh = rb * rad(lat).sin
  if name != "sun" {
    xh = xh + s.xs
    yh = yh + s.ys
  }
  xq = xh
  yq = yh * rad(s.ecl).cos - zh * rad(s.ecl).sin
  zq = yh * rad(s.ecl).sin + zh * rad(s.ecl).cos
  ra = (to_deg(yq.atan2(xq)) + 360.0) % 360.0
  dec = to_deg(zq.atan2((xq * xq + yq * yq).sqrt))
  dist = (xq * xq + yq * yq + zq * zq).sqrt
  observed(s, ra, dec, dist, (8.794 / 3600.0) / rb)
}

// Height and direction of a place in the sky (ra, dec). Use a sky made with sky_at.
horizon(s : Sky, ra : Float, dec : Float) : Hor {
  ha = rad(s.sidtime * 15.0 - ra)
  x = ha.cos * rad(dec).cos
  y = ha.sin * rad(dec).cos
  z = rad(dec).sin
  xh = x * rad(s.lat).sin - z * rad(s.lat).cos
  zh = x * rad(s.lat).cos + z * rad(s.lat).sin
  Hor(alt = to_deg(zh.asin), az = (to_deg(y.atan2(xh)) + 180.0) % 360.0)
}

// Height and direction of a body. Use a sky made with sky_at.
where(s : Sky, name : Str) : Hor {
  p = pos(s, name)
  horizon(s, p.ra, p.dec)
}

// The height a body's centre has when it is seen to rise or set.
rise_height(name : Str) : Float {
  h = -0.5667
  if name == "sun" {
    h = -0.8333
  }
  if name == "moon" {
    h = 0.125
  }
  h
}

// Rise, transit and set of a place in the sky (ra, dec) for the day of a sky made with
// sky. h0 is the height that counts as rising: rise_height(name), or -6.0, -12.0 and
// -18.0 with the sun's place for civil, nautical and astronomical twilight.
times(s : Sky, ra : Float, dec : Float, h0 : Float) : Times {
  tr = ((ra - s.ls - s.lon) / 15.0 + 12.0 + s.tz + 24.0) % 24.0
  phi = rad(s.lat)
  del = rad(dec)
  den = phi.cos * del.cos
  if den.abs < 1.0e-12 {
    return Times(rise = "never", transit = hhmm(tr), set = "always")
  }
  c = (rad(h0).sin - phi.sin * del.sin) / den
  if c < -1.0 {
    return Times(rise = "always", transit = hhmm(tr), set = "never")
  }
  if c > 1.0 {
    return Times(rise = "never", transit = hhmm(tr), set = "always")
  }
  lha = to_deg(c.acos) / 15.0
  Times(rise = hhmm((tr - lha + 24.0) % 24.0), transit = hhmm(tr), set = hhmm((tr + lha + 24.0) % 24.0))
}

// Rise, transit and set of a body on a day.
body_times(year : Int, month : Int, day : Int, name : Str, lat : Float, lon : Float, tz : Float) : Times {
  s = sky(year, month, day, lat, lon, tz)
  p = pos(s, name)
  times(s, p.ra, p.dec, rise_height(name))
}

// Sunrise, noon and sunset on a day.
sun_times(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : Times {
  s = sky(year, month, day, lat, lon, tz)
  times(s, s.sun_ra, s.sun_dec, rise_height("sun"))
}

// Moonrise and moonset on a day.
moon_times(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : Times {
  body_times(year, month, day, "moon", lat, lon, tz)
}

// Dawn and dusk: rise is when the sun climbs past depth degrees below the horizon, set
// when it sinks past it. depth is 6.0 (civil), 12.0 (nautical) or 18.0 (astronomical).
twilight(year : Int, month : Int, day : Int, depth : Float, lat : Float, lon : Float, tz : Float) : Times {
  s = sky(year, month, day, lat, lon, tz)
  times(s, s.sun_ra, s.sun_dec, 0.0 - depth)
}

// Hours of daylight on a day: 24.0 in the midnight sun, 0.0 in the polar night.
day_length(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : Float {
  t = sun_times(year, month, day, lat, lon, tz)
  if t.rise == "always" {
    return 24.0
  }
  if t.rise == "never" {
    return 0.0
  }
  (hours_of(t.set) - hours_of(t.rise) + 24.0) % 24.0
}

// The angle between two places in the sky.
separation(ra1 : Float, dec1 : Float, ra2 : Float, dec2 : Float) : Float {
  c = rad(dec1).sin * rad(dec2).sin + rad(dec1).cos * rad(dec2).cos * rad(ra1 - ra2).cos
  if c > 1.0 {
    c = 1.0
  }
  if c < -1.0 {
    c = -1.0
  }
  to_deg(c.acos)
}

// How far a body stands from the sun in the sky.
elongation(s : Sky, name : Str) : Float {
  p = pos(s, name)
  separation(p.gra, p.gdec, s.sun_ra, s.sun_dec)
}

// The lit part of the moon (0 to 1) from where the sun and the moon really are.
moon_lit(s : Sky) : Float {
  (1.0 - rad(elongation(s, "moon")).cos) / 2.0
}

// The nine body names, in the order bodies gives them.
names() : List[Str] {
  ["sun", "moon", "mercury", "venus", "mars", "jupiter", "saturn", "uranus", "neptune"]
}

index_of(name : Str) : Int {
  all = names()
  for i in 0..all.length {
    if all.at(i) == name {
      return i
    }
  }
  -1
}

// The sign of a body, as text and not as a wide picture.
sign(name : Str) : Str {
  i = index_of(name)
  if i < 0 {
    return "?"
  }
  ["☀", "☾", "☿", "♀", "♂", "♃", "♄", "♅", "♆"].at(i) + 65038.char
}

// The colour number (0 to 255) a body is drawn in, as a style word for a terminal.
colour(name : Str) : Str {
  i = index_of(name)
  if i < 0 {
    return "255"
  }
  ["220", "248", "137", "216", "196", "208", "229", "117", "33"].at(i)
}

// "sun" as "Sun".
title(name : Str) : Str {
  if name.length == 0 {
    return name
  }
  name.slice(0, 1).upper + name.slice(1, name.length)
}

// Every body for one day: where it is and when it rises, transits and sets.
bodies(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : List[Body] {
  s = sky(year, month, day, lat, lon, tz)
  out : List[Body] = []
  for n in names() {
    p = pos(s, n)
    t = times(s, p.ra, p.dec, rise_height(n))
    out.push(Body(name = n, ra = p.ra, dec = p.dec, dist = p.dist, rise = t.rise, transit = t.transit, set = t.set))
  }
  out
}

// Is a body up at a local clock hour, going by its rise and set?
is_up(b : Body, hour : Float) : Bool {
  if b.rise == "always" {
    return true
  }
  if b.rise == "never" {
    return false
  }
  r = hours_of(b.rise)
  st = hours_of(b.set)
  if r > st {
    return hour >= r || hour <= st
  }
  hour >= r && hour <= st
}

// The planets (Mercury to Saturn) that stand more than 5 degrees up at some full hour
// between 20:00 and 04:00.
visible_planets(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : List[Body] {
  s = sky(year, month, day, lat, lon, tz)
  out : List[Body] = []
  for n in ["mercury", "venus", "mars", "jupiter", "saturn"] {
    p = pos(s, n)
    seen = false
    for h in [20.0, 21.0, 22.0, 23.0, 0.0, 1.0, 2.0, 3.0, 4.0] {
      ha = rad((h - p.ra / 15.0) * 15.0)
      zh = ha.cos * rad(p.dec).cos * rad(lat).cos + rad(p.dec).sin * rad(lat).sin
      if to_deg(zh.asin) > 5.0 {
        seen = true
      }
    }
    if seen {
      t = times(s, p.ra, p.dec, rise_height(n))
      out.push(Body(name = n, ra = p.ra, dec = p.dec, dist = p.dist, rise = t.rise, transit = t.transit, set = t.set))
    }
  }
  out
}

pad(s : Str, n : Int) : Str {
  out = s
  while out.length < n {
    out = out + " "
  }
  out
}

// A table of bodies as lines of text: name, RA, Dec, distance, rise, transit, set.
table(list : List[Body]) : List[Str] {
  out = ["Planet    │ RA      │ Dec      │ d=AU    │ Rise  │ Trans │ Set", "──────────┼─────────┼──────────┼─────────┼───────┼───────┼──────"]
  for b in list {
    dist = ((b.dist * 10000.0).round / 10000.0).toStr
    if !dist.contains(".") {
      dist = dist + ".0"
    }
    while dist.length - dist.find(".") < 5 {
      dist = dist + "0"
    }
    out.push(pad(title(b.name), 9) + " │ " + ra_text(b.ra) + " │ " + dec_text(b.dec) + " │ " + dist.padLeft(7) + " │ " + pad(b.rise.slice(0, 5), 5) + " │ " + pad(b.transit, 5) + " │ " + b.set.slice(0, 5))
  }
  out
}

// The star pictures high in the evening sky in a month (the south gets the other half-year).
overhead(month : Int, lat : Float) : List[Str] {
  m = month
  if lat < 0.0 {
    m = (month + 5) % 12 + 1
  }
  all = ["Orion, Taurus, Auriga, Gemini", "Orion, Canis Major, Gemini, Auriga", "Leo, Cancer, Gemini, Hydra", "Leo, Virgo, Ursa Major", "Virgo, Boötes, Coma Berenices", "Boötes, Hercules, Corona Borealis", "Lyra, Cygnus, Hercules, Scorpius", "Cygnus, Lyra, Aquila, Sagittarius", "Pegasus, Andromeda, Cygnus, Capricornus", "Pegasus, Andromeda, Pisces, Aquarius", "Andromeda, Triangulum, Aries, Perseus", "Taurus, Orion, Perseus, Auriga"]
  if m < 1 || m > 12 {
    return []
  }
  all.at(m - 1).split(", ")
}

// Tonight in a few lines: the moon, the planets to see, what is overhead.
tonight(year : Int, month : Int, day : Int, lat : Float, lon : Float, tz : Float) : List[Str] {
  out : List[Str] = []
  mp = moon_phase(year, month, day)
  mt = moon_times(year, month, day, lat, lon, tz)
  line = "Tonight: " + mp.symbol + " " + mp.name + " " + (mp.lit * 100.0).round.toInt.toStr + "%"
  if mt.rise != "never" && mt.rise != "always" {
    line = line + ", rises " + mt.rise + " sets " + mt.set
  }
  out.push(line)
  parts : List[Str] = []
  for p in visible_planets(year, month, day, lat, lon, tz) {
    parts.push(sign(p.name) + " " + title(p.name) + " (rises " + p.rise.slice(0, 5) + " sets " + p.set.slice(0, 5) + ")")
  }
  if parts.length == 0 {
    out.push("Planets: none above 5° between 20:00 and 04:00")
  } else {
    out.push("Planets: " + parts.join(", "))
  }
  out.push("Near zenith: " + overhead(month, lat).join(", "))
  out
}

near(a : Float, b : Float, by : Float) : Bool {
  (a - b).abs <= by
}

test_dates() {
  assert(jd(2000, 1, 1) == 2451544.5)
  assert(jd_text(jd_at(2026, 11, 16, 9, 30, 0)) == "2026-11-16 09:30")
  assert(days_in_month(2024, 2) == 29 && days_in_month(2100, 2) == 28)
  assert(hhmm(7.999) == "08:00" && hhmm(-0.5) == "23:30")
  assert(hours_of("06:30") == 6.5 && hours_of("never") == -1.0)
  assert(ra_text(77.9) == "05h 12m" && dec_text(-19.08) == "-19° 05′")
}

test_moon_phase() {
  p = moon_phase(2026, 11, 16)
  assert(p.name == "Waxing Crescent" && p.index == 1)
  assert(near(p.lit, 0.3801, 0.0001))
  assert(phases_in_month(2026, 11).length == 4)
  assert(notable_phase(2026, 11, 25) && !notable_phase(2026, 11, 26))
}

test_seasons() {
  assert(jd_text(season(2026, 0)) == "2026-03-20 14:46")
  assert(jd_text(season(2026, 2)) == "2026-09-23 00:05")
  assert(jd_text(season(2026, 3)) == "2026-12-21 20:50")
  assert(events(2026, 8, 12).at(0) == "☄ Perseids peak")
}

// Oslo on 2026-11-16, as the orbit library in Rust gives it.
test_positions() {
  s = sky(2026, 11, 16, 59.9139, 10.7522, 1.0)
  sun = pos(s, "sun")
  assert(near(sun.ra, 231.2561, 0.0001) && near(sun.dec, -18.6816, 0.0001) && near(sun.dist, 0.9891, 0.0001))
  moon = pos(s, "moon")
  assert(near(moon.ra, 309.5835, 0.0001) && near(moon.dec, -20.6417, 0.0001) && near(moon.dist, 63.1437, 0.0001))
  sat = pos(s, "saturn")
  assert(near(sat.ra, 8.8257, 0.0001) && near(sat.dec, 0.9333, 0.0001) && near(sat.dist, 8.7202, 0.0001))
  nep = pos(s, "neptune")
  assert(near(nep.ra, 2.2173, 0.0001) && near(nep.dist, 29.2424, 0.0001))
}

test_times() {
  t = sun_times(2026, 11, 16, 59.9139, 10.7522, 1.0)
  assert(t.rise == "08:16" && t.transit == "12:02" && t.set == "15:47")
  m = moon_times(2026, 11, 16, 59.9139, 10.7522, 1.0)
  assert(m.rise == "13:59" && m.set == "20:31")
  assert(sun_times(2026, 6, 21, 69.6492, 18.9553, 2.0).rise == "always")
  assert(sun_times(2026, 12, 21, 69.6492, 18.9553, 1.0).rise == "never")
  assert(day_length(2026, 6, 21, 69.6492, 18.9553, 2.0) == 24.0)
  c = twilight(2026, 11, 16, 6.0, 59.9139, 10.7522, 1.0)
  assert(hours_of(c.rise) < hours_of(t.rise) && hours_of(c.set) > hours_of(t.set))
}

test_sky_now() {
  s = sky_at(2026, 11, 16, 18.0, 59.9139, 10.7522, 1.0)
  assert(where(s, "sun").alt < -10.0)
  assert(where(s, "saturn").alt > 15.0)
  assert(near(elongation(s, "sun"), 0.0, 0.01))
  assert(near(separation(0.0, 0.0, 90.0, 0.0), 90.0, 0.000001))
  v = visible_planets(2026, 11, 16, 59.9139, 10.7522, 1.0)
  assert(v.length == 3 && v.at(0).name == "mars")
  assert(table(bodies(2026, 11, 16, 59.9139, 10.7522, 1.0)).length == 11)
  assert(is_up(v.at(0), 23.0) && !is_up(v.at(0), 18.0))
}
