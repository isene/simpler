main(sys) {
  sys.screen.print((0 - 5).abs + 1)
  sys.screen.print((0.0 - 2.5).abs)
  m = Map()
  m.set("a", 1)
  m.set("b", 2)
  m.set("c", 3)
  m.remove("b")
  m.remove("zz")
  sys.screen.print(m.has("b"))
  sys.screen.print(m.keys.join(","))
  sys.screen.print(m.get("c") + m.get("a"))
  m.set("b", 9)
  sys.screen.print(m.get("b"))
  sys.screen.print(6.bitAnd(3) + 6.bitOr(3) * 10 + 6.bitXor(3) * 100)
  sys.screen.print(1.shl(10) + 1024.shr(3))
  sys.screen.print((0 - 8).shr(1))
}
